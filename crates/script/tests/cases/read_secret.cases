# A read of a key or a credential is `read_secret`, with the file guard's and
# the shell guard's reason for the same file. A read anywhere else is the
# agent's everyday work.

# Python reads.
python finds=read_secret reason="reads your SSH keys" target="/home/me/.ssh/id_rsa" | print(open('/home/me/.ssh/id_rsa').read())
python finds=read_secret reason="reads your SSH keys" | open('~/.ssh/id_ed25519').read()
python finds=read_secret reason="reads your AWS credentials" | open('/home/me/.aws/credentials').read()
python finds=read_secret reason="reads the system's password hashes" | open('/etc/shadow').read()
python finds=read_secret reason="reads your SSH keys" | from pathlib import Path\nPath('/home/me/.ssh/id_rsa').read_text()
python finds=read_secret reason="reads your SSH keys" | import shutil\nshutil.copy('/home/me/.ssh/id_rsa', 'k')
python finds=read_secret reason="reads a disk, and every key on it" | open('/dev/sda', 'rb').read()
python finds=read_secret reason="reads the kernel's process files" | print(open('/proc/self/environ').read())
# A path that starts in a folder of keys is a key, whatever its end.
python finds=read_secret reason="reads your SSH keys" | import sys\nn = sys.argv[1]\nopen('/home/me/.ssh/id_' + n)
# A path only known when the code runs may be any file: unknown.
python rules=unknown first=unknown reason="opens a file whose path is only known when the code runs" | import sys\nprint(open(sys.argv[1]).read())
python finds=unknown reason="opens a file whose path is only known when the code runs" | import sys\nopen('/home/me/' + sys.argv[1]).read()
# Reading a startup file or the repository's history is not reading a key
# (`open_modes.cases` reads a startup file in every mode).
python safe | print(open('.git/config').read())
# A read in a function is still a read.
python finds=read_secret reason="reads your SSH keys" | def f():\n    return open('/home/me/.ssh/id_rsa').read()

# Another user's home directory, wherever a system keeps one.
python finds=read_secret reason="reads your SSH keys" target="~root/.ssh/id_rsa" | print(open('~root/.ssh/id_rsa').read())
python finds=read_secret reason="reads your SSH keys" | print(open('~me/.ssh/id_rsa').read())
python finds=read_secret reason="reads your SSH keys" | print(open('~alice/.ssh/id_ed25519').read())
python finds=read_secret reason="reads your SSH keys" | import os\nprint(open(os.path.expanduser('~root/.ssh/id_rsa')).read())
python@macos finds=read_secret reason="reads your SSH keys" | print(open('~alice/.ssh/id_rsa').read())
# A path that cannot be placed may be any file.
python rules=unknown first=unknown reason="opens a file whose path is only known when the code runs" target="~alice/notes.txt" | print(open('~alice/notes.txt').read())
javascript rules=unknown first=unknown reason="opens a file whose path is only known when the code runs" | console.log(require('fs').readFileSync('~alice/notes.txt'))
javascript finds=read_secret reason="reads your SSH keys" | require('fs').readFileSync('~root/.ssh/id_rsa')

# JavaScript reads.
javascript finds=read_secret reason="reads your SSH keys" | require('fs').readFileSync('/home/me/.ssh/id_rsa')
javascript finds=read_secret reason="reads your SSH keys" | const fs = require('fs'); fs.readFileSync('~/.ssh/id_rsa', 'utf8')
javascript finds=read_secret reason="reads your AWS credentials" | require('fs').readFile('/home/me/.aws/credentials', () => {})
javascript finds=read_secret reason="reads the system's password hashes" | require('fs').createReadStream('/etc/shadow')
javascript finds=read_secret reason="reads your SSH keys" | Deno.readTextFile('/home/me/.ssh/id_rsa')
javascript finds=read_secret reason="reads your SSH keys" | Bun.file('/home/me/.ssh/id_rsa').text()
javascript finds=read_secret reason="reads your SSH keys" | require('fs').copyFileSync('/home/me/.ssh/id_rsa', 'k')
javascript finds=unknown reason="opens a file whose path is only known when the code runs" | require('fs').readFileSync(process.argv[1])
javascript rules=unknown | console.log(require('fs').readFileSync('/home/me/.zshrc', 'utf8'))
