# The secrets a caller names (`Paths::secrets`): a file or a folder core does
# not list, in the caller's words. `place` answers it as a key, before the
# workspace and a temporary folder it sits in; a path that is also protected
# is protected to `place`, and `named` (`named_secret`) still gives the
# secret. It is spelled and compared as a protected path is: without case on
# every host, in either canonical spelling, by a Windows short name; a
# pattern picks it as `picks` picks a key, and a folder read whole reaches
# it.

paths env base=posix secret_file=/home/me/work/repo/.env words="the project's environment file"
paths tokens base=posix secret_folder=/home/me/work/repo/secrets words="the deploy tokens"
paths vault base=posix secret_folder=/home/me/.vault words="your password vault"
paths session base=posix secret_file=/tmp/session/token words="the session token"
paths both base=posix file=/home/me/work/repo/.env words="the agent's settings" secret_file=/home/me/work/repo/.env words="the project's environment file"
paths both_folder base=posix folder=/home/me/work/repo/conf words="the agent's settings" secret_file=/home/me/work/repo/conf/token words="the deploy token"
paths canonical base=posix secret_file=/home/me/work/repo/café.env words="the café's keys"
paths mac_env base=macos secret_file=/Users/me/dev/repo/.env words="the project's environment file"
paths windows_env base=windows secret_file=C:\\Users\\me\\dev\\repo\\.env words="the project's environment file"
paths windows_vault base=windows secret_folder=C:\\Users\\me\\AppData\\Local\\Vault words="your password vault"

# A named file is a secret in the caller's words, inside the workspace too,
# however it is spelled.
posix@env place="secret:the project's environment file" named="the project's environment file" | .env
posix@env place="secret:the project's environment file" | /home/me/work/repo/.env
posix@env place="secret:the project's environment file" | ./src/../.env
posix@env place="secret:the project's environment file" | src/../../repo/.env
posix@env home place="secret:the project's environment file" | work/repo/.env
posix@env into="secret:the project's environment file" | .env
# Names compare without case on every host.
posix@env place="secret:the project's environment file" | .ENV
posix@env place="secret:the project's environment file" | /home/me/work/REPO/.Env
# A file has nothing below it, and a name beside it is no secret.
posix@env place=inside named=none | .env.example
posix@env place=inside named=none | src/.env
posix@env place=inside | .envrc
# With no secret named, the same paths are what they were.
posix place=inside named=none | .env
posix into=inside | .env
posix place=inside | src/../.env

# A named folder is a secret, and so is everything under it.
posix@tokens place="secret:the deploy tokens" named="the deploy tokens" | secrets
posix@tokens place="secret:the deploy tokens" | secrets/prod.json
posix@tokens place="secret:the deploy tokens" | secrets/a/b/c
posix@tokens place=inside named=none | secretsx
posix@vault place="secret:your password vault" | /home/me/.vault
posix@vault home place="secret:your password vault" | .vault/logins.db
posix@vault place="secret:your password vault" | /home/me/.VAULT/x
posix@vault place=outside | /home/me/.vaultx
posix place=outside named=none | /home/me/.vault/logins.db
# It wins over a temporary folder.
posix@session place="secret:the session token" | /tmp/session/token
posix@session place=in_temp | /tmp/session/other
posix place=in_temp | /tmp/session/token

# A pattern that can name a secret picks it, read as for a protected path:
# by the folder it starts in and what its parts can match below.
posix@env picks="the project's environment file" | .e*
posix@env picks="the project's environment file" | .env*
posix@env picks="the project's environment file" | /home/me/work/*/.env
posix@env picks="the project's environment file" | /home/me/*/repo/.e?v
posix@env picks="the project's environment file" | **/.env
posix@env picks="the project's environment file" | .[e]nv
# A POSIX wildcard matches a leading dot only with `dotglob`.
posix@env picks=none | *
posix@env hidden picks="the project's environment file" | *
posix@env picks=none | *env
# A file has nothing below its name.
posix@env picks=none | .env/*
posix@env picks=none | **/*.rs
posix@env picks=none | src/*
posix picks=none | .e*
posix picks=none | /home/me/work/*/.env
# A folder has: a pattern can go into it.
posix@tokens picks="the deploy tokens" | secrets/*.json
posix@tokens picks="the deploy tokens" | */prod.json
posix@tokens picks="the deploy tokens" | s*/x
posix@tokens picks="the deploy tokens" | **/*.rs
posix@tokens picks="the deploy tokens" | sec*
posix@tokens picks=none | src/*
posix@vault picks="your password vault" | /home/me/.va*t/logins.db
posix@vault picks="your password vault" | /home/me/.*
posix@vault home picks="your password vault" | .*/x
posix picks=none | /home/me/.va*t/logins.db
# `named` reads a path literally, a wildcard being a character of the name:
# `.e*` is no named path, and a name of any kind under a named folder is in
# it. What a pattern can pick is `picks`'s.
posix@env named=none | .e*
posix@tokens named="the deploy tokens" | secrets/*
posix@env named=none | /dev/null

# A read of a folder whole, or a pattern, reaches a secret below it.
posix@env deep reaches=yes | .
posix@env deep reaches=yes | /home/me/work
posix@env reaches=no | .
posix@env reaches=yes | .e*
posix@env reaches=yes | .env
posix@env reaches=no | src/*
posix@env deep reaches=no | src
posix@tokens reaches=yes | */prod.json
posix@tokens deep reaches=yes | s*
posix@vault deep reaches=yes | /home/me
posix@vault reaches=yes | /home/me/.vault/x
posix reaches=no | .e*

# Either canonical spelling names the same file: `é` as one character, or as
# `e` and a combining accent.
posix@canonical place="secret:the café's keys" | café.env
posix@canonical place="secret:the café's keys" | cafe\u{301}.env
posix@canonical place="secret:the café's keys" | CAFÉ.ENV
posix@canonical picks="the café's keys" | caf?.env
posix@canonical picks="the café's keys" | cafe\u{301}*
posix place=inside | cafe\u{301}.env

# A Mac's links to the root are read.
posix@mac_env place="secret:the project's environment file" | /System/Volumes/Data/Users/me/dev/repo/.env
posix@mac_env place="secret:the project's environment file" | /Volumes/Macintosh HD/Users/me/dev/repo/.env
posix@mac_env place="secret:the project's environment file" | .env

# Windows spellings: case, either separator, the dots and spaces a name ends
# in, a short name, a long path.
windows@windows_env place="secret:the project's environment file" named="the project's environment file" | .env
windows@windows_env place="secret:the project's environment file" | C:\\Users\\me\\dev\\repo\\.env
windows@windows_env place="secret:the project's environment file" | c:/users/ME/dev/repo/.ENV
windows@windows_env place="secret:the project's environment file" | .env.
windows@windows_env place="secret:the project's environment file" | .env\s
windows@windows_env place="secret:the project's environment file" | ENV~1
windows@windows_env place="secret:the project's environment file" | \\\\?\\C:\\Users\\me\\dev\\repo\\.env
windows@windows_env place=unknown named=none | .env:stream
windows@windows_env picks="the project's environment file" | *env
windows@windows_env picks="the project's environment file" | ENV~*
windows place=inside named=none | .env
windows picks=none | *env
windows@windows_vault home place="secret:your password vault" | AppData\\Local\\Vault\\x
windows@windows_vault place="secret:your password vault" | C:\\Users\\me\\AppData\\Roaming\\..\\Local\\Vault
windows@windows_vault picks="your password vault" | C:\\Users\\me\\AppData\\Local\\V*\\x

# A path both protected and secret is protected to `place`, so a write or a
# delete keeps the protected finding; `named` still gives the secret, which a
# read of it is.
posix@both place="protected:the agent's settings" named="the project's environment file" | .env
posix@both into="protected:the agent's settings" | .env
posix@both reaches=yes | .env
posix@both_folder place="protected:the agent's settings" named="the deploy token" | conf/token
posix@both_folder place="protected:the agent's settings" named=none | conf/other
posix@both_folder picks="the deploy token" | conf/t*

# A name a bracket is a character of: written out, it is the named path, as a
# pattern can also pick it, since a shell hands on a pattern that matches
# nothing as written.
paths bracket base=posix secret_file=/home/me/work/repo/app/[id]/secret.json words="the app's secret"
paths bracket_protected base=posix file=/home/me/work/repo/app/[id]/secret.json words="the agent's settings"
posix@bracket named="the app's secret" picks="the app's secret" | app/[id]/secret.json
posix@bracket picks="the app's secret" | app/*/secret.json
posix@bracket reaches=yes | app/[id]/secret.json
posix@bracket picks=none | app/[id]/other.json
posix@bracket_protected place="protected:the agent's settings" into="protected:the agent's settings" | app/[id]/secret.json
posix place=inside picks=none | app/[id]/secret.json

# After a `cd` the guard cannot follow, a relative name is matched against
# the last names of each named path, which the folder may hold: see
# `named_secret_in_unknown_folder`, held in Rust in `named_secrets.rs`.

# A Mac links `/tmp`, `/var` and `/etc` from `/private`: a named or a
# protected path is the same under either spelling, on every system.
paths mac_tmp base=macos secret_file=/tmp/s/token words="the session token"
paths mac_private base=macos secret_file=/private/tmp/s/token words="the session token"
paths mac_etc base=macos secret_folder=/etc/myapp words="the app's settings"
paths mac_folders base=macos secret_file=/var/folders/ab/T/token words="the session token"
paths mac_protected base=macos file=/tmp/s/token words="the agent's state"
posix@mac_tmp place="secret:the session token" named="the session token" | /private/tmp/s/token
posix@mac_tmp place="secret:the session token" | /tmp/s/token
posix@mac_private place="secret:the session token" | /tmp/s/token
posix@mac_private place="secret:the session token" | /private/tmp/s/token
posix@mac_etc place="secret:the app's settings" | /private/etc/myapp/secret.conf
posix@mac_folders place="secret:the session token" | /private/var/folders/ab/T/token
posix@mac_protected place="protected:the agent's state" | /private/tmp/s/token
posix@mac_tmp picks="the session token" | /private/tmp/s/t*
posix@mac_tmp deep reaches=yes | /private/tmp
posix@mac_tmp place=in_temp | /private/tmp/s/other
posix@macos place=in_temp | /private/tmp/s/token
# A pattern can pick either spelling.
posix@mac_tmp picks="the session token" | /private/*/s/token
posix@mac_tmp picks="the session token" | /priv*/tmp/s/token
posix@mac_tmp picks="the session token" | /*/tmp/s/token
posix@macos picks=none | /private/*/s/token
# A folder named `/private` itself holds every spelling below it.
paths private_protected base=macos folder=/private words="the system's private files"
paths private_secret base=macos secret_folder=/private words="the system's private files"
posix@private_protected place="protected:the system's private files" | /private/tmp/x
posix@private_protected into="protected:the system's private files" | /private/etc/hosts
posix@private_protected place="protected:the system's private files" | /private/other/x
posix@private_secret place="secret:the system's private files" | /private/tmp/x
posix@private_secret place="secret:the system's private files" | /private/other/x
posix@private_secret named="the system's private files" | /private/var/folders/x
