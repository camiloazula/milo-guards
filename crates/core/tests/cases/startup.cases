posix startup="a file a tool runs on its own" | a/.mcp.json
posix startup="a file a tool runs on its own" | .ENVRC
posix startup="a file a tool runs on its own" | .VSCODE/TASKS.JSON
posix startup="a file a tool runs on its own" | jenkinsfile
posix startup="a file a tool runs on its own" | LeftHook-Local.YAML
posix startup="a file a tool runs on its own" | lefthoo\u{212a}.yml
# A backslash is part of a name on POSIX.
posix startup=none | .vscode\\tasks.json
posix startup=none | .github\\workflows\\ci.yml
# Near misses are plain names.
posix startup=none | .envrcx
posix startup=none | x.envrc
posix startup=none | .env
posix startup=none | .vscode
posix startup="a file a tool runs on its own" | .vscode/settings.json
posix startup=none | .vscode/extensions.json
posix startup=none | .vscodex/tasks.json
