# Files a tool runs on its own, as the path model says it: a write into one
# (`into`, `Resolver::place_into`) is `Sensitive` with the kind `Startup`,
# found at any depth in a workspace folder (`startup`, and `below` for a
# folder that can hold one); `place`, which a read or a delete asks, still
# says the workspace's own. Each case is a spelling a review could try.

# A write into one is sensitive, and everything else is unchanged: a read, a
# delete and a move ask `place`, and `place_hidden`.
posix into="startup:a file a tool runs on its own" place=inside place_hidden=inside | .envrc
posix into="startup:a file a tool runs on its own" place=inside place_hidden=inside | .vscode/tasks.json
posix into="startup:a file a tool runs on its own" place=inside place_hidden=inside | .github/workflows/ci.yml
posix into="startup:a file a tool runs on its own" place=inside place_hidden=inside | .husky/pre-commit
posix into="startup:a file a tool runs on its own" place=inside place_hidden=inside | src/deep/.envrc
posix into=inside | Makefile
posix into=inside | justfile
posix into=inside | package.json
posix into=inside | src/main.rs

# Only a workspace's own paths are one: what a write into another is, is what
# it was.
posix into="history:the repository's history" place="history:the repository's history" startup=none below=none | .git/.envrc
posix into="history:the repository's history" place="history:the repository's history" startup=none below=none | .git/hooks/pre-commit
posix into=outside place=outside startup=none below=none | /home/me/other/.envrc
posix into=outside place=outside startup=none below=none | /home/me/.envrc
posix into=in_temp place=in_temp startup=none below=none | /tmp/x/.envrc
posix into="top:a system folder" place="top:a system folder" startup=none below=none | /etc/.envrc
posix into="secret:your SSH keys" place="secret:your SSH keys" startup=none below=none | /home/me/.ssh/.envrc
posix into="startup:a shell startup file" place="startup:a shell startup file" startup=none below=none | /home/me/.bashrc

# A POSIX machine finds every spelling.
posix startup="a file a tool runs on its own" | .envrc
posix startup="a file a tool runs on its own" | ./.envrc
posix startup="a file a tool runs on its own" | src/../.envrc
posix startup="a file a tool runs on its own" | .//.envrc
posix startup="a file a tool runs on its own" | /home/me/work/repo/.envrc
posix startup="a file a tool runs on its own" | /home/me/work/./repo/.envrc
posix startup="a file a tool runs on its own" | ../repo/.envrc
posix startup="a file a tool runs on its own" | .vscode//tasks.json
posix startup="a file a tool runs on its own" | .vscode/./tasks.json
posix startup="a file a tool runs on its own" | .vscode/x/../tasks.json
posix startup="a file a tool runs on its own" | .github/workflows/
