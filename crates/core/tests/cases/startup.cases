windows below="a file a tool runs on its own" | .GITHUB.
windows below="a file a tool runs on its own" | sub\\.vscode
windows below=none | src
windows below=none | PROGRA~1

# A pattern that can pick one is one. Below a folder on the list.
posix startup="a file a tool runs on its own" | .github/workflows/*
posix startup="a file a tool runs on its own" | .github/workflows/*.yml
posix startup="a file a tool runs on its own" | .github/workflows/c?.yml
