posix startup=none | Makefile
posix startup=none | justfile
posix startup=none | package.json
posix startup=none | .cargo/config.toml
# A Windows short name is a plain name on POSIX.
posix startup=none | VSCODE~1/TASKS~1.JSO
posix startup=none | ENVRC~1

# A Mac reads its links and its fold.
posix@macos startup="a file a tool runs on its own" | .envrc
posix@macos startup="a file a tool runs on its own" | .ENVRC
posix@macos startup="a file a tool runs on its own" | /Users/me/dev/repo/.envrc
