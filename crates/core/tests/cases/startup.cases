posix startup="a file a tool runs on its own" | .devcontainer/*
posix startup="a file a tool runs on its own" | .circleci/*
# A pattern that picks the last names of one.
posix startup="a file a tool runs on its own" | .vscode/*.json
posix startup="a file a tool runs on its own" | .vscode/*
posix startup="a file a tool runs on its own" | .vscode/t*
posix startup="a file a tool runs on its own" | .vscode/[t]asks.json
posix startup="a file a tool runs on its own" | .vscode/?asks.json
posix startup="a file a tool runs on its own" | .cursor/mcp.*
posix startup="a file a tool runs on its own" | .github/*/ci.yml
posix startup="a file a tool runs on its own" | .github/*
posix startup="a file a tool runs on its own" | src/.vscode/*.json
# A pattern that names one by a part that is more than stars.
posix startup="a file a tool runs on its own" | *.yml
posix startup="a file a tool runs on its own" | src/*.yml
posix startup="a file a tool runs on its own" | lefthook.*
posix startup="a file a tool runs on its own" | Jenkins*
posix startup="a file a tool runs on its own" | */Jenkinsfile
posix startup="a file a tool runs on its own" | **/Jenkinsfile
posix startup="a file a tool runs on its own" | src/**/Jenkinsfile
# Wildcards alone take what the folder holds, which is its own.
posix startup=none | *
posix startup=none | src/*
posix startup=none | src/*/*
posix startup=none | src/**
posix startup=none | **/*
posix startup=none | src/?*
# Patterns that cannot pick one.
posix startup=none | *.rs
posix startup=none | src/*.js
posix startup=none | *.md
posix startup=none | *.json
posix startup="a file a tool runs on its own" | *.toml
posix startup="a file a tool runs on its own" | .vscode/s*
posix startup=none | .vscode/e*
posix startup=none | .vscode/*.txt
posix startup=none | .github/*.md
posix startup=none | .github/ISSUE_*/*
posix startup=none | lefthook.y
posix startup=none | Makefile*
posix startup=none | justfil?
posix startup=none | package.*

# A pattern whose first part starts with a dot can pick `.git`, so it is
# already the repository's history at the workspace root and below it: what
# it is says so, and nothing is added.
posix into="history:a hidden file such as the repository's history" startup=none | .env*
posix into="history:a hidden file such as the repository's history" startup=none | .?nvrc
posix into="history:a hidden file such as the repository's history" startup=none | .e*
posix into="history:a hidden file such as the repository's history" startup=none | */.envrc
posix into="history:a hidden file such as the repository's history" startup=none | .*/mcp.json
posix into="history:a hidden file such as the repository's history" startup=none | .*/tasks.json
posix into="history:a hidden file such as the repository's history" startup=none | src/.env*

# A wildcard picks a leading dot where the shell says so.
posix startup=none | */tasks.json
posix hidden startup="a file a tool runs on its own" | */tasks.json
posix startup=none | */*.json
posix hidden startup="a file a tool runs on its own" | */*.json
posix hidden startup="a file a tool runs on its own" | *.json
posix startup=none | [.]envrc
posix hidden startup="a file a tool runs on its own" | [.]envrc
posix hidden startup="a file a tool runs on its own" | .vscode/[t]asks.json
posix startup=none | */mcp.json
posix hidden startup="a file a tool runs on its own" | */mcp.json
posix hidden startup=none | *
# On Windows a wildcard always matches a leading dot.
windows startup="a file a tool runs on its own" | *.json
windows startup="a file a tool runs on its own" | *.yml
windows startup="a file a tool runs on its own" | *\\tasks.json
windows startup="a file a tool runs on its own" | *\\*.json
windows startup="a file a tool runs on its own" | .vscode\\*.json
windows startup="a file a tool runs on its own" | GITHUB~1\\workflows\\*
windows startup="a file a tool runs on its own" | VSCODE~*\\tasks.json
windows startup="a file a tool runs on its own" | VSCODE~1\\*
windows startup=none | *.rs
windows startup=none | *
windows startup=none | src\\*

# A pattern that goes below a folder by a `..` is read where it lands.
posix startup="a file a tool runs on its own" | src/*/../../.envrc
posix startup="a file a tool runs on its own" | src/*/../../.vscode/tasks.json
posix startup=none | src/*/../x
posix startup=none | src/*/../../.vscode/extensions.json

# A `home` spelling reads from the home directory, here the workspace.
paths home cwd=/home/me home=/home/me workspace=/home/me
posix@home home startup="a file a tool runs on its own" | proj/.envrc
posix@home home startup="a file a tool runs on its own" | .vscode/tasks.json
posix@home home startup=none | proj/Makefile
# The home directory's own startup files and keys are what they were.
posix@home home startup=none | .bashrc
posix@home home startup=none | .ssh/id_rsa
# Beside the workspace, not in it.
posix home startup=none | .envrc
posix home startup="a file a tool runs on its own" | work/repo/.envrc

# Every workspace folder counts.
paths two base=posix workspace=/home/me/work/other
posix@two startup="a file a tool runs on its own" | /home/me/work/other/.envrc
posix@two startup=none | /home/me/work/third/.envrc

# A protected path wins.
paths protected base=posix folder=/home/me/work/repo/.github words="the agent's rules"
posix@protected into="protected:the agent's rules" startup=none | .github/workflows/ci.yml
posix@protected startup="a file a tool runs on its own" | .vscode/tasks.json

