# From the working directory, `~`, and by `..`.
paths root cwd=/ home=/home/me workspace=/home/me/work/repo
posix@root kernel="the kernel's process files" | proc/self/environ
posix@root kernel="a device file" | dev/mem
posix@root kernel=none | dev/null
posix home kernel="the kernel's process files" | ../../../proc/self/environ
posix kernel="a device file" | ../../../../../dev/mem
posix kernel="the kernel's process files" | src/../../../../../../proc/kcore
# Windows has no `/dev` of this kind: the device namespace is a disk.
windows kernel=none | /dev/mem
windows kernel=none | \\proc\\self\\environ

# A `.git` folder at any depth is the repository's own.
posix git="the repository's history" | .git/config
posix git="the repository's history" | .git
posix git="the repository's history" | .git/HEAD
posix git="the repository's history" | .git/objects/ab/cd
posix git="the repository's history" | .GIT/config
posix git="the repository's history" | vendor/x/.git/config
posix git="the repository's history" | vendor/x/.git/HEAD
posix git="the repository's history" | a/b/c/d/.git
posix git="the repository's history" | /tmp/clone/.git/config
posix git="the repository's history" | ~/work/other/.git/config
posix git="a git hook, which runs code" | .git/hooks/pre-commit
posix git="a git hook, which runs code" | .git/hooks
posix git="a git hook, which runs code" | .GIT/HOOKS/pre-commit
posix git="a git hook, which runs code" | vendor/x/.git/hooks/pre-commit
posix git="a git hook, which runs code" | vendor/x/.git/hooks/
posix git="a git hook, which runs code" | ../other/.git/hooks/post-merge
posix git="a git hook, which runs code" | vendor/x/.git/../.git/hooks/pre-commit
# A repository inside a repository inside a repository.
posix git="the repository's history" | .git/modules/m/hooks/pre-commit
posix git="the repository's history" | sub/.git/modules/m/.git/hooks/x
posix git=none | src/main.rs
posix git=none | .gitignore
posix git=none | .github/hooks/x
posix git=none | hooks/pre-commit
posix git=none | x.git/config
posix git=none | src/.gitx/hooks/x
posix git=none | git/hooks/x
windows git="the repository's history" | src\\.git\\config
windows git="the repository's history" | src\\GIT~1\\config
windows git="a git hook, which runs code" | vendor\\x\\git~2\\hooks\\pre-commit
windows git="a git hook, which runs code" | vendor\\x\\.git.\\hooks\\pre-commit
windows git="a git hook, which runs code" | vendor\\x\\.git\\hooks.\\pre-commit
windows git="a git hook, which runs code" | vendor\\x\\.git\\HOOKS\\pre-commit
windows git="the repository's history" | vendor\\x\\.git\\HOOKS~1\\pre-commit
windows git="a git hook, which runs code" | C:\\Users\\me\\dev\\repo\\vendor\\.git\\hooks\\x
windows git=none | src\\GITHUB~1\\x
windows git=none | src\\x.rs
# Known only when it runs: no answer.
windows git=none | vendor\\.git::$INDEX_ALLOCATION\\hooks\\x
windows git=none | D:vendor/.git/x

# A Mac whose home is root's reads every link spelling.
paths var_root cwd=/tmp/w home=/var/root workspace=/tmp/w
paths private_var_root cwd=/tmp/w home=/private/var/root workspace=/tmp/w
paths data_var_root cwd=/tmp/w home=/System/Volumes/Data/var/root workspace=/tmp/w
