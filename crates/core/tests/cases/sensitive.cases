windows place="startup:your git settings" | C:\\Users\\me\\.config\\git\\config
windows place="startup:your PowerShell profile" | C:\\Users\\me\\.config\\powershell\\profile.ps1
windows place="startup:your PowerShell profile" | C:\\Users\\me\\OneDrive\\Documents\\PowerShell\\profile.ps1
windows place="startup:your PowerShell profile" | C:\\Users\\me\\OneDrive\\Documents\\WindowsPowerShell\\profile.ps1
windows place="startup:the services your system starts at login" | C:\\Users\\me\\.config\\systemd\\user\\x.service
posix place="startup:your git settings" | /home/me/.config/git/config
posix place="startup:your PowerShell profile" | /home/me/.config/powershell/Microsoft.PowerShell_profile.ps1
