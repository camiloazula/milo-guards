# What reading a folder or a pattern can reach below it
# (`Resolver::reaches_secret`): a secret that `place` does not say, since it
# names only the path itself. A folder read whole (`deep`) holds whatever is
# below it; a pattern picks what its parts match, by the shell's own rules for
# hidden names (`hidden` says a wildcard matches a leading dot). `home` gives
# the part below the home directory (`~`).

paths config cwd=/home/me/.config home=/home/me workspace=/home/me/.config
paths home cwd=/home/me home=/home/me workspace=/home/me

# A project folder holds no secret.
posix reaches=no | .
posix deep reaches=no | .
posix reaches=no | src
posix deep reaches=no | src
posix reaches=no | ./src/..
posix deep reaches=no | ./src/..
posix reaches=no | /home/me/work/repo
posix deep reaches=no | /home/me/work/repo
posix reaches=no | src/*
posix deep reaches=no | src/*
posix reaches=no | *
posix deep reaches=no | *
posix reaches=no | **/*.rs
posix deep reaches=no | **/*.rs
posix reaches=no | .*
posix deep reaches=no | .*

# A folder holding a login reaches it only when read whole.
posix@config deep reaches=yes | .
posix@config reaches=no | .
posix@config deep reaches=yes | /home/me/.config
posix@config reaches=no | /home/me/.config
posix@config deep reaches=yes | ../.config
posix@config reaches=no | ../.config
# Neither holds one below.
posix@config deep reaches=no | sub
posix@config reaches=no | gh/..

# The home folder and what holds it hold every secret.
posix home deep reaches=yes |
posix deep reaches=yes | /home/me
posix deep reaches=yes | /home
posix deep reaches=yes | /
posix home deep reaches=yes | /
posix deep reaches=yes | /home/me/.
# Another user's home, and the root user's.
posix deep reaches=yes | /home/other
posix deep reaches=yes | /root
posix deep reaches=yes | /Users/other
posix deep reaches=no | /home/me/work
posix deep reaches=no | /tmp
posix deep reaches=no | /etc/hosts

# A secret itself, or below one, is reached.
posix home reaches=yes | /.ssh
posix home reaches=yes | /.ssh/id_rsa
posix home reaches=yes | /.aws/credentials
posix reaches=yes | /home/me/.config/gh/hosts.yml

# A pattern reaches what it can pick: `gh` is a login in this folder.
posix@config reaches=yes | g*
posix@config reaches=yes | g?
posix@config reaches=yes | [g]h
posix@config reaches=yes | *
posix@config reaches=yes | gh/*
posix@config reaches=yes | g*/hosts.yml
posix@config reaches=yes | */hosts.yml
posix@config reaches=yes | */x
posix@config reaches=no | z*
posix@config reaches=no | sub/*
posix@config reaches=no | *.md
posix@config reaches=no | ?x
posix@config reaches=no | x*/hosts.yml
# Deep, a pattern that picks a folder holding one reaches it.
posix@config deep reaches=yes | g*
posix@config deep reaches=no | z*

# A hidden name is picked by the shell's own rules. A leading dot is not
# matched by `*` in a POSIX shell, unless `dotglob`.
posix@home reaches=no | src/*
# Beneath the home folder the folder itself is the home.
posix@home reaches=yes | .s*/id_rsa
posix@home reaches=yes | .*/id_rsa
# With `dotglob` on, `*` matches `.ssh` too; without it a pattern with no dot
# of its own never does. (In `config`, `*` names `gh`, which is not hidden.)
posix@home hidden reaches=yes | */id_rsa
posix@home reaches=no | */id_rsa
posix@home hidden reaches=no | src/*

# A Windows wildcard matches a hidden folder.
paths windows_home cwd=C:\\Users\\me home=C:\\Users\\me workspace=C:\\Users\\me
windows@windows_home deep reaches=yes | *\\*
windows@windows_home deep reaches=yes | *\\id_rsa
windows@windows_home deep reaches=yes | .\\*\\*
windows@windows_home deep reaches=yes | .s*\\id_rsa
windows@windows_home deep reaches=yes | *
windows@windows_home reaches=yes | *\\id_rsa
windows@windows_home deep reaches=no | src\\*
paths roaming cwd=C:\\Users\\me\\AppData\\Roaming home=C:\\Users\\me workspace=C:\\Users\\me\\AppData\\Roaming
windows@roaming deep reaches=yes | *\\*
windows@roaming deep reaches=yes | .
windows@roaming reaches=no | .
windows@roaming deep reaches=no | Code\\*

# What cannot be spelled out reaches one.
windows@posix reaches=yes | D:x
