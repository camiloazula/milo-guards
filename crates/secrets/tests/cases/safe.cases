safe | password == other.password

# Stand-ins for secrets are safe: the ids AWS's documentation shows end in
# EXAMPLE, a placeholder in an address or a header is no value, and a header
# of a key alone is not a key.
safe | AKIAIOSFODNN7EXAMPLE
safe | postgres://user:${DB_PASSWORD}@db/app
safe | postgres://user:<password>@db/app
safe | https://user:$PASS@host.io/
safe | postgres://user@db/app
safe | postgres://db:5432/app
safe | https://host.io:8080/path?x=a@b
safe | ssh://git@github.com:22/org/repo.git
safe | Authorization: Bearer ${TOKEN}
safe | Authorization: Bearer <token>
safe | Authorization: Bearer YOUR_TOKEN_HERE
safe | Authorization: Bearer
safe | Basic authentication sends the credentials in a header
safe | Basic configuration for the build
safe | Authorization: Basic ZmFrZQ==
# The pair RFC 7617 writes its example with.
safe | Authorization: Basic QWxhZGRpbjpvcGVuIHNlc2FtZQ==
safe | bearer instruments are issued unregistered
safe | -----BEGIN PRIVATE KEY-----
safe | Paste the block that starts with `-----BEGIN RSA PRIVATE KEY-----` here.
safe | -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
safe | -----BEGIN PRIVATE KEY-----\nThe key goes here, and this is how it is read by the tool.\n-----END PRIVATE KEY-----
safe | -----BEGIN CERTIFICATE-----\nMIIBsjCCAVigAwIBAgIUFakeFakeFakeFakeFakeFakeFakeFakeFake\n-----END CERTIFICATE-----
safe | -----BEGIN PUBLIC KEY-----\nMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEFakeFakeFakeFakeFakeFakeFake\n-----END PUBLIC KEY-----

