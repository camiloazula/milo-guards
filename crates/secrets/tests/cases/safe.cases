safe | "password": "string"
safe | "password": ""
safe | password=
safe | password:\s
safe | password = ''
safe | password=${DB_PASSWORD}
safe | password: ${DB_PASSWORD:-changeme-not-a-value}
safe | PASSWORD=$DB_PASSWORD
safe | password: <your password>
safe | --password=<password>
safe | token={{ token }}
