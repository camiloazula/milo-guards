safe | GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
safe | AWS_KEY=AKIAXXXXXXXXXXXXXXXX
safe | OPENAI_API_KEY=sk-...
safe | OPENAI_API_KEY="sk-…"
safe | token=ghp_...
safe | password=********
