# What is found is not found twice: the password of a URL is not also read
# as an email's local part.
rules=url_credentials | https://me:fakePass0word1@git.corp.io/r.git

# A stand-in is safe by the shape of the whole value: a constant (upper
# snake case, letters only, not in quotes),
safe | password: DEFAULT_PASSWORD
safe | x = connect(host, token=DEFAULT_TOKEN)
safe | options = {token: DEFAULT_TOKEN}
safe | def auth(self, password=None, token=DEFAULT_TOKEN):
safe | token = DEFAULT_TOKEN
