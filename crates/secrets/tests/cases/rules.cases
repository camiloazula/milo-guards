# Texts by rule: each text must break its rule, and the spelling variants a
# reviewer would try are cases of their own. A value shaped like a real key
# is built in `rules.rs`, not written here.

# A JSON web token signed with `none` has no signature.
rules=jwt | eyJhbGciOiJub25lIn0.eyJzdWIiOiJmYWtlLXVzZXIifQ.

# Basic authorization headers.
finds=basic_auth | Authorization: Basic ZmFrZXVzZXI6ZmFrZXBhc3M=
finds=basic_auth | authorization: basic ZmFrZXVzZXI6ZmFrZXBhc3M=
finds=basic_auth | curl -H 'Authorization: Basic ZmFrZXVzZXI6ZmFrZXBhc3M=' x
finds=basic_auth | Proxy-Authorization: Basic ZmFrZXVzZXI6ZmFrZXBhc3M=
# No padding.
finds=basic_auth | Authorization: Basic ZmFrZXVzZXI6ZmFrZXBhc3N4

# A password in an address.
finds=connection_string | postgres://u:p@h/db
finds=connection_string | postgresql://app:fakePass0word1@db.internal:5432/app
finds=connection_string | mysql://root:fakePass0word1@localhost/db
finds=connection_string | mongodb://app:fakePass0word1@h1:27017,h2:27017/db
finds=connection_string | mongodb+srv://app:fakePass0word1@cluster.example.io/db
finds=connection_string | redis://:fakePass0word1@cache:6379/0
finds=connection_string | rediss://default:fakePass0word1@cache:6380
finds=connection_string | amqps://app:fakePass0word1@mq.example.io/vhost
finds=connection_string | POSTGRES://app:fakePass0word1@db/app
finds=connection_string | DATABASE_URL="postgres://app:fakePass0word1@db/app?sslmode=require"
finds=url_credentials | https://me:fakePass0word1@example.net/
finds=url_credentials | http://:fakePass0word1@example.net/
finds=url_credentials | ftp://me:fakePass0word1@files.example.net/x
finds=url_credentials | git+https://me:fakePass0word1@host.io/r.git
finds=url_credentials | ssh://me:fakePass0word1@host.io/

# The password of an address is the span, and the rest stays.
span="p@ss0rd" | dsn = postgres://app:p@ss0rd@db.internal:5432/app
span="fakePass0word1" | git clone https://me:fakePass0word1@host.io/r.git

# A secret written as the value of a name.
finds=generic_secret | password=fakePass0word1
finds=generic_secret | PASSWORD=fakeHorse1Staple
finds=generic_secret | export TOKEN=fakeValueXyz
finds=generic_secret | secret = 'fakeValue0Xyz'
finds=generic_secret | secret: fakeValue0Xyz
finds=generic_secret | "password": "fakeHorse1Staple"
finds=generic_secret | {"client_secret":"fakeClientValue"}
finds=generic_secret | api_key = "fakeValueAbc12"
finds=generic_secret | X-Api-Key: fakeValue0123
finds=generic_secret | --password=fakeHorse1Staple
finds=generic_secret | https://x.io/a?token=fakeValue0123b&b=1
finds=generic_secret | Server=db;User Id=sa;Password=fakePass0word1;Encrypt=true
finds=generic_secret | let password = "fakeHorse1Staple";
finds=generic_secret | db.password: fakePass0word1
finds=generic_secret | pass=fakeHorse1Staple
finds=generic_secret | db_pass: fakePass0word1
finds=generic_secret | AUTH_TOKEN = fakeValue01
finds=generic_secret | secret_key: "fakeValue123"
finds=generic_secret | passphrase: "fakeHorseStaple"
finds=generic_secret | data: password=fakePass0word1
finds=generic_secret | token := "fakeValueXyz"
finds=generic_secret | password => "fakeHorse1Staple"

# A generic secret's span is its value, without its name or quotes.
span="fakePass0word1" | password=fakePass0word1 next
span="fakeValueAbc12" | api_key = "fakeValueAbc12" # ok
span="fakePass0word1" | {"password": "fakePass0word1", "user": "x"}
span="fakePass0word1" | Password=fakePass0word1;Encrypt=true
span="fakeValue0123b" | ?token=fakeValue0123b&b=1

# A card number.
finds=credit_card | 4111111111111111
finds=credit_card | card: 4111 1111 1111 1111.
finds=credit_card | 4111-1111-1111-1111
finds=credit_card | {"card":"4012888888881881"}
finds=credit_card | 5555555555554444
finds=credit_card | 2223003122003222
finds=credit_card | 3782 822463 10005
finds=credit_card | 378282246310005
finds=credit_card | 6011111111111117
finds=credit_card | 30569309025904
finds=credit_card | 3530111333300000
finds=credit_card | 4222222222222
finds=credit_card | 6200000000000005

# An id number.
finds=government_id | ssn: 123-45-6789
finds=government_id | (123-45-6789)
finds=government_id | NI AB 12 34 56 C
finds=government_id | NI AB123456C
finds=government_id | cpf 529.982.247-25

# An email, a phone and an address.
finds=email | alice.smith@acme.io
finds=email | Alice <alice+tag@mail.acme.co.uk>
finds=email | mailto:a_b-c@acme.io?subject=x
finds=phone | +14155550132
finds=phone | +1 (415) 555-0132
finds=phone | tel:+49 151 12345678
finds=phone | +44.20.7946.0958
finds=public_ip | 8.8.8.8
finds=public_ip | connect to 93.184.216.34:443
finds=public_ip | 2606:4700:4700::1111
finds=public_ip | [2001:4860:4860:0:0:0:0:8888]:53

# An email in a query is found, and one in a login is the URL's.
rules=email | https://x.io/unsubscribe?email=alice.smith@acme.io
rules=email | https://x.io/contact/alice.smith@acme.io
safe | https://alice.smith@acme.io/repo.git

# Where a value ends is decided on the text as written: an escape is never a
# separator, so the whole value is the span.
rules=generic_secret span="F4kePa%26ss9word" | https://api.fake.test/login?user=me&password=F4kePa%26ss9word&next=/
rules=generic_secret span="F4kePass9%20more9" | password=F4kePass9%20more9
rules=generic_secret span="F4ke%22Pass9word" | password=F4ke%22Pass9word
rules=generic_secret span="F4ke\"Pass9word" | password=F4ke"Pass9word
rules=generic_secret span="F4ke'Pass9word" | password=F4ke'Pass9word
rules=generic_secret span="F4kePass9\\\"tail0123" | {"password": "F4kePass9\\"tail0123"}
rules=generic_secret span="F4kePass9\\u0022tail0123" | {"password": "F4kePass9\\u0022tail0123"}
rules=generic_secret span="F4ke\\\\Pass9word" | password = "F4ke\\\\Pass9word"
rules=generic_secret span="F4ke\\'Pass9word" | password = 'F4ke\\'Pass9word'
rules=generic_secret span="F4ke''Pass9word" | password: 'F4ke''Pass9word'
rules=generic_secret span="F4kePass9\\\\tail0123" | {\\"password\\": \\"F4kePass9\\\\tail0123\\"}
# Not a separator of an unquoted value: only white space ends it.
rules=generic_secret span="F4kePass9|tail0123" | SECRET=F4kePass9|tail0123
rules=generic_secret span="F4ke;Pass9word" | SECRET=F4ke;Pass9word
rules=generic_secret span="F4ke&Pass9word" | SECRET=F4ke&Pass9word
rules=generic_secret span="F4ke(Pass9)word" | SECRET=F4ke(Pass9)word
rules=generic_secret span="F4ke`Pass9word" | SECRET=F4ke`Pass9word
rules=generic_secret span="F4ke,Pass9word" | SECRET=F4ke,Pass9word
# The format's own separator, where there is one.
rules=generic_secret span="F4kePass9" | ?user=me&password=F4kePass9&next=/
rules=generic_secret span="F4kePass9" | password=F4kePass9&x=1
rules=generic_secret span="F4kePass9" | Server=db;User Id=sa;Password=F4kePass9;Encrypt=true
rules=generic_secret span="F4kePass9" | Password=F4kePass9;User Id=sa;Server=db
rules=generic_secret span="F4ke%3BPass9" | Password=F4ke%3BPass9;User Id=sa
# The quote or bracket the name sits in.
rules=generic_secret span="F4kePass9word" | echo "password=F4kePass9word" >> .env
rules=generic_secret span="F4kePass9word" | login(password=F4kePass9word)
rules=generic_secret span="F4kePass9word" | {password: F4kePass9word}
rules=generic_secret span="F4kePass9word" | [password=F4kePass9word]
rules=generic_secret span="F4kePass9word" | "password=F4kePass9word"

# A value that never closes is read as the word after the quote.
rules=generic_secret span="F4kePass9word" | password="F4kePass9word and more
rules=generic_secret span="F4kePass9word" | password='F4kePass9word

# Spans that overlap become one that covers both.
rules=connection_string span="F4ke.me@fake.io" | postgres://u:F4ke.me@fake.io@db.fake.test/x

# A password in an address with escapes in it.
rules=connection_string span="F4ke%2FPass9" | postgres://fakeuser:F4ke%2FPass9@db.fake.test/app
rules=connection_string span="F4ke%40Pass9" | postgres://fakeuser:F4ke%40Pass9@db.fake.test/app
rules=connection_string span="F4ke%23Pass9" | postgres://fakeuser:F4ke%23Pass9@db.fake.test/app
rules=connection_string span="F4ke%3FPass9" | postgres://fakeuser:F4ke%3FPass9@db.fake.test/app
rules=connection_string span="F4kePass9" | postgres://fakeuser%40fakeserver:F4kePass9@fakeserver.postgres.database.azure.com/app
rules=url_credentials span="F4ke%2FPass9" | https://fakeuser:F4ke%2FPass9@git.fake.test/repo.git
rules=url_credentials span="F4kePass9" | https://fake%40user:F4kePass9@git.fake.test/repo.git
# Written in escapes as a whole, in a query.
rules=connection_string span="F4kePass9" | ?next=postgres%3A%2F%2Ffakeuser%3AF4kePass9%40db.fake.test%2Fapp

# A count of private lines with nothing after it is not a key.
safe | Private-Lines: 1\nMAC\n

# The password of a file of login details.
rules=generic_secret span="F4kePassw0rdZ" | machine api.fake.test login fakeuser password F4kePassw0rdZ
rules=generic_secret span="F4kePassw0rdZ" | machine api.fake.test\n  login fakeuser\n  password F4kePassw0rdZ\n
rules=generic_secret span="F4kePassw0rdZ" | default login fakeuser password F4kePassw0rdZ

# A provider shape with nothing to say it is one is safe.
safe | https://fake.test/?sig=FakeSasSig0123AbCdFakeSasSig0123AbCdFakeSasSig0123AbCd
safe | password for the machine is in the vault
safe | Enter your password to log in to the machine
safe | {"auth": "ZmFrZQ=="}
safe | auth: bW9zdGx5IGhhcm1sZXNzIHRleHQ=

# Braces quote a value of a connection string; a template or a value that is
# its own name is no password (`token={{ token }}` is in `safe.cases`).
rules=generic_secret span="F4kePass9" | Driver={SQL};Uid=me;Pwd={F4kePass9};
rules=generic_secret span="F4ke;Pass9=x" | Driver={SQL};Uid=me;Pwd={F4ke;Pass9=x};
rules=generic_secret span="F4ke}}Pass9" | Driver={SQL};Uid=me;Pwd={F4ke}}Pass9};
safe | token={token}
safe | Pwd={}
safe | password={PASSWORD}

# A quote that closes the string a name is in is one only if it is not
# escaped.
rules=generic_secret span="F4kePa\\\"ss9word" | ["password=F4kePa\\"ss9word"]
rules=generic_secret span="F4kePa''ss9word" | 'password=F4kePa''ss9word'
rules=generic_secret span="F4ke\\\\\\\"Pass9word" | "password=F4ke\\\\\\"Pass9word"
rules=generic_secret span="F4kePass9word" | 'password=F4kePass9word' x

# Known limit: a closing bracket is not escaped by anything, so the value of
# a name inside brackets ends at the first one. The part after it is not
# covered; the rest of the text is read on.
rules=generic_secret span="F4kePass9" | [password=F4kePass9]word]
rules=generic_secret span="F4kePass9" | f(password=F4kePass9)word)
rules=generic_secret span="F4kePass9" | {password=F4kePass9}word}

# The limits of reading a value: `&` before something that reads as another
# pair ends a value, even when it was part of the password; a quoted value
# with a space in it is prose; a password of fewer than six characters, and
# a password that is the value of a name that does not end in a word of a
# secret's, are not found.
rules=generic_secret span="F4kePa" | SECRET=F4kePa&ss9=word
safe | export PASSWORD="F4ke Pass9 x"
safe | password=Ab3d9
safe | passcode=F4kePass9word

# A real password or token beside the safe cases is still found: a quoted
# password with a digit or a symbol is not a word,
rules=generic_secret span="Contraseña1" | {"password": "Contraseña1"}
rules=generic_secret span="Hunter2!" | {"password": "Hunter2!"}
rules=generic_secret span="Correct?Horse" | {"password": "Correct?Horse"}
rules=generic_secret span="hunter22" | {"password": "hunter22"}
rules=generic_secret span="Confirmar#7" | {"confirm_password": "Confirmar#7"}
# a word that is not a Title word (lower case, upper case or several
# capitals) is not a label,
rules=generic_secret span="sunshine" | {"password": "sunshine"}
rules=generic_secret span="SUNSHINE" | {"password": "SUNSHINE"}
rules=generic_secret span="SunShine" | {"password": "SunShine"}
# nor is a word as the value of a name that is not a key of data,
rules=generic_secret span="Sunshine" | password = "Sunshine"
rules=generic_secret span="Sunshine" | let password = "Sunshine";
rules=generic_secret span="Sunshine1" | password: Sunshine1
# or more than a word, or one too long to be a label;
rules=generic_secret span="Supercalifragilisticexpialidocious" | {"password": "Supercalifragilisticexpialidocious"}
# a quoted token of eight characters, and a long one under any name,
rules=generic_secret span="abc12345" | let token = "abc12345";
rules=generic_secret span="Xk9fQ2mZ" | {"token": "Xk9fQ2mZ"}
rules=generic_secret span="Xk9fQ2mZ7p" | let api_token = "Xk9fQ2mZ7p";
# and a short secret value under a word that is not a token's.
rules=generic_secret span="abc123" | password = "abc123"
rules=generic_secret span="abc123" | let secret = "abc123";
