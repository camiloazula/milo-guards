# Every kind of key, in the dress it comes in, is found whole: each byte of
# the secret is in a span (`covers=`). These are the texts that hold no
# value shaped like a real key; the keys of each provider and format are
# built in `found_whole.rs`.

# Files of login details, headers and names of a key.
covers="F4kePassw0rdZ" | machine api.fake.test login fakeuser password F4kePassw0rdZ
covers="F4kePassw0rdZ" | machine api.fake.test\n  login fakeuser\n  password F4kePassw0rdZ\n
covers="pypi-AgEIcHlwaS5vcmcFakeFakeFakeFakeFakeFakeFakeFakeFakeFakeFakeFake0123456789" | [pypi]\nusername = __token__\npassword = pypi-AgEIcHlwaS5vcmcFakeFakeFakeFakeFakeFakeFakeFakeFakeFakeFakeFake0123456789\n
covers="F4kePassw0rdZ" | [pypi]\nusername = fakeuser\npassword = F4kePassw0rdZ\n
covers="F4ke8Q~abcdefghijklmnopqrstuvwxyz0123456" | client_secret=F4ke8Q~abcdefghijklmnopqrstuvwxyz0123456
covers="F4keApiKey0123456789abcdef" | x-api-key: F4keApiKey0123456789abcdef
covers="F4keApiKey0123456789abcdef" | api_key: F4keApiKey0123456789abcdef
covers="F4keApiKey0123456789abcdef" | const apiKey = 'F4keApiKey0123456789abcdef';
covers="F4keApiKey0123456789abcdef" | OPENAI_API_KEY=F4keApiKey0123456789abcdef
# A password in base64, wrapped once.
covers="RjRrZVBhc3M5d29yZA==" | data:\n  password: RjRrZVBhc3M5d29yZA==\n
covers="4242 4242 4242 4242" | card 4242 4242 4242 4242 exp

# Connection strings.
covers="F4kePass9" | DATABASE_URL=postgres://fakeuser:F4kePass9@db.fake.test:5432/app
covers="F4kePass9" | DATABASE_URL=mysql://fakeuser:F4kePass9@db.fake.test/app
covers="F4kePass9" | DATABASE_URL=redis://:F4kePass9@cache.fake.test:6379/0
covers="F4kePass9" | DATABASE_URL=amqp://fakeuser:F4kePass9@mq.fake.test:5672/vhost
covers="F4ke%2FPass9" | DATABASE_URL=postgres://fakeuser:F4ke%2FPass9@db.fake.test/app
covers="F4ke%40Pass9" | DATABASE_URL=postgres://fakeuser:F4ke%40Pass9@db.fake.test/app
covers="F4kePass9" | DATABASE_URL=postgres://fakeuser%40fakeserver:F4kePass9@fakeserver.postgres.database.azure.com/app
covers="F4ke%23Pass9" | DATABASE_URL=postgres://fakeuser:F4ke%23Pass9@db.fake.test/app
covers="F4ke%3FPass9" | DATABASE_URL=postgres://fakeuser:F4ke%3FPass9@db.fake.test/app
covers="F4ke%2FPass9" | DATABASE_URL=https://fakeuser:F4ke%2FPass9@git.fake.test/repo.git
covers="F4kePass9" | DATABASE_URL=jdbc:postgresql://db.fake.test:5432/app?user=fakeuser&password=F4kePass9
covers="F4kePass9" | DATABASE_URL=Server=tcp:fake.database.windows.net;Database=app;User ID=fakeuser;Password=F4kePass9;Encrypt=true
covers="F4kePass9" | DATABASE_URL=host=db.fake.test user=fakeuser password=F4kePass9 dbname=app
covers="F4ke#Pass9" | DATABASE_URL=postgres://fakeuser:F4ke#Pass9@db.fake.test/app
covers="F4ke?Pass9" | DATABASE_URL=postgres://fakeuser:F4ke?Pass9@db.fake.test/app

# A value is found whole up to where it ends: an escape that decodes to a
# separator does not end it,
covers="F4kePa%26ss9word" | https://api.fake.test/login?user=me&password=F4kePa%26ss9word&next=/
covers="F4kePass9%20more9" | password=F4kePass9%20more9
covers="F4kePass9\\\"tail0123" | {"password": "F4kePass9\\"tail0123"}
covers="F4kePass9\\u0022tail0123" | {"password": "F4kePass9\\u0022tail0123"}
covers="F4ke\\\"Pa%22ss\\\"9w%22ord" | {"password": "F4ke\\"Pa%22ss\\"9w%22ord"}
covers="F4ke%22Pa%22ss9word" | password=F4ke%22Pa%22ss9word
covers="F4ke\\nPass9word" | password = "F4ke\\nPass9word"
# whatever the dress of a name and its value,
covers="F4kePass9" | db_password: 'F4kePass9'
covers="F4ke''Pass9" | db_password: 'F4ke''Pass9'
covers="F4kePass9" | export DB_PASSWORD=F4kePass9
covers="F4kePass9" | run --password=F4kePass9 now
# nor does a character that is no separator of an unquoted value,
covers="F4kePass9|tail0123" | SECRET=F4kePass9|tail0123
covers="F4ke,Pass9word" | SECRET=F4ke,Pass9word
covers="F4ke;Pass9word" | password=F4ke;Pass9word
covers="F4ke&Pass9word" | SECRET=F4ke&Pass9word
covers="F4ke(Pass9)word" | SECRET=F4ke(Pass9)word
covers="F4ke`Pass9word" | SECRET=F4ke`Pass9word
# a separator inside quotes or braces,
covers="F4ke&Pass9=x" | ?user=me&password="F4ke&Pass9=x"&next=1
covers="F4ke;Pass9=x" | Server=db;User Id=me;Password="F4ke;Pass9=x";Encrypt=true
covers="F4ke;Pass9=x" | Server=db;User Id=me;Password='F4ke;Pass9=x';Encrypt=true
covers="F4kePass9" | Driver={SQL};Uid=me;Pwd={F4kePass9};
covers="F4ke;Pass9=x" | Driver={SQL};Uid=me;Pwd={F4ke;Pass9=x};
# or the quote or bracket the name sits in;
covers="F4kePass9word" | (password=F4kePass9word
covers="F4kePa\\\"ss9word" | ["password=F4kePa\\"ss9word"]
covers="F4kePa''ss9word" | 'password=F4kePa''ss9word'
covers="F4kePass9word" | password="F4kePass9word and more
# and the password of an address is found whole.
covers="F4ke%2FPass9" | postgres://fakeuser:F4ke%2FPass9@db.fake.test/app
covers="F4kePass9" | postgres://fakeuser%40fakeserver:F4kePass9@fake.postgres.database.azure.com/app
covers="F4ke%2FPass9" | https://fakeuser:F4ke%2FPass9@git.fake.test/r.git
covers="F4%2Fke%40Pa%3Ass9" | postgres://u%40s:F4%2Fke%40Pa%3Ass9@db.fake.test/app
covers="F4kePass9" | postgres://u:F4kePass9@db

# Spans that overlap are merged into one that holds each secret whole.
covers="F4ke.me@fake.io" | postgres://u:F4ke.me@fake.io@db.fake.test/x

# A value that looks like a stand-in but is real is found whole.
covers="Password1" | password=Password1
covers="MyPassword!" | password=MyPassword!
covers="supersecret42" | secret=supersecret42
covers="token-8f3a9c2e" | token=token-8f3a9c2e
covers="token-8f3a9c2e7b1d4f60" | token=token-8f3a9c2e7b1d4f60
covers="prod_api_key_9Xq" | api_key=prod_api_key_9Xq
covers="prod_api_key_9XqZwTnV" | api_key=prod_api_key_9XqZwTnV
covers="MySecret!Strong#Pass" | client_secret: "MySecret!Strong#Pass"
covers="P@ssword2024" | DB_PASSWORD=P@ssword2024
covers="Passw0rd!" | password=Passw0rd!
covers="Password1" | postgres://admin:Password1@db.fake.test/app
covers="mysecretpassword" | POSTGRES_PASSWORD=mysecretpassword
covers="django-insecure-secret-key-9x" | SECRET_KEY = 'django-insecure-secret-key-9x'
covers="mytoken_A1b2C3zz" | token=mytoken_A1b2C3zz
covers="K7X_93QZ_M2PL_W8RT" | DB_PASSWORD=K7X_93QZ_M2PL_W8RT
covers="QZ7W_P3XK_M2LV_9TRB" | secret: "QZ7W_P3XK_M2LV_9TRB"
covers="PROD_PW_7X3K" | postgres://u:PROD_PW_7X3K@db.fake.test/x
covers="MY_APP_JWT_KEY_2024" | JWT_SECRET=MY_APP_JWT_KEY_2024
covers="Example#2024" | password=Example#2024
covers="Sample1234" | password=Sample1234
covers="Todo4Ever99" | secret=Todo4Ever99
covers="Replace!Me9x" | token=Replace!Me9x
covers="Dummy2024x" | postgres://u:Dummy2024x@db.fake.test/x
covers="ab...cd9X" | password=ab...cd9X
covers="Zq9!aaaaaaaaaaaaaaaaaa" | password=Zq9!aaaaaaaaaaaaaaaaaa
covers="-_-_-_-_" | password=-_-_-_-_
covers="a1b2c3a1b2c3a1b2c3a1b2c3" | api_key=a1b2c3a1b2c3a1b2c3a1b2c3
