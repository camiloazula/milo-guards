# The everyday commands of `tests/everyday_answers.rs`: what coding agents
# run all day in a POSIX shell, in PowerShell and in cmd, by task, written
# for this repository (no transcript, no dataset). Every line they make is
# harmless where the agent works; the record beside this file,
# `everyday_answers.cases`, holds what the shell guard answers for each, and
# the share it asks about is the false-alarm share (CONTRIBUTING.md, "The
# everyday answers").
#
# Read with the case files' reading, and so their escapes (`\\`, `\n`,
# `\s`, ...):
#
# - `group NAME`: the templates after it are in the group NAME;
# - `fill NAME | A | B | ...`: the fillers of the list NAME (a filler holds
#   no ` | `); a second `fill` of a name adds to it;
# - `SHELL | TEMPLATE`: `«NAME»` takes each filler of the list NAME,
#   `«A|B|C»` each of its alternatives (one may be empty), and the template
#   makes a line for each way of filling its slots, at most 32.
#
# A line two templates of one shell make is refused: write each once.

# ---- The fillers of POSIX lines ----

fill rs_file | src/lib.rs | src/main.rs | src/parser/mod.rs
fill rs_any | src/lib.rs | src/config.rs | crates/core/src/lib.rs | build.rs
fill py_file | app/main.py | app/models.py | tests/test_api.py | scripts/migrate.py
fill ts_file | src/index.ts | src/components/Button.tsx | src/lib/api.ts | test/app.test.ts
fill go_dir | ./internal/store | ./pkg/api | ./cmd/server
fill manifest | package.json | Cargo.toml | pyproject.toml | go.mod
fill doc | README.md | CHANGELOG.md | docs/architecture.md | CONTRIBUTING.md
fill log | build.log | logs/dev.log | test-output.txt
fill branch | main | feature/login | fix/parser-crash | release/2.3
fill new_branch | feature/rate-limit | fix/null-check | chore/bump-deps | docs/readme
fill grep_word | TODO | FIXME | 'unwrap()' | console.log
fill crate | serde | anyhow | tokio | clap
fill ws_crate | core | cli | server | parser
fill rust_test | parses_empty_input | round_trip | config::tests::defaults | handles_unicode
fill npm_pkg | lodash | zod | vitest | @types/node
fill py_pkg | requests | pytest | httpx | pydantic | ruff
fill py_test | tests/ | tests/test_api.py::test_login | tests/unit
fill npm_script | build | test | lint | format | dev | typecheck | e2e | storybook
fill js_script | scripts/build.js | dist/index.js | server.js | scripts/gen-types.mjs
fill local_url | http://localhost:3000 | http://localhost:3000/health | http://127.0.0.1:8000/api/items | http://localhost:8080/actuator/health
fill web_url | https://example.com | https://docs.rs/serde/latest/serde/ | https://registry.npmjs.org/zod | https://api.github.com/repos/rust-lang/rust/releases/latest
fill build_dir | target | dist | build | node_modules | coverage | .next | __pycache__ | .pytest_cache | .turbo
fill sub | frontend | backend | packages/web | crates/cli
fill msg | 'fix: handle empty input' | "chore: bump dependencies" | 'test: cover the parser edge cases'
fill pod | api-7d9f8b6c5-x2kqp | worker-5c4d9 | deploy/api | statefulset/db
fill proc | node | python | cargo | vite | webpack

