python parses=no | print(
python parses=no | import shutil; shutil.rmtree('/home/me'); if 1:
python parses=no | def f(:\n    pass
javascript parses=no | if (
javascript parses=no | console.log(1
javascript parses=no | function f( {}
javascript parses=no | require('fs').rmSync('/home/me'); }
