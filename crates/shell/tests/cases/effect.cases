posix effect=unknown | LESSOPEN='|./x %s' less a
posix effect=unknown | IFS=: ; ls
posix effect=unknown | for PATH in ./bin; do ls; done
posix effect=unknown | for path in ./bin; do ls; done
posix effect=changes | alias ls='rm -rf'; ls
# A function the line calls.
posix effect=unknown | f() { ls; }; f
posix effect=unknown | set -e; ls
posix effect=unknown | shopt -s dotglob; ls
posix effect=unknown | export X=1
posix effect=unknown | read x
# A line the grammar cannot parse. (A line past the length limit, or nested
# too deep, is in effect.rs.)
posix effect=unknown | ls $(
posix effect=unknown | echo 'unclosed

# A line that changes and cannot be read changes: what is known to change
# decides, and not knowing the rest does not take that back.
posix effect=changes | mkdir build && ./script.sh
posix effect=changes | ./script.sh; touch x
posix effect=changes | git add . && eval "$x"
posix effect=changes | ls > out.txt; $CMD
posix effect=changes | rm x; foo --bar
# A backtick substitution in an unquoted here-document, which the shell runs,
# is read as code: what it changes decides.
posix effect=changes | cat <<EOF\n`touch y`\nEOF
posix effect=changes | cat <<EOF\nline `rm x` end\nEOF

# A line that reads and cannot be read is unknown.
posix effect=unknown | ls && ./script.sh
posix effect=unknown | cat a.txt | foo
posix effect=unknown | git status; $CMD
posix effect=unknown | ls; eval "$x"

# Only reads, and not safe: an elevation is its own finding, and so is reading
# a key (`read_secret`), which says the file and not that the line changes
# anything; each read is beyond the workspace.
posix finds=elevated effect=reads_beyond | sudo cat /etc/hosts
posix rules=read_secret effect=reads_beyond | cat ~/.ssh/id_ed25519

# A line the rules flag for what it changes is never reads-only: the rules
# read paths a reader's table cannot, so each of these is a finding whatever
# the table says of the program.
posix effect=changes | cat a > ~/.zshrc
posix effect=changes | echo x > /etc/hosts
posix effect=changes | ls | xargs rm -rf
posix effect=changes | find ~ -delete
posix effect=changes | git clean -fdx
posix effect=changes | git push --force
posix effect=changes | sudo shutdown now
posix effect=changes | chmod -R 777 ~
posix effect=unknown | cat a | bash
posix effect=changes | dd if=/dev/zero of=/dev/sda

# Wrappers come off as `classify` takes them off: what a wrapper runs decides.
posix effect=reads_workspace | sudo ls
posix effect=reads_workspace | sudo -u root cat a
posix effect=unknown | env FOO_UNSET=1 ls
posix effect=reads_workspace | env LC_ALL=C ls
posix effect=reads_workspace | time cat a
posix effect=changes | time rm a
posix effect=changes | nice -n 5 cargo build
posix effect=unknown | timeout 10 foo
posix effect=changes | xargs rm
posix effect=changes | echo a | xargs rm
posix effect=unknown | echo a | xargs sort
posix effect=unknown | echo a | xargs sh -c 'ls'

