posix effect=reads_workspace | stdbuf -oL cat a.txt
posix effect=reads_workspace | ls | xargs -0 -I{} cat {}
posix effect=reads_workspace | ls | xargs -P 4 -n 1 wc -l
posix effect=reads_workspace | command -p ls
posix effect=reads_workspace | sort --reverse names.txt
posix effect=reads_workspace | sort -k2 --key=1 --numeric-sort names.txt
posix effect=reads_workspace | file --brief --mime-type a.bin
posix effect=reads_workspace | less --quit-if-one-screen README.md
posix effect=reads_workspace | ls && false || echo no
posix effect=reads_workspace | ls &
posix effect=reads_workspace | # only a comment

# POSIX writers change. Safe lines change too: `mkdir build`, `touch x`,
# `git add .`, `cargo build` and `cat a > b` are safe and change the disk.
posix safe effect=changes | mkdir build
posix safe effect=changes | touch x
posix safe effect=changes | git add .
posix safe effect=changes | cargo build
posix safe effect=changes | cat a > b
posix effect=changes | mkdir -p /tmp/scratch
posix effect=changes | cat a >> b
posix effect=changes | echo hi > out.txt
posix effect=changes | echo hi 2> err.log
posix effect=changes | ls &> listing.txt
posix effect=changes | git commit -m x
posix effect=changes | git push
posix effect=changes | git checkout main
posix effect=changes | git reset --hard
posix effect=changes | git status && git add .
posix effect=changes | git branch -D x
posix effect=changes | git branch -d x
posix effect=changes | git branch topic
