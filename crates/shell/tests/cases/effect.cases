posix effect=changes | git branch --delete x
posix effect=changes | git branch --set-upstream-to=origin/main
posix effect=changes | git tag v1.0
posix effect=changes | git tag -a v1.0 -m x
posix effect=changes | git tag -d v1.0
posix effect=changes | git remote add origin url
posix effect=changes | git remote remove origin
posix effect=changes | git log --output=history.txt
posix effect=changes | git reflog expire
