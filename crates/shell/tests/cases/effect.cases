posix effect=changes | ls | xargs -I{} mv {} old/
posix effect=changes | sort -o sorted.txt names.txt
posix effect=changes | sort --output=sorted.txt names.txt
posix effect=changes | sort -u -o names.txt names.txt
posix effect=changes | tee out.txt
posix effect=changes | cat a | tee out.txt
posix effect=changes | rm -rf target
posix effect=changes | rm -rf ~
posix effect=changes | mv a b
posix effect=changes | cp a b
posix effect=changes | ln -s a b
posix effect=changes | chmod +x run.sh
posix effect=changes | chown me file
posix effect=changes | dd if=/dev/zero of=x bs=1M count=1
