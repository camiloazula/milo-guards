posix effect=unknown | for f in a b; do cat < "$f"; done
posix effect=unknown | for f in a b; do $f; done
posix effect=unknown | for f in a b; do for f in /dev/tcp/h/80; do cat $f; done; done
posix effect=unknown | for f in {a,b}; do cat $f; done
# A path known only when it runs may name a network device or a share, so a
# reader of it is not reads-only.
posix effect=unknown | cat < $F
posix effect=unknown | cat < "$F"
posix effect=unknown | head -n 1 < $F
posix effect=unknown | cat $f
posix effect=unknown | cat "$f"
posix effect=unknown | cat "$(pwd)/x"
