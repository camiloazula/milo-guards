posix effect=reads_workspace | for f in src/*.rs; do wc -l "$f" | head -n 1; done
posix effect=reads_workspace | for f in *.rs; do echo "$f"; done
posix effect=reads_workspace | for f in *.rs; do wc -l *.rs; done
posix effect=reads_workspace | cat *.rs
posix effect=reads_workspace | wc -l < a.txt
posix effect=reads_workspace | cat < *.txt
posix effect=reads_workspace | time -p cat a.txt
posix effect=reads_workspace | time -f %e cat a.txt
posix effect=reads_workspace | sudo -u root -n cat a.txt
posix effect=reads_workspace | sudo -n -u root cat a.txt
posix effect=reads_workspace | nice -5 ls
posix effect=reads_workspace | ionice -c 3 ls
posix effect=reads_workspace | timeout -s KILL 5 cat a.txt
