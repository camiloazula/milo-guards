posix effect=unknown | printf "$fmt" a
# An option that names a file takes a place like any operand.
posix effect=unknown | wc --files0-from="$f"
# A file that lists the files to open is a list the guard never sees, whatever
# it is called.
posix effect=unknown | wc --files0-from=list.txt
posix effect=unknown | wc --files0-from list.txt
posix effect=unknown | du --files0-from list.txt
posix effect=unknown | sort --files0-from=list.txt
posix effect=unknown | file -f list.txt
posix effect=unknown | file --files-from=list.txt
posix effect=unknown | find -files0-from list.txt
posix effect=unknown | ls | xargs -a list.txt cat
posix effect=unknown | xargs --arg-file=list.txt cat
posix effect=unknown | wc --files0-from "$f"
posix effect=unknown | du --files0-from="$f"
posix effect=unknown | diff --from-file="$f" a
posix effect=unknown | diff --to-file="$f" a
posix effect=unknown | wc --files0-from=/dev/tcp/h/80
posix effect=unknown | wc --files0-from /dev/tcp/h/80
