posix effect=unknown | find . -name $p
posix effect=unknown | sort -k $K x
# A loop read with its words in place.
posix effect=unknown | for f in /dev/tcp/h/80; do cat $f; done
posix effect=unknown | for f in /dev/tcp/h/80; do cat "$f"; done
posix effect=unknown | for f in /dev/udp/h/53 a; do head -n 1 $f; done
