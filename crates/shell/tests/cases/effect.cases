posix effect=changes | less --log=x y
posix effect=changes | less --Log-file=x y
posix effect=changes | less --LOG-FILE=x y

# What cannot be read is unknown.
posix effect=unknown | ./script.sh
posix effect=unknown | foo --bar
posix effect=unknown | bash -c "$X"
posix effect=unknown | eval "$line"
posix effect=unknown | $CMD
posix effect=unknown | $CMD a b
posix effect=unknown | bash script.sh
posix effect=unknown | bash -c 'ls'
posix effect=unknown | sh -c 'cat a.txt'
posix effect=unknown | eval 'ls'
posix effect=unknown | source env.sh
posix effect=unknown | . env.sh
posix effect=unknown | python3 script.py
posix effect=unknown | python3 -c 'print(1)'
