# file, takes a place like any operand.
posix effect=unknown | git blame --contents="$f" x
posix effect=unknown | git blame --contents "$f" x
posix effect=unknown | git blame --ignore-revs-file="$f" x
posix effect=unknown | git blame -S "$f" x
