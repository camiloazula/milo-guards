posix effect=reads_workspace | git status -uno
posix effect=reads_workspace | git status -unormal
posix effect=reads_workspace | git status -u
posix effect=reads_workspace | git status -sb -uall
posix effect=reads_workspace | git log --pretty=oneline
posix effect=reads_workspace | git log --format=%H -n 3
posix effect=reads_workspace | git log --pretty -1
posix effect=reads_workspace | git blame --reverse HEAD~5 a.rs
posix effect=reads_workspace | git diff -M90% --stat
posix effect=reads_workspace | git diff -U3
posix effect=reads_workspace | head -n -5 x
posix effect=reads_workspace | grep -f words.txt a.txt
posix effect=reads_workspace | rg -f words.txt src
# Only what a program opens is a place: a pattern, a count or an author known
# only when it runs is not.
posix effect=reads_workspace | git ls-files | xargs grep x
posix effect=reads_workspace | grep -rn "$PATTERN" .
posix effect=reads_workspace | grep -e "$P" a.txt
posix effect=reads_workspace | rg "$x" src
posix effect=reads_workspace | rg -n -g '*.rs' "$x" src
posix effect=reads_workspace | rg -e "$x" src
posix effect=reads_workspace | head -n "$N" x
posix effect=reads_workspace | head -n"$N" x
posix effect=reads_workspace | tail -n "$N" x
posix effect=reads_workspace | git log --author="$NAME"
posix effect=reads_workspace | git log --author "$NAME" --since="$D"
posix effect=reads_workspace | git log -n "$N"
posix effect=reads_workspace | git log -n 5
posix effect=reads_workspace | git diff HEAD~1 -- src
posix effect=reads_workspace | sort -k "$K" x
posix effect=reads_workspace | sort -t "$S" x
posix effect=reads_workspace | find . -name "$p"
posix effect=reads_workspace | find src -type f -newer Cargo.toml
posix effect=reads_workspace | ls | head -5 | xargs cat
posix effect=reads_workspace | ls | grep x | xargs cat
posix effect=reads_workspace | find . -name '*.rs' | xargs grep TODO
posix effect=reads_workspace | find . -name '*.rs' -print0 | xargs -0 wc -l
posix effect=reads_workspace | fd -e rs | xargs wc -l
# A `for` over words written out is read with each word in place.
posix effect=reads_workspace | for f in *.txt; do wc -l "$f"; done
posix effect=reads_workspace | for f in *.rs; do echo $f; head -n 1 $f; done
posix effect=reads_workspace | for f in a b; do cat "$f"; done
