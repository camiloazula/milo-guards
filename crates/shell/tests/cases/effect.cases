posix effect=changes | time -ao out ls
posix effect=changes | time -p -o out ls
posix effect=changes | sudo time -o out cat x
# GNU `sort`, `file` and `less` take a prefix of a long option.
posix effect=changes | sort --outp=x names
posix effect=changes | sort --o=x names
posix effect=changes | sort --out x y
posix effect=changes | sort --output x y
posix effect=changes | file --comp x
