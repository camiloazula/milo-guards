# `effect`: whether a line only reads, changes something, or cannot be told.
# The answer is independent of `classify`'s, except that a line `classify`
# flags is never reads-only (every case of every file is held to that). Where
# a line that only reads reads (its reach) is in reach.cases and
# reach_windows.cases. One section per shell: what only reads, what changes,
# what cannot be told. The format is in CONTRIBUTING.md.

# POSIX readers only read.
posix effect=reads_workspace |
posix effect=reads_workspace | ls -la
posix effect=reads_workspace | ls src | head -n 5
posix effect=reads_workspace | cat src/main.rs | head
posix effect=reads_workspace | git status && git diff
posix effect=reads_workspace | git diff --stat HEAD~1
posix effect=reads_workspace | git log --oneline -n 5
posix effect=reads_workspace | git show HEAD:README.md
posix effect=reads_workspace | git blame src/lib.rs
posix effect=reads_workspace | git --no-pager log
posix effect=reads_workspace | git rev-parse --show-toplevel
posix effect=reads_workspace | git ls-files
posix effect=reads_workspace | git remote -v
posix effect=reads_workspace | git remote
posix effect=reads_workspace | git branch
posix effect=reads_workspace | git branch -a
posix effect=reads_workspace | git branch -vv
posix effect=reads_workspace | git branch --list 'feat/*'
posix effect=reads_workspace | git branch --contains abc123
posix effect=reads_workspace | git branch --show-current
posix effect=reads_workspace | git tag
posix effect=reads_workspace | git tag -l 'v1.*'
posix effect=reads_workspace | git tag -n5 --sort=-creatordate
posix effect=reads_workspace | rg TODO src
posix effect=reads_workspace | rg -n --no-heading 'fn main' -g '*.rs'
posix effect=reads_workspace | grep -rn 'rm -rf' docs/
posix effect=reads_workspace | fd -e rs
posix effect=reads_workspace | find . -name '*.rs'
posix effect=reads_workspace | find src -type f -newer Cargo.toml | wc -l
posix effect=reads_workspace | find . -name '*.log' -exec cat {} +
posix effect=reads_workspace | find . -type f -exec grep -l TODO {} \\;
posix effect=reads_workspace | env LANG=C ls
posix effect=reads_workspace | env -i ls
posix effect=reads_workspace | LC_ALL=C sort names.txt
posix effect=reads_workspace | sort -u names.txt | head
posix effect=reads_workspace | head -n 3 a.txt b.txt
posix effect=reads_workspace | tail -f build.log
posix effect=reads_workspace | wc -l src/*.rs
posix effect=reads_workspace | file target/debug/app
posix effect=reads_workspace | stat Cargo.toml
posix effect=reads_workspace | pwd
posix effect=reads_workspace | less README.md
posix effect=reads_workspace | echo hello
posix effect=reads_workspace | echo "rm -rf /"
posix effect=reads_workspace | echo $HOME
posix effect=reads_workspace | printf '%s\\n' a b
posix effect=reads_workspace | printf '%s\\n' "$x"
posix effect=reads_workspace | cat a.txt > /dev/null
posix effect=reads_workspace | cat missing 2>/dev/null
posix effect=reads_workspace | cat a.txt 2>&1 | head
posix effect=reads_workspace | cat <<'EOF'\nhello\nEOF
posix effect=reads_workspace | cat <<'EOF'\n`touch y`\nEOF
posix effect=reads_workspace | cat <<EOF\nplain text $HOME\nEOF
posix effect=reads_workspace | cat < a.txt
posix effect=reads_workspace | cd src && ls
posix effect=reads_workspace | cd crates/shell && git status
posix effect=reads_workspace | (cd crates && ls)
posix effect=reads_workspace | ls | xargs cat
posix effect=reads_workspace | ls | xargs -n1 wc -l
posix effect=reads_workspace | timeout 5 cat a.txt
posix effect=reads_workspace | nice -n 10 ls
posix effect=reads_workspace | time ls
posix effect=reads_workspace | /bin/ls
posix effect=reads_workspace | /usr/bin/cat a.txt
posix effect=reads_workspace | [ -f Cargo.toml ] && cat Cargo.toml
posix effect=reads_workspace | test -d src && ls src
posix effect=reads_workspace | [[ -f Cargo.toml ]] && cat Cargo.toml
posix effect=reads_workspace | if [ -d src ]; then ls src; else echo none; fi
posix effect=reads_workspace | echo $(git rev-parse HEAD)
posix effect=reads_workspace | diff a.txt b.txt
posix effect=reads_workspace | du -sh target
posix effect=reads_workspace | which cargo
posix effect=reads_workspace | true
posix effect=reads_workspace | ls; cat a.txt; pwd
posix effect=reads_workspace | diff --from-file=a b
