posix effect=changes | less -o log.txt big.txt
posix effect=changes | kill 4242
posix effect=changes | shutdown now
posix effect=changes | cd src && mkdir build
posix effect=changes | ls; mkdir build
posix effect=changes | ls && ./script.sh && mkdir build
posix effect=changes | ls | tee out.txt | head
posix effect=changes | git branch -D x; ./script.sh
# `time` writes its report to a file with `-o`, behind any wrapper.
posix effect=changes | /usr/bin/time -o out cat x
posix effect=changes | env time -o out cat x
posix effect=changes | command time -o out cat x
posix effect=changes | time --output=out cat x
posix effect=changes | time -o out cat x
posix effect=changes | git log --pretty --output=out -1
posix effect=changes | sort -k --output=out x
posix effect=changes | git log --format --output=out -1
posix effect=changes | git show --pretty --output=out
