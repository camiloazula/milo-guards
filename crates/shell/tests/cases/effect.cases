# An unquoted value or pattern splits into more arguments.
posix effect=unknown | grep $x file
posix effect=unknown | rg $flags src
posix effect=unknown | head -n $N x
posix effect=unknown | git log --author=$NAME
posix effect=unknown | grep -f "$f" x
