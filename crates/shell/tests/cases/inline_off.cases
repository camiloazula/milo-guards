# A script file is the workspace's own code, as before.
posix safe | python3 scripts/gen.py
posix safe | node app.js
posix safe | python3 --version

# With the reader there, `./setup.js` is a file of the workspace and a
# `data:` URL or a module outside it is not. Without it nothing tells them
# apart, so each is code the guard does not read.
posix rules=unknown | node --import data:text/javascript,x script.js
posix rules=unknown | node --import ./setup.js script.js
posix rules=unknown | node -r ./setup.js script.js
posix rules=unknown | PYTHONPATH=/tmp/x python3 <<< 'print(1)'
