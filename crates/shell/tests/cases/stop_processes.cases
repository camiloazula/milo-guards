# An option that selects by user, group, parent, terminal, session or
# context, with no name, stops every process it picks; so does `-v` with only
# a selection. Options are read with their values, by any prefix of a long
# one that fits, and a capital option's attached value is no signal.
posix safe | pkill -P $$
posix safe | pkill -F pids.txt
posix safe | pkill -P 1 node
posix safe | pkill -P 12,34
posix safe | pkill -t pts/1 node
posix safe | pkill -USR1 node
posix safe | pkill -USR2 node
posix safe | pkill -KILL node
posix safe | pkill -SIGHUP node
posix safe | pkill -RTMIN+3 node
posix safe | pkill -P1 node
posix safe | pkill -U501 node
posix safe | killall -USR1 node
posix safe | killall -SIGTERM node
posix safe | pkill --s KILL node
posix safe | pkill --pa 1234 node
posix safe | killall --u me node
posix safe | killall --us=me node
posix safe | killall --re 'node.*'
posix safe | pkill -q 1 node
posix safe | pkill --queue 1 node
posix safe | pkill -r R node
posix safe | pkill --runstates R node
posix safe | pkill -s 1234
posix safe | pkill -g 1234
posix safe | pkill --session 1234
posix safe | pkill -s 0 node
posix safe | pkill -g 0 node
posix safe | pkill -P "$(pgrep -x launchd)" node
posix safe | killall -Z ctx node
posix safe | killall --context ctx node
# psmisc `killall` reads a long option with one dash.
posix safe | killall -older-than 1h node
posix safe | killall -signal HUP node
posix safe | killall -regexp 'node.*'

