# Functions that start each other, as one cycle.
posix finds=stop_system | f() { g & }; g() { f & }; f
posix finds=stop_system | f(){ g & g; }; g(){ f & f; }; f
posix finds=stop_system | f(){ g|g& }; g(){ f|f& }; f
posix finds=stop_system | f() { g & }; g() { h; }; h() { f; }; f
posix finds=stop_system | f() { g & }; g() { f; f; }; f
# A loop that runs the call more than once, or without end, starts many.
posix finds=stop_system | f() { for i in 1 2; do f & done; }; f
posix finds=stop_system | f() { for i in {1..3}; do f | cat; done; }; f
posix finds=stop_system | f() { while true; do f & done; }; f
posix finds=stop_system | f() { for ((;;)); do f & done; }; f
# Two copies under a condition are still a bomb.
posix finds=stop_system | f() { [ -d "$1" ] && { f "$1" & f "$1" & }; }; f .
# A condition that reads nothing that changes is no condition.
posix finds=stop_system | f() { [ -d x ] && f & }; f
# A loop over a word known only when it runs, or over the arguments, runs a
# call that does not pass its variable on as often as it gives names; a
# `while` or `until` loop as often as its condition holds.
posix finds=stop_system | f() { for i in $(seq 2); do f & done; }; f
posix finds=stop_system | f() { for i in *; do f & done; }; f
posix finds=stop_system | f() { for i in `seq 2`; do f & done; }; f
