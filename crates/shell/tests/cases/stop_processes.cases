# Stopping processes in a POSIX shell. A process stopped by a plain name that
# is not the system's is safe; a name, a pattern, an option or a service the
# system needs, every process of a user, a group or the caller's own group
# (`kill 0`, a negative id), and a fork bomb are `stop_system`. An id, a
# name, a listing or a substitution the guard cannot read for sure may be any
# process and is `stop_unknown`; signal 0 sends nothing, but only in its one
# plain shape. The format is in CONTRIBUTING.md.

# Stopping a process by name is safe unless the system needs it.
posix safe | killall node
posix safe | pkill node
posix safe | killall -9 node
posix safe | killall -s HUP nginx
posix safe | killall --signal HUP nginx
posix safe | killall Finder
posix safe | killall Dock
posix safe | pkill -f 'node server.js'
posix safe | pkill -9 -f vite
posix safe | pkill -HUP -f gunicorn
posix safe | pkill -TERM node
posix safe | pkill --signal KILL node
posix safe | pkill -x node
posix safe | pkill '^node$'
posix safe | pkill -f 'node.*server'
posix safe | pkill '(node|vite)'
posix safe | pkill -f "python -m http.server"
posix safe | pkill -u me node
posix safe | pkill -fu me node
posix safe | killall -u me node
posix safe | killall --user me node
posix safe | killall -r 'node.*'
posix safe | pkill --sig KILL node
posix safe | pkill --frobnicate node
posix safe | pkill -- node
posix safe | pkill '[n]ode'
posix safe | pkill '[]a]x'
posix safe | pkill 'a{x}'
posix safe | pkill 'a{0'
posix safe | pkill 'ab{2}'
posix safe | pkill -P 1234
posix safe | pgrep node
posix safe | pgrep -f .
posix safe | pgrep -u me
posix safe | killall
posix safe | pkill
posix safe | pkill -f "node server.js"
posix safe | pkill -f 'npm run dev'
posix safe | pkill -f vite
posix safe | pkill -f ./target/debug/myapp
posix safe | killall -user me node
posix safe | killall -ignore-case node
posix safe | killall gnome-terminal
posix safe | killall ssh-agent
posix safe | pkill ssh-agent
posix safe | pkill -f 'ssh-agent -a /tmp/x'
posix safe | pkill gnome-calculator
posix safe | pkill -f /usr/bin/node
posix safe | pkill -f 'dwmbar'
posix safe | pgrep sshd
posix safe | pgrep -f gnome-shell
# A name with a folder is the process of that file.
posix safe | killall /usr/local/bin/node
posix safe | killall /opt/app/server
posix safe | killall /sbin/initd

