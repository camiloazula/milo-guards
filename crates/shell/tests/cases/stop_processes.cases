# A fork bomb: a function that starts copies of itself without end, read
# through quotes and escapes, in a nested function judged on its own.
posix safe | f() { echo hi; }; f
posix safe | build() { make & }; build
posix safe | build() { make | tee log; }; build
posix safe | f() { g & }; g() { echo hi; }; f
posix safe | greet() { echo hi; }; greet & greet
