posix effect=reads_workspace | find . -samefile Cargo.toml
# A folder moved into and a `cd` that stays inside.
posix effect=reads_workspace | cd src && cat main.rs
posix effect=reads_workspace | cd src && cd ..; ls
# When `cd src` failed, `cd ..` leaves the workspace.
posix effect=reads_beyond | cd src; cd ..; ls
posix effect=reads_workspace | cd . && ls
posix effect=reads_workspace | (cd src && ls)
posix effect=reads_workspace | (cd src && ls); ls
posix effect=reads_workspace | cd src && git status
posix effect=reads_workspace | pushd src && ls
posix effect=reads_workspace | cd /home/me/work/repo/src && ls
posix effect=reads_workspace | cd /tmp/x && ls
posix effect=reads_workspace | cd /tmp/x && cat y
# A `cd` inside a subshell does not move the rest of the line, and is a read
# of where it goes all the same.
posix effect=reads_workspace | (cd src; true); ls
posix effect=reads_workspace | echo $(cd src; true); ls
# Wrappers and loops read what they run.
posix effect=reads_workspace | sudo cat Cargo.toml
posix effect=reads_workspace | for f in src/*.rs; do wc -l "$f"; done
posix effect=reads_workspace | for f in /tmp/a /tmp/b; do cat "$f"; done
posix effect=reads_workspace | echo $(ls src)
posix effect=reads_workspace | echo $(< Cargo.toml)
