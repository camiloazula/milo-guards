# The reach of a POSIX line that only reads: `reads_workspace` when every read
# stays in a workspace folder or a temporary folder, `reads_beyond` for a
# place beyond them or a secret, and `unknown` (never a reach) for what cannot
# be placed. One section per set of paths: the plain workspace, other working
# directories, a protected `.agent` at its root (a protected path is the
# workspace's own: protecting it is about writes), the home folder as the
# workspace and `~/.config` as the workspace (a secret is not the project's,
# so reading everything below it is beyond). The plain readers of the plain
# workspace are in effect.cases; PowerShell and cmd are in
# reach_windows.cases. The format is in CONTRIBUTING.md.

# A POSIX machine whose agent runs in another folder, in the workspace
# `/home/me/work/repo`.
paths in_repo_slash cwd=/home/me/work/repo/ home=/home/me workspace=/home/me/work/repo
paths in_src cwd=/home/me/work/repo/src home=/home/me workspace=/home/me/work/repo
paths in_crates_shell cwd=/home/me/work/repo/crates/shell home=/home/me workspace=/home/me/work/repo
paths in_deep cwd=/home/me/work/repo/a/b/c/d home=/home/me workspace=/home/me/work/repo
paths in_tmp_x cwd=/tmp/x home=/home/me workspace=/home/me/work/repo
paths in_private_tmp_x cwd=/private/tmp/x home=/home/me workspace=/home/me/work/repo
paths in_var_folders cwd=/var/folders/ab/cd/T/x home=/home/me workspace=/home/me/work/repo
paths in_tmp cwd=/tmp home=/home/me workspace=/home/me/work/repo
paths in_private_tmp cwd=/private/tmp home=/home/me workspace=/home/me/work/repo
paths in_home cwd=/home/me home=/home/me workspace=/home/me/work/repo
paths in_work cwd=/home/me/work home=/home/me workspace=/home/me/work/repo
paths in_work_other cwd=/home/me/work/other home=/home/me workspace=/home/me/work/repo
paths in_repo2 cwd=/home/me/work/repo2 home=/home/me workspace=/home/me/work/repo
paths in_ssh cwd=/home/me/.ssh home=/home/me workspace=/home/me/work/repo
paths in_home_agent cwd=/home/me/.agent home=/home/me workspace=/home/me/work/repo
paths in_homes cwd=/home home=/home/me workspace=/home/me/work/repo
paths in_root cwd=/ home=/home/me workspace=/home/me/work/repo
paths in_etc cwd=/etc home=/home/me workspace=/home/me/work/repo
paths in_usr_local cwd=/usr/local home=/home/me workspace=/home/me/work/repo
paths in_users cwd=/Users/me/dev/repo home=/home/me workspace=/home/me/work/repo
paths in_relative cwd=work/repo home=/home/me workspace=/home/me/work/repo
paths in_empty cwd="" home=/home/me workspace=/home/me/work/repo
paths in_home_other cwd=/home/me/other home=/home/me workspace=/home/me/work/repo
# The plain workspace with a protected `.agent` folder at its root; with a
# protected file and folder beside the code; with a protected `.agent` outside
# it; with a second workspace folder that holds one; and with `.agent` and a
# protected file in the home folder.
paths agent base=posix folder=/home/me/work/repo/.agent words="the agent's settings"
paths beside base=posix file=/home/me/work/repo/rules.yaml words="the agent's settings" folder=/home/me/work/repo/conf/app words="the agent's settings"
paths agent_outside base=posix folder=/home/me/.agent words="the agent's settings"
paths second cwd=/home/me/work/repo home=/home/me workspace=/home/me/work/repo workspace=/home/me/work/lib folder=/home/me/work/lib/.agent words="the agent's settings"
paths agent_and_file base=posix folder=/home/me/work/repo/.agent words="the agent's settings" file=/home/me/.agent.yaml words="the agent's settings"
# A machine whose workspace is the home folder; one whose workspace is
# `~/.config`, which holds `gh`'s login; and one that runs in `~/proj` with the
# home folder as the workspace.
paths home_workspace cwd=/home/me home=/home/me workspace=/home/me
paths config cwd=/home/me/.config home=/home/me workspace=/home/me/.config
paths proj cwd=/home/me/proj home=/home/me workspace=/home/me

# Reads inside the workspace stay in it (`cat src/main.rs` is in
# read_secret.cases, beside the keys it is not).
posix effect=reads_workspace | ls src
posix effect=reads_workspace | git status
posix effect=reads_workspace | git log --oneline
posix effect=reads_workspace | for f in *.rs; do wc -l "$f"; done
posix effect=reads_workspace | cat /tmp/x
posix effect=reads_workspace | echo hi
# Every spelling of the workspace.
posix effect=reads_workspace | ls
posix effect=reads_workspace | ls .
posix effect=reads_workspace | ls ./
posix effect=reads_workspace | ls ./src
posix effect=reads_workspace | ls src/
posix effect=reads_workspace | ls src/..
posix effect=reads_workspace | ls src/../src
posix effect=reads_workspace | ls /home/me/work/repo
posix effect=reads_workspace | ls /home/me/work/repo/src
posix effect=reads_workspace | ls /home/me/work/repo/
posix effect=reads_workspace | ls /home/me//work/repo/./src
posix effect=reads_workspace | cat ./Cargo.toml
posix effect=reads_workspace | cat src//main.rs
posix effect=reads_workspace | cat /home/me/work/repo/Cargo.toml
posix effect=reads_workspace | cat /home/me/work/repo/src/../Cargo.toml
posix effect=reads_workspace | cat src/*.rs
posix effect=reads_workspace | ls *
posix effect=reads_workspace | ls */
# Temporary files and the null device.
