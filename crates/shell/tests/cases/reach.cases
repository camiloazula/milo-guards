posix effect=reads_workspace | grep -r x src
posix effect=reads_workspace | grep -R x
posix effect=reads_workspace | grep --recursive x
posix effect=reads_workspace | grep -Ern x
posix effect=reads_workspace | find
posix effect=reads_workspace | find .
posix effect=reads_workspace | find -name '*.rs'
posix effect=reads_workspace | find -type f
posix effect=reads_workspace | find src -type f
posix effect=reads_workspace | find . -newer Cargo.toml
