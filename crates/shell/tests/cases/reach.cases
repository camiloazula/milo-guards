posix effect=reads_workspace | env ls
posix effect=reads_workspace | echo a; ls
posix effect=reads_workspace | git ls-files | xargs cat
# What reads standard input reads no place.
posix effect=reads_workspace | cat
posix effect=reads_workspace | sort
posix effect=reads_workspace | head -n 3
posix effect=reads_workspace | grep x
posix effect=reads_workspace | wc -l
posix effect=reads_workspace | cat | head
# Paths inside the workspace, from the workspace.
posix effect=reads_workspace | git -C . status
posix effect=reads_workspace | git -C src log
posix effect=reads_workspace | git -C src -C .. status
posix effect=reads_workspace | git -C /home/me/work/repo/src -C .. status
