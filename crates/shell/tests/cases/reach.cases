posix effect=reads_workspace | head -c 8 /dev/zero
posix effect=reads_workspace | cat < /dev/null
posix effect=reads_workspace | cat < /tmp/x
posix effect=reads_workspace | cat src/main.rs > /dev/null
posix effect=reads_workspace | cat src/main.rs 2>/dev/null
posix effect=reads_workspace | sort -u /tmp/names
# What reads nothing.
posix effect=reads_workspace | false
posix effect=reads_workspace | basename /etc/passwd
posix effect=reads_workspace | dirname ~/x
posix effect=reads_workspace | printf '%s\\n' hi
posix effect=reads_workspace | echo ~/.ssh/id_ed25519
posix effect=reads_workspace | echo /etc/passwd
posix effect=reads_workspace | echo "hello world"
posix effect=reads_workspace | test -d src && echo yes
posix effect=reads_workspace | [ -f Cargo.toml ]
# A reader with no operand reads the working directory.
posix effect=reads_workspace | git log
posix effect=reads_workspace | git diff
posix effect=reads_workspace | git show HEAD
posix effect=reads_workspace | rg TODO
posix effect=reads_workspace | rg -n 'fn main' -g '*.rs'
