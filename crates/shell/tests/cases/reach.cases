# A path relative to the repository's root is read from the root too: the
# guard does not know where the root is, so a path git reads from it is
# judged from the working directory and from each workspace folder, and a
# read beyond either wins. (PowerShell and cmd are in reach_windows.cases.)
posix@proj effect=reads_beyond | git show HEAD:.ssh/id_rsa
posix@proj effect=reads_beyond | git show :/.ssh/id_rsa
