posix@proj effect=reads_beyond | git diff -- ':!/.ssh/id_rsa'
posix@proj effect=reads_beyond | git diff -- ':^.ssh/id_rsa'
posix@proj effect=reads_beyond | git diff -- ':(exclude).ssh/id_rsa'
posix@proj effect=reads_beyond | git show HEAD:../.ssh/id_rsa
posix@proj effect=reads_beyond | git show HEAD:./../.ssh/id_rsa
posix@proj effect=reads_beyond | git log -p -- ../.ssh/id_rsa
posix@proj effect=reads_beyond | git show HEAD:.s*/id_rsa
