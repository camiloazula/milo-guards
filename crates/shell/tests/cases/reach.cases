posix effect=reads_beyond | git -C src -C .. -C .. status
posix effect=reads_beyond | git -C ~/x log --oneline
posix effect=reads_beyond | git --no-pager -C ~/x diff
posix effect=reads_beyond | git -C /home/me/work/repo/.. status
posix effect=reads_beyond | git diff --no-index a ~/b
posix effect=reads_beyond | git diff --no-index ~/a b
posix effect=reads_beyond | git diff --no-index ../a b
posix effect=reads_beyond | git diff --no-index /etc/hosts /etc/passwd
posix effect=reads_beyond | git log -O ~/order
posix effect=reads_beyond | git diff -O ~/order
posix effect=reads_beyond | git blame --contents ~/x f
posix effect=reads_beyond | git blame --contents=/etc/hosts f
posix effect=reads_beyond | git blame --ignore-revs-file=~/x f
posix effect=reads_beyond | git ls-files -X ~/x
posix effect=reads_beyond | git ls-files --exclude-from=~/x
posix effect=reads_beyond | git ls-files ..
posix effect=reads_beyond | git diff -- ~/x
posix effect=reads_beyond | git diff -- /etc/hosts
posix effect=reads_beyond | git log -- ../x
posix effect=reads_beyond | git show HEAD:../x
posix effect=reads_beyond | git diff /etc/hosts
posix effect=reads_beyond | git log ~/x
# Loops over what they read.
posix effect=reads_beyond | for f in ~/.ssh/*; do cat "$f"; done
posix effect=reads_beyond | for f in /etc/passwd; do cat "$f"; done
posix effect=reads_beyond | for f in a ~/b; do cat "$f"; done
posix effect=reads_beyond | for f in /etc/*; do echo $f; done
posix effect=reads_beyond | for f in a b; do cat ~/x; done
# A pass after the first starts where the last left the line: in the home
# directory again, when each `cd` goes to a whole path; one that goes on from
# where it is reads from a place only known when it runs too.
posix effect=reads_beyond | for f in a b; do cd ~; ls; done
posix effect=unknown | for f in a b; do cd ..; ls; done
posix effect=reads_beyond | for d in a; do cd ~; done; ls
# Substitutions read as units.
posix effect=reads_beyond | echo $(cat ~/.ssh/id_ed25519)
posix effect=reads_beyond | echo $(< ~/.aws/credentials)
posix effect=reads_beyond | echo $(ls ~)
posix effect=reads_beyond | echo `ls ~`
posix effect=reads_beyond | if [ -d src ]; then ls ~; fi
posix effect=reads_beyond | ls && cat /etc/hosts
# Every spelling of a read beyond stays beyond.
posix effect=reads_beyond | ls -- ~
posix effect=reads_beyond | ls -d ~
posix effect=reads_beyond | cat -- ~/x
posix effect=reads_beyond | cat -n ~/x
posix effect=reads_beyond | grep -r -- x ~
posix effect=reads_beyond | grep -e x -- ~/f
posix effect=reads_beyond | rg -- x ~
posix effect=reads_beyond | rg x -g '*.rs' ~
posix effect=reads_beyond | fd -H . ~
posix effect=reads_beyond | /bin/ls ~
posix effect=reads_beyond | /usr/bin/cat /etc/passwd
posix effect=reads_beyond | command ls ~
posix effect=reads_beyond | ls ~ 2>&1 | head
posix effect=reads_beyond | ls ~ > /dev/null
posix effect=reads_beyond | git log -p -- ~/x
posix effect=reads_beyond | ls $HOME/..
posix effect=reads_beyond | ls ${HOME}
posix effect=reads_beyond | ls "$HOME/work/.."
posix effect=reads_beyond | head -n1 /etc/passwd
posix effect=reads_beyond | tail -n 1 ~/x
posix effect=reads_beyond | find . -name y -newer ~/x
posix effect=reads_beyond | nice -n 5 ls ~
posix effect=reads_beyond | ls a b ~
posix effect=reads_beyond | ls ~ a b
posix effect=reads_beyond | ls -l -a -h ~/.ssh

# What cannot be placed is not the workspace: a path known only when it runs
# is unknown, never a reach, and so is a working directory the guard cannot
# follow (the readers of a path known only when it runs are in effect.cases).
posix effect=unknown | cd "$d" && ls
posix effect=unknown | cd $d && ls
posix effect=unknown | cd "$d"; cat x
posix effect=unknown | rg x "$d"
posix effect=unknown | cd -
posix effect=unknown | cd $OLDPWD; ls
posix effect=unknown | cd ~+; ls
posix effect=unknown | CDPATH=/ cd etc; ls
posix effect=unknown | f() { cd ~; }; f; ls
posix effect=unknown | pushd /tmp; pushd ~; popd; ls
posix effect=unknown | popd; ls
posix effect=unknown | cat ~+/x
posix effect=unknown | cat ~-/x
posix effect=unknown | tree
posix effect=unknown | git --git-dir=../.git log
posix effect=unknown | GIT_DIR=../.git git log
posix effect=unknown | git grep x
# A wrapper that moves the program to another folder is not followed.
posix effect=unknown | env -C ~ ls
posix effect=unknown | env -C/etc ls
posix effect=unknown | env --chdir=/etc ls
posix effect=unknown | env --chdir /etc cat hosts

# The working directory is read by a reader with no operand: from each folder
# the agent can run in, a reader that reads the working directory says where
# it is. (From the workspace itself, the plain workspace's sections hold each
# of these readers.) The workspace itself, and below it.
