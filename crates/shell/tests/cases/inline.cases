posix finds=delete | python3 -c "from os import system; system('rm -rf ~')"
posix finds=unknown | python3 -c "import os; os.system(cmd)"
posix finds=unknown | python3 -c "import os; os.system(f'rm -rf {d}')"
posix finds=unknown | python3 -c "import os; os.system('rm -rf ' + d)"
posix finds=unknown | python3 -c "import os; os.system(input())"
posix finds=delete | python3 -c "import subprocess; subprocess.run('rm -rf ~', shell=True)"
posix finds=delete | python3 -c "import subprocess; subprocess.run('rm -rf ~')"
posix finds=delete | python3 -c "import subprocess; subprocess.run(['rm', '-rf', '/home/me'])"
posix finds=delete | python3 -c "import subprocess; subprocess.call(['rm', '-rf', '/home/me'])"
posix finds=delete | python3 -c "import subprocess; subprocess.check_call(['rm', '-rf', '/home/me'])"
posix finds=delete | python3 -c "import subprocess; subprocess.check_output(['rm', '-rf', '/home/me'])"
posix finds=delete | python3 -c "import subprocess; subprocess.Popen(['rm', '-rf', '/home/me'])"
posix finds=delete | python3 -c "import subprocess; subprocess.run(args=['rm', '-rf', '/home/me'])"
posix finds=delete | python3 -c "import subprocess as sp; sp.run(['rm', '-rf', '/home/me'])"
posix finds=delete | python3 -c "from subprocess import run; run(['rm', '-rf', '/home/me'])"
posix finds=elevated | python3 -c "import subprocess; subprocess.run(['sudo', 'ls'])"
posix finds=delete | python3 -c "import subprocess; subprocess.run(['rm', '-rf', d])"
posix finds=unknown | python3 -c "import subprocess; subprocess.run([prog, 'x'])"
posix finds=unknown | python3 -c "import subprocess; subprocess.run(cmd)"
posix finds=unknown | python3 -c "import subprocess; subprocess.run(['rm', *flags, 'x'])"
posix finds=delete | python3 -c "import subprocess; subprocess.run(['rm -rf ~'], shell=True)"
posix finds=delete | python3 -c "import subprocess; subprocess.getoutput('rm -rf ~')"
posix finds=delete | python3 -c "import asyncio; asyncio.create_subprocess_shell('rm -rf ~')"
posix finds=delete | python3 -c "import asyncio; asyncio.create_subprocess_exec('rm', '-rf', '/home/me')"
posix finds=unknown | python3 -c "import os; os.execvp('rm', ['rm', '-rf', '~'])"
posix finds=unknown | python3 -c "import os; os.spawnlp(os.P_WAIT, 'rm', 'rm', '-rf', '~')"
posix finds=unknown | python3 -c "import pty; pty.spawn(['sh'])"
posix finds=delete | node -e "require('child_process').execSync('rm -rf ~')"
posix finds=delete | node -e "require('child_process').exec('rm -rf ~')"
posix finds=delete | node -e "const {execSync} = require('child_process'); execSync('rm -rf ~')"
posix finds=delete | node -e "const cp = require('child_process'); cp.execSync('rm -rf ~')"
posix finds=delete | node -e "require('node:child_process').execSync('rm -rf ~')"
posix finds=unknown | node -e "require('child_process').execSync(process.argv[1])"
posix finds=unknown | node -e 'require("child_process").execSync(`rm -rf ${d}`)'
posix finds=unknown | node -e "require('child_process').execSync('rm -rf ' + d)"
posix finds=delete | node -e "require('child_process').spawnSync('rm', ['-rf', '/home/me'])"
posix finds=delete | node -e "require('child_process').spawn('rm', ['-rf', '/home/me'])"
posix finds=delete | node -e "require('child_process').execFileSync('rm', ['-rf', '/home/me'])"
posix finds=delete | node -e "require('child_process').execFile('rm', ['-rf', '/home/me'])"
posix finds=delete | node -e "require('child_process').spawn('rm -rf ~', {shell: true})"
posix finds=delete | node -e "require('child_process').spawn('rm', ['-rf', '~'], {shell: true})"
posix finds=elevated | node -e "require('child_process').spawnSync('sudo', ['ls'])"
posix finds=delete | node -e "require('child_process').spawnSync('rm', args)"
posix finds=unknown | node -e "require('child_process').spawnSync(prog, ['x'])"
posix finds=delete | deno eval 'new Deno.Command("rm", {args: ["-rf", "/home/me"]}).outputSync()'
posix finds=delete | deno eval 'Deno.run({cmd: ["rm", "-rf", "/home/me"]})'
posix finds=delete | bun -e 'Bun.spawn(["rm", "-rf", "/home/me"])'
posix finds=delete | bun -e 'Bun.spawnSync({cmd: ["rm", "-rf", "/home/me"]})'
posix finds=delete | bun -e 'await Bun.$`rm -rf ~`'
posix finds=unknown | bun -e 'await Bun.$`rm -rf ${d}`'
posix finds=delete | python3 - <<'PY'\nimport os\nos.system('rm -rf ~')\nPY
posix finds=delete | node - <<'JS'\nrequire('child_process').execSync('rm -rf ~')\nJS

# A finding names why: its rule and its reason (the paths a finding names are
# checked in inline.rs).
posix rules=delete first=delete reason="deletes your home directory" | node -e "require('fs').rmSync(process.env.HOME,{recursive:true})"
posix rules=delete first=delete reason="deletes your home directory" | python3 -c "import os; os.system('rm -rf ~')"
posix rules=overwrite first=overwrite reason="writes to a shell startup file" | python3 -c "open('/home/me/.zshrc','w').write('x')"
posix rules=unknown | node -e "require('child_process').execSync(process.argv[1])"

# A path is read as the shell reads it. A `~` in code from a double-quoted
# argument may be a `$HOME` the shell put in, so it is the home directory.
posix rules=delete | python3 -c "import os; os.remove('$HOME/x')"
posix rules=delete | python3 -c "import os; os.remove('~/x')"
# Relative paths are from where a `cd` in the line moved to, and a `chdir` in
# the code moves the code's own process only.
posix rules=delete | cd /home/me && python3 -c "import os; os.remove('x')"
# The `rm x` after it is the workspace's, so only the code, which is not read
# whole (an import off the list), is unknown.
posix rules=unknown | python3 -c "import os; os.chdir('/home/me')"; rm x

# Code that starts code is read to a limit (the levels past it are in
# inline.rs). Python that runs `python3 -c` that runs Python, three levels
# deep, each inside the last: the delete at the bottom is found.
posix rules=delete | python3 -c "import os; os.system('python3 -c \\"import os; os.system(\\\\'python3 -c \\\\\\\\\\"import os; os.system(\\\\\\\\\\\\\\\\\\\\'rm -rf /home/me\\\\\\\\\\\\\\\\\\\\')\\\\\\\\\\"\\\\')\\"')"
# Read to the end, but `exec` is not on the strict gate's list: unknown.
posix rules=unknown | python3 -c "exec('exec(\\\\'import os\\\\')')"
