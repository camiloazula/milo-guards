# Inline code: Python and JavaScript given with `-c`, `-e`, `eval` or a
# here-document are read, and what they delete, write and run is judged like
# the same shell command: a finding names the path and why, a path is read as
# the shell reads it, and code that starts code is read to a limit. The
# format is in CONTRIBUTING.md.

# Inline code is judged like the same shell command.
posix safe | python3 -c 'print(1+1)'
posix safe | node -e 'console.log(1)'
posix safe | python3 -c "import sys; print(sys.stdin.read())"
posix safe | python3 -c "open('out.txt','w')"
posix safe | python -c 'print("hi")'
posix safe | python3.12 -c 'print(1)'
posix safe | node --eval 'console.log(1)'
posix safe | bun -e 'console.log(1)'
posix safe | bun --print '1+1'
posix safe | deno eval 'console.log(1)'
posix safe | python3 -c "print(open('/home/me/.zshrc').read())"
posix safe | python3 -c "print(open('/home/me/.zshrc', 'r').read())"
# Work in the workspace and the temporary folder is the agent's own.
posix safe | python3 -c "open('/tmp/x', 'w').write('x')"
# Programs and command lines are judged like the ones typed. A script file is
# the workspace's own code (`python3 scripts/gen.py` is in drop_data.cases).
posix safe | python3 -m http.server
# Not read whole by the strict gate: unknown.
posix finds=unknown | node -p 'process.version'
posix finds=unknown | node -pe '1+1'
posix finds=unknown | node --eval='console.log(1)'
posix finds=unknown | node -r ts-node/register -e 'console.log(1)'
# A module that is a file is looked up in the folder first, so an import of
# `json` or `re` is unknown.
posix finds=unknown | python3 -c "import json,sys; json.load(sys.stdin)"
posix finds=unknown | python3 -c "import re; print(re.sub('a','b','abc'))"
posix finds=unknown | python3 -Sc 'print(1)'
posix finds=unknown | python3 -W ignore -c 'print(1)'
posix finds=unknown | python3 -cprint\\(1\\)
posix finds=unknown | deno eval -p '1+1'
posix finds=unknown | python3 -c "x = {'a': 1}; print(getattr(x, 'get')('a'))"
posix finds=unknown | python3 -c "import os; print(os.path.expanduser('~'))"
posix finds=unknown | python3 -c "import os; print(os.listdir('/home/me'))"
posix finds=unknown | node -e "console.log(require('fs').readFileSync('/home/me/.zshrc','utf8'))"
posix finds=unknown | python3 -c "import os; os.remove('build.log')"
posix finds=unknown | python3 -c "import shutil; shutil.rmtree('target')"
posix finds=unknown | python3 -c "import shutil; shutil.rmtree('/tmp/scratch')"
posix finds=unknown | python3 -c "import os; os.makedirs('a/b', exist_ok=True)"
posix finds=unknown | python3 -c "import os; os.chmod('run.sh', 0o755)"
posix finds=unknown | python3 -c "from pathlib import Path; Path('out/x.txt').write_text('x')"
posix finds=unknown | python3 -c "import os; os.chdir('/tmp'); os.remove('x')"
posix finds=unknown | python3 -c "import shutil; shutil.copy('a.txt', 'b.txt')"
posix finds=unknown | python3 -c "import shutil; shutil.move('a.txt', 'b.txt')"
posix finds=unknown | python3 -c "import os; os.rename('a.txt', 'b.txt')"
posix finds=unknown | python3 -c "import os; os.symlink('a', 'link')"
posix finds=unknown | python3 -c "import sqlite3; sqlite3.connect(':memory:')"
posix finds=unknown | node -e "require('fs').rmSync('dist',{recursive:true,force:true})"
posix finds=unknown | node -e "require('fs').writeFileSync('out.txt','x')"
posix finds=unknown | node -e "require('fs').mkdirSync('dist/a',{recursive:true})"
posix finds=unknown | node -e "require('fs').copyFileSync('a','b')"
posix finds=unknown | node -e "require('fs').renameSync('a','b')"
posix finds=unknown | node -e "require('fs').chmodSync('run.sh',0o755)"
posix finds=unknown | node -e "process.chdir('/tmp'); require('fs').rmSync('x')"
posix finds=unknown | node -e "const fs = require('fs'); fs.unlinkSync('a.txt')"
posix finds=unknown | node -e "require('fs').rmSync(require('path').join('dist','x'))"
posix finds=unknown | node -e "console.log(process.env.HOME)"
posix finds=unknown | deno eval 'Deno.removeSync("dist")'
posix finds=unknown | bun -e 'Bun.write("out.txt", "x")'
posix finds=unknown | bun -e 'await Bun.file("tmp.txt").delete()'
posix finds=unknown | python3 -c "import subprocess; subprocess.run(['cargo','build'])"
posix finds=unknown | python3 -c "import subprocess; subprocess.run('cargo test', shell=True)"
posix finds=unknown | python3 -c "import os; os.system('ls')"
posix finds=unknown | node -e "require('child_process').execSync('npm test')"
posix finds=unknown | node -e "require('child_process').spawnSync('git', ['status'])"
# A here-document or here-string of code that does nothing.
posix finds=unknown | python3 - <<'PY'\nprint(1)\nPY
posix finds=unknown | python3 <<'PY'\nimport os\nos.remove('x')\nPY
posix finds=unknown | python3 - <<PY\nprint(1)\nPY
posix finds=unknown | python3 - <<< 'print(1)'
posix finds=unknown | python3 - <<<'print(1)'
posix finds=unknown | node - <<'JS'\nconsole.log(1)\nJS
posix finds=unknown | node <<'JS'\nconsole.log(1)\nJS
posix finds=unknown | python3 - <<-'PY'\n\tprint(1)\nPY
# Code that deletes is judged like `rm`.
