# POSIX shell lines and what each rule finds in them: deletes and writes
# beyond the workspace, disks, git work that cannot come back, permissions,
# root and the system, what runs unseen, nested shells, traps, what a finding
# says, device paths, macOS paths, the words after a redirect, and what
# cannot be read. The format is in CONTRIBUTING.md.

# A workspace that is the home directory.
paths home cwd=/home/me home=/home/me workspace=/home/me

# Deleting beyond the workspace is risky.
posix finds=delete | rm -rf ~
posix finds=delete | rm -rf ~/
posix finds=delete | rm -rf $HOME
posix finds=delete | rm -rf "${HOME}"
posix finds=delete | rm -rf /
posix finds=delete | rm -rf /*
posix finds=delete | rm -rf ~/*
posix finds=delete | rm -rf ..
posix finds=delete | rm -rf ../..
posix finds=delete | rm -rf .
posix finds=delete | rm -rf *
posix finds=delete | rm -rf ../other-project
posix finds=delete | rm -rf /usr/local/lib
posix finds=delete | rm -rf /etc
posix finds=delete | rm ~/.ssh/id_ed25519
posix finds=delete | rm -rf .git
posix finds=delete | rm -rf "$DIR"
posix finds=delete | rm -rf $(cat dirs.txt)
posix finds=delete | rm -rf ~other
posix finds=delete | /bin/rm -rf ~
posix finds=delete | command rm -rf ~
posix finds=delete | cd /tmp && rm -rf ~/Documents
posix finds=delete | false && rm -rf ~
posix finds=delete | echo ok; rm -rf ~
posix finds=delete | cargo build | tee log; rm -rf /
posix finds=delete | find / -name '*.log' -delete
posix finds=delete | find ~ -type f -exec rm -f {} +
posix finds=delete | cat list.txt | xargs rm -rf
posix finds=delete | echo /etc | xargs rm -rf
posix finds=delete | shred -u ~/.bash_history
posix finds=delete | mv ~ /tmp/x
posix finds=delete | mv .git /tmp/old-git
posix finds=delete | rsync -a --delete build/ ../deploy/
posix finds=delete | (cd src/a/b); rm -rf ../x
posix finds=delete | bash -c 'cd src/a/b'; rm -rf ../x
posix finds=delete | find -H ~ -name '*' -delete
posix finds=delete | find -P ~ -type f -exec rm {} +
posix finds=delete | RM -rf ~
posix finds=delete | busybox rm -rf ~
posix finds=delete | set -x FOO bar; and rm -rf ~
posix finds=delete | false; or rm -rf ~
posix finds=delete | not rm -rf ~
posix finds=delete | rm -rf {~,x}
posix finds=delete | rm -rf x{,/../..}
posix finds=delete | rm -rf src/*/../../../x
posix finds=delete | r\\\nm -rf ~
posix finds=delete | echo hi # a note \\\nrm -rf ~
posix finds=delete | pushd +1; rm -rf build
posix finds=delete | run0 rm -rf /
posix finds=delete | systemd-run --user rm -rf ~
posix finds=delete | crontab -r
