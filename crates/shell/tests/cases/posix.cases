# Permissions, root and the system are risky.
posix finds=permissions | chmod -R 777 /
posix finds=permissions | chmod 777 deploy.sh
posix finds=permissions | chmod -R a+w .
posix finds=permissions | chmod 600 ~/.ssh/id_rsa
posix finds=permissions | chown -R me /usr/local
posix finds=elevated | sudo apt install ripgrep
posix finds=elevated | sudo -u postgres psql
posix finds=elevated | doas reboot
posix finds=elevated | su -c 'make install'
