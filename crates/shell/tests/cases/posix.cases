posix finds=git_discard | git reset --hard origin/main
posix finds=git_discard | git -C ../app reset --hard
posix finds=git_discard | git -c core.pager=cat reset --hard
posix finds=git_discard | git clean -fdx
posix finds=git_discard | git clean --force -d
posix finds=git_discard | git checkout -- .
posix finds=git_discard | git checkout .
posix finds=git_discard | git checkout -f main
