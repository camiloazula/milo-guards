posix finds=unknown | printf 'rm -rf ~' > s.sh && bash -o pipefail s.sh
posix finds=unknown | perl -le 'system "rm -rf ~"'
posix finds=overwrite | perl -pi -e 's/a/b/' ~/.bashrc
posix finds=unknown | perl -pi -e 's/x/system("rm -rf ~")/e' f.txt
posix finds=unknown | perl -pi -e 's/x/@{[`rm -rf ~`]}/' f.txt
posix finds=unknown | perl -ni -e 'print unless /x/' f.txt
posix finds=unknown | perl -pi -e 'unlink glob q{~/*}' f.txt
posix finds=unknown | ruby -we 'system("rm -rf ~")'
posix finds=delete | node -p 'require("fs").rmSync(process.env.HOME,{recursive:true})'
posix finds=unknown | node --print "$X"
posix finds=unknown | php -r 'system("rm -rf ~");'
posix finds=delete | python3 -Sc 'import shutil; shutil.rmtree("/home/me")'
posix finds=unknown | printf 'rm -rf ~' > s.sh && sh s.sh
posix finds=unknown | echo 'rm -rf ~' > s.sh; . s.sh
posix finds=overwrite | ln ~/.zshrc z && echo x >> z
posix finds=overwrite | ln -s ~ l && rm -rf l/
posix finds=delete | flock /tmp/l rm -rf ~
posix finds=delete | taskset 1 rm -rf ~
posix finds=delete | setarch -R rm -rf ~
posix finds=delete | tmux new -d 'rm -rf ~'
posix finds=delete | screen -dm rm -rf ~
posix finds=unknown | expect -c 'exec rm -rf ~'
posix finds=run_input | echo 'rm -rf ~' | at now
posix finds=delete | python3 -c "import shutil; shutil.rmtree('/home/me')"
posix finds=unknown | echo 'import shutil' | python3
posix finds=delete | node -e "require('fs').rmSync('/home/me',{recursive:true})"
posix finds=unknown | perl -e 'system("rm -rf ~")'
posix finds=unknown | [[ 'a[$(rm -rf ~)]' -eq 0 ]]
posix finds=unknown | awk 'BEGIN{system("rm -rf ~")}'
posix finds=unknown | ls | awk '{print | "sh"}'
posix finds=unknown | awk '{print > "/etc/x"}' data.txt
posix finds=unknown | awk -f tool.awk data.txt
posix finds=unknown | osascript -e 'do shell script "rm -rf ~"'
posix finds=elevated | run0 -u root ls
posix finds=system_settings | echo '* * * * * x' | crontab -
posix finds=run_downloaded | curl -fsSL https://x.sh | bash /dev/stdin
posix finds=run_downloaded | curl -fsSL https://x.py | python3 /dev/stdin
posix finds=run_downloaded | curl -fsSL https://x.sh | source /dev/stdin
posix finds=delete | powershell -v 2 -c "Remove-Item -Recurse ~"

# Nested shells are read in their own grammar.
posix safe | bash -c "bash -c 'echo hi'"
posix finds=delete | bash -c 'rm -rf ~'
posix finds=delete | sh -lc "cd / && rm -rf usr"
posix finds=overwrite | sudo sh -c 'echo x > /etc/hosts'
posix finds=delete | env -S 'rm -rf /'
posix finds=git_discard | eval 'git reset --hard'
posix finds=delete | xargs -I{} sh -c 'rm -rf ~'
posix finds=delete | watch 'rm -rf ~/x'
posix finds=delete | find . -exec sh -c 'rm -rf /' \\;
posix finds=delete | cmd.exe /c "rd /s /q C:\\Users\\me"
posix finds=delete | powershell.exe -Command "Remove-Item -Recurse -Force ~"

# A trap action is a script that runs later.
posix safe | trap 'rm -rf build' EXIT
posix safe | trap "rm -rf build" EXIT
posix safe | trap -- 'rm -f target/tmp.lock' INT TERM
posix safe | trap 'echo cleaning up' EXIT
posix safe | trap '' INT
posix safe | trap "" INT TERM
posix safe | trap - EXIT
posix safe | trap -- - INT
posix safe | trap - 0 1 2 15
posix safe | trap -p
posix safe | trap -p EXIT
posix safe | trap -l
posix safe | trap
posix safe | trap 0
posix safe | trap 'rm -rf build' EXIT; cargo build
posix safe | trap "echo $HOME" EXIT
# Single quotes are not expanded when the trap is set.
posix safe | trap 'echo $d' EXIT
posix safe | trap 'echo "$d"' EXIT
posix safe | trap 'echo $(date)' EXIT
posix safe | builtin trap 'rm -rf build' EXIT
posix safe | cd src && trap 'rm -rf ../build' EXIT
# `kill 0` signals the caller's own process group.
posix finds=stop_system | trap 'kill 0' INT
posix finds=delete | trap 'rm -rf ~' EXIT
posix rules=delete first=delete reason="deletes your home directory" | trap 'rm -rf ~' EXIT
posix finds=delete | trap 'rm -rf /' EXIT
posix finds=delete | trap "rm -rf ~" EXIT
posix finds=delete | trap -- 'rm -rf ~' EXIT
posix finds=delete | trap -- "rm -rf ~" EXIT
posix finds=delete | trap 'rm -rf ~' 0
posix finds=delete | trap 'rm -rf ~' INT
posix finds=delete | trap 'rm -rf ~' TERM
posix finds=delete | trap 'rm -rf ~' ERR
posix finds=delete | trap 'rm -rf ~' DEBUG
posix finds=delete | trap 'rm -rf ~' RETURN
posix finds=delete | trap 'rm -rf ~' HUP
posix finds=delete | trap 'rm -rf ~' EXIT INT TERM HUP 1 2
posix finds=delete | trap 'rm -rf $HOME' EXIT
posix finds=delete | trap 'cd / && rm -rf usr' EXIT
posix finds=delete | trap 'rm -rf build; rm -rf ~' EXIT
posix finds=git_discard | trap 'git reset --hard' EXIT
posix finds=overwrite | trap 'echo x > ~/.bashrc' EXIT
posix finds=delete | trap 'rm -rf ~' EXIT; echo done
posix finds=delete | builtin trap 'rm -rf ~' EXIT
posix finds=delete | command trap 'rm -rf ~' EXIT
posix finds=delete | bash -c "trap 'rm -rf ~' EXIT"
posix finds=delete | eval "trap 'rm -rf ~' EXIT"
posix finds=delete | trap 'trap "rm -rf ~" EXIT' EXIT
posix finds=delete | trap 'sh -c "rm -rf ~"' EXIT
posix finds=delete | make | trap 'rm -rf ~' EXIT
posix finds=delete | echo hi && trap 'rm -rf ~' EXIT
posix finds=delete | f() { trap 'rm -rf ~' EXIT; }; f
posix finds=delete | trap 'rm -rf '"$d" EXIT
# Only known when it runs: a path, a variable, a substitution.
posix finds=delete | trap "rm -rf $d" EXIT
posix finds=delete reason="deletes a path only known when it runs" | trap "rm -rf $d" EXIT
posix finds=delete | trap "rm -rf $d/x" EXIT
posix finds=delete | trap "rm -rf ${d:-x}" EXIT
posix finds=delete | trap "rm -rf $(mktemp -d)" EXIT
posix finds=delete | trap 'rm -rf $d' EXIT
posix finds=delete | trap 'rm -f "$tmp"' EXIT
posix finds=delete | tmp=$(mktemp); trap 'rm -f "$tmp"' EXIT
# Expanded when the trap is set, read as code when it runs, as `eval "…"` is:
# what the expansion holds becomes code. The text around the expansion is
# still read, so a delete in it is found too.
posix finds=unknown | trap "echo $d" EXIT
posix rules=unknown | trap "echo $d" EXIT
posix finds=unknown | trap "echo ${d}" EXIT
posix finds=unknown | trap "echo $(date)" EXIT
posix finds=unknown | trap "echo `date`" EXIT
posix finds=unknown | trap 'echo '"$d" EXIT
posix finds=unknown | trap "rm -rf $d" EXIT
posix finds=unknown reason="runs a script only known when it runs" | trap "rm -rf $d" EXIT
posix finds=unknown | trap "rm -rf $d/x" EXIT
posix finds=delete | trap 'rm -rf "$d"' EXIT
posix rules=delete | trap 'rm -rf "$d"' EXIT
posix finds=unknown | trap "$x" EXIT
posix finds=unknown | trap $x EXIT
posix finds=unknown | trap "$(cat f)" EXIT
posix finds=unknown | trap "`cat f`" EXIT
posix finds=unknown | trap "${x:-rm}" EXIT
posix finds=unknown | trap -- "$x" EXIT
posix finds=unknown | trap $'rm -rf ~' EXIT
posix finds=unknown | trap $"rm -rf ~" EXIT
posix finds=unknown | trap "$x $y" EXIT

# A trap action reads the line as it ends: it runs after the line's last
# command, or between its commands, so a `cd` after the `trap` means its
# relative paths are known only when it runs; before the `trap` the path is
# where it was.
posix safe | cd build && trap 'rm -rf out' EXIT
posix safe | trap 'rm -rf out' EXIT; (echo hi)
posix safe | trap 'cd src && rm -rf out' EXIT; cargo build
posix safe | bash -c 'cd build'; trap 'rm -rf out' EXIT
# A `cd` in a subshell or a child shell after the `trap` does not move this
# shell, so the action still runs from where it was.
posix safe | trap 'rm -rf out' EXIT; (cd ~)
posix safe | trap 'rm -f lock' EXIT; (cd sub && make)
posix safe | trap 'rm -f lock' EXIT; bash -c 'cd sub && make'
posix safe | trap 'rm -f lock' EXIT; echo $(cd sub && pwd)
posix safe | trap 'rm -rf build' EXIT; (cd /; false)
posix safe | trap 'rm -rf build' EXIT; x=$(cd /; true)
# The ordinary signals are reset in a subshell.
posix safe | trap 'rm -rf build' INT TERM HUP 15; (cd /; sleep 1)
# `eval` in a subshell or a substitution does not move this shell.
posix safe | x=$(eval 'cd /'); rm -rf build
posix safe | (eval 'cd /'); rm -rf build
posix safe | eval 'cd src'; rm -rf build
posix safe | bash -c 'cd /'; rm -rf build
posix finds=delete | trap 'rm -rf out' EXIT; cd ~
posix finds=delete | trap 'rm -rf out' EXIT; cd src
posix finds=delete | trap 'rm -rf out' EXIT; cd src; cd ..
posix finds=delete | trap 'rm -rf out' EXIT; pushd ~
posix finds=delete | trap 'rm -rf out' EXIT; cd /
posix finds=delete | trap 'rm -rf out' DEBUG; cd ~
# A subshell copies `ERR`, `DEBUG` and `RETURN` traps (zsh also `ZERR`; bash
# with `set -E` and `set -T`), so they run from where the subshell has moved
# to too.
posix finds=delete | trap 'rm -rf build' ZERR; (cd /; false)
posix finds=delete | trap 'rm -rf build' DEBUG; (cd /; true)
posix finds=delete | set -E; trap 'rm -rf build' ERR; (cd /; false)
posix finds=delete | set -T; trap 'rm -rf build' DEBUG; x=$(cd /; true)
posix finds=delete | trap 'rm -rf build' RETURN; (cd /; true)
posix finds=delete | trap 'rm -rf build' SIGERR; (cd /; false)
posix finds=delete | trap 'rm -rf build' err; (cd /; false)
posix finds=delete | trap 'rm -rf build' EXIT ERR; (cd /; false)
posix finds=delete | trap 'rm -rf build' NOSUCH; (cd /; false)
posix finds=delete | trap 'rm -rf build' "$sig"; (cd /; false)
# `eval` runs in this shell: its `cd` moves the line, and so the trap's paths,
# and the paths after it.
posix finds=delete | trap 'rm -rf build' EXIT; eval 'cd /'
posix finds=delete | trap 'rm -rf build' ERR; eval 'cd ~'
posix finds=delete | eval 'cd /'; rm -rf build
posix finds=delete | eval 'cd ..'; rm -rf build
posix finds=delete | eval 'cd /' && rm -rf build
# zsh runs the last stage of a pipeline in the current shell; as for a `cd`,
# any stage counts.
posix finds=delete | true | eval 'cd /'; rm -rf build
posix finds=delete | eval 'cd /' | cat; rm -rf build
posix finds=delete | trap 'rm -rf build' EXIT; true | eval 'cd /'
# A trap set in a subshell runs from where the subshell ends up.
posix finds=delete | (trap 'rm -rf out' EXIT; cd ~)
posix finds=delete | (trap 'rm -rf out' EXIT; cd ~); cd src
posix finds=delete | (trap 'rm -rf out' EXIT); cd src
posix finds=delete | eval "trap 'rm -rf out' EXIT"; cd ~
posix finds=overwrite | trap 'echo x > out' EXIT; cd ~
# A `cd` the action itself runs may come before the next command.
posix finds=delete | trap 'cd ~' DEBUG; rm -rf out
posix finds=delete | trap 'cd /' EXIT; rm -rf out
# An absolute path is the same wherever the line has moved.
posix finds=delete | trap 'rm -rf /' EXIT; cd src
posix finds=delete | trap 'rm -rf ~' EXIT; cd src
# The action runs with the options the line ends with.
posix safe | trap 'rm -rf *git' EXIT
posix safe | trap 'shopt -u dotglob; rm -rf *git' EXIT
posix finds=delete | trap 'rm -rf *git' EXIT; shopt -s dotglob
posix finds=delete | shopt -s dotglob; trap 'rm -rf *git' EXIT
posix finds=delete | shopt -s dotglob; trap 'shopt -u dotglob' EXIT; rm -rf *git
posix finds=delete | shopt -s dotglob; trap 'shopt -u dotglob; rm -rf *git' EXIT
posix finds=delete | trap 'shopt -s dotglob' DEBUG; rm -rf *git

# A path that climbs out of a device is judged where it lands.
posix@macos safe | echo x > /dev/fd/2
posix@macos safe | cat /dev/fd/0
posix@macos safe | echo x > /dev/./null
posix@macos safe | echo x > /dev/fd/../null
posix@macos safe | echo x > /dev/fd/../../dev/null
posix@macos safe | echo x > /dev/fd/3
posix@macos finds=delete | rm -rf /dev/fd/../../Users/me
posix@macos finds=delete | cd /dev/fd/../.. && rm -rf Users
posix@macos finds=overwrite | cp evil /dev/fd/../../etc/sudoers
posix@macos finds=delete | rm -rf /dev/fd/3/../../../Users/me
posix@macos finds=delete | rm -rf /dev/stderr/../../Users/me
posix@macos finds=overwrite | cp evil /dev/null/../../etc/sudoers
posix@macos finds=overwrite | cp evil /dev/sda/../../etc/sudoers
posix@macos finds=overwrite | echo x > /dev/fd/../../etc/sudoers
posix@macos finds=overwrite | echo x > /dev/fd/
posix@macos finds=overwrite | echo x > /dev/fd/x
# A brace list can expand to paths its text does not show.
posix@macos finds=delete | rm -rf /Users/me/{x,y/../../../,z}/../dev/fd/0
posix@macos finds=overwrite | cp evil /Users/me/{x,y/../../../,z}/../dev/fd/0
posix@macos finds=overwrite | echo x > /Users/me/{x,y/../../../,z}/../dev/fd/0
posix@macos finds=overwrite | echo x > /dev/fd/{0,1}
# A folder spelling: descriptor 3 could be a folder.
posix@macos finds=delete | rm -rf /dev/fd/3/
posix@macos finds=permissions | chmod -R 777 /dev/fd/3/.

# macOS paths are judged like any other.
posix@macos safe | rm -rf build
posix@macos safe | rm -rf /private/tmp/x
posix@macos safe | rm -rf /var/folders/ab/T/x
posix@macos finds=delete | rm -rf /Users
posix@macos first=delete reason="deletes a folder holding your home directory" | rm -rf /Users
posix@macos finds=delete | rm -rf ~/Library/Keychains
posix@macos finds=delete | rm -rf /Applications/Xcode.app
posix@macos finds=delete | rm -rf /System

# The data volume is the root on a Mac.
posix@macos safe | rm -rf /System/Volumes/Data/Users/me/dev/repo/x
posix@macos safe | rm -rf /System/Volumes/Data/tmp/x
posix@macos finds=delete | rm -rf /System/Volumes/Data/Users/me/.ssh
posix@macos finds=delete | rm -rf ../../../../System/Volumes/Data/Users/me
posix@macos finds=delete | rm -rf /Volumes/Macintosh\\ HD/Users/me/.ssh

# A redirect does not hide the command after it. The grammar takes every
# word after the file of a redirect for one more file; the shell takes the
# first, and the rest are arguments of the command, wherever the redirect
# stands among them.
posix finds=delete | command 2>/dev/null rm -rf ~
posix finds=delete | env 2>/dev/null rm -rf ~
posix finds=delete | nice 2>/dev/null rm -rf ~
posix finds=delete | exec 2>/dev/null rm -rf ~
posix finds=delete | xargs 2>/dev/null rm -rf ~
posix finds=delete | noglob 2>/dev/null rm -rf ~
posix finds=delete | time 2>/dev/null rm -rf ~
posix finds=delete | eval 2>/dev/null 'rm -rf ~'
posix finds=delete | rm 2>/dev/null -rf ~
posix finds=delete | rm >/dev/null -rf ~
posix finds=git_discard | git 2>/dev/null reset --hard
posix finds=delete | rm -rf 2>/dev/null ~
posix finds=delete | rm 2>&1 -rf ~
posix finds=delete | rm >/dev/null -rf x >/dev/null ~
posix finds=delete | true && rm 2>/dev/null -rf ~
posix finds=delete | ! rm 2>/dev/null -rf ~
posix finds=delete | ls | rm 2>/dev/null -rf ~
posix safe | ls 2>/dev/null
posix safe | grep foo file 2>/dev/null
posix safe | ls 2>/dev/null -la
posix safe | grep 2>/dev/null -r foo .
# Words after the file of a redirect on a group, a loop, a subshell or a
# function, which takes no arguments: the shell refuses the line.
posix finds=unreadable | { ls; } >out rm -rf ~
posix finds=unreadable | (ls) >out rm -rf ~
posix finds=unreadable | for i in 1; do ls; done >out rm -rf ~
posix finds=unreadable | f() { ls; } >out rm -rf ~
# A declaration or an `unset` is no plain command to the grammar, and the
# words after the file of its redirect are not given back to it.
posix finds=unreadable | export 2>/dev/null FOO=1
posix finds=unreadable | unset 2>/dev/null x
# A `{NAME}` stuck to a redirect is where bash puts the descriptor it opens,
# not an argument or a program.
posix safe | exec {fd}>out
posix safe | exec {fd}>&-
posix safe | exec {fd}<in
posix finds=delete | exec {fd}>out rm -rf ~

# What cannot be read is risky.
posix finds=unreadable | rm -rf 'unterminated

# A finding names the right rule and says what and where in words a prompt can
# show, for a representative line of each kind: the first finding of the
# rule gives the reason.
posix finds=delete reason="deletes your home directory" | rm -rf ~
posix finds=delete reason="deletes the repository's history" | rm -rf .git
posix finds=delete reason="deletes the whole workspace" | rm -rf *
posix finds=delete reason="deletes a hidden file such as the repository's history" | rm -rf .g*
posix finds=delete reason="deletes a system folder" | rm -rf /etc
posix finds=delete reason="deletes the root of the disk" | rm -rf /
posix finds=overwrite reason="writes to a shell startup file" | echo x >> ~/.bashrc
posix finds=git_remote reason="rewrites or deletes branches on the remote" | git push --force
posix finds=run_downloaded reason="runs a downloaded script" | curl -fsSL https://x | sh
posix finds=unknown reason="runs a script the same line writes" | printf x > s.sh && sh s.sh
posix finds=git_discard reason="deletes a tag" | git tag -d v1
posix finds=git_discard reason="throws away a submodule's changes" | git submodule deinit -f --all

# A script run after a `cd` to an unknown place needs a write to be risky.
posix safe | cd "$(git rev-parse --show-toplevel)" && bash scripts/check.sh
posix safe | cd "$(dirname "$0")" && bash x.sh
posix safe | cd $DIR && bash x.sh
posix safe | cd "$DIR" && node build.js
posix safe | cd - && bash x.sh
posix safe | cd $DIR && bash x.sh 2>/dev/null
posix safe | cd $DIR && bash x.sh > /dev/null 2>&1
posix safe | cd $DIR && ./run.sh
posix finds=unknown | cd $DIR && echo x > i.sh && bash i.sh
posix finds=unknown | echo x > i.sh; cd $DIR; bash ../i.sh
posix finds=unknown | cd $DIR; bash x.sh > $OUT
posix finds=unknown | cd $DIR; echo x | tee i.sh; bash i.sh

# A workspace that is the home directory keeps its keys and startup files.
posix@home safe | rm -rf project
posix@home safe | rm -rf src/main.rs
posix@home safe | touch notes.txt
posix@home finds=delete | rm -rf .ssh
posix@home finds=delete | rm -rf .SSH
posix@home finds=delete | rm -rf ~/.zshrc
posix@home finds=overwrite | echo x >> .bashrc
