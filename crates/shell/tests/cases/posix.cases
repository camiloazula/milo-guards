posix finds=overwrite | sed -i '' 's/^/#/' ~/.zshrc
posix finds=overwrite | sed -i.bak -e 's/a/b/' /etc/hosts
posix finds=overwrite | sed --in-place 's/a/b/' ~/.bashrc

# Disks are risky.
posix finds=wipe_disk | dd if=/dev/zero of=/dev/sda bs=1M
