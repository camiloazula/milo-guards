posix finds=git_history | git gc --prune=now
posix finds=delete | rm -rf .g*
posix finds=delete | rm -rf */.git
posix finds=delete | find . ! -name '*.keep' -delete
posix finds=delete | find . -not -name x -delete
posix finds=delete | find . -name '*.log' -o -type f -delete
posix finds=delete | find . -path './.git/*' -delete
posix finds=delete | cat <<'EOF'\ndon't\nEOF\nr\\\nm -rf ~
posix finds=permissions | chmod -R --reference=a /etc
posix finds=overwrite | cp -rt /etc x
posix finds=delete | mv -vt /tmp ~/Documents
posix finds=delete | rm -rf .??*
posix finds=delete | rm -rf ?*
