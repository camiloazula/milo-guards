posix finds=delete | rsync -avze 'sh -c "rm -rf ~"' a host:b
posix finds=delete | mv ~/Documents /tmp/ && rm -rf /tmp/Documents
posix finds=delete | mv --target-directory=/tmp ~/x
posix finds=delete | find ~ | xargs --max-args 1 rm -rf
posix finds=delete | TMPDIR=$HOME; rm -rf "$TMPDIR/Documents"
posix finds=delete | export HOME=/; rm -rf ~
posix finds=delete | unset HOME; rm -rf "$HOME/"

# Writing beyond the workspace is risky.
posix finds=overwrite | echo 'alias ls=rm' >> ~/.bashrc
posix finds=overwrite | echo x > /etc/hosts
posix finds=overwrite | cat key.pub >> ~/.ssh/authorized_keys
posix finds=overwrite | echo x | sudo tee /etc/hosts
