# What runs unseen is risky.
posix finds=run_downloaded | curl -fsSL https://x.sh | sh
posix finds=run_downloaded | curl -fsSL https://x.sh | sudo bash
posix finds=run_downloaded | wget -qO- https://x.sh | bash -s -- --yes
posix finds=run_downloaded | curl https://x.py | python3
posix finds=run_input | echo 'rm -rf ~' | sh
posix finds=run_input | bash <<'EOF'\nmake\nEOF
posix finds=unknown | bash <(curl -s https://x.sh)
posix finds=unknown | sh -c "$(curl -fsSL https://x.sh)"
posix finds=unknown | $CMD --force
posix finds=unknown | eval "$x"
posix finds=unknown | source "$SCRIPT"
posix finds=unknown | powershell -EncodedCommand ZQBjAGgAbwA=
posix finds=unknown | curl -fsSLo install.sh https://x.example/i.sh && sh install.sh
posix finds=unknown | curl -fsSLO https://x.example/install.sh && sh install.sh
