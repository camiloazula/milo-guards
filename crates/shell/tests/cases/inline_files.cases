# What the file calls of inline code do to their paths: the target of
# `rename` and `replace`, file calls that were not listed (`io.FileIO`,
# `Bun.file().unlink()`), a read with a flag that writes, the `fs` stream
# classes, `fileinput` in place, pathlib's move and copy methods, an `open`
# whose argument can be a mode, copying permission bits, and
# `argparse.FileType`. The format is in CONTRIBUTING.md.

# A file call of inline code is judged by what it does to the path.
# `replace` of a string, and `copy` of a dict.
posix safe | python3 -c "print('abc'.replace('a', 'b'))"
posix safe | python3 -c "s = 'abc'; print(s.replace('a', 'b'))"
posix safe | python3 -c 'd = {}; print(d.copy())'
# Path's `rename` and `replace` take a `target` keyword. A name nothing
# bound is not a string the code made: it is read as a module, which the
# reader has no row for.
posix finds=unknown | python3 -c "print(s.replace('a', 'b'))"
posix finds=overwrite | python3 -c "from pathlib import Path; Path('/tmp/x').replace(target='/home/me/.zshrc')"
posix finds=overwrite | python3 -c "from pathlib import Path; Path('/tmp/x').rename(target='/home/me/.zshrc')"
posix finds=overwrite | python3 -c "from pathlib import Path; Path('/tmp/x').replace('/home/me/.zshrc')"
posix finds=unknown | python3 -c "from pathlib import Path; Path('/tmp/x').replace(*args)"
posix finds=unknown | python3 -c "from pathlib import Path; Path('/tmp/x').rename(**kw)"
# Not read whole by the strict gate: unknown.
posix finds=unknown | python3 -c "from pathlib import Path; Path('a').rename(target='b')"
posix finds=unknown | python3 -c "from pathlib import Path; Path('a').replace(target='b')"
posix finds=unknown | python3 -c "print('abc'.replace(*args))"
# File calls that were not listed.
posix finds=overwrite | python3 -c "import io; io.FileIO('/home/me/.zshrc', 'w')"
posix finds=overwrite | python3 -c "import io; io.FileIO('/home/me/.zshrc', mode='a')"
posix finds=overwrite | python3 -c "from io import FileIO; FileIO('/home/me/.zshrc', 'w')"
posix finds=overwrite | python3 -c "import _io; _io.FileIO('/home/me/.zshrc', 'wb')"
posix finds=delete | bun -e "Bun.file('/home/me/.zshrc').unlink()"
posix finds=delete | bun -e "await Bun.file('/home/me/.zshrc').unlink()"
# Not read whole by the strict gate: unknown.
posix finds=unknown | python3 -c "import io; io.FileIO('/home/me/.zshrc')"
posix finds=unknown | python3 -c "import io; io.FileIO('/home/me/.zshrc', 'r')"
posix finds=unknown | python3 -c "import io; io.FileIO('out.txt', 'w')"
posix finds=unknown | bun -e "Bun.file('dist/x').unlink()"
posix finds=unknown | bun -e "Bun.file('/home/me/.zshrc').text()"
# Reading a file with a flag that writes writes it: `{flag: 'w'}` opens the
# file for writing, which truncates it.
posix finds=overwrite | node -e "require('fs').readFileSync('/home/me/.zshrc', {flag:'w'})"
posix finds=overwrite | node -e "require('fs').createReadStream('/home/me/.zshrc', {flags:'w'})"
posix finds=overwrite | node -e "require('fs').readFile('/home/me/.zshrc', {flag:'w'}, () => 0)"
posix finds=overwrite | node -e "require('fs').promises.readFile('/home/me/.zshrc', {flag:'w+'})"
posix finds=overwrite | node -e "require('fs').readFileSync('/home/me/.zshrc', {encoding: 'utf8', flag: 'a'})"
# A flag only known when it runs, a spread, a computed name.
posix finds=overwrite | node -e "require('fs').readFileSync('/home/me/.zshrc', {flag: process.argv[1]})"
posix finds=overwrite | node -e "require('fs').readFileSync('/home/me/.zshrc', {flag: require('fs').constants.O_WRONLY})"
posix finds=overwrite | node -e "require('fs').readFileSync('/home/me/.zshrc', {...process.env})"
posix finds=overwrite | node -e "require('fs').readFileSync('/home/me/.zshrc', {['fl'+'ag']: 'w'})"
posix finds=overwrite | node -e "const flag = 'w'; require('fs').readFileSync('/home/me/.zshrc', {flag})"
posix finds=overwrite | node -e "require('fs').readFileSync('/home/me/.zshrc', process.argv[1])"
posix finds=overwrite | node -e "const {readFileSync: r} = require('fs'); r('/home/me/.zshrc', {flag: 'w'})"
# Not read whole by the strict gate: unknown.
posix finds=unknown | node -e "require('fs').readFileSync('/home/me/.zshrc')"
posix finds=unknown | node -e "require('fs').readFileSync('/home/me/.zshrc', 'utf8')"
posix finds=unknown | node -e "require('fs').readFileSync('/home/me/.zshrc', {encoding: 'utf8'})"
posix finds=unknown | node -e "require('fs').readFileSync('/home/me/.zshrc', {encoding: 'utf8', flag: 'r'})"
posix finds=unknown | node -e "require('fs').readFileSync('/home/me/.zshrc', {flag: 'rs'})"
posix finds=unknown | node -e "require('fs').readFile('/home/me/.zshrc', 'utf8', (e, d) => console.log(d))"
posix finds=unknown | node -e "require('fs').readFile('/home/me/.zshrc', (e, d) => console.log(d))"
posix finds=unknown | node -e "require('fs').promises.readFile('/home/me/.zshrc', {flag: 'r'})"
posix finds=unknown | node -e "require('fs').createReadStream('/home/me/.zshrc').pipe(process.stdout)"
posix finds=unknown | node -e "require('fs').createReadStream('/home/me/.zshrc', {flags: 'r', encoding: 'utf8'})"
posix finds=unknown | node -e "require('fs').createReadStream('/home/me/.zshrc', 'utf8')"
# The stream classes of `fs` write as the functions that make them do.
posix finds=overwrite | node -e 'const fs = require("fs"); fs.WriteStream("/home/me/a")'
posix finds=overwrite | node -e 'const fs = require("fs"); new fs.WriteStream("/home/me/a")'
posix finds=overwrite | node -e 'const {WriteStream} = require("fs"); new WriteStream("/home/me/a")'
posix finds=overwrite | node -e 'const fs = require("fs"); fs.ReadStream("/home/me/a", {flags: "w"})'
posix finds=overwrite | node -e 'const fs = require("fs"); new fs.ReadStream("/home/me/a", {flags: "w"})'
posix finds=overwrite | node -e 'const {ReadStream} = require("fs"); new ReadStream("/home/me/a", {flags: "w"})'
posix finds=unknown | node -e 'make().WriteStream("/home/me/a")'
# Not read whole by the strict gate: unknown.
posix finds=unknown | node -e 'const fs = require("fs"); new fs.ReadStream("/home/me/a")'
posix finds=unknown | node -e 'const fs = require("fs"); new fs.ReadStream("/home/me/a", {flags: "r"})'
posix finds=unknown | node -e 'const {ReadStream} = require("fs"); ReadStream("/home/me/a", {encoding: "utf8"})'
# `fileinput` in place rewrites each file as `sed -i` does.
posix finds=overwrite | python3 -c 'import fileinput; [print("x") for l in fileinput.input("/home/me/.zshrc", inplace=True)]'
posix finds=overwrite | python3 -c 'import fileinput; fileinput.FileInput("/home/me/.zshrc", inplace=True)'
posix finds=overwrite | python3 -c 'import fileinput; fileinput.input(files=["/home/me/.zshrc"], inplace=1)'
# The files in a tuple, the second argument, any one of them.
posix finds=overwrite | python3 -c 'import fileinput; fileinput.input(("a.txt", "/home/me/.zshrc"), True)'
posix finds=overwrite | python3 -c 'import fileinput; fileinput.input(files="/home/me/.zshrc", inplace=True, backup=".bak")'
# Under another name.
posix finds=overwrite | python3 -c 'import fileinput as f; f.input("/home/me/.zshrc", inplace=True)'
posix finds=overwrite | python3 -c 'from fileinput import FileInput as F; F("/home/me/.zshrc", inplace=True)'
posix finds=overwrite | python3 -c 'from fileinput import *; input("/home/me/.zshrc", inplace=True)'
# `inplace` only known when it runs may be on.
posix finds=overwrite | python3 -c 'import fileinput; fileinput.input("/home/me/.zshrc", inplace=flag)'
# Files only known when it runs, or the script's own arguments.
posix finds=unknown | python3 -c 'import fileinput; fileinput.input(inplace=True)'
posix finds=unknown | python3 -c 'import fileinput, sys; fileinput.input(sys.argv[1:], inplace=True)'
posix finds=unknown | python3 -c 'import fileinput; fileinput.input([], inplace=True)'
posix finds=unknown | python3 -c 'import fileinput; fileinput.input(*a, inplace=True)'
posix finds=unknown | python3 -c 'import fileinput; fileinput.input(*a)'
# Not read whole by the strict gate: unknown.
posix finds=unknown | python3 -c 'import fileinput; [print(l) for l in fileinput.input("/home/me/.zshrc")]'
posix finds=unknown | python3 -c 'import fileinput; fileinput.input(["/home/me/.zshrc"], False)'
posix finds=unknown | python3 -c 'import fileinput; fileinput.input("/home/me/.zshrc", inplace=False)'
posix finds=unknown | python3 -c 'import fileinput; fileinput.FileInput("/home/me/.zshrc", inplace=0)'
posix finds=unknown | python3 -c 'import fileinput; fileinput.input("notes.txt", inplace=True)'
posix finds=unknown | python3 -c 'import fileinput; fileinput.input(files=["a.txt", "b.txt"], inplace=1)'
# Pathlib's move and copy methods are read like `rename` and `shutil.copy`.
# The functions of a module the reader has no row for are not safe: `copy`
# and `move` may be anything there.
posix finds=unknown | python3 -c 'import numpy as np; a = np.copy(b)'
posix finds=unknown | python3 -c 'import turtle; turtle.move(5)'
posix finds=delete | python3 -c 'from pathlib import Path; Path("/home/me/.ssh").move("/tmp/x")'
posix finds=delete | python3 -c 'from pathlib import Path; Path("/home/me/.ssh").move_into("/tmp")'
posix finds=delete | python3 -c 'from pathlib import Path; Path("/home/me/.ssh").move(target="/tmp/x")'
posix finds=overwrite | python3 -c 'from pathlib import Path; Path("/tmp/x").copy("/home/me/.zshrc")'
posix finds=overwrite | python3 -c 'from pathlib import Path; Path("/tmp/x").copy(target="/home/me/.zshrc")'
posix finds=overwrite | python3 -c 'from pathlib import Path; Path("/tmp/x").copy_into("/home/me/.ssh")'
posix finds=overwrite | python3 -c 'from pathlib import Path; Path("/tmp/x").copy_into(target_dir="/home/me/.ssh")'
posix finds=overwrite | python3 -c 'from pathlib import Path; p = Path("/tmp/x"); p.copy("/home/me/.zshrc", preserve_metadata=True)'
# The path or its target only known when it runs.
posix finds=unknown | python3 -c 'from pathlib import Path; Path("/tmp/x").copy(*a)'
posix finds=unknown | python3 -c 'from pathlib import Path; Path("/home/me/.ssh").move(*a)'
# Not read whole by the strict gate: unknown.
posix finds=unknown | python3 -c 'from pathlib import Path; Path("notes.txt").copy("out.txt")'
posix finds=unknown | python3 -c 'from pathlib import Path; Path("notes.txt").copy_into("out")'
posix finds=unknown | python3 -c 'from pathlib import Path; Path("notes.txt").move("out.txt")'
posix finds=unknown | python3 -c 'from pathlib import Path; Path("a").move_into("out")'
posix finds=unknown | python3 -c 'from pathlib import Path; Path("/tmp/x").move("/tmp/y")'
posix finds=unknown | python3 -c 'from pathlib import Path; Path("/home/me/a").copy("/tmp/y", follow_symlinks=False)'
posix finds=unknown | python3 -c 'import copy; x = copy.copy(y)'
# An `open` call is a write only when its argument can be a mode.
posix finds=overwrite | python3 -c "from pathlib import Path; Path('/home/me/f').open('w')"
posix finds=overwrite | python3 -c "from pathlib import Path; Path('/home/me/f').open('a')"
posix finds=overwrite | python3 -c "from pathlib import Path; Path('/home/me/f').open('wb')"
posix finds=overwrite | python3 -c "from pathlib import Path; Path('/home/me/f').open('r+')"
posix finds=overwrite | python3 -c "from pathlib import Path; Path('/home/me/f').open('x')"
posix finds=overwrite | python3 -c "from pathlib import Path; Path('/home/me/f').open(mode='w')"
posix finds=overwrite | python3 -c "from pathlib import Path; Path('/home/me/f').open(mode='ab')"
posix finds=overwrite | python3 -c "open('/home/me/f', 'a')"
posix finds=overwrite | python3 -c "open('/home/me/f', mode='w')"
# The mode is the second argument of these.
posix finds=overwrite | python3 -c "import wave; wave.open('/home/me/out.wav', 'wb')"
posix finds=overwrite | python3 -c "import tarfile; tarfile.TarFile.open('/home/me/a.tar', 'w:gz')"
posix finds=overwrite | python3 -c "import shelve; shelve.open('/home/me/data', 'n')"
posix finds=overwrite | python3 -c "import shelve; shelve.open('/home/me/data', flag='c')"
# The calls that open a file by name keep their own modes.
posix finds=overwrite | python3 -c "import tarfile; tarfile.open('/home/me/a.tar', 'w:gz')"
posix finds=overwrite | python3 -c "import gzip; gzip.open('/home/me/a.gz', 'wt')"
# A literal reading mode reads.
posix finds=read_secret | python3 -c "from pathlib import Path; Path('/home/me/.ssh/id_rsa').open(mode='rb')"
# Not read whole by the strict gate: unknown.
posix finds=unknown | python3 -c "from pathlib import Path; Path('a.txt').open().read()"
posix finds=unknown | python3 -c "from pathlib import Path; Path('a.txt').open('r')"
posix finds=unknown | python3 -c "from pathlib import Path; Path('a.txt').open('rb')"
posix finds=unknown | python3 -c "from pathlib import Path; Path('a.txt').open(mode='rt')"
posix finds=unknown | python3 -c "from pathlib import Path; Path('a.txt').open('rr')"
posix finds=unknown | python3 -c "from pathlib import Path; Path('a.txt').open('rw')"
posix finds=unknown | python3 -c "from pathlib import Path; Path('a.txt').open('bt')"
posix finds=unknown | python3 -c "from pathlib import Path; Path('a.txt').open('+')"
posix finds=unknown | python3 -c "from pathlib import Path; Path('notes.txt').open()"
posix finds=unknown | python3 -c "from pathlib import Path; Path('notes.txt').open('r')"
posix finds=unknown | python3 -c "from pathlib import Path; Path('notes.txt').open(mode='rb')"
posix finds=unknown | python3 -c "from pathlib import Path; Path('notes.txt').open('r', encoding='utf-8')"
# Copying permission bits is a `chmod` of the destination.
posix finds=permissions | python3 -c 'import shutil; shutil.copymode("/tmp/x", "/home/me/.ssh/id_rsa")'
posix finds=permissions | python3 -c 'import shutil; shutil.copystat("/tmp/x", "/home/me/.ssh/id_rsa")'
posix finds=permissions | python3 -c 'import shutil; shutil.copymode("/tmp/x", dst="/home/me/.ssh/id_rsa")'
posix finds=permissions | python3 -c 'from shutil import copystat as c; c("/tmp/x", "/home/me/.ssh/id_rsa")'
posix finds=permissions | python3 -c 'import shutil; shutil.copymode("/tmp/x", d)'
# What the shell reads the same way.
posix finds=permissions | chmod --reference=/tmp/x /home/me/.ssh/id_rsa
# Not read whole by the strict gate: unknown.
posix finds=unknown | python3 -c 'import shutil; shutil.copymode("a.txt", "b.txt")'
posix finds=unknown | python3 -c 'import shutil; shutil.copystat("/home/me/.ssh/id_rsa", "b.txt")'
posix finds=unknown | python3 -c 'import shutil; shutil.copystat("a", "/tmp/y", follow_symlinks=False)'
# `argparse.FileType`: not read whole by the strict gate, unknown.
posix finds=unknown | python3 -c "import argparse; p = argparse.ArgumentParser(); p.add_argument('-n', type=int); print(p.parse_args(['-n', '1']))"

# A pathlib `open` with a mode that is not a literal reading mode writes the
# path.
posix finds=overwrite | python3 -c "from pathlib import Path; import sys; Path('/home/me/.zshrc').open(sys.argv[1])"
posix finds=overwrite | python3 -c "from pathlib import Path; import sys; Path('/home/me/.zshrc').open(mode=sys.argv[1])"
posix finds=overwrite | python3 -c "from pathlib import Path; import sys; Path('/home/me/.zshrc').open(*sys.argv[1:])"
posix finds=overwrite | python3 -c "from pathlib import Path; Path('/home/me/.zshrc').open(**{'mode': 'w'})"
posix finds=overwrite | python3 -c "from pathlib import Path; m = 'r'; m = 'w'; Path('/home/me/.zshrc').open(m)"
posix finds=overwrite | python3 -c "from pathlib import Path; Path('/home/me/.zshrc').open('r' + '+')"

# `argparse.FileType` opens what it is given.
posix finds=unknown | python3 -c "import argparse; p = argparse.ArgumentParser(); p.add_argument('f', type=argparse.FileType('w')); p.parse_args(['/home/me/.zshrc'])"
posix finds=unknown | python3 -c "from argparse import FileType; import argparse; p = argparse.ArgumentParser(); p.add_argument('f', type=FileType('w'))"
posix finds=unknown | python3 -c "import argparse; f = argparse.FileType('w'); f('/home/me/.zshrc')"

# A file name, a URL, a name with an `a` in it is no mode, so it is no
# write; but the `open` of a module the reader has no row for is a call it
# has no row for, so each is `unknown` and none is an overwrite.
posix finds=unknown lacks=overwrite | python3 -c "from PIL import Image; print(Image.open('a.png').size)"
posix finds=unknown lacks=overwrite | python3 -c "import wave; print(wave.open('a.wav').getnframes())"
posix finds=unknown lacks=overwrite | python3 -c "import fitz; fitz.open('a.pdf')"
posix finds=unknown lacks=overwrite | python3 -c "import webbrowser; webbrowser.open('http://localhost:8000')"
posix finds=unknown lacks=overwrite | python3 -c "import webbrowser; webbrowser.open('https://example.com/x', new=2)"
posix finds=unknown lacks=overwrite | python3 -c "import wave; wave.open('data.wav', 'rb')"
posix finds=unknown lacks=overwrite | python3 -c "from PIL import Image; Image.open('x.png', 'r')"
posix finds=unknown lacks=overwrite | python3 -c "import shelve; shelve.open('data.db', 'r')"
