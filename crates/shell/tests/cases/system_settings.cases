# The settings of the machine on macOS and Linux: security switches, the
# firewall, the services the system runs, Time Machine backups and
# machine-wide preferences are `system_settings`; reading a setting, a user's
# own services and an application's own preferences are not. One section per
# tool, then the reason a prompt can show. The format is in CONTRIBUTING.md.

# Gatekeeper, System Integrity Protection, `SELinux` and the startup settings
# in `NVRAM`: turning one off or changing it is risky, reading it or turning
# it on is not.
posix safe | spctl --master-enable
posix safe | spctl --global-enable
posix safe | spctl --status
posix safe | spctl --assess --type execute x.app
posix safe | spctl --add --label x /Applications/x.app
posix safe | csrutil status
posix safe | csrutil enable
posix safe | csrutil authenticated-root status
posix safe | setenforce 1
posix safe | setenforce Enforcing
posix safe | setenforce --help
posix safe | getenforce
posix safe | sestatus
posix safe | cat /etc/selinux/config
posix safe | grep SELINUX= /etc/selinux/config
posix safe | cp /etc/selinux/config selinux.conf
posix safe | echo x > selinux/config
posix safe | nvram -p
posix safe | nvram -x -p
posix safe | nvram boot-args
posix safe | nvram -p | grep boot-args
posix finds=system_settings | spctl --master-disable
posix finds=system_settings | spctl --global-disable
posix finds=system_settings | spctl --disable --label x
posix finds=system_settings | spctl --master-d
posix finds=system_settings | spctl --global-d
posix finds=system_settings | spctl --di --label x
posix finds=system_settings | csrutil disable
posix finds=system_settings | csrutil authenticated-root disable
posix finds=system_settings | csrutil enable --without debug
posix finds=system_settings | csrutil $mode
posix finds=system_settings | setenforce 0
posix finds=system_settings | setenforce Permissive
posix finds=system_settings | setenforce permissive
posix finds=system_settings | setenforce PERMISSIVE
posix finds=system_settings | setenforce $mode
posix finds=system_settings | echo SELINUX=disabled > /etc/selinux/config
posix finds=system_settings | echo SELINUX=disabled >> /etc/selinux/config
posix finds=system_settings | sed -i s/enforcing/disabled/ /etc/selinux/config
posix finds=system_settings | sudo tee /etc/selinux/config
posix finds=system_settings | cp selinux.conf /etc/selinux/config
posix finds=system_settings | cd /etc/selinux && echo x > config
posix finds=system_settings | echo x > /etc/../etc/selinux/config
posix finds=system_settings | echo SELINUX=disabled > /etc/sysconfig/selinux
posix finds=system_settings | sudo nvram boot-args=-v
posix finds=system_settings | nvram boot-args=-v
posix finds=system_settings | nvram -d boot-args
posix finds=system_settings | nvram -c
posix finds=system_settings | nvram -f vars.txt
posix finds=system_settings | nvram $var

# iptables: emptying the rules, deleting a chain or letting everything
# through is risky; listing, adding and deleting one rule is not. A policy
# may have its chain attached, and only `INPUT`, `FORWARD` and `PREROUTING`
# let things in.
posix safe | iptables -L
posix safe | iptables -nvL
posix safe | iptables -L -n --line-numbers
posix safe | iptables -S
posix safe | iptables -C INPUT -j DROP
posix safe | iptables -Z
posix safe | iptables -A INPUT -p tcp --dport 22 -j ACCEPT
posix safe | iptables -A INPUT -s "$ip" -j DROP
# Outside quotes a value may split into words, an option among them.
posix finds=system_settings | iptables -A INPUT -s $ip -j DROP
posix safe | iptables -I INPUT -p tcp -m multiport --dports 80,443 -j ACCEPT
posix safe | iptables -D INPUT 1
posix safe | iptables -P INPUT DROP
posix safe | iptables -P INPUT
posix safe | iptables -P OUTPUT ACCEPT
posix safe | iptables -t mangle -P OUTPUT ACCEPT
posix safe | iptables -PINPUT DROP
posix safe | iptables-save
posix safe | ip6tables -L
posix safe | iptables -nPINPUT DROP
posix safe | iptables --policy=INPUT DROP
posix safe | iptables -POUTPUT ACCEPT
posix safe | iptables --policy=OUTPUT ACCEPT
posix safe | iptables -P OUTPUT "$policy"
posix finds=system_settings | iptables -P OUTPUT $policy
posix safe | iptables -PINPUT
posix safe | iptables -A INPUT -m policy --dir in --pol ipsec -j ACCEPT
posix finds=system_settings | iptables -F
posix finds=system_settings | iptables -t nat -F
posix finds=system_settings | iptables -F INPUT
posix finds=system_settings | iptables -nF
posix finds=system_settings | iptables --flush
posix finds=system_settings | iptables --fl
posix finds=system_settings | iptables -X
posix finds=system_settings | iptables -t nat -X
posix finds=system_settings | iptables --delete-chain
posix finds=system_settings | iptables --delete-c
posix finds=system_settings | iptables -P INPUT ACCEPT
posix finds=system_settings | iptables -P FORWARD accept
posix finds=system_settings | iptables -t mangle -P FORWARD ACCEPT
posix finds=system_settings | iptables --policy INPUT ACCEPT
posix finds=system_settings | iptables --po INPUT ACCEPT
posix finds=system_settings | iptables -P INPUT $policy
posix finds=system_settings | ip6tables -F
posix finds=system_settings | ip6tables -X
posix finds=system_settings | ip6tables -P INPUT ACCEPT
posix finds=system_settings | iptables-legacy -F
posix finds=system_settings | iptables-nft -F
posix finds=system_settings | ip6tables-legacy -P INPUT ACCEPT
posix finds=system_settings | /usr/sbin/iptables -F
posix finds=system_settings | sudo iptables -F
posix finds=system_settings | bash -c 'iptables -F'
posix finds=system_settings | iptables -PINPUT ACCEPT
posix finds=system_settings | iptables -nPINPUT ACCEPT
posix finds=system_settings | iptables --policy=INPUT ACCEPT
posix finds=system_settings | iptables --policy=FORWARD accept
posix finds=system_settings | iptables --pol=INPUT ACCEPT
posix finds=system_settings | iptables -PINPUT $policy
posix finds=system_settings | iptables -P $chain ACCEPT
posix finds=system_settings | iptables -P PREROUTING ACCEPT
posix finds=system_settings | iptables -t nat -P FORWARD ACCEPT

# nft reads its arguments as one command line (`;` and a newline end a
# command), after its options; flushing or deleting a ruleset, a table or a
# chain is risky, a set, a map, a rule or an element is not. JSON commands
# (`-j`) are not read.
posix safe | nft list ruleset
posix safe | nft add rule inet filter input tcp dport 22 accept
posix safe | nft flush set inet filter blocked
posix safe | nft 'list ruleset'
posix safe | nft 'flush set inet filter blocked'
posix safe | nft 'delete rule inet filter input handle 5'
posix safe | nft delete element inet filter blocked '{ 1.2.3.4 }'
posix safe | nft delete set inet filter blocked
posix safe | nft flush map inet filter m
posix safe | nft add chain inet filter input '{ type filter hook input priority 0; policy drop; }'
posix finds=system_settings | nft add rule inet filter input $rule
posix safe | nft -d netlink list ruleset
posix safe | nft --debug all list ruleset
posix safe | nft
posix safe | nft -j list ruleset
posix safe | nft -j list table inet filter
posix safe | nft --json list ruleset
posix safe | nft -aj list tables
posix safe | nft -dj list ruleset
posix finds=system_settings | nft flush ruleset
posix finds=system_settings | nft flush table inet filter
posix finds=system_settings | nft flush chain inet filter input
posix finds=system_settings | nft delete table inet filter
posix finds=system_settings | nft delete chain inet filter input
posix finds=system_settings | nft destroy table inet filter
posix finds=system_settings | nft $cmd
posix finds=system_settings | nft 'flush ruleset'
posix finds=system_settings | nft "delete table inet filter"
