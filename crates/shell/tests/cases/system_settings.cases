posix rules=system_settings first=system_settings reason="changes the quarantine of downloaded files" | defaults write com.apple.LaunchServices LSQuarantine -bool false
posix rules=system_settings first=system_settings reason="changes how the system starts services" | launchctl config system path /x
posix finds=system_settings reason="changes SELinux settings" | cp config /etc/selinux/

# A machine-setting program given an option only known when it runs: one
# outside quotes may split into words, and a quoted one that starts with
# `-` is an option.
posix finds=system_settings | ufw $c
posix finds=system_settings | csrutil $x
posix finds=system_settings reason="may change the firewall with an option only known when it runs" | iptables "-$F"
