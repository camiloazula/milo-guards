posix safe | iptables -I INPUT --src 10.0.0.0/8 -j ACCEPT
posix safe | iptables -I INPUT -c 0 0 -i lo -j ACCEPT
posix safe | iptables -I INPUT --set-counters 0 0 -p tcp --dport 22 -j ACCEPT
posix safe | iptables -I INPUT -i eth+ -j ACCEPT
posix safe | nft add rule inet filter input iif lo accept
posix safe | nft add rule inet filter input ip saddr 10.0.0.0/8 accept
posix safe | nft add rule inet filter input counter drop
posix safe | nft add rule inet filter output accept
posix safe | nft add rule inet filter input ct state established,related accept
posix safe | nft add table inet x '{ chain y { type filter hook output priority 0; policy accept; } }'
posix safe | nft add chain ip nat prerouting '{ type nat hook prerouting priority -100; policy accept; }'
posix safe | nft add chain ip nat postrouting '{ type nat hook postrouting priority 100; policy accept; }'
