# The reason a prompt can show: what the setting is, and whether the line
# turns it off, deletes or replaces it, or changes it. Each line has one
# finding of `system_settings`, with this reason (a write to /etc is also an
# overwrite).
posix rules=system_settings first=system_settings reason="turns off Gatekeeper" | spctl --master-disable
posix rules=system_settings first=system_settings reason="turns off System Integrity Protection" | csrutil disable
posix rules=system_settings first=system_settings reason="turns off SELinux enforcement" | setenforce 0
posix rules=system_settings,overwrite first=system_settings reason="changes SELinux settings" | echo x > /etc/selinux/config
posix rules=system_settings first=system_settings reason="changes the computer's startup settings" | nvram boot-args=-v
posix rules=system_settings first=system_settings reason="changes the firewall" | iptables -F
posix rules=system_settings first=system_settings reason="changes the firewall" | ip6tables -P INPUT ACCEPT
posix rules=system_settings first=system_settings reason="changes the firewall" | nft flush ruleset
posix rules=system_settings first=system_settings reason="turns the firewall off" | ufw disable
