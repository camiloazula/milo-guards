posix safe | arptables -L
posix safe | xtables-nft-multi iptables -L
posix safe | xtables-legacy-multi main4 -L
posix safe | xtables-nft-multi save4 > rules.v4
posix finds=system_settings | xtables-legacy-multi main4 -F
posix finds=system_settings | xtables-nft-multi main6 -F
posix finds=system_settings | xtables-nft-multi restore4 < rules.v4
posix finds=system_settings | xtables-legacy-multi restore6 < rules.v6
posix finds=system_settings | ebtables -F
posix finds=system_settings | ebtables -t broute -F
posix finds=system_settings | ebtables -P INPUT ACCEPT
posix finds=system_settings | ebtables --init-table
posix finds=system_settings | arptables -F
posix finds=system_settings | arptables -P INPUT ACCEPT
posix finds=system_settings | ebtables-legacy -F
posix finds=system_settings | arptables-nft -F
posix finds=system_settings | xtables-nft-multi iptables -F
posix finds=system_settings | xtables-legacy-multi iptables -F
posix finds=system_settings | xtables-nft-multi ip6tables -P INPUT ACCEPT
