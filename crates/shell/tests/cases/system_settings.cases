posix rules=system_settings first=system_settings reason="disables a system service" | systemctl disable x
posix rules=system_settings first=system_settings reason="changes a system service only known when it runs" | systemctl $verb x
posix rules=system_settings first=system_settings reason="stops a service that protects the system" | systemctl stop ufw
posix rules=system_settings first=system_settings reason="stops a service that protects the system" | service ufw stop
posix rules=system_settings first=system_settings reason="stops services that may protect the system" | systemctl stop 'firewall*'
