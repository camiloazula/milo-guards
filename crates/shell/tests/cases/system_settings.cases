# firewall-cmd's direct pass-through hands its arguments to iptables
# (`ipv6` to ip6tables, `eb` to ebtables), and a direct rule is an iptables
# rule at a priority: both are read as iptables.
posix safe | firewall-cmd --direct --passthrough ipv4 -L
posix safe | firewall-cmd --direct --passthrough ipv4 -A INPUT -p tcp --dport 22 -j ACCEPT
posix safe | firewall-cmd --direct --add-rule ipv4 filter INPUT 0 -p tcp --dport 22 -j ACCEPT
