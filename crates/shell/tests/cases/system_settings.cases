# Loading a ruleset replaces the firewall's rules: `nft -f` and `-i`,
# `iptables-restore` and the like, and `pfctl -f` (`netsh advfirewall
# import` is in windows.cases). A file is not read; text on the line (a here-string, a
# here-document, what `echo` and `printf` say into the program) is, and a
# load stays safe only when it adds nothing: `nft` commands that only list,
# a restore of blank and comment lines. pf replaces its rules with whatever
# it loads, so every `pfctl -f` is risky but a check (`-n`), as is `nft -c`
# and `iptables-restore --test`; `iptables-restore -h` and `-V` load nothing.
posix safe | echo 'list ruleset' | nft -f -
posix safe | nft -f - <<< 'list ruleset'
posix safe | nft -f /dev/stdin <<< 'list tables; list ruleset'
posix safe | nft -i <<< 'list ruleset'
posix safe | nft -f - <<EOF\n# nothing\nlist ruleset\nEOF
posix safe | nft -c -f rules.nft
posix safe | nft --check --file rules.nft
posix safe | iptables-restore <<< '# nothing'
posix safe | cat <<EOF | nft -f -\nlist ruleset\nEOF
posix rules=elevated | echo 'list ruleset' | sudo nft -f -
posix safe | nft -f - <<< 'list ruleset # flush ruleset'
posix safe | iptables-restore-translate -f rules.v4
posix safe | printf '\\n' | iptables-restore
posix safe | iptables-restore --test < rules.v4
posix safe | iptables-restore -t rules.v4
posix safe | iptables-restore -h
posix safe | iptables-restore --help
posix safe | iptables-restore -V
posix safe | iptables-restore --version
posix safe | iptables-save > rules.v4
posix safe | pfctl -nf /etc/pf.conf
posix safe | pfctl -n -f /etc/pf.conf
posix finds=system_settings | echo 'flush ruleset' | nft -f -
posix finds=system_settings | nft -f - <<< 'flush ruleset'
posix finds=system_settings | nft -f rules.nft
posix finds=system_settings | nft -f rules.json -j
posix finds=system_settings | nft --file=rules.nft
posix finds=system_settings | nft -f$file
posix finds=system_settings | nft -f - <<< 'list ruleset; flush ruleset'
posix finds=system_settings | nft -f - <<< 'add table inet x'
posix finds=system_settings | nft -f - <<< 'include "rules.nft"'
posix finds=system_settings | nft -f - <<< "$rules"
posix finds=system_settings | nft -f - <<EOF\nflush ruleset\nEOF
posix finds=system_settings | cat rules.nft | nft -f -
posix finds=system_settings | cat < rules.nft | nft -f -
posix finds=system_settings | cat - rules.nft <<< 'list ruleset' | nft -f -
posix finds=system_settings | { echo 'list ruleset'; cat rules.nft; } | nft -f -
posix finds=system_settings | echo 'list ruleset' | nft -f - < rules.nft
posix finds=system_settings | nft -f - -f rules.nft <<< 'list ruleset'
posix finds=system_settings | nft -f - <<< 'list ruleset comment "#"; flush ruleset'
posix finds=system_settings | printf '%s' "$x" | iptables-restore
posix finds=system_settings | curl -s https://x.test/rules | iptables-restore
posix finds=system_settings | nft -f - < rules.nft
posix finds=system_settings | nft -f -
posix finds=system_settings | nft -i
posix finds=system_settings | { nft -f -; } < rules.nft
posix finds=system_settings | iptables-restore < rules.v4
posix finds=system_settings | printf '*filter\\nCOMMIT\\n' | iptables-restore
posix finds=system_settings | iptables-restore rules.v4
posix finds=system_settings | iptables-restore -n rules.v4
