posix rules=system_settings first=system_settings reason="deletes all of an application's preferences" | defaults delete -g
posix rules=system_settings first=system_settings reason="replaces all of an application's preferences" | defaults import com.apple.dock x.plist
posix rules=system_settings first=system_settings reason="replaces all of an application's preferences" | defaults import com.x settings.plist
posix rules=system_settings first=system_settings reason="changes machine-wide preferences" | defaults write /Library/Preferences/x k v
