posix finds=system_settings | firewall-cmd --direct --passthrough ipv4 -I INPUT -j ACCEPT
posix finds=system_settings | firewall-cmd --direct --add-rule ipv4 filter INPUT 0 -j ACCEPT
posix finds=system_settings | firewall-cmd --direct --add-rule ipv4 filter INPUT 0 -c 0 0 -j ACCEPT

# ebtables and arptables are read as iptables, and `xtables-nft-multi` and
# `xtables-legacy-multi` run the program they name, by its own name or by
# theirs for it (`main4` is iptables, `restore4` iptables-restore).
