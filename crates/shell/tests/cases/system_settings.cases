posix rules=system_settings first=system_settings reason="changes the computer's name" | hostnamectl hostname newname
posix rules=system_settings first=system_settings reason="changes the computer's clock settings" | timedatectl set-timezone UTC
posix rules=system_settings first=system_settings reason="changes the computer's name" | hostname newname
