posix finds=system_settings | ip6tables-restore < rules.v6
posix finds=system_settings | iptables-legacy-restore < rules.v4
posix finds=system_settings | ebtables-restore < rules.eb
posix finds=system_settings | arptables-restore < rules.arp
posix finds=system_settings | echo "$rules" | iptables-restore
posix finds=system_settings | pfctl -f /etc/pf.conf
posix finds=system_settings | pfctl -f all
posix finds=system_settings | pfctl -ef /etc/pf.conf
posix finds=system_settings | pfctl -f - <<< ''

# A rule that lets everything in opens the firewall as an ACCEPT policy
# does: an ACCEPT rule on the input or forward chain with no match (a source
# or destination of anywhere and `-p all` match everything), a zone whose
# target is ACCEPT, a source of anywhere added to the trusted zone, an `nft`
# chain with `policy accept` on any hook but output, and `ufw allow` from
# anywhere with nothing to narrow it. A rule with a match, a port or a
# source stays safe.
posix safe | iptables -A INPUT -s 1.2.3.4 -j DROP
posix safe | iptables -A INPUT -i lo -j ACCEPT
posix safe | iptables -I INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
posix safe | iptables -I INPUT -p icmp -j ACCEPT
posix safe | iptables -A INPUT -p tcp --dport 22 -s 0.0.0.0/0 -j ACCEPT
