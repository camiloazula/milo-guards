# iptables: emptying the rules, deleting a chain or letting everything
# through is risky; listing, adding and deleting one rule is not. A policy
# may have its chain attached, and only `INPUT`, `FORWARD` and `PREROUTING`
# let things in.
posix safe | iptables -L
posix safe | iptables -nvL
posix safe | iptables -L -n --line-numbers
posix safe | iptables -S
posix safe | iptables -C INPUT -j DROP
posix safe | iptables -Z
posix safe | iptables -A INPUT -p tcp --dport 22 -j ACCEPT
posix safe | iptables -A INPUT -s "$ip" -j DROP
# Outside quotes a value may split into words, an option among them.
posix finds=system_settings | iptables -A INPUT -s $ip -j DROP
posix safe | iptables -I INPUT -p tcp -m multiport --dports 80,443 -j ACCEPT
posix safe | iptables -D INPUT 1
posix safe | iptables -P INPUT DROP
posix safe | iptables -P INPUT
posix safe | iptables -P OUTPUT ACCEPT
posix safe | iptables -t mangle -P OUTPUT ACCEPT
posix safe | iptables -PINPUT DROP
posix safe | iptables-save
posix safe | ip6tables -L
posix safe | iptables -nPINPUT DROP
posix safe | iptables --policy=INPUT DROP
posix safe | iptables -POUTPUT ACCEPT
posix safe | iptables --policy=OUTPUT ACCEPT
