posix finds=system_settings | nft -ja '[{"flush":{"ruleset":null}}]'
posix finds=system_settings | nft --js '{"nftables":[]}'
posix finds=system_settings | nft --j '{"nftables":[]}'
posix finds=system_settings | nft -j add table x '[1]'

# Turning ufw off, resetting it, or letting everything in by default is
# risky; letting everything out is ufw's stock default.
posix safe | ufw status
posix safe | ufw status verbose
posix safe | ufw allow 22
posix safe | ufw deny 23
