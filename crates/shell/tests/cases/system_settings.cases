posix finds=system_settings | nft 'add table x; flush ruleset'
posix finds=system_settings | nft 'add table x\nflush ruleset'
posix finds=system_settings | nft add table x \\; flush ruleset
posix finds=system_settings | nft 'delete chain inet filter input'
posix finds=system_settings | nft flush $what
posix finds=system_settings | nft flush "$what"
posix finds=system_settings | nft delete $kind inet filter
posix finds=system_settings | nft flush everything
posix finds=system_settings | nft delete everything x
posix finds=system_settings | nft -d netlink flush ruleset
posix finds=system_settings | nft --debug netlink flush ruleset
posix finds=system_settings | nft --debug=all flush ruleset
posix finds=system_settings | nft --deb all flush ruleset
posix finds=system_settings | nft -nd netlink flush ruleset
posix finds=system_settings | nft -a flush ruleset
posix finds=system_settings | nft --json 'flush ruleset'
posix finds=system_settings | nft -- flush ruleset
posix finds=system_settings | nft add table x ';' $cmd
posix finds=system_settings | nft -j '{"nftables": [{"flush": {"ruleset": null}}]}'
posix finds=system_settings | nft --json '{"nftables":[{"flush":{"ruleset":null}}]}'
