posix finds=delete | rake --execute='FileUtils.rm_rf("/home/me")'
posix finds=delete | rake -E 'FileUtils.rm_rf("/home/me")' test
posix finds=unknown | rake -e 'puts 1'
posix safe | rake test
# An embedded document the grammar ends at a line Ruby does not (`=endx`,
# `  =end`, `*=end`) is not read, in single and double quotes: the code Ruby
# runs after it is a string to the grammar.
posix finds=unknown | ruby -e '=begin\n=endx\ny = "\n=end\nsystem(%q(rm -rf ~)) #"\nputs y'
posix finds=unknown | ruby -e "=begin\n=endx\ny = \\"\n=end\nsystem(%q(rm -rf ~)) #\\"\nputs y"
posix finds=unknown | ruby -e '=begin\n=end=\ny = "\n=end\nsystem(%q(rm -rf ~)) #"\nputs y'
posix finds=unknown | ruby -e "=begin\n=end=\ny = \\"\n=end\nsystem(%q(rm -rf ~)) #\\"\nputs y"
posix finds=unknown | ruby -e '=begin\n=end#\ny = "\n=end\nsystem(%q(rm -rf ~)) #"\nputs y'
posix finds=unknown | ruby -e "=begin\n=end#\ny = \\"\n=end\nsystem(%q(rm -rf ~)) #\\"\nputs y"
posix finds=unknown | ruby -e '=begin\n  =end\ny = "\n=end\nsystem(%q(rm -rf ~)) #"\nputs y'
posix finds=unknown | ruby -e "=begin\n  =end\ny = \\"\n=end\nsystem(%q(rm -rf ~)) #\\"\nputs y"
posix finds=unknown | ruby -e '=begin\n\t=end\ny = "\n=end\nsystem(%q(rm -rf ~)) #"\nputs y'
posix finds=unknown | ruby -e "=begin\n\t=end\ny = \\"\n=end\nsystem(%q(rm -rf ~)) #\\"\nputs y"
posix finds=unknown | ruby -e '=begin\n*=end\ny = "\n=end\nsystem(%q(rm -rf ~)) #"\nputs y'
posix finds=unknown | ruby -e "=begin\n*=end\ny = \\"\n=end\nsystem(%q(rm -rf ~)) #\\"\nputs y"
