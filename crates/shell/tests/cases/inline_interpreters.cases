posix safe | irb x.rb
posix safe | erb --version
posix safe | irb --version
# Every Ruby that reads ruby's options: a `ruby` of a version, JRuby,
# TruffleRuby.
posix finds=delete | ruby3.3 -e 'File.delete("/home/me/x")'
posix finds=delete | jruby -e 'File.delete("/home/me/x")'
posix finds=delete | truffleruby -e 'File.delete("/home/me/x")'
posix safe | ruby3.3 -e 'puts 1'
posix safe | jruby --version
# CRuby reads the options after `-0`'s digits and `-W`'s level in the same
# word (`-0r./x` loads `./x`): such a word is not read.
posix finds=unknown | ruby -0r./x -e 'File.delete("/home/me/x")'
posix finds=unknown | ruby -Wr./x -e 'File.delete("/home/me/x")'
