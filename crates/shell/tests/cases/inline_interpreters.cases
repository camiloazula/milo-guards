# read.
posix finds=unknown | ruby <<'RB'\nx = <<"É"\nÉ\nsystem("rm -rf ~")\nRB
# irb reads its input as Ruby, after its `.irbrc` (never read whole), and not
# after `-r` or `-I`; erb runs the Ruby of the template it reads, from its
# input or a file.
posix finds=delete | irb <<'RB'\nsystem("rm -rf ~")\nRB
posix finds=unknown | irb <<'RB'\nputs 1\nRB
posix finds=unknown | irb -r ./x <<'RB'\nsystem("rm -rf ~")\nRB
