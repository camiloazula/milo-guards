posix finds=unknown | trap 'python3 -c "print(1)"' EXIT; for PATH; do :; done
posix finds=unknown | trap 'node -e "console.log(1)"' EXIT; for NODE_OPTIONS in --require=/tmp/x.js; do :; done
posix finds=unknown | while node -e 'console.log(1)'; do for PATH in /tmp/e; do break; done; done
posix finds=unknown | f() { node -e 'console.log(1)'; }; for NODE_OPTIONS in --require=/tmp/x.js; do f; done
