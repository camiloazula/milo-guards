# A loop's variable is a variable the line sets, for code that runs later, and
# so is a prefix of a call to a function the line defines.
posix finds=unknown | trap 'ruby -e "p 1"' EXIT; for PATH in /tmp/e; do :; done
posix finds=unknown | while true; do ruby -e 'p 1'; for PATH in /tmp/e; do break; done; done
