# Code in a loop, a function or a trap runs after what the line goes on to set:
# the environment is the line's last.
posix finds=unknown | while true; do ruby -e 'p 1'; export RUBYOPT=-r/tmp/x; done
posix finds=unknown | until false; do ruby -e 'p 1'; export RUBYOPT=-r/tmp/x; done
