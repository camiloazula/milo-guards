# From its input, as it is: a here-document, a here-string, `-`; not after
# an option that loads code first, or `-C`, which runs it elsewhere.
posix finds=delete | ruby <<'RB'\nFile.delete("/home/me/x")\nRB
posix finds=delete | ruby -w <<'RB'\nFile.delete("/home/me/x")\nRB
posix finds=delete | ruby <<< 'File.delete("/home/me/x")'
