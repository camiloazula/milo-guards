posix finds=unknown | rake -r ./x test
posix finds=unknown | RAKEOPT="-e system('rm -rf ~')" rake
posix finds=unknown | export RAKEOPT='-r ./x'; rake test
posix finds=unknown | env RAKEOPT=-t rake test
