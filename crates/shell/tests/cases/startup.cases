powershell finds=overwrite | Set-Content ENVRC~1 x
powershell finds=overwrite | Set-Content GITHUB~1\\WORKFL~1\\ci.yml x
powershell finds=overwrite | Set-Content HUSKY~1\\pre-commit x
powershell finds=overwrite | Set-Content JENKIN~1 x
powershell finds=overwrite | Set-Content VS1A2B~1\\tasks.json x
powershell finds=overwrite | Set-Content .en`vrc x
powershell finds=overwrite | Set-Content FileSystem::.envrc x
powershell finds=overwrite | Set-Content Microsoft.PowerShell.Core\\FileSystem::C:\\Users\\me\\dev\\repo\\.envrc x
powershell finds=overwrite | Set-Location .vscode; Set-Content tasks.json x
powershell finds=overwrite | cd .github\\workflows; Out-File ci.yml
powershell finds=overwrite | Push-Location .husky; Set-Content pre-commit x
powershell finds=overwrite | & { Set-Content .envrc x }
powershell finds=overwrite | pwsh -Command "Set-Content .envrc x"
powershell finds=overwrite | powershell -NoProfile -Command "'x' | Out-File .vscode\\tasks.json"

# PowerShell: recursive copies and patterns.
powershell safe | Copy-Item -Recurse a dist
powershell safe | Copy-Item -Recurse a .githubx
powershell safe | Set-Content src\\*.rs x
powershell safe | Set-Content *.md x
powershell safe | Set-Content src\\* x
powershell finds=overwrite | Copy-Item -Recurse a .github
powershell finds=overwrite | Copy-Item -Recurse a .vscode\\
powershell finds=overwrite | Copy-Item -Recurse a GITHUB~1
powershell finds=overwrite | Copy-Item -Recurse a sub\\.github
powershell finds=overwrite | Copy-Item -Recurse .vscode sub\\
powershell finds=overwrite | Copy-Item lefthook.yml sub\\
powershell finds=overwrite | Copy-Item a\\.envrc sub\\
powershell finds=overwrite | Copy-Item a\\tasks.json .vscode\\
powershell finds=overwrite | Copy-Item a .vscode\\*
powershell finds=overwrite | Set-Content .github\\workflows\\*.yml x
powershell finds=overwrite | Set-Content .husky\\* x
powershell finds=overwrite | Set-Content *.yml x
powershell finds=overwrite | Set-Content *\\tasks.json x
powershell finds=overwrite | Set-Content *.json x
powershell finds=overwrite | Set-Content .e* x

# A destination that may be a file as well as a folder is judged as the
# name it is: `cp .envrc .envrc.bak` is an everyday backup, and which of the
# two a name is cannot be read. A folder that is one for certain (a trailing
# separator, `.`, `..`, `-t`, several sources) is read as one (and
# `cp a/.envrc sub/` and `cp -t .vscode a/tasks.json` are cases above).
posix safe | cp .envrc .envrc.bak
posix safe | cp .envrc backup
posix safe | cp -r .vscode backup
posix safe | cp a/lefthook.yml sub
posix safe | mv a/.envrc sub
posix safe | mv .vscode/tasks.json old-tasks
posix safe | ln -s a/.envrc link
posix finds=overwrite | cp a/.envrc sub/.
posix finds=overwrite | cp a/.envrc ..
posix finds=overwrite | cp -t sub a/.envrc
posix finds=overwrite | cp --target-directory=sub a/.envrc
posix finds=overwrite | cp -rt .vscode a
posix finds=overwrite | mv -t .vscode a/tasks.json
posix finds=overwrite | cp a/.envrc b/Jenkinsfile sub
posix finds=overwrite | mv a/.envrc a/other sub

# Reading one only reads, and what it reads is the project's own: a file a
# tool runs on its own is no secret, so its `Reach` stays `Workspace`.
# Writing one changes.
posix effect=reads_workspace | cat .envrc
posix effect=reads_workspace | cat .vscode/tasks.json
posix effect=reads_workspace | grep x .github/workflows/*
posix effect=reads_workspace | head -n 3 .husky/pre-commit
posix effect=reads_workspace | wc -l lefthook.yml
posix effect=reads_workspace | diff .envrc .envrc.bak
posix effect=reads_workspace | ls -la .github/workflows
posix effect=reads_workspace | git diff -- .github/workflows/ci.yml
posix effect=changes | echo x > .envrc
posix effect=changes | tee .vscode/tasks.json
posix effect=changes | cp a .github/workflows/ci.yml
posix effect=changes | sed -i s/a/b/ .husky/pre-commit
posix effect=changes | cp -r a .github
posix effect=changes | cat .envrc > .envrc.new
cmd effect=reads_workspace | type .envrc
cmd effect=reads_workspace | type .vscode\\tasks.json
cmd effect=reads_workspace | findstr x .github\\workflows\\ci.yml
powershell effect=reads_workspace | Get-Content .envrc
powershell effect=reads_workspace | Select-String x .github\\workflows\\ci.yml
# Reading the places all together (each place alone is read in
# startup.rs).
posix effect=reads_workspace | ls .github/workflows
posix effect=reads_workspace | ls -la .husky .githooks .devcontainer
posix effect=reads_workspace | grep -r x .github
posix effect=reads_workspace | cat .github/workflows/*
posix effect=reads_workspace | cat .vscode/*.json
posix effect=reads_workspace | cat *.code-workspace
posix effect=reads_workspace | cat **/.envrc
posix effect=reads_workspace | find . -name Jenkinsfile
# Beyond the workspace the same names are not the project's.
posix effect=reads_beyond | cat ../.envrc
posix effect=reads_beyond | cat ~/.envrc
posix effect=reads_beyond | cat /etc/.vscode/tasks.json

# More ways to write one.
posix finds=overwrite | exec 3> .envrc
posix finds=overwrite | exec 3>>.vscode/tasks.json
posix finds=overwrite | echo x 1> .envrc
posix finds=overwrite | echo x >.envrc
posix finds=overwrite | echo x>.envrc
posix finds=overwrite | rsync a .envrc
posix finds=overwrite | rsync -a a/ .github/workflows/
posix finds=overwrite | rsync a b/Jenkinsfile
posix finds=overwrite | awk '{print}' a > .envrc
posix finds=overwrite | rm .envrc && echo x > .envrc
posix finds=overwrite | if true; then echo x > .envrc; fi
posix finds=overwrite | while read l; do echo $l >> .envrc; done < a
posix finds=overwrite | xargs -I{} cp {} .envrc < list
posix finds=overwrite | echo x | sudo -u me tee .envrc
posix finds=overwrite | env X=1 tee .envrc
posix finds=overwrite | command tee .envrc
posix finds=overwrite | nohup tee .envrc
posix finds=overwrite | time sh -c 'echo x > .envrc'

# An empty folder is no code: making the folder a place is not a finding
# (`mkdir -p .github/workflows` comes before every workflow), and what is
# written into it is.
posix safe | mkdir .github/workflows
posix safe | mkdir -p .github/workflows
posix safe | mkdir -p .husky
posix safe | mkdir .vscode
posix safe | mkdir -p .devcontainer
posix safe | mkdir -p .idea/runConfigurations
posix safe | mkdir -p src/.github/workflows
posix safe | mkdir -p .GitHub/Workflows
posix safe | mkdir -m 755 .husky
posix finds=overwrite | touch .envrc
posix finds=overwrite | touch .husky/pre-commit
posix finds=overwrite | mkfifo .envrc
