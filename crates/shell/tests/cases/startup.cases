powershell@windows_workspace_folder finds=overwrite | ren a .agent
powershell@windows_workspace_folder finds=overwrite | rni a AGENT~1
powershell@windows_workspace_folder finds=overwrite | Rename-Item .\\a .agent
powershell@windows_workspace_folder finds=overwrite | New-Item -ItemType SymbolicLink -Path .agent -Value a
powershell@windows_workspace_folder finds=overwrite | New-Item -Name .agent -ItemType Junction -Value x
powershell@windows_workspace_folder finds=overwrite | New-Item -Path .agent -Name rules
# What is renamed away is a delete of it, as `mv` is.
