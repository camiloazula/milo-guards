cmd finds=overwrite | echo x > ~\\dev\\repo\\.envrc
cmd finds=overwrite | echo x > C:.envrc
cmd finds=overwrite | echo x > VSCODE~1\\TASKS~1.JSO
cmd finds=overwrite | echo x > VSCODE~1\\tasks.json
cmd finds=overwrite | echo x > .vscode\\TASKS~1.JSO
cmd finds=overwrite | echo x > ENVRC~1
cmd finds=overwrite | echo x > GITHUB~1\\WORKFL~1\\ci.yml
cmd finds=overwrite | echo x > GITHUB~1\\workflows\\ci.yml
cmd finds=overwrite | echo x > HUSKY~1\\pre-commit
cmd finds=overwrite | echo x > GITLAB~1.YML
cmd finds=overwrite | echo x > LEFTHO~1.YML
cmd finds=overwrite | echo x > JENKIN~1
cmd finds=overwrite | echo x > DEVCON~1\\devcontainer.json
cmd finds=overwrite | echo x > VS1A2B~1\\tasks.json
cmd finds=overwrite | echo x > src\\ENVRC~1
cmd finds=overwrite | cd .vscode & echo x > tasks.json
cmd finds=overwrite | cd .github\\workflows && copy a ci.yml
cmd finds=overwrite | cd /d C:\\Users\\me\\dev\\repo\\.vscode && echo x > tasks.json
cmd finds=overwrite | echo x>.envrc
cmd finds=overwrite | echo x > .en^vrc
cmd finds=overwrite | echo x > .vscode\\tasks.json 2>&1
cmd finds=overwrite | cmd /c "echo x > .envrc"

# cmd: recursive copies and patterns.
cmd safe | xcopy /s /y a dist
cmd safe | robocopy a dist /E
cmd safe | copy a dist\\
cmd safe | xcopy a .githubx\\ /s
cmd finds=overwrite | xcopy /s /y a .github
cmd finds=overwrite | xcopy /e /y a .vscode\\
cmd finds=overwrite | robocopy a .github /E
cmd finds=overwrite | robocopy a GITHUB~1 /E
cmd finds=overwrite | xcopy /s a sub\\.github
cmd finds=overwrite | copy a .vscode\\*
cmd finds=overwrite | copy a .github\\workflows\\*.yml
cmd finds=overwrite | copy lefthook.yml sub\\
cmd finds=overwrite | copy a\\.envrc sub\\
cmd finds=overwrite | copy a\\tasks.json .vscode\\
cmd finds=overwrite | copy a\\ci.yml .github\\workflows\\
cmd finds=overwrite | copy a *.yml
cmd finds=overwrite | echo x > *.json

# PowerShell reads every spelling Windows resolves to one name.
powershell safe | Set-Content VSCODE~1\\EXTENS~1.JSO x
powershell safe | Set-Content PROGRA~1\\x x
powershell safe | Set-Content ENVRCX~1 x
powershell safe | Set-Content .envrcx x
powershell finds=overwrite | Set-Content .ENVRC x
powershell finds=overwrite | Set-Content .envrc. x
powershell finds=overwrite | Set-Content '.envrc ' x
powershell finds=overwrite | Set-Content .vscode/tasks.json x
powershell finds=overwrite | Set-Content .VSCODE\\TASKS.JSON x
powershell finds=overwrite | Set-Content C:\\Users\\me\\dev\\repo\\.envrc x
powershell finds=overwrite | Set-Content c:\\users\\ME\\dev\\repo\\.ENVRC x
powershell finds=overwrite | Set-Content C:/Users/me/dev/repo/.envrc x
powershell finds=overwrite | Set-Content \\\\?\\C:\\Users\\me\\dev\\repo\\.envrc x
powershell finds=overwrite | Set-Content ~\\dev\\repo\\.envrc x
powershell finds=overwrite | Set-Content $HOME\\dev\\repo\\.envrc x
powershell finds=overwrite | Set-Content $env:USERPROFILE\\dev\\repo\\.envrc x
powershell finds=overwrite | Set-Content C:.envrc x
powershell finds=overwrite | Set-Content VSCODE~1\\TASKS~1.JSO x
