# The same hole for the caller's own files: a rename or a link onto a
# protected name is a write of it.
powershell@windows_workspace_folder safe | Rename-Item a b
powershell@windows_workspace_folder safe | ren a .agentx
powershell@windows_workspace_folder safe | New-Item -Name .agentx
