# Files a tool runs on its own (`.vscode/tasks.json`, `.envrc`, `.husky/*`,
# `.github/workflows/*`...): a line that writes one, at any depth in a
# workspace folder and however it is spelled, is `overwrite` with "a file a
# tool runs on its own"; a line that reads one, or deletes one, is safe; and
# the files that only run when someone asks (`Makefile`, `justfile`,
# `package.json`) stay safe. Every spelling a review could try is a case.
# Every writer of every place, and the reads and deletes of each, are made
# in startup.rs. The format is in CONTRIBUTING.md.

# A protected folder of the caller's in the workspace.
paths workspace_folder base=posix folder=/home/me/work/repo/.agent words="the agent's settings"
# The same folder on Windows.
paths windows_workspace_folder base=windows folder=C:\\Users\\me\\dev\\repo\\.agent words="the agent's settings"
# A protected folder that is also a place on the list.
paths github_rules base=posix folder=/home/me/work/repo/.github words="the agent's rules"

# Said in the words of the place: `writes to`, and the verb of the line.
posix rules=overwrite first=overwrite reason="writes to a file a tool runs on its own" | echo x > .envrc
posix rules=overwrite first=overwrite reason="writes to a file a tool runs on its own" | tee .vscode/tasks.json
posix rules=overwrite first=overwrite reason="writes to a file a tool runs on its own" | cp a .envrc
posix rules=overwrite first=overwrite reason="edits a file a tool runs on its own" | sed -i s/a/b/ .github/workflows/ci.yml
posix rules=overwrite first=overwrite reason="creates a file a tool runs on its own" | touch .envrc
posix rules=overwrite first=overwrite reason="truncates a file a tool runs on its own" | truncate -s 0 .envrc
# A finding names the path as written (its target is in startup.rs).
posix first=overwrite reason="writes to a file a tool runs on its own" | echo x > .Vscode/Tasks.json

# Spellings of one are one file.
# Quoted, escaped and expanded.
posix finds=overwrite | echo x > '.envrc'
posix finds=overwrite | echo x > ".envrc"
posix finds=overwrite | echo x > .en""vrc
posix finds=overwrite | echo x > .e'n'vrc
posix finds=overwrite | echo x > .env\\rc
posix finds=overwrite | echo x > $'.envrc'
posix finds=overwrite | echo x > $'.\\x65nvrc'
posix finds=overwrite | echo x > $'\\056envrc'
posix finds=overwrite | echo x > ${EMPTY:-.envrc}
posix finds=overwrite | echo x > .vscode/"tasks".json
# Absolute, from home, from the working directory.
posix finds=overwrite | echo x > /home/me/work/repo/.envrc
posix finds=overwrite | echo x > ~/work/repo/.envrc
posix finds=overwrite | echo x > $HOME/work/repo/.envrc
posix finds=overwrite | echo x > ${HOME}/work/repo/.vscode/tasks.json
posix finds=overwrite | echo x > ./.envrc
posix finds=overwrite | echo x > src/../.envrc
posix finds=overwrite | echo x > ../repo/.envrc
posix finds=overwrite | echo x > .//.envrc
posix finds=overwrite | echo x > .vscode//tasks.json
posix finds=overwrite | echo x > .vscode/./tasks.json
posix finds=overwrite | echo x > .vscode/x/../tasks.json
posix finds=overwrite | echo x > /home/me/work/./repo/.vscode/../.envrc
# Without case (`\u{212a}` is the Kelvin sign, which folds to `k`).
posix finds=overwrite | echo x > .ENVRC
posix finds=overwrite | echo x > .VSCode/Tasks.JSON
posix finds=overwrite | echo x > .GitHub/Workflows/CI.yml
posix finds=overwrite | echo x > JENKINSFILE
posix finds=overwrite | echo x > lefthoo\u{212a}.yml
# A `cd` moves where a relative path is.
posix finds=overwrite | cd .vscode && echo x > tasks.json
posix finds=overwrite | cd .github/workflows; echo x > ci.yml
posix finds=overwrite | cd .github && cp a workflows/ci.yml
posix finds=overwrite | cd .husky; sed -i s/a/b/ pre-commit
posix finds=overwrite | cd src && echo x > .envrc
posix finds=overwrite | cd /home/me/work/repo/.vscode && tee launch.json
# In a subshell, a group, a pipeline, a loop and a function.
posix finds=overwrite | (echo x > .envrc)
posix finds=overwrite | { echo x > .envrc; }
posix finds=overwrite | true && echo x > .envrc
posix finds=overwrite | cat a | tee .envrc
posix finds=overwrite | for f in a b; do echo x > .envrc; done
posix finds=overwrite | f() { echo x > .envrc; }; f
posix finds=overwrite | sh -c 'echo x > .envrc'
posix finds=overwrite | bash -c "echo x > .vscode/tasks.json"
posix finds=overwrite | cat <<'EOF' > .envrc\nx\nEOF
posix finds=overwrite | sudo tee .envrc
# Several at once.
posix finds=overwrite | cp a b .husky/
posix finds=overwrite | tee a.txt .envrc

# A Mac reads its links and its fold (`\u{17f}` is the long s, which folds to
# `s`).
posix@macos finds=overwrite | echo x > .envrc
posix@macos finds=overwrite | echo x > .ENVRC
posix@macos finds=overwrite | echo x > .VSCODE/TASKS.JSON
posix@macos finds=overwrite | echo x > /Users/me/dev/repo/.envrc
posix@macos finds=overwrite | echo x > ~/dev/repo/.github/workflows/ci.yml
posix@macos finds=overwrite | echo x > /System/Volumes/Data/Users/me/dev/repo/.envrc
posix@macos finds=overwrite | echo x > '/Volumes/Macintosh HD/Users/me/dev/repo/.vscode/tasks.json'
posix@macos finds=overwrite | echo x > '/Volumes/Macintosh HD - Data/Users/me/dev/repo/.husky/pre-commit'
posix@macos finds=overwrite | echo x > ../../../../System/Volumes/Data/Users/me/dev/repo/.envrc
posix@macos finds=overwrite | echo x > .v\u{17f}code/tasks.json
posix@macos finds=overwrite | sed -i '' s/a/b/ .envrc
posix@macos finds=overwrite | cp a .GitHub/Workflows/x.yml
posix@macos safe | cat .envrc
posix@macos safe | rm .envrc
posix@macos safe | echo x > Makefile

# A write beyond the workspace keeps its own words.
posix rules=overwrite first=overwrite reason="writes to a file outside the workspace" | echo x > /home/me/other/.envrc
posix rules=overwrite first=overwrite reason="writes to a file outside the workspace" | echo x > ~/.vscode/tasks.json
posix rules=overwrite first=overwrite reason="writes to a system folder" | echo x > /etc/.envrc
posix rules=overwrite first=overwrite reason="writes to the repository's history" | echo x > .git/.envrc
posix rules=overwrite first=overwrite reason="writes to your SSH keys" | echo x > ~/.ssh/.envrc
posix rules=overwrite first=overwrite reason="writes to a shell startup file" | echo x > ~/.bashrc
# A temporary file is the agent's own.
posix safe | echo x > /tmp/x/.envrc
posix safe | echo x > /tmp/.vscode/tasks.json
posix safe | cp a /var/tmp/x/.github/workflows/ci.yml
posix safe | echo x > $TMPDIR/.envrc

# A protected path and the history keep their words.
posix@github_rules rules=overwrite first=overwrite reason="writes to the agent's rules" | echo x > .github/workflows/ci.yml
posix@github_rules rules=overwrite first=overwrite reason="writes to a file a tool runs on its own" | echo x > .vscode/tasks.json

# A file lands at its own name in a folder.
posix safe | cp a.txt .vscode/
posix safe | cp a.txt .husky-old/
posix safe | cp -r a .vscode-x
posix safe | cp lefthook.yml.bak sub/
posix safe | cp .envrc /tmp/
posix safe | mv Makefile sub/
posix safe | cp *.md docs/
posix safe | cp *.yaml conf/
posix safe | cp *.yml deploy/
posix safe | mv *.json dist/
posix safe | cp 'x*/.env' sub/
posix finds=overwrite | cp lefthook.yml sub/
posix finds=overwrite | cp a/lefthook.yml sub/
posix finds=overwrite | cp a/.envrc sub/
posix finds=overwrite | cp a/.envrc .
posix finds=overwrite | cp a/.envrc ./
posix finds=overwrite | cp a/tasks.json .vscode/
posix finds=overwrite | cp -t .vscode a/tasks.json
posix finds=overwrite | cp a/ci.yml .github/workflows/
posix finds=overwrite | cp a/pre-commit .husky
posix finds=overwrite | mv a/.envrc sub/
posix finds=overwrite | mv x/Jenkinsfile .
posix finds=overwrite | install a/.envrc sub/
posix finds=overwrite | ln -s a/.envrc sub/
posix finds=overwrite | ln -sf a/Jenkinsfile sub/
posix finds=overwrite | cp a/.envrc a/lefthook.yml sub/
posix finds=overwrite | cp .envrc .vscode/tasks.json sub/

# A recursive copy can replace what is below (and `cp -r a .vscode-x` is
# safe, above).
posix safe | cp -r src dist
posix safe | cp -r src dist/
posix safe | cp -R src dist
posix safe | cp -a src build
posix safe | cp -r a/. src
posix safe | cp -r a .githubx
posix safe | cp -r a .config
posix safe | rsync -a src/ dist/
posix safe | cp -r ~/.config dist/
posix safe | cp -r x /tmp/.github
posix finds=overwrite | cp -r a .github
posix finds=overwrite | cp -r a .github/
posix finds=overwrite | cp -r a/. .github
posix finds=overwrite | cp -R a .vscode
posix finds=overwrite | cp -a a .idea
posix finds=overwrite | cp -a a .cursor
posix finds=overwrite | cp -r a sub/.github
posix finds=overwrite | cp -r a .GitHub
posix finds=overwrite | cp -r a src/../.vscode
posix finds=overwrite | cp -r a ~/work/repo/.github
posix finds=overwrite | cp -r a .github/workflows
posix finds=overwrite | cp -r a .husky
posix finds=overwrite | cp --recursive a .github
posix finds=overwrite | cp -rt .github a
posix finds=overwrite | cp -r .github sub/
posix finds=overwrite | cp -r .vscode sub/
posix finds=overwrite | cp -r a/.github .
posix finds=overwrite | cp -r a/.github/ sub/
posix finds=overwrite | rsync -a a/ .github/
posix finds=overwrite | rsync -a a .vscode

# A pattern that can pick one is one.
posix safe | sed -i s/a/b/ src/*.rs
posix safe | sed -i s/a/b/ *.md
posix safe | sed -i s/a/b/ *.json
posix safe | sed -i s/a/b/ src/*
posix safe | tee src/*
posix safe | echo x > src/*.txt
posix safe | sed -i s/a/b/ .vscode/e*
posix safe | sed -i s/a/b/ .github/*.md
posix safe | sed -i s/a/b/ lefthook.y
posix safe | sed -i s/a/b/ Makefile*
posix safe | sed -i s/a/b/ package.*
posix finds=overwrite | sed -i s/a/b/ .github/workflows/*
posix finds=overwrite | sed -i s/a/b/ .github/workflows/*.yml
posix finds=overwrite | echo x > .github/workflows/*
posix finds=overwrite | tee .husky/*
posix finds=overwrite | sed -i s/a/b/ .vscode/*.json
posix finds=overwrite | sed -i s/a/b/ .vscode/*
posix finds=overwrite | sed -i s/a/b/ .vscode/t*
posix finds=overwrite | sed -i s/a/b/ .vscode/?asks.json
posix finds=overwrite | sed -i s/a/b/ .vscode/[t]asks.json
posix finds=overwrite | sed -i s/a/b/ .github/*/ci.yml
posix finds=overwrite | sed -i s/a/b/ src/.vscode/*.json
posix finds=overwrite | sed -i s/a/b/ */.vscode/tasks.json
posix finds=overwrite | sed -i s/a/b/ *.yml
posix finds=overwrite | sed -i s/a/b/ lefthook.*
posix finds=overwrite | sed -i s/a/b/ Jenkins*
posix finds=overwrite | sed -i s/a/b/ */Jenkinsfile
posix finds=overwrite | sed -i s/a/b/ **/Jenkinsfile
posix finds=overwrite | cp a .vscode/*
posix finds=overwrite | cp a .github/workflows/*
# A wildcard that matches a leading dot where the shell says so.
posix finds=overwrite | shopt -s dotglob; sed -i s/a/b/ */tasks.json
posix finds=overwrite | shopt -s dotglob; sed -i s/a/b/ *.json
posix finds=overwrite | shopt -s dotglob; tee .v*/launch.json
posix finds=overwrite | sed -i s/a/b/ .e*
posix finds=overwrite | sed -i s/a/b/ .?nvrc
posix finds=overwrite | echo x > .env*
posix finds=overwrite | echo x > .*/mcp.json
# A `..` after a wildcard part still climbs.
posix finds=overwrite | sed -i s/a/b/ src/*/../../.envrc

# What is known only when it runs is risky, as before.
posix finds=overwrite | echo x > $F
posix finds=overwrite | echo x > "$DIR/.envrc"
posix finds=overwrite | echo x > $(pwd)/.envrc
posix finds=overwrite | echo x > ~root/.envrc
posix finds=overwrite | echo x > {.envrc,x}

# cmd reads every spelling Windows resolves to one name.
cmd safe | echo x > VSCODE~1\\EXTENS~1.JSO
cmd safe | echo x > PROGRA~1\\x
cmd safe | echo x > ENVRCX~1
cmd safe | del VSCODE~1\\TASKS~1.JSO
cmd safe | type VSCODE~1\\TASKS~1.JSO
cmd finds=overwrite | echo x > .ENVRC
cmd finds=overwrite | echo x > .Envrc.
cmd finds=overwrite | echo x > .envrc.
cmd finds=overwrite | echo x > .vscode/tasks.json
cmd finds=overwrite | echo x > .vscode\\\\tasks.json
cmd finds=overwrite | echo x > .VSCODE\\TASKS.JSON
cmd finds=overwrite | echo x > .vscode.\\tasks.json
cmd finds=overwrite | echo x > C:\\Users\\me\\dev\\repo\\.envrc
cmd finds=overwrite | echo x > c:\\users\\ME\\dev\\repo\\.ENVRC
