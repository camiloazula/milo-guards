powershell finds=stop_unknown | Stop-Process -Id (Get-Process -Id $id).Id

# `taskkill` and `tskill` judge the names, ids and `PID` filters they are
# given as `Stop-Process` judges its own, in cmd and in PowerShell; a
# variable of the other shell is a plain word.
cmd safe | taskkill /PID 1234
cmd safe | taskkill /PID 1234 /F
cmd safe | taskkill /F /PID 1234 /T
cmd safe | taskkill /pid 4242 /f
cmd safe | taskkill /PID 1234 /PID 5678
cmd safe | taskkill /IM node.exe /F
cmd safe | tskill node
cmd safe | tskill node /a
cmd safe | tskill node /v
cmd safe | tskill 1234
cmd safe | tskill 4242 /a /v
cmd safe | tskill 1234 /server:build
cmd safe | tskill.exe node
cmd safe | tskill
cmd safe | taskkill /F /FI "PID eq 1234"
