# `wmic process` and `wmic path win32_process` stop the processes their
# `where` clause picks; in PowerShell a value with a variable in it is only
# known when it runs, while in cmd a `$` is a character of the name.
cmd safe | wmic process get name,processid
cmd safe | wmic process where name="node.exe" get processid
cmd safe | wmic process where name="node.exe" call terminate
cmd safe | wmic process where name='node.exe' call terminate
cmd safe | wmic process where "name='node.exe'" call terminate
cmd safe | wmic process where name="node.exe" delete
cmd safe | wmic process where processid=1234 call terminate
cmd safe | wmic process where processid="4242" delete
cmd safe | wmic path win32_process get name
cmd safe | wmic path win32_process where name="node.exe" get processid
cmd safe | wmic path win32_process where name="node.exe" call terminate
cmd safe | wmic path Win32_Process where "name='node.exe'" delete
cmd safe | wmic path win32_process where processid=1234 call terminate
cmd safe | wmic PATH WIN32_PROCESS where name="node.exe" delete
