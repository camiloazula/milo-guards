# A `Where-Object` name pattern (`-like`, `-match`) is read like a wildcard
# around it. `-match` takes a .NET expression, read only in the subset it
# shares with POSIX's: a lookaround, an inline option or comment, an escape
# that spells a character (`\x6f`, `\157`, `\cO`), a Unicode class
# (`\p{L}`), a named backreference, a backslash inside `[...]` (.NET reads
# `[\]o]` as the set `]` and `o`; POSIX closes the set at the first `]`), and
# a letter that is not ASCII (.NET ignores case by the current culture, so
# `İ` and `ſ` can stand for `i` and `s`) are not read, so the filter is one
# only known when it runs. (`\uXXXX` goes the same way, by the same code
# path.)
powershell safe | Get-Process | Where-Object { $_.Name -match 'node' } | Stop-Process
powershell safe | Get-Process | Where-Object { $_.ProcessName -imatch 'vite' } | Stop-Process -Force
powershell safe | Get-Process | Where-Object { $_.Name -cmatch "node" } | Stop-Process
powershell safe | Get-Process | ? { $_.Name -match 'node' } | Stop-Process
powershell safe | Get-Process | Where-Object Name -match node | Stop-Process
powershell safe | Get-Process | Where-Object -Property Name -Match -Value 'node' | Stop-Process
powershell safe | Get-Process | Where-Object { $_.Name -match 'node|vite' } | Stop-Process
powershell safe | Get-Process | Where-Object { $_.Name -match 'node' } | ForEach-Object { $_.Kill() }
powershell safe | Get-Process | Where-Object { $_.Name -match 'node' }
powershell safe | Get-Process | Where-Object { $_.Name -match 'node\\d*' } | Stop-Process
powershell safe | Get-Process | Where-Object { $_.Name -match 'node\\.exe' } | Stop-Process
powershell safe | Get-Process | Where-Object { $_.Name -match '^node\\b' } | Stop-Process
powershell safe | Get-Process | Where-Object { $_.Name -match '^vite\\w*$' } | Stop-Process
powershell safe | Get-Process | Where-Object { $_.Name -match 'node\\\\n' } | Stop-Process
powershell safe | Get-Process | Where-Object { $_.Name -match 'node[0-9]+' } | Stop-Process
powershell safe | Get-Process | Where-Object { $_.Name -match '^[nN]ode$' } | Stop-Process
powershell safe | Get-Process | Where-Object { $_.Name -match 'no[d]e' } | Stop-Process
powershell safe | Get-Process | Where-Object { $_.Name -match 'no[^x]e\\.exe' } | Stop-Process
powershell safe | Get-Process | Where-Object { $_.Name -match 'node\\[a' } | Stop-Process
powershell safe | Get-Process | Where-Object { $_.Name -match 'a/b' } | Stop-Process
powershell safe | Get-Process | Where-Object { $_.Name -match 'node/?x' } | Stop-Process
powershell safe | Get-Process | Where-Object { $_.Name -match '^*node' } | Stop-Process
powershell safe | Get-Process | Where-Object { $_.Name -match 'node$?' } | Stop-Process
powershell finds=stop_system | Get-Process | Where-Object { $_.Name -match 'explorer' } | Stop-Process
powershell finds=stop_system | Get-Process | Where-Object { $_.Name -match 'node|explorer' } | Stop-Process
powershell finds=stop_system | Get-Process | Where-Object { $_.Name -match 'svc' } | Stop-Process
powershell finds=stop_system | Get-Process | Where-Object { $_.Name -match '.*' } | Stop-Process
powershell finds=stop_system | Get-Process | Where-Object { $_.Name -match '' } | Stop-Process
powershell finds=stop_system | Get-Process | Where-Object { $_.Name -match '^' } | Stop-Process
powershell finds=stop_system | Get-Process | Where-Object { $_.Name -match 'x|.*$|' } | Stop-Process
powershell finds=stop_system | Get-Process | Where-Object { $_.Name -match 'a*' } | Stop-Process
powershell finds=stop_system | Get-Process | Where-Object { $_.Name -match '\\w' } | Stop-Process
powershell finds=stop_system | Get-Process | Where-Object { $_.Name -match '(' } | Stop-Process
powershell finds=stop_unknown | Get-Process | Where-Object { $_.Name -match $pattern } | Stop-Process
powershell finds=stop_unknown | Get-Process | Where-Object { $_.Name -match "$dir" } | Stop-Process
powershell finds=stop_unknown | Get-Process | Where-Object { $_.Name -notmatch 'node' } | Stop-Process
