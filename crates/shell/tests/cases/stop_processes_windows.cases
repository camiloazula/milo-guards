# Stopping processes in PowerShell and cmd. `Stop-Process`, `taskkill`,
# `tskill`, `wmic`, a method such as `.Kill()` and WMI's `Terminate` stop a
# process safely only when the guard reads which one for sure: a name that is
# not the system's, a `Get-Process` listing of those, or an id written out in
# digits other than 0 and 1. A name, a filter or a listing that picks every
# process or one the system needs (`explorer`, `svchost`, the compositor, the
# remote login) is `stop_system`; an id, a variable, another cmdlet's
# listing, a filter or a `-match` pattern the guard cannot read may be any
# process and is `stop_unknown`. The format is in CONTRIBUTING.md.

# Stopping a process by name is safe unless the system needs it.
powershell safe | Stop-Process -Name node
powershell safe | Stop-Process -Name node -Force
powershell safe | Stop-Process -Name node,chrome
powershell safe | Stop-Process -Name 'node*'
powershell safe | stop-process -name NODE
powershell safe | kill -Name node
powershell safe | spps -Name node
powershell safe | Stop-Process -Id 1234
powershell safe | Stop-Process -Id 1234 -Force
powershell safe | Get-Process node | Stop-Process
powershell safe | Get-Process -Name node | Stop-Process -Force
powershell safe | gps node | kill
powershell safe | Get-Process
powershell safe | Get-Process | Format-Table
powershell safe | Stop-Process -Name svc
powershell finds=stop_system | Stop-Process -Name explorer
powershell finds=stop_system | Stop-Process -Name explorer -Force
powershell finds=stop_system | Stop-Process -Name Explorer.exe
powershell finds=stop_system | Stop-Process -Name csrss
powershell finds=stop_system | Stop-Process -Name winlogon
powershell finds=stop_system | Stop-Process -Name node,explorer
powershell finds=stop_system | Stop-Process -Name explorer,node
powershell finds=stop_system | Stop-Process -Name *
powershell finds=stop_system | Stop-Process -Name '*' -Force
powershell finds=stop_system | Stop-Process -Name ?*
powershell finds=stop_system | Stop-Process -Name '[a-z]*'
powershell finds=stop_system | Stop-Process -Name s*
powershell finds=stop_system | Stop-Process -Name expl*
powershell finds=stop_unknown | Stop-Process -Name $name
powershell finds=stop_system | Stop-Process -Name e?plorer
powershell finds=stop_system | Stop-Process -Name 'explore[r]'
powershell finds=stop_system | kill -Name explorer
powershell finds=stop_system | Get-Process | Stop-Process
powershell finds=stop_system | Get-Process | Stop-Process -Force
powershell finds=stop_system | gps | kill
powershell finds=stop_system | Get-Process -Name * | Stop-Process
powershell finds=stop_system | Get-Process explorer | Stop-Process
powershell finds=stop_unknown | Get-Process | Where-Object CPU -gt 100 | Stop-Process
powershell finds=stop_unknown | $procs | Stop-Process
powershell finds=stop_unknown | Get-CimInstance Win32_Process | Stop-Process
powershell finds=stop_system | powershell -Command "Stop-Process -Name *"
powershell finds=stop_system | Stop-Process -Name svchost -Force
powershell finds=stop_system | Stop-Process -Name SvcHost.exe
powershell finds=stop_system | Stop-Process -Name svc*
# The compositor and the remote login.
powershell finds=stop_system | Stop-Process -Name dwm
powershell finds=stop_system | Stop-Process -Name dwm -Force
powershell finds=stop_system | Stop-Process -Name DWM.exe
powershell finds=stop_system | Stop-Process -Name sshd
powershell finds=stop_system | Stop-Process -Name node, dwm
powershell finds=stop_system | Stop-Process -Name dw*
powershell finds=stop_system | Get-Process dwm | Stop-Process
powershell finds=stop_unknown | Stop-Process -Name $n

# `Stop-Process` reads its own parameters.
powershell safe | Stop-Process -N node
powershell safe | Stop-Process -ProcessName node
powershell safe | Stop-Process -Proc node -Force
powershell safe | Stop-Process -Name:node
powershell safe | Stop-Process -Name node -ErrorAction SilentlyContinue
powershell safe | Stop-Process -ErrorAction SilentlyContinue -Name node
powershell safe | spps -ea 0 -Name node
powershell safe | kill -n node
powershell safe | Stop-Process -Name node -PassThru -WhatIf
powershell safe | Stop-Process -Id 12 -Confirm:$false
powershell finds=stop_system | Stop-Process -N explorer
powershell finds=stop_system | Stop-Process -Na explorer
powershell finds=stop_system | Stop-Process -ProcessName explorer
powershell finds=stop_system | Stop-Process -Proc explorer
powershell finds=stop_system | Stop-Process -Name:explorer
powershell finds=stop_system | Stop-Process -ErrorAction SilentlyContinue -Name explorer
powershell finds=stop_system | Stop-Process -ea 0 -N explorer -Force
powershell finds=stop_system | kill -n *
powershell finds=stop_system | kill -ProcessName winlogon
powershell finds=stop_system | Stop-Process -N node,explorer
powershell finds=stop_unknown | Stop-Process -N $n

# A `Get-Process` listing piped or handed to `Stop-Process` is judged like the
# listing: a name, an id or a filter the guard reads narrows it, a
# `Select-Object` that hands on other objects does not, and a member read off
# it is the listing only for `Id` and `Name`. Another cmdlet's listing, a
# variable and a part beside the listing are only known when it runs.
powershell safe | Stop-Process -InputObject (Get-Process node)
powershell safe | Stop-Process -Id (Get-Process -Name node).Id
powershell safe | Stop-Process -Id (Get-Process node | Select-Object -First 1).Id
powershell safe | Stop-Process (Get-Process node)
powershell safe | Stop-Process -Id (Get-Process -Id $pid).Id
powershell safe | Get-Process node | % { Stop-Process -Id $_.Id }
powershell safe | Get-Process node | ForEach-Object { Stop-Process -InputObject $_ -Force }
powershell safe | Get-Process | % { $_.Name }
powershell safe | Get-Process -Id 123 | Stop-Process
powershell safe | Get-Process -Id $pid | Stop-Process
# Ids 12 and 13: 1 is the system's first process.
powershell safe | gps -Id 12,13 | kill
powershell safe | Get-Process | Where-Object { $_.ProcessName -eq 'node' } | Stop-Process
powershell safe | Get-Process | Where-Object { $_.Name -like 'node*' } | Stop-Process -Force
powershell safe | Get-Process | Where-Object { $PSItem.Name -eq 'node' } | Stop-Process -WhatIf
powershell safe | gps | ? Name -eq node | kill
powershell safe | Get-Process | Where-Object ProcessName -like 'node*' | Stop-Process
powershell safe | Get-Process | Where-Object -Property ProcessName -eq -Value node | Stop-Process
powershell safe | Get-Process | Where-Object -FilterScript { $_.Name -eq 'node' } | Stop-Process
powershell safe | Get-Process node | Where-Object { $_.CPU -gt 100 } | Stop-Process
powershell safe | Get-Process node | Sort-Object CPU | Select-Object -First 1 | Stop-Process
powershell safe | Get-Process | Where-Object { $_.ProcessName -ceq 'node' } | Stop-Process
powershell safe | Get-Process node | Select-Object -First 1 | Stop-Process
powershell safe | Get-Process node | select -Property Name | kill
powershell safe | Get-Process node | Select-Object Id | Stop-Process
powershell safe | Get-Process node | Select-Object -Last 2 | Stop-Process
powershell safe | Get-Process node | Sort-Object CPU | Select-Object -First 1 | kill
powershell safe | Get-Process node | select -ex 1 | kill
powershell safe | Stop-Process -Id (Get-Process node).Id
powershell safe | Stop-Process -Id ((Get-Process node).Id)
powershell safe | Stop-Process -Id (Get-Process node).Id, 4242
powershell safe | Stop-Process -InputObject (Get-Process node), (Get-Process vite)
powershell safe | Stop-Process -Id (Get-Process node).ID
powershell safe | Stop-Process -InputObject (Get-Process node).Name
powershell safe | Stop-Process -InputObject ((Get-Process node).ProcessName)
powershell safe | Stop-Process -Id (Get-Process -Id $PID).Id
# Another cmdlet's listing, a variable and the item of a block that no
# `Get-Process` feeds are processes only known when it runs, as
# `kill $(lsof -ti:3000)` is.
powershell finds=stop_unknown | Stop-Process -Id (Get-NetTCPConnection -LocalPort 3000).OwningProcess
powershell finds=stop_unknown | Stop-Process -InputObject $p
powershell finds=stop_unknown | $procs | % { Stop-Process -Id $_.Id }
powershell finds=stop_unknown | Get-NetTCPConnection -LocalPort 3000 | % { Stop-Process -Id $_.OwningProcess }
powershell finds=stop_system | Stop-Process -InputObject (Get-Process) -Force
powershell finds=stop_system | Stop-Process -InputObject (Get-Process explorer)
powershell finds=stop_system | Stop-Process -Id (Get-Process).Id
powershell finds=stop_system | Stop-Process -Id $(Get-Process)
powershell finds=stop_system | Stop-Process (Get-Process)
powershell finds=stop_unknown | Stop-Process -Id (Get-Process | Where-Object CPU -gt 1).Id
powershell finds=stop_unknown | Stop-Process -Id (Get-Process).Where({ $_.CPU -gt 1 }).Id
powershell finds=stop_system | Get-Process | % { Stop-Process -InputObject $_ }
powershell finds=stop_system | Get-Process | % { Stop-Process -Id $_.Id }
powershell finds=stop_system | Get-Process | ForEach-Object { Stop-Process -Id $PSItem.Id -Force }
powershell finds=stop_system | Get-Process -Name explorer | % { Stop-Process -Id $_.Id }
powershell finds=stop_unknown | Get-Process | Where-Object CPU -gt 1 | % { Stop-Process -Id $_.Id }
powershell finds=stop_system | Get-Process | % { if ($_.CPU -gt 1) { Stop-Process -Id $_.Id } }
# A variable picks the processes only when it runs.
powershell finds=stop_unknown | Get-Process -InputObject $x | Stop-Process
powershell finds=stop_system | Get-Process | Where-Object { $_.ProcessName -eq 'explorer' } | Stop-Process
powershell finds=stop_system | Get-Process | Where-Object { $_.Name -like 'e*' } | Stop-Process
powershell finds=stop_system | gps | ? Name -eq svchost | kill
powershell finds=stop_unknown | Get-Process | Where-Object { $_.CPU -gt 100 } | Stop-Process
powershell finds=stop_unknown | Get-Process | Where-Object { $_.ProcessName -ne 'node' } | Stop-Process
powershell finds=stop_unknown | Get-Process | Where-Object { $_.ProcessName -eq 'a' -or $_.CPU -gt 1 } | Stop-Process
powershell finds=stop_unknown | Get-Process | Where-Object { $_.ProcessName -eq $n } | Stop-Process
powershell finds=stop_unknown | Get-Process | Where-Object { $_.Id -eq 5 } | Stop-Process
powershell finds=stop_unknown | Get-Process | Select-Object -First 1 | Stop-Process
powershell finds=stop_unknown | Get-Process | ForEach-Object { $_ } | Stop-Process
powershell finds=stop_unknown | Get-Process node | ForEach-Object { Get-Process } | Stop-Process
powershell finds=stop_system | Get-Process | Where-Object { $_.ProcessName -eq 'node' } | Stop-Process; Get-Process | Stop-Process
# A `Select-Object` that hands on other objects.
powershell finds=stop_unknown | Get-Process node | Select-Object -ExpandProperty Parent | Stop-Process
powershell finds=stop_unknown | Get-Process node | select -exp Parent | kill
powershell finds=stop_unknown | Get-Process node | select -ExpandProperty:Parent | kill
powershell finds=stop_unknown | Get-Process node | select -expa Parent | kill
powershell finds=stop_unknown | Get-Process node | select @{n='x';e={$_.Parent}} | kill
powershell finds=stop_unknown | Get-Process node | Select-Object -Property @{Name='P';Expression={$_.Parent}} | Stop-Process
powershell finds=stop_unknown | Stop-Process -InputObject (Get-Process node | select -exp Parent)
powershell finds=stop_unknown | Get-Process node | select -exp Parent | Select-Object -First 1 | kill
# The listing says nothing of the id or the object beside it.
powershell finds=stop_unknown | Stop-Process -Id ((Get-Process node).Id, $x)
powershell finds=stop_unknown | Stop-Process -Id ($x, (Get-Process node).Id)
powershell finds=stop_unknown | Stop-Process -Id $((Get-Process node).Id; $x)
powershell finds=stop_unknown | Stop-Process -Id (Get-Process node).Id, $x
powershell finds=stop_unknown | Stop-Process -InputObject ((Get-Process node), $x)
powershell finds=stop_unknown | Stop-Process -InputObject (Get-Process node), $x
powershell finds=stop_unknown | Stop-Process -Id ((Get-Process node).Id + 1)
powershell finds=stop_unknown | Stop-Process -Id (Get-Process node).Id, (Get-Content app.pid)
# A member other than `Id` and `Name`.
powershell finds=stop_unknown | Stop-Process -InputObject (Get-Process notepad).Parent
powershell finds=stop_unknown | Stop-Process -InputObject (Get-Process -Id $PID).Parent
powershell finds=stop_unknown | Stop-Process -Id (Get-Process node).Parent.Id
powershell finds=stop_unknown | Stop-Process -InputObject ((Get-Process node).Parent)
powershell finds=stop_unknown | (Get-Process node).Parent | Stop-Process
powershell finds=stop_unknown | Stop-Process -Id (Get-Process node | Select-Object -ExpandProperty Parent).Id
