# An id, a name, a listing, an object or a filter the guard cannot read is
# `stop_unknown` and never `stop_system`; a certain stop is `stop_system` and
# never `stop_unknown`.
powershell finds=stop_unknown lacks=stop_system | Stop-Process -Id $id
powershell finds=stop_unknown lacks=stop_system | Stop-Process -InputObject $p
powershell finds=stop_unknown lacks=stop_system | Stop-Process -Name $n
powershell finds=stop_unknown lacks=stop_system | Stop-Process -Id (Get-Content app.pid)
powershell finds=stop_unknown lacks=stop_system | Stop-Process -Id (Get-NetTCPConnection -LocalPort 3000).OwningProcess
