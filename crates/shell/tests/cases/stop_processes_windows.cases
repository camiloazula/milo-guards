powershell finds=stop_unknown | Get-Process | Where-Object { $_.Name -match 'expl\\0157rer' } | Stop-Process
powershell finds=stop_unknown | Get-Process | Where-Object { $_.Name -match 'expl\\cOrer' } | Stop-Process
# Unicode classes.
