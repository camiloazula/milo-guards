powershell finds=stop_unknown | Stop-Process -Id 0x10
powershell finds=stop_unknown | Stop-Process -Id -1
powershell finds=stop_unknown | Stop-Process -Id 1.5
powershell finds=stop_unknown | Stop-Process -Id ' 1234'
