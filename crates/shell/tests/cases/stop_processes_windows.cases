powershell finds=stop_unknown | Stop-Process -Id $(Get-Content app.pid)
powershell finds=stop_unknown | Stop-Process -Id (Get-NetTCPConnection -LocalPort 3000 -State Listen).OwningProcess -Force
powershell finds=stop_unknown | Stop-Process -Id (netstat -ano)
