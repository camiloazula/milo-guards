powershell finds=stop_unknown | Stop-Process -Id (Get-Process node).Threads.Id
powershell finds=stop_unknown | Stop-Process -Id (Get-Process node).ParentX
powershell finds=stop_unknown | Stop-Process -Id (Get-Process -Id (Get-Process explorer).Id).Id
powershell finds=stop_unknown | Stop-Process -Id (Get-Content pid.txt | % { (Get-Process $_).Parent.Id })

# The item `$_` of a block a `Get-Process` feeds is that process, wrapped or
# not; a member other than the process's own, and the item after anything
# but a `Get-Process`, is another process only known when it runs.
powershell safe | Get-Process notepad | % { Stop-Process -Id $_.Id }
powershell safe | Get-Process notepad | % { Stop-Process -InputObject $_ }
powershell safe | Get-Process notepad | % { Stop-Process $_.Id }
powershell safe | Get-Process notepad | % { Stop-Process -Id $PSItem.Id -Force }
powershell safe | Get-Process node | % { Stop-Process -Id ($_.Id) }
powershell safe | Get-Process node | % { Stop-Process ($_) }
powershell safe | Get-Process node | % { Stop-Process @($_) }
powershell safe | Get-Process node | % { Stop-Process -InputObject ($_) }
powershell safe | Get-Process node | % { Stop-Process -Id $($_.Id) }
powershell safe | Get-Process node | % { Stop-Process -Id "$($_.Id)" }
powershell safe | Get-Process node | % { Stop-Process -Id ([int]$_.Id) }
powershell safe | Get-Process node | % { Stop-Process -Id "$_" }
powershell finds=stop_unknown | Get-NetTCPConnection -LocalPort 3000 | % { Stop-Process -Id ($_.OwningProcess) }
powershell finds=stop_unknown | Get-Process notepad | % { Stop-Process -InputObject $_.Parent }
powershell finds=stop_unknown | Get-Process notepad | % { Stop-Process $_.Parent }
powershell finds=stop_unknown | Get-Process notepad | % { Stop-Process -Id $_.Parent.Id -Force }
powershell finds=stop_unknown | Get-Process notepad | % { Stop-Process -Id $_.Threads.Id }
powershell finds=stop_unknown | Get-Process notepad | % { Stop-Process -Id ($_.Parent.Id) }
powershell finds=stop_unknown | Get-Process notepad | % { Stop-Process -Id ($_.Id + 1) }
powershell finds=stop_unknown | Get-Process notepad | % { Stop-Process -Id $_.Id, $_.Parent.Id }
powershell finds=stop_system | Get-Process | % { Stop-Process ($_) }
powershell finds=stop_system | Get-Process | % { Stop-Process @($_) }
powershell finds=stop_system | Get-Process | % { Stop-Process -InputObject ($_) }
powershell finds=stop_system | Get-Process | % { Stop-Process -Id ($_.Id) }
powershell finds=stop_system | Get-Process | % { Stop-Process -Id $($_.Id) }
powershell finds=stop_system | Get-Process | % { Stop-Process -Id "$($_.Id)" }
powershell finds=stop_system | Get-Process | % { Stop-Process -Id ([int]$_.Id) }
# Not the item or one of its own members.
powershell finds=stop_unknown | Get-Process node | % { Stop-Process -Id (-not $_.Id) }
powershell finds=stop_unknown | Get-Process node | % { Stop-Process -Id ($_.Id + 1) }
powershell finds=stop_unknown | Get-Process node | % { Stop-Process -Id "1$($_.Id)" }
powershell finds=stop_unknown | Get-Process node | % { Stop-Process -Id ([int]$_.Parent.Id) }
powershell finds=stop_unknown | Get-Process node | % { Stop-Process -Id $(Get-Process explorer | % { $_.Id }) }

# No listing in them, so no listing finding, but a file's text is an id only
# known when it runs.
powershell finds=stop_unknown | Stop-Process -Id (Get-Content pid.txt)
powershell finds=stop_unknown | Stop-Process -Id (cat pid.txt | Select-Object -First 1)
powershell finds=stop_unknown | Stop-Process -Id (Foo (Get-Process explorer).Id)

# A method that stops a process (`Kill`, `CloseMainWindow`, WMI's
# `Terminate`) is judged like `Stop-Process` given the same object.
powershell safe | (Get-Process node).Kill()
powershell safe | (Get-Process -Name node).Kill()
powershell safe | (Get-Process node).Kill($true)
powershell safe | (Get-Process node | Select-Object -First 1).Kill()
powershell safe | (Get-Process node).CloseMainWindow()
powershell safe | Get-Process node | ForEach-Object { $_.Kill() }
powershell safe | Get-Process node | % { $_.Kill() }
powershell safe | Get-Process node | Foreach { $PSItem.Kill() }
powershell safe | Get-Process node | % Kill
powershell safe | Get-Process node | ForEach-Object Kill
powershell safe | Get-Process node | ForEach-Object -MemberName Kill
powershell safe | Get-Process node | % { $_.CloseMainWindow() }
powershell safe | Get-Process | Where-Object { $_.Name -like 'node' } | ForEach-Object { $_.Kill() }
powershell safe | Get-Process node | Where-Object CPU -gt 100 | % { $_.Kill() }
powershell safe | [System.Diagnostics.Process]::GetProcessById(1234).Kill()
powershell safe | [Diagnostics.Process]::GetProcessById(4242).Kill()
powershell safe | (Get-Process -Id 1234).Kill()
powershell safe | (Get-Process -Id $pid).Kill()
powershell safe | Get-Process node | % { $_.Name }
powershell safe | Get-CimInstance Win32_Process
powershell safe | Get-WmiObject Win32_Process
powershell safe | Get-CimInstance Win32_Process | Select-Object Name, ProcessId
powershell finds=stop_system | (Get-Process).Kill()
powershell finds=stop_system | (Get-Process explorer).Kill()
powershell finds=stop_system | (Get-Process node, explorer).Kill()
powershell finds=stop_unknown | (Get-Process | Where-Object CPU -gt 100).Kill()
# The array's `.ForEach('Kill')` is a line the grammar does not read, so it
# is risky for that.
powershell finds=unreadable | (Get-Process).ForEach('Kill')
powershell finds=unreadable | (Get-Process node).ForEach('Kill')
powershell finds=stop_system | (Get-Process).CloseMainWindow()
powershell finds=stop_system | Get-Process | ForEach-Object { $_.Kill() }
powershell finds=stop_system | Get-Process | % { $_.Kill() }
powershell finds=stop_system | Get-Process | Foreach { $_.Kill() }
powershell finds=stop_system | Get-Process | % Kill
powershell finds=stop_system | Get-Process | ForEach-Object Kill
powershell finds=stop_system | Get-Process | ForEach-Object -MemberName Kill
powershell finds=stop_system | Get-Process | % CloseMainWindow
powershell finds=stop_system | Get-Process | % { $_.CloseMainWindow() }
powershell finds=stop_system | Get-Process explorer | ForEach-Object { $_.Kill() }
powershell finds=stop_system | Get-Process explorer | % Kill
powershell finds=stop_unknown | Get-Process | Where-Object CPU -gt 100 | % { $_.Kill() }
# Not the process itself: its parent, or an item of a list.
powershell finds=stop_unknown | (Get-Process node).Parent.Kill()
powershell finds=stop_unknown | Get-Process node | % { $_.Parent.Kill() }
powershell finds=stop_unknown | (Get-Process node)[0].Kill()
powershell finds=stop_unknown | ((Get-Process node), $x).Kill()
# An object only known when it runs.
powershell finds=stop_unknown | $p.Kill()
powershell finds=stop_unknown | $proc.Kill($true)
powershell finds=stop_unknown | $p = Get-Process; $p.Kill()
powershell finds=stop_unknown | $procs | % { $_.Kill() }
powershell finds=stop_unknown | $procs | % Kill
powershell finds=stop_unknown | $procs.ForEach({ $_.Kill() })
powershell finds=stop_unknown | % { $_.Kill() }
powershell finds=stop_unknown | Get-Content pids.txt | % { (Get-Process -Id $_).Kill() }
# .NET's lists, and an id that is not written out in digits or is the
# group's or the system's own.
powershell finds=stop_unknown | [System.Diagnostics.Process]::GetProcesses() | % { $_.Kill() }
powershell finds=stop_unknown | [System.Diagnostics.Process]::GetProcessesByName('explorer').Kill()
powershell finds=stop_system | [System.Diagnostics.Process]::GetProcessById(0).Kill()
powershell finds=stop_system | [System.Diagnostics.Process]::GetProcessById(1).Kill()
powershell finds=stop_unknown | [System.Diagnostics.Process]::GetProcessById($id).Kill()
powershell finds=stop_unknown | [System.Diagnostics.Process]::GetProcessById(1234 + 0).Kill()
powershell finds=stop_system | (Get-Process -Id 0).Kill()
powershell finds=stop_unknown | (Get-Process -Id $id).Kill()
# WMI stops processes through a method.
powershell finds=stop_unknown | Get-CimInstance Win32_Process | Invoke-CimMethod -MethodName Terminate
powershell finds=stop_unknown | Get-CimInstance Win32_Process -Filter "name='node.exe'" | Invoke-CimMethod -MethodName Terminate
powershell finds=stop_unknown | Invoke-CimMethod -InputObject $p -MethodName terminate
powershell finds=stop_unknown | Get-WmiObject Win32_Process | Invoke-WmiMethod -Name Terminate
powershell finds=stop_unknown | Get-CimInstance Win32_Process | icim -MethodName Terminate
powershell finds=stop_unknown | Get-WmiObject Win32_Process | iwmi -Name Terminate
powershell finds=stop_unknown | Get-WmiObject Win32_Process | % { $_.Terminate() }
powershell finds=stop_unknown | (Get-WmiObject Win32_Process -Filter "name='explorer.exe'").Terminate()
powershell finds=stop_unknown | (Get-CimInstance Win32_Process -Filter "name='node.exe'").Terminate()

# An id written out in digits is a process the agent picked, and so is the
# shell's own `$PID`; 0 and 1 are the system's. An id only known when it
# runs, or one that is not an id, may be any process.
powershell safe | Stop-Process 1234
powershell safe | Stop-Process -Id 1234,5678
powershell safe | Stop-Process -Id 1234, 5678 -Force
powershell safe | Stop-Process -Id "1234"
powershell safe | Stop-Process -Id:1234
powershell safe | Stop-Process -Id 4
powershell safe | spps -Id 4242
powershell safe | kill 4242
powershell safe | kill -Id 4242
powershell safe | Get-Process -Id 1234 | Stop-Process
powershell safe | Get-Process -Id 12,13 | Stop-Process
powershell safe | Get-Process -Id 12,13 | % { $_.Kill() }
# The shell that runs the line.
powershell safe | Stop-Process -Id $PID
powershell safe | Stop-Process -Id $pid -Force
powershell safe | Stop-Process $PID
powershell safe | Get-Process -Id $PID | Stop-Process
powershell finds=stop_system | Stop-Process -Id 0
powershell finds=stop_system | Stop-Process 0
powershell finds=stop_system | Stop-Process -Id 00
powershell finds=stop_system | Stop-Process -Id "0"
powershell finds=stop_system | Stop-Process -Id 0 -Force
powershell finds=stop_system | Stop-Process -Id 1234,0
powershell finds=stop_system | Stop-Process -Id 0,1234
powershell finds=stop_system | kill 0
powershell finds=stop_system | kill -Id 0
powershell finds=stop_system | spps -Id 0
powershell finds=stop_system | Stop-Process -Id 1
powershell finds=stop_system | Stop-Process 1 -Force
powershell finds=stop_system | Get-Process -Id 0 | Stop-Process
powershell finds=stop_system | Get-Process -Id 1 | % { $_.Kill() }
powershell finds=stop_system | Get-Process -Id 1234,0 | kill
# A variable, a file's text and another cmdlet's listing.
powershell finds=stop_unknown | Stop-Process -Id $id
powershell finds=stop_unknown | Stop-Process $id
