powershell finds=stop_unknown | Stop-Process -Id '1234,5678'
powershell finds=stop_unknown | Stop-Process -Id $null
# The item of a block, when no `Get-Process` feeds it.
powershell finds=stop_unknown | $procs | % { Stop-Process $_ }
powershell finds=stop_unknown | Get-Content app.pid | % { Stop-Process -Id $_ }
powershell finds=stop_unknown | 1..3 | % { Stop-Process -Id $_ }
powershell finds=stop_unknown | Get-Content app.pid | Stop-Process
powershell finds=stop_unknown | Get-NetTCPConnection -LocalPort 3000 | Stop-Process
powershell finds=stop_unknown | % { Stop-Process -Id $_ }
# A listing by id takes the same ids.
powershell finds=stop_unknown | Get-Process -Id $id | Stop-Process
powershell finds=stop_unknown | Get-Process -Id (Get-Content app.pid) | Stop-Process
