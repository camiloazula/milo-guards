powershell finds=stop_unknown lacks=stop_system | taskkill /F /PID $id
powershell finds=stop_unknown lacks=stop_system | taskkill /IM $n
powershell finds=stop_unknown lacks=stop_system | taskkill /F /FI "PID eq $id"
powershell finds=stop_unknown lacks=stop_system | tskill $n
powershell finds=stop_unknown lacks=stop_system | $p.Kill()
powershell finds=stop_unknown lacks=stop_system | (Get-Process node).Parent.Kill()
powershell finds=stop_unknown lacks=stop_system | Get-Process | Where-Object CPU -gt 100 | Stop-Process
