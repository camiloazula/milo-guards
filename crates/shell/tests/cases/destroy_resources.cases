# No alias in cmd, nor on a POSIX shell (`Infrastructure` holds that case).
cmd finds=destroy_resources | sls remove

# The one finding of each line and the reason a prompt can show for it, for
# what it destroys or for the command only known when it runs.
posix rules=destroy_resources first=destroy_resources reason="deletes a namespace and everything in it" | kubectl delete namespace prod
posix rules=destroy_resources first=destroy_resources reason="removes unused containers, images and volumes" | docker system prune -af --volumes
posix rules=destroy_resources first=destroy_resources reason="removes unused containers, networks and images" | docker system prune
posix rules=destroy_resources first=destroy_resources reason="deletes volumes" | docker volume rm pgdata
posix rules=destroy_resources first=destroy_resources reason="removes containers chosen when it runs" | docker rm -f $(docker ps -aq)
posix rules=destroy_resources first=destroy_resources reason="deletes every object of a kind" | kubectl delete pods --all
posix rules=destroy_resources first=destroy_resources reason="deletes objects in every namespace" | kubectl delete pods -A
posix rules=destroy_resources first=destroy_resources reason="deletes cluster objects" | kubectl delete pod web
posix rules=destroy_resources first=destroy_resources reason="uninstalls a Helm release" | helm uninstall api
posix rules=destroy_resources first=destroy_resources reason="destroys the infrastructure a configuration manages" | terraform apply -destroy
posix rules=destroy_resources first=destroy_resources reason="terminates EC2 instances" | aws ec2 terminate-instances --instance-ids i-1
posix rules=destroy_resources first=destroy_resources reason="deletes AWS resources" | aws rds delete-db-instance --db-instance-identifier x
powershell rules=destroy_resources first=destroy_resources reason="deletes Azure resources" | Remove-AzResourceGroup -Name rg -Force
powershell rules=destroy_resources first=destroy_resources reason="deletes AWS resources" | Remove-EC2Instance -InstanceId i-1 -Force
powershell rules=destroy_resources first=destroy_resources reason="deletes Google Cloud resources" | Remove-GcsBucket -Name b -Force
powershell rules=destroy_resources first=destroy_resources reason="deletes Google Cloud resources" | Remove-GkeCluster -ClusterName c
powershell rules=destroy_resources first=destroy_resources reason="deletes AWS resources" | Remove-SecurityIRResourceTag -ResourceArn a -TagKey k
powershell rules=destroy_resources first=destroy_resources reason="deletes Microsoft Entra or Microsoft 365 objects" | Remove-MgUser -UserId u
posix rules=destroy_resources first=destroy_resources reason="deletes every object under a prefix" | aws s3 rm s3://b --recursive
posix rules=unknown first=unknown reason="runs a docker command only known when it runs" | docker $cmd ps
posix rules=unknown first=unknown reason="runs an aws command only known when it runs" | aws $service
posix rules=unknown first=unknown reason="runs an az command only known when it runs" | az $x
posix rules=unknown first=unknown reason="runs an oc command only known when it runs" | oc $x
posix rules=unknown first=unknown reason="runs an oci command only known when it runs" | oci $x
posix rules=unknown first=unknown reason="runs an eksctl command only known when it runs" | eksctl $x
posix rules=unknown first=unknown reason="runs an sst command only known when it runs" | sst $x
posix rules=unknown first=unknown reason="runs a gcloud command only known when it runs" | gcloud $x
posix rules=destroy_resources first=destroy_resources reason="removes containers chosen when it runs" | docker rm -f *
posix rules=destroy_resources first=destroy_resources reason="removes every container a search finds" | find ids -type f -exec docker rm -f {} +
posix rules=destroy_resources first=destroy_resources reason="removes images chosen when it runs" | docker rmi -f $(docker images -aq)
posix rules=destroy_resources first=destroy_resources reason="removes resources from the Terraform state" | terraform state rm aws_instance.web
posix rules=destroy_resources first=destroy_resources reason="deletes a Terraform workspace" | terraform workspace delete prod
posix rules=destroy_resources first=destroy_resources reason="deletes old images, builds or deployments" | oc adm prune images --confirm
posix rules=destroy_resources first=destroy_resources reason="stops a Nomad job and deletes it" | nomad job stop -purge web
posix rules=destroy_resources first=destroy_resources reason="wipes a Hetzner Cloud server's disk" | hcloud server rebuild web --image ubuntu-24.04
posix rules=destroy_resources first=destroy_resources reason="replaces data in a Firebase database" | firebase database:set / empty.json
posix rules=destroy_resources first=destroy_resources reason="takes a Firebase site offline" | firebase hosting:disable
posix rules=destroy_resources first=destroy_resources reason="deletes a GitHub repository, release or other object" | gh repo delete me/x --yes
posix rules=destroy_resources first=destroy_resources reason="deletes what a GitHub API call names" | gh api -X DELETE repos/me/x
posix rules=unknown first=unknown reason="calls the GitHub API with a method only known when it runs" | gh api -X "$METHOD" repos/me/x
posix rules=unknown first=unknown reason="runs a kubecolor command only known when it runs" | kubecolor $x
posix rules=unknown first=unknown reason="runs an s3cmd command only known when it runs" | s3cmd $x

# An option that destroys may be held in a value only known when it runs:
# one outside quotes may split into words, and a quoted one that starts
# with `-` is an option. The finding says what the program may do.
posix finds=destroy_resources reason="may delete every unused image with an option only known when it runs" | docker image prune $FLAGS
posix finds=destroy_resources | docker image prune "-$F"
posix finds=destroy_resources reason="removes unused containers, networks and images" | docker system prune $FLAGS
posix finds=destroy_resources reason="may delete a compose project's volumes with an option only known when it runs" | docker compose down $FLAGS
posix finds=destroy_resources reason="may destroy the infrastructure a configuration manages with an option only known when it runs" | terraform apply $TF_ARGS
posix finds=destroy_resources | terraform apply "-$F"
posix finds=destroy_resources | terraform apply "-${X:-destroy}"
posix finds=destroy_resources | aws s3 sync . s3://b $FLAGS
posix finds=destroy_resources reason="may delete cluster objects the files do not list with an option only known when it runs" | kubectl apply -f $FILE
posix finds=destroy_resources | kubectl apply -f x.yaml $FLAGS
posix finds=destroy_resources | kubectl replace -f x.yaml $FLAGS
posix finds=destroy_resources | oc adm prune images $FLAGS
posix finds=destroy_resources reason="may leave a swarm, even as its last manager, with an option only known when it runs" | docker swarm leave $FLAGS
posix finds=destroy_resources | podman kube play x.yaml $FLAGS
posix finds=destroy_resources | gsutil rsync $FLAGS a gs://b
posix finds=destroy_resources | nomad job stop $FLAGS web
posix finds=destroy_resources | terragrunt apply $FLAGS
posix safe | terraform apply "$PLAN"
posix safe | docker image prune "$F"
posix safe | kubectl apply -f "$FILE"
