posix safe | vercel pull --environment $E
posix safe | vercel promote $URL
posix safe | vercel redeploy $URL
posix safe | hcloud context use $C
posix safe | oci os object put -bn $B
posix safe | oci ce cluster create-kubeconfig --cluster-id $ID
posix safe | oci session authenticate --profile-name $P
posix safe | az storage blob upload -f $F -c c -n x
posix safe | az storage blob upload-batch -d c -s $DIR
posix safe | az storage blob download -c c -n x -f $F
posix safe | az storage blob download-batch -d $DIR -s c
posix safe | az acr build -r $R -t img .
posix safe | aws lambda invoke --function-name $F out.json
# A word only known when it runs, where a verb could be, is still unknown.
posix finds=unknown | heroku $verb
posix finds=unknown | wrangler kv:namespace $verb x
posix finds=unknown | gcloud compute $x instances
posix finds=unknown | gcloud run $verb web
# A verb that deletes is read behind an operand too.
posix finds=destroy_resources | heroku config:set FOO=$BAR; heroku apps:destroy x
posix finds=destroy_resources | gcloud compute instances delete $VM
posix finds=destroy_resources | gcloud storage cp $F gs://b/; gcloud storage rm gs://b/x
posix finds=destroy_resources | gcloud storage rsync $SRC gs://b --delete-unmatched-destination-objects
posix finds=destroy_resources | az storage blob upload -f $F -c c -n x; az group delete -n g -y

# A destroying command is found inside a shell's script, behind a wrapper, a
# path, an assignment, in a list or a pipeline, and when a package runner
# runs it; quoted or searched for, it is only text.
posix safe | echo 'docker system prune -af'
posix safe | echo kubectl delete namespace prod
posix safe | git commit -m 'terraform destroy'
posix safe | grep -r 'aws s3 rm' docs
posix safe | man docker
posix safe | docker ps -a | grep web
posix safe | kubectl get pods | grep delete
posix safe | terraform plan | tee plan.txt
posix safe | npx cdk diff
posix safe | pnpm dlx cdk synth
posix finds=destroy_resources | bash -c 'docker system prune -af'
posix finds=destroy_resources | sh -c "kubectl delete namespace prod"
posix finds=destroy_resources | env KUBECONFIG=x kubectl delete pod web
posix finds=destroy_resources | nohup terraform destroy -auto-approve &
posix finds=destroy_resources | time terraform destroy
posix finds=destroy_resources | cd infra && terraform destroy -auto-approve
posix finds=destroy_resources | terraform plan && terraform destroy -auto-approve
posix finds=destroy_resources | kubectl get ns -o name | xargs kubectl delete
posix finds=destroy_resources | /usr/local/bin/kubectl delete pod web
posix finds=destroy_resources | DOCKER_HOST=tcp://h:2375 docker system prune -af
posix finds=destroy_resources | for ns in a b; do kubectl delete namespace $ns; done
posix finds=destroy_resources | npx cdk destroy
posix finds=destroy_resources | pnpm dlx cdk destroy
posix finds=destroy_resources | bunx cdk destroy
posix finds=destroy_resources | npm exec -- cdk destroy
posix finds=destroy_resources | npx wrangler delete
posix finds=destroy_resources | npx sst remove

# It adds to what other rules find.
posix rules=elevated,destroy_resources | sudo docker system prune -af
posix rules=destroy_resources,delete | kubectl delete ns prod; rm -rf ~/x

# PowerShell and cmd.
powershell safe | docker ps
powershell safe | docker rm web
powershell safe | docker rm -f web
powershell safe | docker compose down
powershell safe | kubectl get pods
powershell safe | terraform plan
powershell safe | aws s3 ls
powershell safe | az group list
powershell finds=destroy_resources | docker system prune -af
powershell finds=destroy_resources | docker.exe system prune -af
powershell finds=destroy_resources | docker volume rm pgdata
powershell finds=destroy_resources | docker rm -f (docker ps -aq)
powershell finds=destroy_resources | docker rm -f $(docker ps -aq)
powershell finds=destroy_resources | docker compose down -v
powershell finds=destroy_resources | kubectl delete namespace prod
powershell finds=destroy_resources | kubectl.exe delete pod web
powershell finds=destroy_resources | helm uninstall api
powershell finds=destroy_resources | terraform destroy -auto-approve
powershell finds=destroy_resources | terraform apply -destroy
powershell finds=destroy_resources | aws s3 rm s3://prod-bucket --recursive
powershell finds=destroy_resources | aws.exe ec2 terminate-instances --instance-ids i-1
powershell finds=destroy_resources | gcloud projects delete prod
powershell finds=destroy_resources | az group delete --name rg --yes
powershell finds=destroy_resources | docker ps -aq | ForEach-Object { docker rm -f $_ }
cmd safe | docker ps
cmd safe | docker rm web
cmd safe | kubectl get pods
cmd safe | terraform plan
cmd finds=destroy_resources | docker system prune -af
cmd finds=destroy_resources | kubectl delete namespace prod
cmd finds=destroy_resources | terraform destroy -auto-approve
cmd finds=destroy_resources | aws s3 rm s3://prod-bucket --recursive
cmd finds=destroy_resources | docker volume rm %VOL%

# `sls` in PowerShell is `Select-String`: the alias wins over any program on
# the path, so this never runs serverless.
powershell safe | Get-Content app.log | sls remove
powershell safe | git log --oneline | sls remove
powershell safe | gci -r | sls "remove"
powershell safe | sls remove *.txt
powershell safe | sls -Pattern remove -Path *.txt
powershell safe | SLS remove
powershell effect=reads_workspace | Get-Content app.log | sls remove
powershell effect=reads_workspace | gci -r | sls "remove"
powershell effect=reads_workspace | sls remove *.txt
powershell effect=reads_workspace | sls -Pattern remove -Path *.txt
powershell effect=reads_workspace | SLS remove
# A program with an extension, or serverless itself, is still serverless.
powershell finds=destroy_resources | sls.cmd remove
powershell finds=destroy_resources | serverless remove
# No alias in cmd, nor on a POSIX shell (`Infrastructure` holds that case).
cmd finds=destroy_resources | sls remove

# The one finding of each line and the reason a prompt can show for it, for
# what it destroys or for the command only known when it runs.
posix rules=destroy_resources first=destroy_resources reason="deletes a namespace and everything in it" | kubectl delete namespace prod
posix rules=destroy_resources first=destroy_resources reason="removes unused containers, images and volumes" | docker system prune -af --volumes
posix rules=destroy_resources first=destroy_resources reason="removes unused containers, networks and images" | docker system prune
posix rules=destroy_resources first=destroy_resources reason="deletes volumes" | docker volume rm pgdata
posix rules=destroy_resources first=destroy_resources reason="removes containers chosen when it runs" | docker rm -f $(docker ps -aq)
posix rules=destroy_resources first=destroy_resources reason="deletes every object of a kind" | kubectl delete pods --all
posix rules=destroy_resources first=destroy_resources reason="deletes objects in every namespace" | kubectl delete pods -A
posix rules=destroy_resources first=destroy_resources reason="deletes cluster objects" | kubectl delete pod web
posix rules=destroy_resources first=destroy_resources reason="uninstalls a Helm release" | helm uninstall api
posix rules=destroy_resources first=destroy_resources reason="destroys the infrastructure a configuration manages" | terraform apply -destroy
posix rules=destroy_resources first=destroy_resources reason="terminates EC2 instances" | aws ec2 terminate-instances --instance-ids i-1
posix rules=destroy_resources first=destroy_resources reason="deletes AWS resources" | aws rds delete-db-instance --db-instance-identifier x
posix rules=destroy_resources first=destroy_resources reason="deletes every object under a prefix" | aws s3 rm s3://b --recursive
posix rules=unknown first=unknown reason="runs a docker command only known when it runs" | docker $cmd ps
posix rules=unknown first=unknown reason="runs an aws command only known when it runs" | aws $service
posix rules=unknown first=unknown reason="runs an az command only known when it runs" | az $x
posix rules=unknown first=unknown reason="runs an oc command only known when it runs" | oc $x
posix rules=unknown first=unknown reason="runs an oci command only known when it runs" | oci $x
posix rules=unknown first=unknown reason="runs an eksctl command only known when it runs" | eksctl $x
posix rules=unknown first=unknown reason="runs an sst command only known when it runs" | sst $x
posix rules=unknown first=unknown reason="runs a gcloud command only known when it runs" | gcloud $x
