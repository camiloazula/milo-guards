# Archives. Unpacking writes into a folder: the one an option names, or the
# working directory with none, judged like any write, in every shell and by
# every prefix of tar's long options; a mode only known when it runs may
# unpack. Archiving that deletes what it archives (`tar --remove-files`,
# `zip -m`, `7z a -sdel`) deletes its members, judged as `rm` judges its
# operands and with the reasons of `rm`; without such an option it deletes
# nothing. The format is in CONTRIBUTING.md.

# A home that is the working directory.
paths home_is_cwd cwd=/home/me home=/home/me workspace=/home/me/work/repo

# Unpacking an archive is judged by the folder it fills.
posix safe | tar -xf x.tar
posix safe | tar xf x.tar
posix safe | tar xzvf x.tgz
posix safe | tar -xzf x.tgz -C build
posix safe | tar -xf x.tar -C ./out/deps
posix safe | tar -xf x.tar -C .
posix safe | tar -xf x.tar --directory build
posix safe | tar --extract --file=x.tar --directory=build
posix safe | tar -xf x.tar -C /tmp/scratch
posix safe | tar -xf x.tar -C ~/work/repo/vendor
posix safe | tar -xf x.tar -C /home/me/work/repo
posix safe | tar -C build -xf x.tar
posix safe | tar -xOf x.tar notes.txt | head
posix safe | tar --to-stdout -xf x.tar notes.txt
posix safe | tar -cf x.tar src
posix safe | tar czf out.tgz -C ~/work/repo/src .
posix safe | tar -czf out.tgz -C ~ notes
posix safe | tar -tf x.tar
posix safe | tar tvf x.tar
posix safe | unzip x.zip
posix safe | unzip -o x.zip
posix safe | unzip x.zip -d build
posix safe | unzip -o x.zip -d build/deps
posix safe | unzip -qod build x.zip
posix safe | unzip -dbuild x.zip
posix safe | unzip -l x.zip
posix safe | unzip -p x.zip notes.txt | head
posix safe | unzip -c x.zip notes.txt
posix safe | unzip -t x.zip
posix safe | unzip -Z x.zip
posix safe | unzip -P secret x.zip -d build
posix safe | 7z x a.7z
posix safe | 7z x a.7z -obuild
posix safe | 7z x -obuild a.7z
posix safe | 7z e a.7z -o/tmp/scratch
posix safe | 7z l a.7z
posix safe | 7z a out.7z src
posix safe | 7z x a.7z -aoa
posix safe | cd build && tar -xf ../x.tar
# With no folder, into the working directory.
posix safe | cd build && tar -xf x.tar
posix safe | cd build && unzip x.zip
