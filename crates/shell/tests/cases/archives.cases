# tar takes any unique prefix of a long option. A prefix that is a flag to one
# tar and an option with a value to another takes no value: `--inc` is
# `--incremental` in GNU tar and `--include` in bsdtar, and `--mod` is
# `--mode` in GNU tar and the only prefix of `--modification-time` (`-m`) in
# bsdtar; the next argument is a member or an option.
posix safe | tar --cre -f x.tar -C ~ .
posix safe | tar --crea -f x.tar -C ~ .
posix safe | tar --lis -f x.tar -C ~
posix safe | tar --upd -f x.tar -C ~ .
posix safe | tar --app -f x.tar -C ~ .
posix safe | tar --dif -f x.tar -C ~
posix safe | tar --com -f x.tar -C ~
posix safe | tar --ext --to-stdout -f x.tar -C ~
posix safe | tar --ext --to-s -f x.tar -C ~
posix safe | tar --extr --to-std -f x.tar -C ~
posix safe | tar --ex -f x.tar -C ~
posix safe | tar --one-file-system -f x.tar -C ~
posix safe | tar --ext -f x.tar -C build
posix safe | tar --ext --dir build -f x.tar
posix safe | tar --ext --one-top=build -f x.tar
posix safe | tar -cf x.tar --inc src --remove-files
posix finds=overwrite | tar --ext -f x.tar -C ~
posix finds=overwrite | tar --extr -f x.tar -C ~
posix finds=overwrite | tar --extra -f x.tar -C ~
posix finds=overwrite | tar --extrac -f x.tar -C ~
posix finds=overwrite | tar --ext -C ~ -f x.tar
posix finds=overwrite | tar --ext -f x.tar --dir ~
posix finds=overwrite | tar --ext -f x.tar --one-top=~
posix finds=overwrite | tar --ext -f x.tar --one-top-level=~
posix finds=overwrite | bsdtar --ext -f x.tar -C ~
posix finds=overwrite | gtar --extr -f x.tar -C /etc
posix finds=overwrite | tar --ext -f x.tar -C "$d"
posix finds=delete | gtar -cf x.tar --inc ~ --remove-files
posix finds=delete | tar -cf x.tar --incremental ~ --remove-files
posix finds=overwrite | tar -xf x.tar --inc -C /etc
posix finds=overwrite | gtar -xf x.tar --inc -C /etc
posix finds=overwrite | tar -xf x.tar --mod -C /etc
posix finds=overwrite | bsdtar -xf x.tar --mod -C /etc
posix finds=overwrite | tar -xpf x.tar --mod -C ~

# tar with a mode only known when it runs may unpack. One outside quotes
# may split into words, `--remove-files` among them.
posix safe | tar -czf "$out" -C ~ .
posix safe | tar -cf "$out" -C ~ "$file"
posix safe | tar -tf "$a" -C ~
posix safe | tar "$mode" -f x.tar -C build
posix finds=delete | tar $mode -f x.tar -C .
posix safe | tar "$mode" -f x.tar -O -C ~
posix safe | tar --create -f "$out" -C ~ .
posix safe | tar -xf x.tar "$file"
posix finds=overwrite | tar "$mode" -f x.tar -C ~
posix finds=overwrite | tar $mode -C ~
posix finds=overwrite | tar -f x.tar $mode -C ~
posix finds=overwrite | tar -f x.tar -C ~ "-$mode"
posix finds=overwrite | tar "$mode" -f x.tar -C /usr/local
posix finds=overwrite | tar $(echo xf) x.tar -C ~
posix finds=overwrite | cd ~ && tar $mode x.tar

# `tar --remove-files` deletes the members it archives, read from where each
# `-C` moves; members only known when it runs, from a list or from a mode
# only known when it runs may be anything. Members inside the workspace, and
# packing without the option, stay safe.
posix safe | tar -cf x.tar *
posix safe | tar -cf x.tar src --remove-files
posix safe | tar -czf x.tgz src docs --remove-files
posix safe | tar --remove-files -cf x.tar src/a.txt
posix safe | tar -cf x.tar -C src . --remove-files
posix safe | tar -cf x.tar -C ~/work/repo/build out --remove-files
posix safe | tar -cf x.tar -C /tmp/scratch . --remove-files
posix safe | tar -cf x.tar /tmp/scratch/a --remove-files
