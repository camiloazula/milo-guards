posix finds=delete | tar "$mode" -f x.tar ~ --remove-files
posix finds=delete | tar $mode -f x.tar src --remove-files
posix finds=delete | ls | xargs tar -rf x.tar --remove-files
posix finds=delete | ls ~ | xargs tar -rf x.tar --remove-files

