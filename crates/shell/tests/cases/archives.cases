# The options zip reads to find the archive and its members.
posix safe | zip -m -x'*.o' x.zip src
posix safe | zip -m -xb x.zip src
posix safe | zip -m -x=b x.zip src
posix safe | zip -m --exclude=b x.zip src
posix safe | zip -m --exc=b x.zip src
posix safe | zip -mr -x'*.o' x.zip src
# A bare `-x` keeps the names after it out of the members.
posix safe | zip -m x.zip src -x ~
posix safe | zip -m x.zip src --exclude ~ ~
posix safe | zip -m x.zip src -x ~ @
posix safe | zip -m x.zip -x b @ src
posix safe | zip -m -db x.zip src
posix safe | zip -dbm x.zip src
posix safe | zip -mr x.zip src -li
posix safe | zip -mr x.zip src -li keep
posix safe | zip -mr --logfile-path log x.zip src
posix safe | zip -mr --logfile-path=log x.zip src
posix safe | zip -m -UN warn x.zip src
posix safe | zip -m --unicode warn x.zip src
posix safe | zip -m x.zip src -x "$X" '*.o'
# `-xpat`, `-x=pat`, `--exclude=pat` and `-ipat` are one value; the archive's
# name and the members after them stay operands.
posix finds=delete | zip -m -x'*.o' x.zip ~
posix finds=delete | zip -mr -x'*.o' x.zip ~
posix finds=delete | zip -m -xb x.zip ~
posix finds=delete | zip -m -x=b x.zip ~
posix finds=delete | zip -m --exclude=b x.zip ~
posix finds=delete | zip -m --exc=b x.zip ~
posix finds=delete | zip -m -mx'*.o' x.zip ~
posix finds=delete | zip -m -i'*.c' x.zip ~
posix finds=delete | zip -m -i=b x.zip ~
posix finds=delete | zip -m --include=b x.zip ~
posix finds=delete | zip -m --include=b x.zip ~ -x b
posix finds=delete | zip -m -xb x.zip src ~
posix finds=delete | zip -m -xb -m x.zip ~
posix finds=delete | zip -m --exclude=b -- x.zip ~
# A bare one still opens a list that swallows what follows.
posix finds=delete | zip -m x.zip ~ -x b
posix finds=delete | zip -m x.zip ~ --exclude b
# `@` ends an exclude or include list.
posix finds=delete | zip -m -x b @ x.zip ~
posix finds=delete | zip -m x.zip -x b @ ~
posix finds=delete | zip -m x.zip src -x b @ ~
posix finds=delete | zip -m x.zip -x b c @ ~
posix finds=delete | zip -m x.zip --exclude b @ ~
posix finds=delete | zip -m x.zip -i b @ ~
posix finds=delete | zip -m x.zip -i b @ ~ -x c
posix finds=delete | zip -m -x b @ x.zip src ~
# Two-letter flags ending in `b` or `s` take no value; the single letters
# still take theirs.
posix finds=delete | zip -m -db x.zip ~
posix finds=delete | zip -m -sb x.zip ~
posix finds=delete | zip -m -ws x.zip ~
posix finds=delete | zip -dbm x.zip ~
posix finds=delete | zip -sbm x.zip ~
posix finds=delete | zip -r -dbm x.zip ~
posix finds=delete | zip -mdb x.zip ~
posix finds=delete | zip -mwsr x.zip ~
# `-li` is a flag and opens no include list.
posix finds=delete | zip -mr x.zip src -li ~
posix finds=delete | zip -m x.zip src -rli ~
posix finds=delete | zip -mr x.zip src -lli ~
# A long option takes a value only when zip has it by that name.
posix finds=delete | zip -mr --unzip-command cmd x.zip ~
posix finds=delete | zip -mr --logfile-path log x.zip ~
posix finds=delete | zip -mr --test x.zip ~
# A value attached to its option ends the bundle.
posix finds=delete | zip -m -lfout x.zip ~
posix finds=delete | zip -m -n.dat x.zip ~
posix finds=delete | zip -m -n.mat x.zip ~
posix finds=delete | zip -m -s1t x.zip ~
posix finds=delete | zip -m -s1x x.zip ~ src
# `-UN` (`--unicode`) takes `q`, `w`, `i`, `n` or a word; its last letter
# must not be read as `-n`, which would take the archive's name.
posix finds=delete | zip -m -UN=warn x.zip ~
posix finds=delete | zip -m -UN=n x.zip ~
posix finds=delete | zip -UNwarn -m x.zip ~
posix finds=delete | zip -mUNn x.zip ~
posix finds=delete | zip -m --unicode warn x.zip ~
# A variable can be a switch or `@`, which zip ends a list at, so the names
# after it are operands again.
posix finds=delete | zip -m x.zip src -x "$X" ~
posix finds=delete | zip -m x.zip src -x $X ~
posix finds=delete | zip -m x.zip -x "$X" ~
posix finds=delete | zip -mr x.zip src -x "$X" /etc
posix finds=delete | zip -m x.zip src --exclude "$X" ~
posix finds=delete | zip -m x.zip src -i "$X" ~

# `7z a -sdel` (and `u`) deletes the members it archives. With no name after
# the archive's it packs, and deletes, everything in the folder; a switch
# with a value only known when it runs starts with `-` and is no operand.
posix safe | 7z a x.7z src
posix safe | 7z a x.7z *
posix safe | 7z a x.7z src -sdel
posix safe | 7z a -sdel x.7z src
posix safe | 7z u x.7z src/a.txt -sdel
posix safe | 7z a x.7z *.log -sdel
posix safe | 7z a x.7z src -sdel -x!~
posix safe | 7z l x.7z ~ -sdel
posix safe | 7z x a.7z -sdel
posix safe | 7z d x.7z ~ -sdel
posix safe | 7z a x.7z src -tzip -mx9
# A name or an `-i` switch says what to pack; so do commands that do not add.
posix safe | 7z a x.7z -sdel -i!src
posix safe | 7z a x.7z -sdel -ir!src
posix safe | 7z a x.7z
posix safe | 7z a x.7z -x!keep
posix safe | 7z a -sdel
posix safe | 7z l x.7z -sdel
posix safe | 7z x x.7z -sdel
posix safe | 7z d x.7z -sdel
posix safe | 7z a -p"$PASS" x.7z src -sdel
posix finds=delete | 7z a x.7z ~ -sdel
posix finds=delete | 7z a -sdel x.7z ~
posix finds=delete | 7z a x.7z -sdel ~
posix finds=delete | 7z u x.7z ~ -sdel
posix finds=delete | 7z a x.7z ~ -SDEL
posix finds=delete | 7z A x.7z ~ -sdel
posix finds=delete | 7z a x.7z * -sdel
posix finds=delete | 7z a x.7z '*' -sdel
posix finds=delete | 7z a x.7z . -sdel
posix finds=delete | 7z a x.7z .git -sdel
posix finds=delete | 7z a x.7z '*git' -sdel
posix finds=delete | 7z a x.7z /etc -sdel -r
posix finds=delete | 7z a x.7z ../other-project -sdel
posix finds=delete | 7z a x.7z src ~ -sdel
posix finds=delete | 7z a -tzip -mx9 x.zip ~ -sdel
posix finds=delete | 7z a x.7z ~ -x!'*.o' -sdel
posix finds=delete | 7z a x.7z @list.txt -sdel
posix finds=delete | 7z a x.7z -i!~ -sdel
posix finds=delete | 7z a x.7z -ir!/etc/* -sdel
posix finds=delete | 7z a x.7z -ir0!/etc/* -sdel
posix finds=delete | 7z a x.7z -i@list.txt -sdel
posix finds=delete | 7z a x.7z "$DIR" -sdel
posix finds=delete | 7z $CMD x.7z ~ -sdel
posix finds=delete | 7za a x.7z ~ -sdel
posix finds=delete | 7zr a x.7z ~ -sdel
posix finds=delete | 7zz a x.7z ~ -sdel
posix finds=delete | ls | xargs 7z a x.7z -sdel
posix finds=delete | sudo 7z a x.7z /etc -sdel
posix finds=delete | cd ~ && 7z a x.7z * -sdel
# No name: everything in the folder.
posix finds=delete | cd ~ && 7z a -sdel x.7z
posix finds=delete | cd ~ && 7z u -sdel x.7z
posix finds=delete | 7z a x.7z -sdel -i!~
posix finds=delete | 7z a x.7z -sdel -i@list.txt
# A switch with a value only known when it runs.
posix finds=delete | 7z a -p"$PASS" x.7z -sdel
posix finds=delete | 7z a -sdel -p"$PASS" x.7z
posix finds=delete | 7z a -x!"$SKIP" x.7z -sdel
posix finds=delete | 7z a -sdel -mx="$LEVEL" backup.7z
posix finds=delete | 7z a -t"$FMT" -sdel out.7z
posix finds=delete | 7z a -w"$T" x.7z -sdel
posix finds=delete | 7z a $OPTS x.7z -sdel
posix finds=delete | 7z a "$OPTS" x.7z -sdel
posix finds=delete | 7z a x.7z -i"$PAT" -sdel
posix finds=delete | 7z a x.7z -i!"$PAT" -sdel

# `7z -sdel` on Windows.
powershell safe | 7z a x.7z src -sdel
powershell safe | 7z x a.7z -sdel
powershell safe | 7z a -sdel x.7z src
powershell finds=delete | 7z a x.7z ~ -sdel
powershell finds=delete | 7z a x.7z $HOME -sdel
powershell finds=delete | 7z a x.7z C:\\Users\\me -sdel
powershell finds=delete | 7z a x.7z C:\\Windows -sdel
powershell finds=delete | 7z a x.7z * -sdel
powershell finds=delete | 7z a x.7z $dir -sdel
powershell finds=delete | 7z a -sdel x.7z
powershell finds=delete | 7z u x.7z -sdel
powershell finds=delete | cd ~; 7z a -sdel x.7z
cmd safe | 7z a x.7z src -sdel
cmd safe | 7z a x.7z C:\\Windows
cmd safe | 7z a -sdel x.7z src
cmd finds=delete | 7z a x.7z C:\\Windows -sdel
cmd finds=delete | 7z a x.7z %USERPROFILE% -sdel
cmd finds=delete | 7z a x.7z * -sdel
cmd finds=delete | 7z a -sdel x.7z
cmd finds=delete | 7z u x.7z -sdel -x!keep
cmd finds=delete | cd %USERPROFILE% && 7z a -sdel x.7z
cmd finds=delete | 7z a -sdel -p%PW% x.7z

# Archiving that deletes is judged from the machine's home.
posix@macos safe | tar -cf x.tar src --remove-files
posix@macos safe | zip -mr x.zip src
posix@macos finds=delete | tar -cf x.tar ~ --remove-files
posix@macos finds=delete | tar -cf x.tar /Users/me --remove-files
posix@macos finds=delete | zip -mr x.zip /Users/me
posix@macos finds=delete | 7z a x.7z /Applications -sdel

# Packing the home folder reads the keys in it (`read_secret`), but with no
# option that deletes what it archives it is no `delete`. `7z a` adds a named
# folder with everything under it, so it reads the keys in the home as well;
# that read is not judged yet (a followup), so its cases are held only to "no
# `delete`", not to safe.
posix finds=read_secret lacks=delete | tar -cf x.tar ~
posix finds=read_secret lacks=delete | tar -rf x.tar ~
posix finds=read_secret lacks=delete | zip -r x.zip ~
posix finds=read_secret lacks=delete | tar -tf x.tar ~ --remove-files
posix finds=read_secret lacks=delete | zip -r x.zip ~ --no-dir-entries
posix finds=read_secret lacks=delete | zip -r -s100m x.zip ~
posix finds=read_secret lacks=delete | zip -r -n.mp3 x.zip ~
posix finds=read_secret lacks=delete | zip -r -ds10m x.zip ~
posix finds=read_secret lacks=delete | zip -r -lfmain.log x.zip ~
posix lacks=delete | 7z a x.7z ~
powershell lacks=delete | 7z a x.7z ~\s

# The delete of each archiver gives the reason `rm -rf` gives for the same
# members; with no name, `7z` packs `*`. Each `rm -rf` line is held to that
# reason too: here, or in `posix.cases` for `rm -rf ~`, `*`, `.git` and
# `/etc`.
posix finds=delete reason="deletes the whole workspace" | rm -rf .
posix finds=delete reason="deletes a path outside the workspace" | rm -rf ~/notes
posix finds=delete reason="deletes a system folder" | rm -rf /etc/passwd
posix finds=delete reason="deletes a path only known when it runs" | rm -rf "$DIR"
posix finds=delete reason="deletes your home directory" | cd ~ && rm -rf *
posix finds=delete reason="deletes your home directory" | tar -cf x.tar ~ --remove-files
posix finds=delete reason="deletes the whole workspace" | tar -cf x.tar * --remove-files
posix finds=delete reason="deletes the whole workspace" | tar -cf x.tar . --remove-files
posix finds=delete reason="deletes the repository's history" | tar -cf x.tar .git --remove-files
posix finds=delete reason="deletes a path outside the workspace" | tar -cf x.tar -C ~ notes --remove-files
posix finds=delete reason="deletes a system folder" | tar -cf x.tar -C /etc passwd --remove-files
posix finds=delete reason="deletes a path only known when it runs" | tar -cf x.tar "$DIR" --remove-files
posix finds=delete reason="deletes your home directory" | cd ~ && tar -cf x.tar * --remove-files
posix finds=delete reason="deletes your home directory" | zip -mr x.zip ~
posix finds=delete reason="deletes the whole workspace" | zip -mr x.zip *
posix finds=delete reason="deletes the whole workspace" | zip -mr x.zip .
posix finds=delete reason="deletes a system folder" | zip -mr x.zip /etc
posix finds=delete reason="deletes a path only known when it runs" | zip -mr x.zip "$DIR"
posix finds=delete reason="deletes your home directory" | 7z a x.7z ~ -sdel
posix finds=delete reason="deletes the whole workspace" | 7z a x.7z * -sdel
posix finds=delete reason="deletes the whole workspace" | 7z a x.7z . -sdel
posix finds=delete reason="deletes a system folder" | 7z a x.7z /etc -sdel
posix finds=delete reason="deletes the whole workspace" | 7z a -sdel x.7z
posix finds=delete reason="deletes the whole workspace" | 7z a x.7z -sdel -x!keep
posix finds=delete reason="deletes the whole workspace" | 7za a -sdel x.7z
posix finds=delete reason="deletes the whole workspace" | 7z u -sdel x.7z
posix finds=delete reason="deletes the whole workspace" | 7z a x.7z -sdel -r

# The rules give a reason a prompt can show (the reason of `tar
# --remove-files` on the home is above).
posix finds=overwrite reason="unpacks into your home directory" | tar -xf x.tar -C ~
posix finds=overwrite reason="unpacks into a system folder" | unzip x.zip -d /etc
posix finds=overwrite reason="unpacks into a folder outside the workspace" | tar -xf x.tar -C ../x
posix finds=overwrite reason="unpacks into a folder only known when it runs" | tar -xf x.tar -C "$D"
