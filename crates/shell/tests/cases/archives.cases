posix finds=delete | tar -cf x.tar /etc --remove-files
posix finds=delete | tar -cf x.tar / --remove-files
posix finds=delete | tar -cf x.tar src ~ --remove-files
posix finds=delete | tar -cf x.tar ~ src --remove-files
posix finds=delete | tar -cf x.tar --exclude=a ~ --remove-files
posix finds=delete | tar -cf x.tar --exclude a ~ --remove-files
posix finds=delete | tar -cf x.tar --exclude ~ ~ --remove-files
posix finds=delete | tar -cf x.tar --sparse ~ --remove-files
posix finds=delete | tar -cf x.tar --checkpoint ~ --remove-files
posix finds=delete | tar -cf x.tar -z ~ --remove-files
posix finds=delete | tar -cvf x.tar ~ --remove-files
