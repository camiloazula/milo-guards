posix finds=overwrite | tar xf x.tar -C ~
posix finds=overwrite | tar -xzf x.tgz -C ~
posix finds=overwrite | tar -xzf x.tgz -C /usr/local
posix finds=overwrite | tar -xf x.tar -C /
