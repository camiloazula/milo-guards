posix safe | tar -cf x.tar --exclude ~ src --remove-files
posix safe | tar -cf x.tar --exclude-from ~/skip.txt src --remove-files
posix safe | tar -cf x.tar --transform 's,^,pre/,' src --remove-files
posix safe | tar -cf x.tar --sparse src --remove-files
posix safe | tar -cf x.tar --checkpoint src --remove-files
posix safe | tar -cf x.tar --remove-files --file-not-an-option src
posix safe | tar -xf x.tar --remove-files
posix safe | tar -xf x.tar notes --remove-files
posix safe | tar -cf x.tar -C src a --remove-files
posix safe | tar -cf x.tar -C build -C out . --remove-files
posix safe | tar -cf x.tar a -C ~ --remove-files
posix finds=delete | tar -cf x.tar ~ --remove-files
posix finds=delete | tar -cf x.tar ~/ --remove-files
posix finds=delete | tar -cf x.tar $HOME --remove-files
posix finds=delete | tar cf x.tar ~ --remove-files
posix finds=delete | tar --remove-files -cf x.tar ~
posix finds=delete | tar -czf x.tgz ~ --remove-files
posix finds=delete | tar -rf x.tar ~ --remove-files
posix finds=delete | tar -uf x.tar ~ --remove-files
posix finds=delete | tar --create --file=x.tar ~ --remove-files
posix finds=delete | tar --create --file x.tar ~ --remove-files
posix finds=delete | tar --append -f x.tar ~ --remove-files
posix finds=delete | tar --update -f x.tar ~ --remove-files
posix finds=delete | tar -cf x.tar ~ --remove
posix finds=delete | tar -cf x.tar ~ --rem
posix finds=delete | tar -cf x.tar ~ --remove-files=ignored
