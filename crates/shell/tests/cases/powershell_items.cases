powershell finds=delete | New-PSDrive -Name Q -PSProvider $p -Root HKLM:\\SOFTWARE; Remove-Item Q:\\x
powershell finds=delete | New-PSDrive -Name $n -PSProvider Registry -Root HKLM:\\SOFTWARE; Remove-Item C:\\Users\\me\\dev\\repo\\x
