powershell safe | Get-ChildItem -s -Filter *.rs | Select-String x
powershell safe | gci -s src | Clear-Item
powershell safe | Get-ChildItem -ar src | Rename-Item -NewName x
powershell safe | Get-ChildItem -Name src | Select-String x
powershell safe | Start-Process cmd -ar x
powershell safe | Remove-Item -s x
powershell finds=delete | Get-ChildItem -File ~ | Rename-Item -NewName x
powershell finds=delete | Get-ChildItem -File ~\\Downloads | Rename-Item -NewName { $_.Name -replace " ","_" }
powershell finds=delete | ls -File ~ | Rename-Item -NewName x
powershell finds=delete | dir -File C:\\Windows | ren -NewName x
powershell finds=system_settings | Get-ChildItem -File HKCU:\\Software | Rename-Item -NewName x
powershell finds=overwrite | Get-ChildItem -File ~ | Clear-Item
powershell finds=delete | Get-ChildItem -File ~ | Move-Item -Destination old
powershell finds=delete | Get-ChildItem -File ~ | ForEach-Object { Rename-Item $_ x }
powershell finds=delete | Get-ChildItem -File ~ | ForEach-Object { Move-Item $_ old }
powershell finds=delete | Get-ChildItem ~ -File | Rename-Item -NewName x
powershell finds=delete | Get-ChildItem -File:$true ~ | Rename-Item -NewName x
powershell finds=system_settings | gci -s HKCU:\\Software | Clear-Item
powershell finds=system_settings | gci -s HKCU:\\Software | Rename-Item -NewName x
powershell finds=system_settings | gci -s HKCU:\\Software -Filter x | Clear-Item
powershell finds=system_settings | Get-ChildItem -ar HKCU:\\Software | Set-Item -Value 1
powershell finds=delete | Get-ChildItem -s C:\\Windows | Move-Item -Destination old
powershell finds=delete | Get-ChildItem -ar C:\\Windows | Rename-Item -NewName { $_.Name + 'x' }
powershell finds=delete | Get-ChildItem -s C:\\Windows -Filter *.log | Remove-Item
powershell finds=delete | dir -s C:\\Windows -Filter *.log | Remove-Item
powershell finds=delete | gci -ar C:\\Windows -Filter *.log | Remove-Item
powershell finds=delete | gci -s .. -Filter *.rs | Remove-Item
powershell finds=delete | gci -Name C:\\Windows | Remove-Item
powershell finds=delete | gci -n C:\\Windows -Filter *.log | Remove-Item

# The aliases of `-LiteralPath` name the item.
powershell safe | Rename-Item src\\y -LP src\\x
powershell safe | Rename-Item y -PSPath src\\x
powershell safe | Set-ItemProperty y -LP src\\x -Value 1
powershell finds=delete | Rename-Item y -PSPath $p
powershell finds=delete | Rename-Item y -LP $p
powershell finds=delete | Rename-Item y -psp C:\\Windows\\x
powershell finds=delete | Rename-Item y -LP (Get-Item C:\\Windows\\x)
powershell finds=delete | Rename-Item y -LP C:\\Windows\\x
powershell finds=system_settings | Rename-Item y -PSPath HKCU:\\Software\\x
powershell finds=system_settings | Clear-ItemProperty y -PSPath HKCU:\\Software\\x
powershell finds=system_settings | Rename-ItemProperty y -PSPath HKCU:\\Software\\x -NewName z
powershell finds=system_settings | Set-ItemProperty y -LP HKCU:\\Software\\x -Value 1
powershell finds=system_settings | Clear-ItemProperty y -LP HKCU:\\Software\\x

# A splat hides which argument is the item: it may bind any parameter, the
# item or the destination among them; an array or a hashtable written out is
# not a splat.
powershell safe | Rename-Item src\\y z
powershell safe | Copy-Item src\\a src\\b
powershell safe | Copy-Item -Path src\\a -Destination src\\b @p
powershell safe | Copy-Item @('src\\a','src\\b') dist
powershell safe | Copy-Item @(Get-ChildItem src\\*.rs) dist
powershell finds=delete | Rename-Item y @p
powershell finds=delete | Rename-Item y @args
powershell finds=delete | Rename-Item @p y
powershell finds=overwrite | Clear-ItemProperty y @p
powershell finds=overwrite | Rename-ItemProperty y @p
powershell finds=overwrite | Copy-Item @p
powershell finds=overwrite | Copy-Item @p -Force
powershell finds=overwrite | cp @p
powershell finds=overwrite | Copy-Item @args
powershell finds=overwrite | Copy-Item @p src\\hosts
powershell finds=overwrite | Copy-Item @p src\\a
powershell finds=overwrite | Copy-Item src\\a @p
powershell finds=overwrite | $p = @{ Path = 'src\\hosts'; Destination = 'C:\\Windows\\System32\\drivers\\etc\\hosts'; Force = $true }; Copy-Item @p
powershell finds=overwrite | Copy-Item @p dist

# A common parameter before the path does not hide it, and one after the
