powershell finds=delete reason="deletes a path only known when it runs" | New-PSDrive -Name W -PSProvider FileSystem -Root C:\\Users\\me\\dev\\repo; Remove-Item W:\\x
powershell finds=delete | New-PSDrive -Name C -PSProvider FileSystem -Root C:\\Windows; Remove-Item C:\\Users\\me\\dev\\repo\\x
