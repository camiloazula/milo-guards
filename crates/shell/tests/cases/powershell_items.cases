powershell finds=delete | Set-Item -Path Env:CD -Value C:\\Users\\me; cmd /c "rd /s /q %CD%\\.ssh"
powershell finds=delete | $env:TEMP = 'C:\\Users\\me'; cmd /c "rd /s /q %TEMP%\\.ssh"
powershell safe | cmd /c "rd /s /q %TEMP%\\x"
# A read of the drives, or a change of another item, changes no place.
powershell safe | if (Test-Path Env:CI) { $c = 1 }; Remove-Item -Recurse -Force "$env:TEMP\\build"
powershell safe | Get-ChildItem Env:; Remove-Item -Recurse "$env:TEMP\\x"
powershell safe | Get-Content Env:PATH; New-Item -ItemType Directory "$env:LOCALAPPDATA\\Temp\\x"
powershell safe | Get-ChildItem Variable:; Remove-Item -Recurse "$HOME\\dev\\repo\\build"
powershell safe | Remove-Item Env:FOO; Remove-Item -Recurse "$env:TEMP\\x"
powershell safe | Set-Item Env:FOO $x; Remove-Item -Recurse "$env:TEMP\\x"
powershell finds=delete | Set-Item Env:T[E]MP ~; Remove-Item -Recurse "$env:TEMP\\x"
# So does one a program reads as its arguments or its command: by a pattern,
# by the new name of a rename, or by a plain name after a `cd` to `Env:`.
powershell safe | Set-Item Env:FOO x; npx
powershell finds=unknown | Set-Item Env:npm_config_* x; npx
powershell finds=unknown | Rename-Item Env:FOO npm_config_call; npx
powershell finds=unknown | cd Env:; Set-Item npm_config_call x; npx
powershell finds=unknown | cd Env:; Set-Item ZIPOPT -Value '-m'; zip -qr x.zip src

# `Temp:` is the user's temporary folder, a drive of the file system.
powershell safe | Remove-Item Temp:\\scratch -Recurse
