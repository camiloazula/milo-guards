# A shortened `-FilePath` is not read as the `-File` switch: `-File`, `-Fil`
# and `-Fi` are a switch only for a listing; for every other cmdlet they
# abbreviate `-FilePath` (or `-Filter`), which takes a value, so the path or
# program that follows is still judged when a value parameter the guard does
# not know comes before it.
powershell finds=overwrite | Tee-Object -InputObject a -File ~\\.bashrc
powershell finds=overwrite | Tee-Object -InputObject a -Fil ~\\.bashrc
powershell finds=overwrite | Tee-Object -InputObject a -File ~\\.bashrc -Append
powershell finds=overwrite | Tee-Object -InputObject a -Append -File ~\\.bashrc
powershell finds=overwrite | 'x' | Tee-Object -InputObject a -File ~\\.bashrc
powershell finds=overwrite | Tee-Object -InputObject a -File C:\\Windows\\System32\\drivers\\etc\\hosts
powershell finds=overwrite | Out-File -InputObject a -File ~\\.bashrc
powershell finds=overwrite | Out-File -InputObject a -Fil ~\\.bashrc
powershell finds=overwrite | Out-File -InputObject a -Fi ~\\.bashrc
powershell finds=overwrite | Out-File -Encoding utf8 -InputObject a -File ~\\.bashrc
powershell finds=delete | Start-Process -WindowStyle Hidden -File cmd.exe -ArgumentList '/c rd /s /q C:\\'
powershell finds=delete | Start-Process -WindowStyle Hidden -Fi cmd.exe -ArgumentList '/c rd /s /q C:\\'
powershell finds=delete | saps -WindowStyle Hidden -File cmd.exe -ArgumentList '/c rd /s /q C:\\'
powershell finds=delete | start -WindowStyle Hidden -File cmd.exe -ArgumentList '/c rd /s /q C:\\'
powershell finds=delete | Start-Process -WindowStyle Hidden -File cmd.exe '/c rd /s /q C:\\'
powershell finds=delete | Start-Process -File cmd.exe -ArgumentList '/c rd /s /q C:\\'
powershell finds=delete | Start-Process -RedirectStandardOutput o.txt -File cmd.exe -ArgumentList '/c rd /s /q C:\\'
powershell finds=permissions | Set-Acl -Fil x ~\\.ssh $a
