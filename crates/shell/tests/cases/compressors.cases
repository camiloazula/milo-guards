# Compressors. A compressor run on a file deletes that file and writes the
# compressed one beside it (`gzip x` writes `x.gz`), and decompressing does
# the reverse (`gunzip x.gz` writes `x`): the file it deletes is judged as
# `rm` judges its operands, and the file it writes as any write, so beyond
# the workspace, a startup file or a protected one is `delete` or
# `overwrite`. `-c` (`--stdout`) writes to the screen, `-t` and `-l` test
# and list, and `-k` (`--keep`) keeps the file. `zstd`, `lz4`, `lzop` and
# `brotli` keep it unless `--rm` (`lzop -U`, `brotli -j`) says not to. The
# same lines inside the workspace are safe. The format is in
# CONTRIBUTING.md.

# A compressor deletes the file it is given and writes the one it makes.
posix finds=delete,overwrite | gzip ~/.bashrc
posix finds=delete reason="deletes a shell startup file" | xz ~/.bashrc
posix finds=delete,overwrite | bzip2 ~/.bashrc
posix finds=delete,overwrite | zstd --rm ~/.bashrc
posix finds=delete,overwrite | lz4 --rm ~/.bashrc
posix finds=delete,overwrite | compress ~/.bashrc
posix finds=delete,overwrite | zstdmt --rm ~/.bashrc
posix finds=delete,overwrite | lz4c --rm ~/.bashrc
posix rules=overwrite | zstdmt ~/.bashrc
posix safe | zstdmt --rm src/a.txt
posix safe | lz4c --rm src/a.txt
posix finds=delete,overwrite | pigz ~/.bashrc
posix finds=delete,overwrite | lzma ~/.bashrc
posix finds=delete,overwrite | lzip ~/.bashrc
posix finds=delete,overwrite | lzop -U ~/.bashrc
posix finds=delete,overwrite | lzop --unlink ~/.bashrc
posix finds=delete,overwrite | brotli -j ~/.bashrc
posix finds=delete,overwrite | brotli --rm ~/.bashrc
posix finds=delete,overwrite | gzip -9 ~/notes.txt
posix finds=delete,overwrite | gzip -- ~/notes.txt
posix finds=delete,overwrite | cd ~ && gzip notes.txt
posix finds=delete,overwrite | gzip -f /etc/hosts
posix finds=delete,overwrite | xz -T 4 ~/notes.txt
posix finds=delete | gzip ~/*
posix finds=delete,overwrite | gzip "$f"
posix finds=delete | gzip .git/config
posix safe | gzip src/a.txt
posix safe | gzip -9 src/a.txt
posix safe | xz src/a.txt
posix safe | bzip2 src/a.txt
posix safe | zstd --rm src/a.txt
posix safe | lz4 --rm src/a.txt
posix safe | compress src/a.txt
posix safe | gzip /tmp/a.txt
posix safe | gzip *.log
posix safe | xz -T 4 src/a.txt

# Writing to the screen, testing and listing write nothing; keeping the file
# still writes the compressed one.
posix safe | gzip -c ~/.bashrc
posix safe | gzip --stdout ~/.bashrc
posix safe | gzip --to-stdout ~/.bashrc
posix safe | xz -dc ~/x.xz
posix safe | zstd -c ~/x
posix safe | gzip -t ~/x.gz
posix safe | gzip -l ~/x.gz
posix safe | xz --list ~/x.xz
posix safe | zstd -t ~/x.zst
posix safe | xz -z -t ~/.bashrc
posix safe | zstd -d -l ~/x.zst
posix safe | gzip
posix safe | gzip -
posix safe | zcat ~/x.gz
posix first=overwrite lacks=delete reason="writes to a file outside the workspace" | gzip -k ~/.bashrc
posix rules=overwrite | gzip --keep ~/.bashrc
posix rules=overwrite | xz -k ~/.bashrc
posix rules=overwrite | bzip2 -k ~/.bashrc
posix safe | gzip -k src/a.txt

# zstd, lz4, lzop and brotli keep the file unless told not to; the file they
# write is judged still.
posix rules=overwrite | zstd ~/.bashrc
posix rules=overwrite | lz4 ~/.bashrc
posix rules=overwrite | lzop ~/.bashrc
posix rules=overwrite | brotli ~/.bashrc
posix safe | zstd src/a.txt
posix safe | lz4 src/a.txt
posix safe | brotli src/a.txt
posix finds=delete reason="may delete a path outside the workspace with an option only known when it runs" | zstd "--$X" ~/notes.txt
posix finds=delete,overwrite | zstd $OPTS ~/notes.txt

# The last mode given wins: a `-z` or `-d` after `-t` or `-l` compresses or
# decompresses, and deletes. One only known when it runs after it may.
posix finds=delete,overwrite | xz -t -z ~/.bashrc
posix finds=delete,overwrite | bzip2 -tz ~/.bashrc
posix finds=delete,overwrite | zstd -l -z --rm ~/.bashrc
posix finds=delete,overwrite | zstd -t -d --rm ~/.bashrc.zst
posix finds=delete,overwrite | xz -ld ~/.bashrc.xz
posix finds=delete,overwrite | xz -t --decompress ~/x.xz
posix finds=delete,overwrite | xz --test --compress ~/x
posix rules=overwrite | lz4 -t -z ~/x ~/.bashrc
posix finds=delete reason="may delete a shell startup file with an option only known when it runs" | xz -t "-$M" ~/.bashrc
posix safe | xz "-$M" -t ~/.bashrc
posix safe | xz -t -z src/a.txt
posix safe | zstd -t -d --rm src/a.txt.zst

# Decompressing deletes the compressed file and writes the one it held,
# which may be a startup file.
posix finds=delete,overwrite | gunzip ~/x.gz
posix finds=overwrite reason="writes to a shell startup file" | gunzip ~/.bashrc.gz
posix finds=overwrite reason="writes to a shell startup file" | gzip -d ~/.bashrc.gz
posix finds=overwrite reason="writes to a shell startup file" | gzip --decompress ~/.bashrc.gz
posix finds=overwrite reason="writes to a shell startup file" | gzip --decomp ~/.bashrc.gz
posix finds=overwrite reason="writes to a shell startup file" | unxz ~/.bashrc.xz
posix finds=overwrite reason="writes to a shell startup file" | bunzip2 ~/.bashrc.bz2
posix finds=overwrite reason="writes to a shell startup file" | zstd -d ~/.bashrc.zst
posix finds=overwrite reason="writes to a shell startup file" | unzstd ~/.bashrc.zst
posix finds=overwrite reason="writes to a shell startup file" | uncompress ~/.bashrc.Z
posix finds=overwrite reason="writes to a shell startup file" | xz -d -S .bak ~/.bashrc.bak
posix finds=overwrite | gunzip .envrc.gz
posix finds=delete,overwrite | gunzip .git/hooks/pre-commit.gz
posix finds=overwrite | gunzip -S .bak .envrc.bak
posix finds=overwrite | bunzip2 ~/x
posix safe | gunzip src/x.gz
posix safe | gunzip x.tgz
posix safe | gzip -d -c ~/.bashrc.gz

# The file named to write, a folder to write into and a suffix are judged
# where they land.
posix first=overwrite lacks=delete reason="writes to a shell startup file" | zstd -o ~/.bashrc src/a.txt
posix rules=overwrite | zstd -d -o /etc/hosts x.zst
posix rules=overwrite | zstd --output-dir-flat ~ src/a.txt
posix first=overwrite lacks=delete reason="writes to a shell startup file" | zstd -d --output-dir-flat ~ src/.bashrc.zst
posix rules=overwrite | lzip -o ~/x src/a.txt
posix rules=overwrite | lzop -p ~ src/a.txt
posix rules=overwrite | brotli -o ~/x.br src/a.txt
posix first=overwrite lacks=delete reason="writes to a shell startup file" | lz4 src/a.txt ~/.bashrc
posix rules=overwrite | lz4 -d x.lz4 /etc/hosts
posix safe | lz4 -m src/a.txt src/b.txt
posix safe | lz4 src/a.txt out.lz4
posix safe | zstd -o out.zst src/a.txt
posix safe | zstd -d -o out < x.zst
posix safe | lz4 -d - out < x.lz4
posix safe | zstd -o - src/a.txt
posix safe | zstd -D ~/dict src/a.txt
posix first=overwrite reason="writes to a shell startup file" | gzip -k -S rc ~/.bash
posix finds=overwrite | gzip -k -S rc src/.env
posix safe | gzip -S .bak src/a.txt
posix finds=overwrite reason="may write to a file only known when it runs with an option only known when it runs" | zstd "-$L" src/a.txt

# A file `-o` names is written also when the compressor reads its input
# (no file, or `-`), and also when `-c` comes before it.
posix finds=overwrite reason="writes to a shell startup file" | zstd -d -o ~/.bashrc < x.zst
posix finds=overwrite reason="writes to a shell startup file" | echo x | zstd -o ~/.bashrc
posix finds=overwrite reason="writes to a shell startup file" | zstd -o ~/.bashrc -
posix finds=overwrite reason="writes to a shell startup file" | lz4 -d - ~/.bashrc < x.lz4
posix finds=overwrite reason="writes to a shell startup file" | brotli -d -o ~/.bashrc < x.br
posix finds=overwrite reason="writes to a shell startup file" | lzip -d -o ~/.bashrc < x.lz
posix finds=overwrite reason="writes to a shell startup file" | lzop -d -o ~/.bashrc < x.lzo
posix first=overwrite lacks=delete reason="writes to a shell startup file" | zstd -c -o ~/.bashrc x
posix rules=delete | zstd -c -o out --rm ~/x
posix finds=overwrite reason="writes to a shell startup file" | brotli -o ~/.bashrc -c x
posix safe | zstd -c -o out x
posix safe | brotli -d -o out < x.br
posix safe | lz4 -c x out
posix finds=overwrite reason="writes to a file only known when it runs" | zstd --output-dir-flat "$D" src/a

# A folder given to `-r` has every file in it compressed.
posix finds=delete reason="deletes your home directory" | gzip -r ~
posix finds=overwrite reason="writes into your home directory" | gzip -r ~
posix safe | gzip -r src

# Files from a list, or from the stage before, may be anywhere.
posix finds=delete,overwrite | xz --files=list.txt
posix finds=delete,overwrite | zstd --rm --filelist list.txt
posix finds=delete,overwrite | find ~ -name '*.log' | xargs gzip
posix finds=delete | ls | xargs gzip

# `pixz` deletes the file it compresses unless `-k` keeps it, and ignores
# `-c`; it writes `x.tar` as `x.tpxz` and any other name with `.xz` added,
# keeps the file when a second operand names the one it writes, and `-t`
# only says the input is no tarball. `-l` lists and `-x` extracts to the
# screen, and write nothing but the file `-o` names.
posix finds=delete,overwrite | pixz ~/.bashrc
posix finds=delete reason="deletes a shell startup file" | pixz -c ~/.bashrc
posix finds=delete,overwrite | pixz -t ~/.bashrc
posix finds=delete,overwrite | pixz -9 ~/x.tar
posix finds=delete,overwrite | pixz -p 4 ~/notes.txt
posix rules=overwrite | pixz -k ~/.bashrc
posix first=overwrite lacks=delete reason="writes to a shell startup file" | pixz src/a.txt ~/.bashrc
posix finds=overwrite reason="writes to a shell startup file" | pixz -d ~/.bashrc.xz
posix finds=delete,overwrite | pixz -d ~/x.tpxz
posix finds=overwrite reason="writes to a shell startup file" | pixz -d -i x.xz -o ~/.bashrc
posix finds=overwrite reason="writes to a shell startup file" | pixz -o ~/.bashrc < x
posix finds=overwrite reason="writes to a shell startup file" | pixz -l -o ~/.bashrc x.tpxz
posix safe | pixz src/a.tar
posix safe | pixz -t src/a.txt
posix safe | pixz src/a.txt out.xz
posix safe | pixz ~/notes.txt out.xz
posix safe | pixz -d -i ~/x.xz -o out
posix safe | pixz -l ~/x.tpxz
posix safe | pixz -x dir/file < ~/x.tpxz
posix safe | pixz < ~/x > out.xz

# `bzip3` keeps the file unless `--rm` says not to, writes `x.bz3`, and
# writes a second operand also with `-c`; `-r` recovers, which decompresses,
# and `-B` makes every operand an input.
posix rules=overwrite | bzip3 ~/.bashrc
posix first=delete reason="deletes a shell startup file" | bzip3 --rm ~/.bashrc
posix finds=delete,overwrite | bzip3 --rm ~/notes.txt
posix finds=overwrite reason="writes to a shell startup file" | bzip3 -d ~/.bashrc.bz3
posix finds=overwrite reason="writes to a shell startup file" | bzip3 -r ~/.bashrc.bz3
posix finds=overwrite reason="writes to a shell startup file" | bzip3 --decode ~/.bashrc.bz3
posix first=overwrite lacks=delete reason="writes to a shell startup file" | bzip3 src/a.txt ~/.bashrc
posix first=overwrite lacks=delete reason="writes to a shell startup file" | bzip3 -c src/a.txt ~/.bashrc
posix finds=overwrite reason="writes to a shell startup file" | bzip3 -d -c src/x.bz3 ~/.bashrc
posix rules=overwrite | bzip3 -B src/a.txt ~/x
posix rules=overwrite | bzip3 -j 4 -b 16 ~/notes.txt
posix safe | bzip3 src/a.txt
posix safe | bzip3 --rm src/a.txt
posix safe | bzip3 src/a.txt out.bz3
posix safe | bzip3 -B src/a.txt src/b.txt
posix safe | bzip3 -c ~/.bashrc
posix safe | bzip3 -t ~/x.bz3
posix safe | bzip3 -d -c ~/.bashrc.bz3

# `zopfli` keeps the file and writes `x.gz` (`.zlib` with `--zlib`,
# `.deflate` with `--deflate`) beside it, or to the screen with `-c`; it
# reads only whole options, so `-vc` is none it knows, and every word that
# starts with `-` is an option to it.
posix rules=overwrite | zopfli ~/.bashrc
posix first=overwrite reason="writes to a file outside the workspace" | zopfli --zlib ~/x
posix rules=overwrite | zopfli -vc ~/.bashrc
posix rules=overwrite | zopfli --i50 ~/notes.txt
posix safe | zopfli -c ~/.bashrc
posix safe | zopfli src/a.txt
posix safe | zopfli --deflate --i50 src/a.txt
posix finds=overwrite | zopfli "--$f" ~/x
posix safe | zopfli "--$f" src/a.txt
posix finds=overwrite | zopfli -- -c ~/x

# In PowerShell and cmd, `gzip` is the same program; `compress` there is
# Windows' own.
powershell finds=delete,overwrite | gzip C:\\Users\\me\\notes.txt
cmd finds=delete,overwrite | gzip C:\\Users\\me\\notes.txt
cmd safe | gzip src\\a.txt
cmd safe | compress -r src\\a.txt out

# Windows' `compress` writes its last operand, a file or a folder, and keeps
# the files it compresses; with `-r` and no destination it writes each file
# beside itself, the last letter of its extension made `_`.
cmd first=overwrite lacks=delete reason="writes to a system folder" | compress.exe -r src C:\\Windows\\x
cmd finds=overwrite | compress src\\a.txt C:\\Windows\\a.tx_
cmd finds=overwrite | compress -r -d -z src\\*.dll C:\\Windows
cmd finds=overwrite | compress -r C:\\Windows\\x.dll
cmd finds=overwrite | compress -r %USERPROFILE%\\x.txt
cmd finds=overwrite | compress /r src\\a.txt C:\\Windows\\x
cmd finds=overwrite reason="writes to a file only known when it runs" | compress -r src\\a.txt %OUT%
powershell finds=overwrite | compress.exe -r src C:\\Windows\\x
powershell finds=overwrite | compress -zx src\\a.txt $env:windir\\a.tx_
cmd safe | compress src\\a.txt out.tx_
cmd safe | compress -r src\\a.txt
cmd safe | compress -r -zx src\\*.txt build
powershell safe | compress.exe -r src build
