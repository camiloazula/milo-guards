# Inline code that starts a program: the options of the call (`cwd`,
# `executable`, `shell`), Python library calls that run code, every call of
# `execa` and `cross-spawn`, a spread in the call, members of a function that
# starts a program, `os.kill` and `process.kill` of a literal id, the
# members of `child_process` that run what the reader does not read,
# `asyncio.subprocess`, a string handed to a timer, the words a program is
# started with in either quoting, and an environment given to a started
# program. The format is in CONTRIBUTING.md.

# Inline code that starts a program is judged like the program.
# The options of a call that starts a program are read.
posix finds=delete | python3 -c "import subprocess; subprocess.run(['rm','-rf','x'], cwd='/home/me')"
posix finds=delete | python3 -c "import subprocess; subprocess.run('rm -rf .ssh', shell=True, cwd='/home/me')"
posix finds=delete | python3 -c "import os, subprocess; subprocess.run(['rm','-rf','.ssh'], cwd=os.path.expanduser('~'))"
posix finds=delete | python3 -c "import subprocess; subprocess.Popen('rm -rf .ssh', shell=True, cwd='/home/me')"
posix finds=delete | python3 -c "import subprocess; subprocess.run(['x','-rf','/home/me'], executable='/bin/rm')"
# A directory or a program only known when it runs.
posix finds=unknown | python3 -c "import subprocess; subprocess.run(['rm','-rf','x'], cwd=d)"
posix finds=unknown | python3 -c "import subprocess; subprocess.run(['ls'], cwd=d)"
posix finds=unknown | python3 -c "import subprocess; subprocess.run(['x'], executable=e)"
posix finds=unknown | python3 -c "import subprocess; subprocess.run('x', shell=True, executable='/usr/bin/python3')"
posix finds=unknown | python3 -c "import subprocess; subprocess.run(['ls'], **options)"
posix finds=unknown | python3 -c "import subprocess; subprocess.run(['x'], -1, '/bin/rm')"
posix finds=delete | node -e "require('child_process').execSync('rm -rf .ssh', {cwd: '/home/me'})"
posix finds=delete | node -e "require('child_process').spawnSync('rm', ['-rf','.ssh'], {cwd: process.env.HOME})"
posix finds=delete | node -e "const {spawnSync} = require('child_process'); spawnSync('rm', ['-rf','.ssh'], {cwd: process.env.HOME})"
posix finds=delete | node -e "require('child_process').execFileSync('rm', ['-rf','.ssh'], {cwd: '/home/me'})"
posix finds=delete | node -e "require('child_process').spawn('rm -rf .ssh', {shell: true, cwd: '/home/me'})"
posix finds=delete | bun -e 'Bun.spawnSync(["rm", "-rf", ".ssh"], {cwd: "/home/me"})'
posix finds=delete | bun -e 'Bun.spawn({cmd: ["rm", "-rf", ".ssh"], cwd: "/home/me"})'
posix finds=delete | deno eval 'Deno.run({cmd: ["rm", "-rf", ".ssh"], cwd: "/home/me"})'
posix finds=delete | deno eval 'new Deno.Command("rm", {args: ["-rf", ".ssh"], cwd: "/home/me"}).outputSync()'
posix finds=delete | bun -e 'Bun.$`rm -rf .ssh`.cwd("/home/me")'
posix finds=delete | bun -e 'await Bun.$`rm -rf .ssh`.quiet().cwd("/home/me")'
# A directory, options or a shell only known when it runs.
posix finds=unknown | node -e "require('child_process').execSync('rm -rf .ssh', {cwd: dir})"
posix finds=unknown | node -e "require('child_process').execSync('ls', {cwd})"
posix finds=unknown | node -e "require('child_process').execSync('ls', {...options})"
posix finds=unknown | node -e "require('child_process').execSync('ls', {[key]: '/home/me'})"
posix finds=unknown | node -e "require('child_process').execSync('ls', options)"
posix finds=unknown | node -e "require('child_process').spawnSync('git', ['status'], options)"
posix finds=unknown | node -e "require('child_process').spawnSync('git', options)"
posix finds=unknown | node -e "require('child_process').execSync(\\"import os; os.remove('/home/me/.zshrc')\\", {shell: 'python3'})"
posix finds=unknown | node -e "require('child_process').execSync('x', {shell: sh})"
posix finds=unknown | bun -e 'Bun.$.cwd("/home/me"); Bun.$`rm -rf .ssh`'
# Not read whole by the strict gate: unknown.
posix finds=unknown | python3 -c "import subprocess; subprocess.run(['ls'], cwd='/home/me')"
posix finds=unknown | python3 -c "import subprocess; subprocess.run(['cargo', 'build'], cwd='sub')"
posix finds=unknown | python3 -c "import subprocess; subprocess.run(['rm', '-rf', 'build'], cwd='/home/me/work/repo')"
posix finds=unknown | python3 -c "import subprocess; subprocess.run(['rm', '-rf', 'build'], cwd=None)"
posix finds=unknown | python3 -c "import subprocess; subprocess.run('cargo test', shell=True, cwd='sub')"
posix finds=unknown | python3 -c "import subprocess; subprocess.run(['x', '/tmp'], executable='/bin/ls')"
posix finds=unknown | python3 -c "import os, subprocess; subprocess.run(['ls'], cwd=os.getcwd())"
posix finds=unknown | node -e "require('child_process').execSync('ls', {cwd: '/home/me'})"
posix finds=unknown | node -e "require('child_process').execSync('npm test', {cwd: 'sub'})"
posix finds=unknown | node -e "require('child_process').execSync('npm test', {cwd: undefined})"
posix finds=unknown | node -e "require('child_process').execSync('echo hi', {shell: '/bin/bash'})"
posix finds=unknown | node -e "require('child_process').execSync('echo hi', {shell: true})"
posix finds=unknown | node -e "require('child_process').spawnSync('git', ['status'], {cwd: 'sub'})"
posix finds=unknown | node -e "require('child_process').execFile('ls', ['a'], (e) => {})"
posix finds=unknown | node -e "require('child_process').exec('ls', (e) => {})"
posix finds=unknown | bun -e 'Bun.spawnSync(["ls"], {cwd: "/home/me"})'
# An environment written out whole, with nothing the shell side judges: not
# read whole by the strict gate, unknown.
posix finds=unknown | python3 -c "import subprocess; subprocess.run(['ls'], env={'LANG': 'C'})"
posix finds=unknown | node -e "require('child_process').spawnSync('ls', [], {env: {LANG: 'C'}})"
posix finds=unknown | python3 -c "import subprocess; subprocess.run(['ls'])"
# Python library calls that run code are read or unknown. A callable is
# walked where it is written, a literal is read. (`json` is a file looked up
# in the folder first: unknown.)
posix finds=unknown | python3 -c 'import json; json.loads("{}")'
posix finds=delete | python3 -c 'import timeit; timeit.timeit("import shutil; shutil.rmtree(\\"/home/me\\")", number=1)'
posix finds=delete | python3 -c 'import timeit; timeit.timeit(stmt="import shutil; shutil.rmtree(\\"/home/me\\")")'
posix finds=delete | python3 -c 'import timeit; timeit.timeit("pass", setup="import shutil; shutil.rmtree(\\"/home/me\\")")'
posix finds=delete | python3 -c 'import timeit; timeit.repeat("import shutil; shutil.rmtree(\\"/home/me\\")")'
posix finds=delete | python3 -c 'import timeit; timeit.Timer("import shutil; shutil.rmtree(\\"/home/me\\")").timeit()'
posix finds=delete | python3 -c 'from timeit import timeit as t; t("import shutil; shutil.rmtree(\\"/home/me\\")")'
posix finds=delete | python3 -c 'import cProfile; cProfile.run("import shutil; shutil.rmtree(\\"/home/me\\")")'
posix finds=delete | python3 -c 'import cProfile; cProfile.runctx("import shutil; shutil.rmtree(\\"/home/me\\")", {}, {})'
posix finds=delete | python3 -c 'import profile; profile.run("import shutil; shutil.rmtree(\\"/home/me\\")")'
posix finds=unknown | python3 -c 'import pdb; pdb.run("import shutil; shutil.rmtree(\\"/home/me\\")")'
posix finds=unknown | python3 -c 'import pdb; pdb.runeval("__import__(\\"shutil\\").rmtree(\\"/home/me\\")")'
# Code only known when it runs, a profiler's or a debugger's own object, and
# a call handed on.
posix finds=unknown | python3 -c 'import timeit; timeit.timeit(s)'
posix finds=unknown | python3 -c 'import timeit; timeit.timeit(stmt=s)'
posix finds=unknown | python3 -c 'import timeit; timeit.timeit("x", setup=s)'
posix finds=unknown | python3 -c 'import timeit; timeit.timeit(*a)'
posix finds=unknown | python3 -c 'import cProfile; cProfile.run(s)'
posix finds=unknown | python3 -c 'import profile; profile.runctx(s, g, l)'
posix finds=unknown | python3 -c 'import pdb; pdb.run(s)'
posix finds=unknown | python3 -c 'import pdb; pdb.runcall(f)'
posix finds=unknown | python3 -c 'import cProfile; cProfile.Profile().run("import shutil; shutil.rmtree(\\"/home/me\\")")'
posix finds=unknown | python3 -c 'import cProfile; p = cProfile.Profile(); p.runctx(s, g, l)'
posix finds=unknown | python3 -c 'import timeit; f = timeit.timeit; f(s)'
