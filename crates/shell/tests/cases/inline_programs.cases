posix finds=unknown | python3 -c 'import pickle; pickle.loads(b"cposix\\nsystem\\n(S\\"rm -rf ~\\"\\ntR.")'
posix finds=unknown | python3 -c 'import pickle; pickle.load(f)'
posix finds=unknown | python3 -c 'from pickle import loads; loads(data)'
posix finds=unknown | python3 -c 'import marshal; marshal.loads(data)'
posix finds=unknown | python3 -c 'import marshal; marshal.load(f)'
posix finds=unknown | python3 -c 'import pkgutil; pkgutil.resolve_name("shutil:rmtree")("/home/me")'
posix finds=unknown | python3 -c 'import importlib.util as u; s = u.spec_from_file_location("m", "m.py"); m = u.module_from_spec(s); s.loader.exec_module(m); m.rmtree("/home/me")'
posix finds=unknown | python3 -c 'import importlib.util; m = importlib.util.module_from_spec(spec)'
posix finds=unknown | python3 -c 'spec.loader.exec_module(m)'
posix finds=unknown | python3 -c 'loader.load_module("m")'
# Not read whole by the strict gate: unknown.
posix finds=unknown | python3 -c 'import timeit; timeit.timeit(lambda: sum(range(10)), number=1)'
posix finds=unknown | python3 -c 'import timeit; timeit.timeit("sum(range(10))", number=1)'
posix finds=unknown | python3 -c 'import timeit; timeit.timeit("x = 1", setup="import os")'
posix finds=unknown | python3 -c 'import timeit; timeit.repeat("x = 1", repeat=2)'
posix finds=unknown | python3 -c 'import timeit; timeit.Timer("x = 1")'
posix finds=unknown | python3 -c 'import cProfile; cProfile.run("sum(range(10))")'
posix finds=unknown | python3 -c 'import profile; profile.run("sum(range(10))")'
# `asyncio.subprocess` starts programs.
posix finds=delete | python3 -c "import asyncio.subprocess as s; s.create_subprocess_shell('rm -rf ~')"
posix finds=delete | python3 -c "from asyncio.subprocess import create_subprocess_shell as c; c('rm -rf ~')"
posix finds=delete | python3 -c "from asyncio import subprocess as sp; sp.create_subprocess_shell('rm -rf ~')"
posix finds=delete | python3 -c "import asyncio; asyncio.subprocess.create_subprocess_exec('rm','-rf','/home/me')"
# Every call of execa that runs a command is read.
posix finds=delete | node -e "require('execa').execaCommand('rm -rf ~')"
posix finds=delete | node -e "require('execa').command('rm -rf ~')"
posix finds=delete | node -e "require('execa').commandSync('rm -rf ~')"
posix finds=delete | node -e "const {command} = require('execa'); command('rm -rf ~')"
posix finds=delete | node --input-type=module -e "import execa from 'execa'; execa.command('rm -rf ~')"
# `$`, as a call and as a tagged template, and its `.sync`.
posix finds=delete | node --input-type=module -e 'import {$} from "execa"; await $`rm -rf /home/me`'
posix finds=delete | node --input-type=module -e 'import {$} from "execa"; await $("rm -rf /home/me")'
posix finds=delete | node --input-type=module -e 'import {$} from "execa"; $.sync`rm -rf /home/me`'
posix finds=delete | node -e 'const {$} = require("execa"); $.sync`rm -rf /home/me`'
posix finds=delete | node -e 'require("execa").$`rm -rf /home/me`'
# A command only known when it runs.
posix finds=unknown | node --input-type=module -e 'import {$} from "execa"; await $`ls ${x}`'
# cross-spawn: `spawn` and `sync` are `child_process`'s.
posix finds=delete | node -e "require('cross-spawn').sync('rm', ['-rf', '/home/me'])"
posix finds=delete | node -e "require('cross-spawn').spawn('rm', ['-rf', '/home/me'])"
posix finds=delete | node -e "const spawn = require('cross-spawn'); spawn.sync('rm', ['-rf', '/home/me'])"
posix finds=delete | node --input-type=module -e "import spawn from 'cross-spawn'; spawn.sync('rm', ['-rf', '/home/me'])"
# The module itself is the spawn: bare, through a name (any declaration, or a
# later assignment), as a default import, and as the namespace's `default`.
posix finds=delete | node -e "require('cross-spawn')('rm', ['-rf', '/home/me'])"
posix finds=delete | node -e "const spawn = require('cross-spawn'); spawn('rm', ['-rf', '/home/me'])"
posix finds=delete | node -e "var spawn = require('cross-spawn'); spawn('rm', ['-rf', '/home/me'])"
posix finds=delete | node -e "let spawn = require('cross-spawn'); spawn('rm', ['-rf', '/home/me'])"
posix finds=delete | node -e "let spawn; spawn = require('cross-spawn'); spawn('rm', ['-rf', '/home/me'])"
posix finds=delete | node --input-type=module -e "import spawn from 'cross-spawn'; spawn('rm', ['-rf', '/home/me'])"
posix finds=delete | node --input-type=module -e "import {default as spawn} from 'cross-spawn'; spawn('rm', ['-rf', '/home/me'])"
posix finds=delete | node --input-type=module -e "import * as cs from 'cross-spawn'; cs.default('rm', ['-rf', '/home/me'])"
posix finds=delete | node -e "require('execa')('rm', ['-rf', '/home/me'])"
# The module handed on as a value stays unknown.
posix finds=unknown | node -e "run(require('cross-spawn'))"
posix finds=unknown | node -e "const spawn = require('cross-spawn'); run(spawn)"
# Not read whole by the strict gate: unknown.
posix finds=unknown | node -e "require('execa').command('ls -l')"
posix finds=unknown | node -e "require('execa').commandSync('ls')"
posix finds=unknown | node --input-type=module -e 'import {$} from "execa"; await $`ls`'
posix finds=unknown | node --input-type=module -e 'import {$} from "execa"; $.sync`git status`'
posix finds=unknown | node -e "require('cross-spawn').sync('ls', ['-l'])"
posix finds=unknown | node -e "require('cross-spawn').spawn('ls')"
posix finds=unknown | node -e "const spawn = require('cross-spawn'); spawn.sync('ls')"
posix finds=unknown | node -e "require('cross-spawn')('ls')"
posix finds=unknown | node -e "const spawn = require('cross-spawn'); spawn('ls', ['-l'])"
posix finds=unknown | node --input-type=module -e "import spawn from 'cross-spawn'; spawn('ls')"
# A spread in a call that starts a program is not read: it may hold the
# program, its arguments or its options, and may come before any of them, so
# the call is code the guard does not read, as `fork` with one already was.
# Without a spread the same calls are read.
posix finds=delete | node -e "const {spawn} = require('child_process'); spawn('rm', ['-rf', '/home/me'])"
posix finds=unknown | node -e "const {spawn} = require('child_process'); spawn(...['rm', ['-rf', '/home/me']])"
posix finds=unknown | node -e "const {spawnSync} = require('child_process'); const a = ['rm', ['-rf', '/home/me']]; spawnSync(...a)"
# The spread after the program is read as a bare `rm`.
posix finds=unknown | node -e "const {execFileSync} = require('child_process'); execFileSync('rm', ...[['-rf', '/home/me']])"
posix finds=unknown | node -e "const {execa} = require('execa'); execa(...['rm', ['-rf', '/home/me']])"
posix finds=unknown | node -e "const {execa} = require('execa'); execa('rm', ...[['-rf', '/home/me']])"
posix finds=unknown | node -e "const spawn = require('cross-spawn'); spawn(...['rm', ['-rf', '/home/me']])"
posix finds=unknown | node -e "const spawn = require('cross-spawn'); [['rm', ['-rf', '/home/me']]].forEach(a => spawn(...a))"
posix finds=unknown | node -e "new Deno.Command(...['rm', {args: ['-rf', '/home/me']}])"
posix finds=unknown | node -e "const a = ['rm', {args: ['-rf', '/home/me']}]; new Deno.Command(...a)"
# Not read whole by the strict gate: unknown. A spread inside the list of
# arguments is a word of the list.
posix finds=unknown | node -e "const {spawn} = require('child_process'); spawn('ls', ['-l'])"
posix finds=unknown | node -e "const {execa} = require('execa'); execa('ls', ['-l'])"
posix finds=unknown | node -e "new Deno.Command('ls', {args: ['-l']})"
posix finds=unknown | node -e "const {spawn} = require('child_process'); spawn('ls', ['-l', ...[]])"
# The members of `child_process` that run what the reader does not read are
# unknown. `execArgv` is node's own options: `-e` is code.
posix finds=unknown | node -e "require('child_process').fork('x.js', {execArgv:['-e', \\"require('fs').rmSync('/home/me',{recursive:true})\\"]})"
posix finds=unknown | node -e "require('child_process').fork('x.js', ['a'], {execArgv: []})"
posix finds=unknown | node -e "require('child_process').fork('x.js', {'execArgv': ['--import=data:text/javascript,1']})"
posix finds=unknown | node -e "const execArgv = ['-e', '1']; require('child_process').fork('x.js', {execArgv})"
# `execPath` is the program that runs.
posix finds=unknown | node -e "require('child_process').fork('/home/me', ['-rf'], {execPath:'/bin/rm'})"
posix finds=unknown | node -e "require('child_process').fork('x.js', {execPath})"
# Options that are not an object literal may hold either.
posix finds=unknown | node -e "require('child_process').fork('x.js', opts)"
posix finds=unknown | node -e "require('child_process').fork('x.js', ['a'], process.env.OPTS)"
posix finds=unknown | node -e "require('child_process').fork('x.js', {...opts})"
posix finds=unknown | node -e "require('child_process').fork('x.js', {[key]: 1})"
posix finds=unknown | node -e "require('child_process').fork('x.js', {get execPath() { return '/bin/rm' }})"
posix finds=unknown | node -e "require('child_process').fork('x.js', ...args)"
# A module that starts with `-` is an option of node.
posix finds=unknown | node -e "require('child_process').fork('-e', ['require(\\"fs\\").rmSync(\\"/home/me\\",{recursive:true})'])"
posix finds=unknown | node -e "require('child_process').fork('--import=data:text/javascript,1')"
posix finds=unknown | node -e "require('child_process').fork(process.argv[1])"
# `fork` handed on as a value.
posix finds=unknown | node -e "[require('child_process').fork].forEach(f => f('x.js', {execPath: '/bin/rm'}))"
# Members of `child_process` the reader does not read.
posix finds=unknown | node -e "new (require('child_process').ChildProcess)().spawn({file:'rm',args:['rm','-rf','/home/me']})"
posix finds=unknown | node -e "const { ChildProcess } = require('child_process'); new ChildProcess().spawn({file:'rm',args:['rm','-rf','/home/me']})"
posix finds=unknown | node -e "require('child_process')._forkChild(3, 'json')"
# A worker the cluster starts takes its options from the settings.
posix finds=unknown | node -e "const c = require('cluster'); c.setupPrimary({execArgv: ['-e', '1']}); c.fork()"
# A session of the inspector evaluates what it is sent.
posix finds=unknown | node -e "const i = require('inspector'); const s = new i.Session(); s.connect(); s.post('Runtime.evaluate', {expression: 'process.exit()'})"
# Not read whole by the strict gate: unknown.
posix finds=unknown | node -e "require('child_process').fork('worker.js', ['a', 'b'])"
posix finds=unknown | node -e "require('child_process').fork('worker.js', { silent: true })"
posix finds=unknown | node -e "require('child_process').fork('worker.js', ['a'], { cwd: 'sub', silent: true, stdio: 'inherit' })"
posix finds=unknown | node -e "const { fork } = require('child_process'); fork('worker.js')"
posix finds=unknown | node -e "require('child_process').fork('worker.js', [], {})"
posix finds=unknown | node -e "require('child_process').execSync('echo 1')"
posix finds=unknown | node -e "require('child_process').spawn('echo', ['1'])"
# A string handed to a timer is code the reader does not read.
posix finds=unknown | deno eval "setTimeout('Deno.removeSync(\\"/home/me\\",{recursive:true})')"
posix finds=unknown | deno eval "setInterval('Deno.removeSync(\\"/home/me\\")', 10)"
posix finds=unknown | deno eval "setTimeout(`Deno.removeSync(\\"/home/me\\")`)"
posix finds=unknown | deno eval "globalThis.setTimeout('x')"
posix finds=unknown | deno eval "setTimeout(...['x'])"
posix finds=unknown | deno eval "setTimeout.call(null, 'x')"
posix finds=unknown | node -e "setTimeout('x' + y, 5)"
posix finds=unknown | bun -e "setTimeout('x', 5)"
# A function is read where it is written.
posix finds=delete | node -e "setTimeout(() => require('fs').rmSync('/home/me', {recursive:true}), 100)"
# Not read whole by the strict gate: unknown.
posix finds=unknown | node -e 'setTimeout(() => console.log(1), 100)'
posix finds=unknown | node -e 'function f() {}; setTimeout(f, 100); setInterval(f, 1, "a")'
posix finds=unknown | node -e 'setTimeout(console.log, 1, "x")'
posix finds=unknown | deno eval 'setTimeout(() => console.log(1), 100)'
posix finds=unknown | bun -e 'setInterval(function () {}, 1000)'
# Killing a process by a literal id is the `kill` command.
posix finds=stop_system | python3 -c 'import os; os.kill(-1, 9)'
posix finds=stop_system | python3 -c 'import os; os.kill(-1, 15)'
posix finds=stop_system | python3 -c 'import os, signal; os.kill(-1, signal.SIGKILL)'
posix finds=stop_system | python3 -c 'import os; os.kill(pid=-1, sig=9)'
posix finds=stop_system | python3 -c 'from os import kill; kill(-1, 9)'
posix finds=stop_system | python3 -c 'import os; os.kill(- 1, 9)'
posix finds=stop_system | python3 -c 'import os; os.kill(-0x1, 9)'
posix finds=stop_system | python3 -c 'import os; os.kill(1, 9)'
posix finds=stop_system | python3 -c 'import os; os.killpg(1, 9)'
posix finds=stop_system | python3 -c 'import os; os.killpg(-1, 9)'
# A process id only known when it runs may be any of them.
posix finds=unknown | python3 -c 'import os; os.kill(pid, 9)'
posix finds=unknown | python3 -c 'import os; os.kill(-1 if a else 2, 9)'
posix finds=unknown | python3 -c 'import os; os.kill(*a)'
posix finds=unknown | python3 -c 'import os; os.kill(-01, 9)'
posix finds=stop_system | node -e "process.kill(-1, 'SIGKILL')"
posix finds=stop_system | node -e "process.kill(-1)"
posix finds=stop_system | node -e "process.kill(1, 'SIGTERM')"
posix finds=stop_system | node -e "const {kill} = process; kill(-1, 'SIGKILL')"
posix finds=stop_system | deno eval 'Deno.kill(-1, "SIGKILL")'
posix finds=unknown | node -e "process.kill(pid, 'SIGKILL')"
posix finds=unknown | node -e "process.kill(...a)"
posix finds=unknown | node -e "process.kill(-1.5)"
# Process 0 is the caller's own group (`os.kill(0, 9)` and `os.killpg(0, 9)`
# are in stop_processes.cases); another id is not read whole: unknown.
posix finds=unknown | python3 -c 'import os, signal; os.kill(4242, signal.SIGTERM)'
posix finds=stop_system | node -e "process.kill(0, 'SIGKILL')"
posix finds=unknown | node -e "process.kill(4242)"
posix finds=unknown | deno eval 'Deno.kill(4242, "SIGTERM")'
# A member of a function that starts a program is not the call:
# `cross-spawn` and `execa` are functions that start a program, with `spawn`,
# `sync` and the like for members, and `call`, `apply` and `bind` hand the
# program on to a call the guard does not see, as they do through
# `child_process`. The members that are read are still read, but code with a
# `require` is not read whole by the strict gate: each is unknown.
posix finds=unknown | node -e "const spawn = require('cross-spawn'); spawn.sync('ls', ['-l'])"
posix finds=unknown | node -e "const spawn = require('cross-spawn'); spawn.spawn('ls', ['-l'])"
posix finds=unknown | node -e "require('cross-spawn')('ls', ['-l'])"
posix finds=unknown | node -e "require('cross-spawn').spawn('ls', ['-l'])"
posix finds=unknown | node -e "require('cross-spawn').default('ls', ['-l'])"
posix finds=unknown | node -e "require('execa').execa('ls', ['-l'])"
posix finds=unknown | node -e "require('execa').execaSync('ls', ['-l'])"
posix finds=unknown | node -e "import spawn from 'cross-spawn'; spawn('ls', ['-l'])"
posix finds=unknown | node -e "const spawn = require('cross-spawn'); spawn.call(null, 'rm', ['-rf', '/home/me'])"
posix finds=unknown | node -e "const spawn = require('cross-spawn'); spawn.apply(null, ['rm', ['-rf', '/home/me']])"
posix finds=unknown | node -e "const spawn = require('cross-spawn'); spawn.bind(null, 'rm')(['-rf', '/home/me'])"
posix finds=unknown | node -e "const spawn = require('cross-spawn'); const f = spawn.bind(null); f('rm', ['-rf', '/home/me'])"
posix finds=unknown | node -e "const spawn = require('cross-spawn'); ['/home/me'].map(spawn.bind(null, 'rm'))"
posix finds=unknown | node -e "const spawn = require('cross-spawn'); spawn.foo('rm', ['-rf', '/home/me'])"
posix finds=unknown | node -e "require('cross-spawn').call(null, 'rm', ['-rf', '/home/me'])"
posix finds=unknown | node -e "require('cross-spawn').apply(null, ['rm', ['-rf', '/home/me']])"
posix finds=unknown | node -e "require('cross-spawn').bind(null, 'rm')(['-rf', '/home/me'])"
posix finds=unknown | node -e "require('cross-spawn').default.call(null, 'rm', ['-rf', '/home/me'])"
posix finds=unknown | node -e "import * as cs from 'cross-spawn'; cs.default.call(null, 'rm', ['-rf', '/home/me'])"
posix finds=unknown | node -e "import spawn from 'cross-spawn'; spawn.call(null, 'rm', ['-rf', '/home/me'])"
posix finds=unknown | node -e "let s; s = require('cross-spawn'); s.call(null, 'rm', ['-rf', '/home/me'])"
posix finds=unknown | node -e "const {$} = require('execa'); $.call(null, 'rm', ['-rf', '/home/me'])"
posix finds=unknown | node -e "const {$} = require('execa'); $.apply(null, [['rm -rf ~']])"
posix finds=unknown | node -e "const {$} = require('execa'); $.bind(null)('rm -rf ~')"
posix finds=unknown | node -e "require('execa').call(null, 'rm', ['-rf', '/home/me'])"
posix finds=unknown | node -e "require('execa').apply(null, ['rm', ['-rf', '/home/me']])"
posix finds=unknown | node -e "require('execa').bind(null, 'rm')(['-rf', '/home/me'])"
posix finds=unknown | node -e "require('execa').execaNode('script.js')"

# A program argument the code writes out is read in either quoting.
# Programs started with words the code writes out are still read as before,
# but code with an import, a `require` or a loop is not read whole by the
# strict gate: unknown. A word only known when the code runs is one the
# guard cannot judge, as `cat "$F"` is not one it can.
posix finds=unknown | python3 -c 'import subprocess\nsubprocess.run(["ls", "-l"])'
posix finds=unknown | python3 -c 'import subprocess\nsubprocess.run(["git", "status", "--short"], check=True)'
posix finds=unknown | python3 -c 'import subprocess\nsubprocess.run(["cat", "README.md"])'
posix finds=unknown | python3 -c 'import subprocess\nf = "README.md"\nsubprocess.run(["cat", f])'
posix finds=unknown | python3 -c 'import subprocess\nfor f in ["a.txt", "b.txt"]: subprocess.run(["cat", f])'
posix finds=unknown | python3 -c 'import subprocess\nsubprocess.run(["cat", "notes/" + "a.txt"])'
posix finds=unknown | node -e 'require("child_process").execFileSync("ls", ["-l"])'
posix finds=unknown | node -e 'const f = "README.md"; require("child_process").execFileSync("cat", [f])'
posix finds=unknown | bun -e 'Bun.spawnSync(["ls", "-l"])'
posix finds=unknown | python3 -c 'import subprocess, sys\nsubprocess.run(["echo", sys.argv[1]])'
posix finds=unknown | node -e 'require("child_process").spawnSync("echo", [process.argv[1]])'
# A program argument is read the same when the code is in double quotes
# (single-quoted strings in the code): a key named whole is a read of it.
posix finds=read_secret | python3 -c "import subprocess\nf = '/home/me/.ssh/id_rsa'\nsubprocess.run(['cat', f])"
posix finds=read_secret | python3 -c "import subprocess\nf = 'id_rsa'\nsubprocess.run(['cat', '/home/me/.ssh/' + f])"
posix finds=read_secret | python3 -c "import subprocess\nfor f in ['id_rsa']: subprocess.run(['cat', '/home/me/.ssh/' + f])"
posix finds=read_secret | node -e "const cp = require('child_process'); const f = '/home/me/.ssh/id_rsa'; cp.execFileSync('cat', [f])"
posix finds=read_secret | node -e "const f = 'id_rsa'; require('child_process').execFileSync('cat', ['/home/me/.ssh/' + f])"
posix finds=read_secret | bun -e "const f = 'id_rsa'; Bun.spawnSync(['cat', '/home/me/.ssh/' + f])"
# And an argument the reader does not fold, or one from a listing, the
# arguments or the environment, is not safe.
posix finds=unknown/read_secret | python3 -c "import subprocess\nsubprocess.run(['cat', '/home/me/.ssh/%s' % 'id_rsa'])"
posix finds=unknown/read_secret | python3 -c "import subprocess\nsubprocess.run(['cat', '/home/me/.ssh/{}'.format('id_rsa')])"
posix finds=unknown/read_secret | python3 -c "import subprocess, sys\nsubprocess.run(['cat', f'/home/me/.ssh/{sys.argv[1]}'])"
posix finds=unknown/read_secret | python3 -c "import subprocess, os\nfor f in os.listdir(os.path.expanduser('~/.ssh')): subprocess.run(['cat', f], cwd=os.path.expanduser('~/.ssh'))"
posix finds=unknown/read_secret | python3 -c "import subprocess, os\nfor f in os.listdir('.'): subprocess.run(['cat', f])"
posix finds=unknown/read_secret | python3 -c "import subprocess, sys\nsubprocess.run(['cat', sys.argv[1]])" ~/.ssh/id_rsa
posix finds=unknown/read_secret | python3 -c "import subprocess, sys\nsubprocess.run(['cat', sys.argv[1]], cwd='/home/me/.ssh')"
posix finds=unknown/read_secret | python3 -c "import subprocess, sys\nsubprocess.run(['python3', sys.argv[1]])"
posix finds=unknown/read_secret | node -e "require('child_process').execFileSync('cat', [process.argv[1]])" ~/.ssh/id_rsa
posix finds=unknown/read_secret | node -e "require('child_process').execFileSync('cat', [process.argv[1]], {cwd: '/home/me/.ssh'})"
posix finds=unknown/read_secret | node -e "require('child_process').execFileSync('cat', ['/home/me/.ssh/id_rsa'.slice(0)])"
posix finds=unknown/read_secret | node -e "require('child_process').execFileSync('cat', [['/home/me/.ssh/id_rsa'][0]])"
posix finds=unknown/read_secret | bun -e "Bun.spawnSync(['cat', Bun.argv[1]])"

# Inline code that gives a started program an environment is unknown.
posix finds=unknown | python3 -c "import subprocess; subprocess.run(['python3', '-c', '1'], env={'PYTHONPATH': '/tmp'})"
posix finds=unknown | python3 -c "import subprocess, os; subprocess.run(['python3', '-c', '1'], env={**os.environ, 'PYTHONPATH': '/tmp'})"
posix finds=unknown | python3 -c "import subprocess, os; subprocess.run(['python3', '-c', '1'], env=dict(os.environ, PYTHONPATH='/tmp'))"
posix finds=unknown | python3 -c "import subprocess, os; e = os.environ.copy(); e['PYTHONPATH'] = '/tmp'; subprocess.run(['python3', '-c', '1'], env=e)"
posix finds=unknown | python3 -c "import subprocess, sys; subprocess.run(['python3', '-c', '1'], env={'PYTHONPATH': sys.argv[1]})" /tmp
posix finds=unknown | python3 -c "import os; os.environ['PYTHONPATH'] = '/tmp'; os.system('python3 -c 1')"
posix finds=unknown | python3 -c "import os; os.putenv('PYTHONPATH', '/tmp'); os.system('python3 -c 1')"
posix finds=unknown | python3 -c "import os; os.environ.update(PYTHONPATH='/tmp'); os.system('python3 -c 1')"
posix finds=unknown | python3 -c "import os, subprocess; os.environ['PYTHONPATH'] = '/tmp'; subprocess.run(['python3', '-c', '1'])"
posix finds=unknown | python3 -c "import subprocess; subprocess.run(['python3', '-c', '1'], env={'LD_PRELOAD': '/tmp/x.so'})"
posix finds=unknown | python3 -c "import subprocess; subprocess.run(['ls'], env={'PATH': '/tmp'})"
posix finds=unknown | node -e "require('child_process').spawnSync('node', ['-e', '1'], {env: {NODE_OPTIONS: '--require /tmp/x.js'}})"
posix finds=unknown | node -e "require('child_process').spawnSync('node', ['-e', '1'], {env: {...process.env, NODE_OPTIONS: '--require /tmp/x.js'}})"
posix finds=unknown | node -e "process.env.NODE_OPTIONS = '--require /tmp/x.js'; require('child_process').execSync('node -e 1')"
posix finds=unknown | node -e "require('child_process').execSync('node -e 1', {env: {NODE_OPTIONS: '--require /tmp/x.js'}})"
posix finds=unknown | node -e "const e = process.env; require('child_process').spawnSync('ls', [], {env: e})"
posix finds=unknown | node -e "const {execa} = require('execa'); execa('node', ['-e', '1'], {env: {NODE_OPTIONS: '--require /tmp/x.js'}})"
posix finds=unknown | node -e "process.env.NODE_OPTIONS = '--require /tmp/x.js'; require('execa').execa('node', ['-e', '1'])"
posix finds=unknown | bun -e "Bun.spawn(['bun', '-e', '1'], {env: {NODE_OPTIONS: '--require /tmp/x.js'}})"
posix finds=unknown | bun -e "Bun.spawn(['bun', '-e', '1'], {env: {...process.env, NODE_OPTIONS: '--require /tmp/x.js'}})"
posix finds=unknown | bun -e "process.env.NODE_OPTIONS = '--require /tmp/x.js'; Bun.spawn(['bun', '-e', '1'])"
posix finds=unknown | deno eval "new Deno.Command('deno', {args: ['eval', '1'], env: {NODE_OPTIONS: '--require /tmp/x.js'}}).outputSync()"
posix finds=unknown | deno eval "Deno.env.set('NODE_OPTIONS', '--require /tmp/x.js'); new Deno.Command('deno', {args: ['eval', '1']}).outputSync()"
# A key it reads still wins.
posix finds=read_secret | python3 -c "import subprocess; subprocess.run(['cat', '/home/me/.ssh/id_rsa'], env={'PYTHONPATH': '/tmp'})"
