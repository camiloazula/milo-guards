# Inline code given through a runner is read as the interpreter's.
posix finds=delete | yarn node -e 'require("fs").rmSync("/home/me",{recursive:true})'
posix finds=delete | bun run -e "require('fs').rmSync('/home/me', {recursive:true})"
posix finds=delete | bun run --eval "require('fs').rmSync('/home/me', {recursive:true})"
posix finds=delete | bun run -p "require('fs').rmSync('/home/me', {recursive:true})"
posix finds=delete | bun run --print "require('fs').rmSync('/home/me', {recursive:true})"
posix finds=unknown | yarn node -e 'console.log(1)'
posix safe | yarn node server.js
# In PowerShell a program run by its `.ps1` shim is judged as the program.
powershell finds=delete | npx.ps1 rimraf C:\\
powershell finds=delete | rm.ps1 -r C:\\
powershell finds=destroy_resources | cdk.ps1 destroy
powershell finds=destroy_resources | gcloud.ps1 projects delete prod
powershell finds=delete | C:\\nodejs\\npx.ps1 rimraf C:\\
powershell safe | npx.ps1 prettier --check .
