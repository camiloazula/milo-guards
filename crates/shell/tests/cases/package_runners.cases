# A package runner (`npx`, `npm exec`, `pnpm`, `pnpx`, `yarn`, `bunx`, `bun`,
# `deno`, `dx`, `uv`, `uvx`, `pipx`, `corepack`, and the runners of a
# project's environment: `poetry`, `pdm`, `hatch`, `conda`, `pixi`, `rye`,
# `volta`, `mise`) runs the program it names, so that
# program is judged, past every option of the runner that takes a value;
# `bun` and `deno` run code given inline or read from their input; a script a
# runner runs may be one the same line writes; and on Windows the script
# given to npm or pnpm runs in cmd. The format is in CONTRIBUTING.md.

# A package runner is judged by the program it runs. What a runner starts is
# a program, never a builtin of the shell: a `cd` it runs does not move the
# line.
posix safe | npx rimraf dist
posix safe | npx -y create-vite@latest my-site
posix safe | uvx ruff check .
posix safe | uvx ruff@0.5.0 check .
posix safe | npx --yes prettier --write .
posix safe | npm exec -- prettier --check .
posix safe | npm exec --package=typescript tsc
posix safe | npm install
posix safe | npm run build
posix safe | pnpm dlx create-next-app my-app
posix safe | pnpm exec tsc --noEmit
posix safe | pnpm install
posix safe | yarn dlx -p typescript tsc --version
posix safe | yarn exec tsc
posix safe | yarn install
posix safe | bunx prettier --check .
posix safe | bun x vite build
posix safe | bun run build
posix safe | uv tool run ruff check .
posix safe | uv run pytest
posix safe | uv sync
posix safe | pipx run black --check .
posix safe | pipx list
posix safe | uvx --from httpie http example.org
posix safe | npx -p typescript tsc --version
posix safe | npx rimraf node_modules
posix safe | pnpm rimraf dist
posix safe | yarn rimraf dist
posix safe | bunx rimraf ./build
posix safe | npx del-cli dist
posix safe | npx del --dry-run /
posix safe | npx
posix safe | uvx
posix safe | npm exec
posix safe | bun
posix safe | bun --version
posix safe | bun test
posix safe | bun build ./index.ts --outdir out
posix safe | bun run script.ts
posix safe | bun script.ts
posix safe | bun run -- script.ts
posix safe | deno fmt
posix safe | deno task build
posix safe | deno run npm:vite build
posix safe | deno main.ts
# Only del and del-cli have a dry run, and it is spelt out.
posix safe | npx del-cli --dry-run /
posix safe | del --dry-run /
# `npx` hands the `--` on, so `sh` is given `--` and then reads a script file
# called `-c`; the same after a `--` before `sh`.
posix safe | npx sh -- -c 'rm -rf ~'
posix safe | npm exec -- sh -- -c 'rm -rf ~'
posix safe | npm exec stub -- --flag
# npm's call script, and a `-c` after the program, which is the program's
# own.
posix safe | npx -yc 'echo hi'
posix safe | npm exec -yc 'echo hi'
posix safe | npm -c 'echo hi' exec
posix safe | npx --c 'echo hi'
posix safe | npx prettier -c .
posix safe | npm exec prettier -- -c .
posix safe | npx -y prettier -c .
# pnpm's shell mode before `exec`.
posix safe | pnpm -r exec tsc
posix safe | pnpm -c exec 'echo hi'
# `pnpx` and `pnx` are `pnpm dlx`.
posix safe | pnpx create-vite my-site
posix safe | pnpx rimraf dist
posix safe | pnx rimraf dist
posix safe | pnpx -p typescript tsc --version
posix safe | pnpx --version
posix safe | pnpx cd ~ && ls
posix safe | pnx cd / && ls
# A bare pnpm name runs a script or else the program: read as `pnpm exec
# NAME`, unless NAME is a command of pnpm ("If there is no script with the
# specified name, then pnpm will execute the command as a shell script").
posix safe | pnpm lint
posix safe | pnpm dev
posix safe | pnpm build
posix safe | pnpm test
posix safe | pnpm start
posix safe | pnpm format --check
posix safe | pnpm --filter app lint
posix safe | pnpm -r build
posix safe | pnpm rm lodash
posix safe | pnpm remove lodash
posix safe | pnpm uninstall lodash
posix safe | pnpm un lodash
posix safe | pnpm add lodash
posix safe | pnpm i
posix safe | pnpm up
posix safe | pnpm update
posix safe | pnpm ls
posix safe | pnpm list
posix safe | pnpm env use --global lts
posix safe | pnpm store prune
posix safe | pnpm run build
posix safe | pnpm view react version
posix safe | pnpm --version
posix safe | pnpm echo hi
# `recursive`, `multi` and `m` are pnpm's own spellings of `-r`
# (pnpm.io/cli/recursive): `pnpm recursive exec` is `pnpm -r exec`.
posix safe | pnpm recursive exec tsc
posix safe | pnpm m exec tsc --noEmit
posix safe | pnpm multi exec -- tsc
posix safe | pnpm recursive install
posix safe | pnpm m run build
posix safe | pnpm multi test
posix safe | pnpm recursive
posix safe | pnpm recursive lint
posix safe | pnpm recursive exec
posix safe | pnpm exec m x
# `yarn exec` runs its arguments as a script; `yarn run` starts a delete tool
# of the project like yarn does.
posix safe | yarn exec tsc --noEmit
posix safe | yarn exec 'echo hi'
posix safe | yarn exec 'tsc & babel src --out-dir lib'
posix safe | yarn run rimraf dist
posix safe | yarn run build
posix safe | yarn run clean
posix safe | yarn run --silent build
# bun starts a delete tool of the project by its name.
posix safe | bun rimraf dist
posix safe | bun run rimraf dist
posix safe | bun run clean
# `bun exec` runs its arguments as a shell script.
posix safe | bun exec 'echo hi'
posix safe | bun exec
posix safe | bun --cwd x exec 'echo hi'
# `bun run` starts any program on the path that is no file. Names of
# scripts: unknown programs.
posix safe | bun run dev
posix safe | bun run start
posix safe | bun run test
posix safe | bun run lint
posix safe | bun run format
posix safe | bun run deploy
posix safe | bun run typecheck
posix safe | bun run test:unit
posix safe | bun run build -- --watch
posix safe | bun --hot run dev
posix safe | bun run --silent build
posix safe | bun run --bun dev
posix safe | bun run --filter app build
# Files.
posix safe | bun run ./build.ts
posix safe | bun run src/main
posix safe | bun run echo.sh
# Known programs that only read.
posix safe | bun run echo X
posix safe | bun run ls
posix safe | bun run git status
# `bun <name>` runs only scripts and local bins.
posix safe | bun build
posix safe | bun sh -c 'rm -rf ~'
posix safe | bun rm -rf ~
# bun picks its subcommand before any option reads a value, so
# `bun -F x echo RAN` runs `bunx echo RAN`, and `bun --title repl` opens the
# REPL.
posix safe | bun -F x echo RAN
posix safe | bun --filter x echo RAN
posix safe | bun --cwd app run build
posix safe | bun -F app run build
posix safe | bun --filter app test
posix safe | bun -c x vite build
# deno runs a script when it is given no subcommand; `deno x` and `dx` are
# package runners; its help and version flags only print.
posix safe | deno npm:vite build
posix safe | deno -A main.ts
posix safe | deno watch main.ts
posix safe | deno watch --allow-all main.ts
posix safe | deno x prettier --check .
posix safe | dx prettier --check .
posix safe | deno x -y prettier .
posix safe | deno x npm:prettier .
posix safe | dx
posix safe | deno x
posix safe | dx -p typescript tsc --version
posix safe | deno -v
posix safe | deno --help=full
posix safe | deno --help=unstable
# A plain `cd` still moves the shell.
posix safe | cd src && rm -f target/x.o
posix safe | npx prettier --write src && ls

