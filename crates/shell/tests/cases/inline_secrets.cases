# A key handed to a started program is read as the program reads it. A name
# bound whole to a key is one when it is an argument of a program: the same
# binding read by `open(f)` is a read of the key, and as an element of the
# list a program is started with it is the same read. Where a listing is a
# key folder and the path is built from it, the key is named.
posix finds=read_secret | python3 -c 'import subprocess\nf = "/home/me/.ssh/id_rsa"\nsubprocess.run(["cat", f])'
posix finds=read_secret | python3 -c 'import subprocess\nf = "id_rsa"\nsubprocess.run(["cat", "/home/me/.ssh/" + f])'
posix finds=read_secret | python3 -c 'import subprocess\nfor f in ["id_rsa"]: subprocess.run(["cat", "/home/me/.ssh/" + f])'
posix finds=read_secret | python3 -c 'import subprocess\nfor f in ["a", "id_rsa"]: subprocess.run(["cat", "/home/me/.ssh/" + f])'
posix finds=read_secret | python3 -c 'import subprocess\nf = "/home/me/.ssh/id_rsa"\nsubprocess.check_output(["cat", f])'
posix finds=read_secret | python3 -c 'import subprocess\nf = "/home/me/.ssh/id_rsa"\nsubprocess.Popen(["cp", f, "/tmp/k"])'
posix finds=read_secret | python3 -c 'import subprocess, os\nfor f in os.listdir("/home/me/.ssh"): subprocess.run(["cat", "/home/me/.ssh/" + f])'
posix finds=read_secret | python3 -c 'import subprocess, glob\nfor f in glob.glob("/home/me/.ssh/*"): subprocess.run(["cat", f])'
posix finds=read_secret | node -e 'const cp = require("child_process"); const f = "/home/me/.ssh/id_rsa"; cp.execFileSync("cat", [f])'
posix finds=read_secret | node -e 'const f = "id_rsa"; require("child_process").execFileSync("cat", ["/home/me/.ssh/" + f])'
posix finds=read_secret | node -e 'const f = "id_rsa"; require("child_process").execFileSync("cat", [`/home/me/.ssh/${f}`])'
posix finds=read_secret | node -e 'const f = "id_rsa"; require("child_process").execFileSync("cat", [f], {cwd: "/home/me/.ssh"})'
posix finds=read_secret | node -e 'const f = "/home/me/.ssh/id_rsa"; require("child_process").spawnSync("cat", [f])'
posix finds=read_secret | node -e 'for (const f of ["a", "id_rsa"]) require("child_process").spawnSync("cat", ["/home/me/.ssh/" + f])'
posix finds=read_secret | node -e 'const fs = require("fs"), cp = require("child_process"); for (const f of fs.readdirSync("/home/me/.ssh")) cp.spawnSync("cat", ["/home/me/.ssh/" + f])'
posix finds=read_secret | bun -e 'const f = "id_rsa"; Bun.spawnSync(["cat", "/home/me/.ssh/" + f])'
# An argument of a program the reader does not fold is not safe: a `%`, a
# `.format`, a method, a conditional, a subscript, a join with a word only
# known when the code runs; none is folded to the key it names, so each is at
# least `unknown`. Nor is an argument that comes from a listing, a loop, argv
# or the environment.
posix finds=unknown/read_secret | python3 -c 'import subprocess\nsubprocess.run(["cat", "/home/me/.ssh/%s" % "id_rsa"])'
posix finds=unknown/read_secret | python3 -c 'import subprocess\nsubprocess.run(["cat", "/home/me/.ssh/{}".format("id_rsa")])'
posix finds=unknown/read_secret | python3 -c 'import subprocess\nsubprocess.run(["cat", "/home/me/.ssh/id_rsa".strip()])'
posix finds=unknown/read_secret | python3 -c 'import subprocess\nsubprocess.run(["cat", "/home/me/.ssh/id_rsa" if 1 else "a"])'
posix finds=unknown/read_secret | python3 -c 'import subprocess, sys\nsubprocess.run(["cat", "/home/me/.ssh/%s" % sys.argv[1]])'
posix finds=unknown/read_secret | python3 -c 'import subprocess, sys\nsubprocess.run(["cat", "/home/me/.ssh/{}".format(sys.argv[1])])'
posix finds=unknown/read_secret | python3 -c 'import subprocess, sys\nsubprocess.run(["cat", f"/home/me/.ssh/{sys.argv[1]}"])'
posix finds=unknown/read_secret | python3 -c 'import subprocess, sys, os\nsubprocess.run(["cat", os.path.join("/home/me/.ssh", sys.argv[1])])'
