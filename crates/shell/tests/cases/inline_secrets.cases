posix finds=unknown | python3 -c "print(open(input()).read())"
posix finds=unknown | python3 -c "import os\nprint(open(os.environ['KEYFILE']).read())"
posix finds=unknown | node -e "console.log(require('fs').readFileSync(process.env.KEYFILE, 'utf8'))"
# A loop variable or a listing loses the path: the pattern of a listing is
# not followed, so what it gives is a path somewhere in the folder.
posix finds=unknown | python3 -c "import pathlib\nfor p in pathlib.Path('/home/me').glob('.ssh/*'):\n    print(p.read_text())"
posix finds=unknown | python3 -c "import pathlib\nfor p in pathlib.Path.home().rglob('id_rsa'):\n    print(p.read_text())"
posix finds=unknown | python3 -c "import glob\nfor p in glob.glob('/home/me/.n*'):\n    print(open(p).read())"
posix finds=unknown | python3 -c "import pathlib\nfor p in pathlib.Path('/home/me').iterdir():\n    print(p.read_text())"
posix finds=unknown | python3 -c "import pathlib\nfor p in pathlib.Path('/home/me').glob('*'):\n    print(p.read_text())"
posix finds=unknown | python3 -c "import pathlib\nfor p in pathlib.Path('/home/me').rglob('*'):\n    print(p.read_text())"
posix finds=unknown | python3 -c "import os\nfor n in os.listdir('/home/me'):\n    print(open('/home/me/' + n).read())"
posix finds=unknown | node -e "const fs = require('fs'); for (const n of fs.readdirSync('/home/me')) console.log(fs.readFileSync('/home/me/' + n, 'utf8'))"
