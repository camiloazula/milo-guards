# A read whose path comes from the command line: the path is on the line,
# but the guard does not follow the arguments the code is given, so a read of
# one is `unknown`.
posix finds=unknown | python3 -c "import sys\nprint(open(sys.argv[1]).read())" /home/me/.ssh/id_rsa
posix finds=unknown | python3 -c "import sys\nprint(open(sys.argv[1]).read())" README.md
posix finds=unknown | node -e "console.log(require('fs').readFileSync(process.argv[1], 'utf8'))" /home/me/.ssh/id_rsa
posix finds=unknown | python3 -c "import sys\nfor k in sys.argv[1:]:\n    print(open(k).read())" /home/me/.ssh/id_rsa
posix finds=unknown | node -e "process.argv.slice(1).forEach(k => console.log(require('fs').readFileSync(k)))" /home/me/.ssh/id_rsa
posix finds=unknown | python3 -c "import sys\nprint(open('/home/me/%s' % sys.argv[1]).read())" .netrc
posix finds=unknown | python3 -c "import fileinput\nfor l in fileinput.input():\n    print(l)" /home/me/.ssh/id_rsa
