posix finds=unknown | python3 -c "print(open('/home/me/.ssh/id_rsaX'[:-1]).read())"
posix finds=unknown | python3 -c "print(open('/home/me/.ssh/id_rsa '.strip()).read())"
posix finds=unknown | python3 -c "print(open('/HOME/ME/.SSH/ID_RSA'.lower()).read())"
