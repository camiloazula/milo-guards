# a call it cannot follow.
posix finds=unknown | node -e 'make().rmSync("/home/me")'
posix finds=unknown | node -e 'x.rmdirSync("/home/me")'
posix finds=unknown | node -e 'x.unlinkSync("/home/me/.zshrc")'
