# The names and modules the inline reader follows, and those it does not: a
# module under another name, default values, a module handed on as a value,
# `with` and destructuring with a rest, every way JavaScript reaches a
# module, names read in their NFKC form or written with an escape, names
# bound in a class body or more than once, keys that are not plain names,
# names literal `exec` and `eval` code binds or uses, a dotted `__import__`,
# the value of `eval`, node's `module`, awaited imports of a computed value,
# assignments to a module or a builtin prototype, escapes the reader does not
# decode, and names that hold more than one string. The format is in
# CONTRIBUTING.md.

# A name is followed only to what it is certain to hold.
# What is decoded is the character it stands for.
posix safe | python3 -c "print('\\N{BULLET}')"
posix safe | node -e "console.log('\\57', '\\0')"
# A string or a comment that is not ASCII is only text.
posix safe | python3 -c "print('ｒｅｍｏｖｅ')"
posix safe | python3 -c "print('é')  # ｒｅｍｏｖｅ"
# An escape in a string is decoded, and reads as it always did.
posix safe | node -e "console.log('\\u0072mSync')"
# A module under another name is followed.
posix finds=delete | python3 -c 'import os; o = os; o.remove("/etc/passwd")'
posix finds=delete | python3 -c 'o = __import__("os"); o.remove("/etc/passwd")'
posix finds=delete | python3 -c 'import shutil; shutil.os.remove("/etc/passwd")'
posix finds=delete | python3 -c 'import posix; posix.remove("/etc/passwd")'
posix finds=unknown | python3 -c '__builtins__.__import__("os").remove("/etc/passwd")'
posix finds=overwrite | python3 -c 'import builtins; builtins.open("/etc/x", "w")'
posix finds=unknown | python3 -c 'from builtins import exec as e; e(x)'
posix finds=unknown | python3 -c '().__class__.__bases__[0].__subclasses__()'
posix finds=delete | python3 -c 'import subprocess; subprocess.os.system("rm -rf ~")'
posix finds=delete | python3 -c 'from distutils import dir_util; dir_util.remove_tree("/home/me")'
posix finds=overwrite | python3 -c 'import urllib.request; urllib.request.urlretrieve("http://x", "/etc/x")'
posix finds=delete | python3 -c 'import os; os.remove("/home/me/x")\nimport subprocess; subprocess.run("ls")'
posix finds=delete | node -e 'const fs=require("fs"); const g = fs; g.rmSync("/home/me")'
posix finds=unknown | node -e 'const {rmSync}=require("fs"); (0, rmSync)("/home/me")'
posix finds=unknown | node -e '(function(){}).constructor("return process")()'
posix finds=unknown | node -e 'const cp=require("child_process"); const x = cp.exec; x("rm -rf ~")'
posix finds=delete | node -e 'const x = require; x("fs").rmSync("/home/me")'
posix finds=delete | node -e 'require("fs").rmSync?.("/home/me")'
posix finds=unknown | node -e 'module.require("fs").rmSync("/home/me")'
posix finds=delete | bun -e 'import {$} from "bun"; await $`rm -rf ~`'
posix finds=overwrite | bun -e 'import {write} from "bun"; await write("/home/me/.zshrc", "x")'
posix finds=delete | node -e 'require("shelljs").rm("-rf", "~")'
posix finds=delete | node -e 'const sh = require("shelljs"); sh.exec("rm -rf ~")'
posix finds=delete | node -e 'require("execa").execaSync("rm", ["-rf", "~"])'
posix finds=delete | node --input-type=module -e 'import {execSync as e} from "node:child_process"; e("rm -rf ~")'
posix finds=delete | deno eval 'const {remove} = Deno; await remove("/home/me")'
posix finds=delete | deno eval 'Deno.run({cmd: ["sh", "-c", "rm -rf ~"]})'
posix finds=unknown | deno eval 'Deno.run(opts)'
posix finds=unknown | bun -e 'Bun.spawn(argv)'
posix finds=delete | node -e 'require("fs").rmSync(...paths)'
posix finds=overwrite | node -e 'require("fs").writeFileSync(...a)'
posix finds=overwrite | node -e 'require("fs").openSync(...a)'
posix finds=overwrite | deno eval 'Deno.openSync(...a)'
posix finds=overwrite | python3 -c 'import os; os.open(*a)'
posix finds=overwrite | python3 -c 'open(*a)'
posix finds=delete | node -e 'eval("require(\\"fs\\").rmSync(\\"/home/me\\")")'
posix finds=delete | python3 -c 'eval("__import__(\\"os\\").remove(\\"/home/me\\")")'
posix finds=delete | python3 -c 'exec("import os\\nos.remove(\\"/home/me\\")")'
# Not read whole by the strict gate: unknown.
posix finds=unknown | python3 -c 'import os; p = os.path; print(p.join("a"))'
posix finds=unknown | python3 -c 'import os, sys; print(sys.argv, os.getcwd())'
posix finds=unknown | python3 -c 'import pathlib; print(list(pathlib.Path(".").glob("*.py")))'
posix finds=unknown | python3 -c 'import os; print([f for f in os.listdir(".") if f.endswith(".pyc")])'
posix finds=unknown | node -e 'console.log(process.argv, require("os").homedir())'
posix finds=unknown | node -e 'JSON.parse(require("fs").readFileSync("package.json"))'
posix finds=unknown | node --input-type=module -e 'import {execSync as e} from "node:child_process"; e("echo")'
posix finds=unknown | node -e 'require("shelljs").rm("-rf", "build")'
posix finds=unknown | node -e 'require("shelljs").mkdir("-p", "build")'
posix finds=unknown | node -e 'require("child_process").execSync("echo hi", {stdio: "inherit"})'
posix finds=unknown | node -e 'require("fs").openSync("in.txt")'
posix finds=unknown | node -e 'require("fs").openSync("/etc/hosts", "r")'
posix finds=unknown | deno eval 'Deno.openSync("/etc/hosts", {read: true})'
posix finds=unknown | deno eval 'Deno.openSync("/etc/hosts", {write: false})'
posix finds=unknown | deno eval 'Deno.openSync("/etc/hosts")'
posix finds=unknown | python3 -c "import os; os.open('/etc/hosts', os.O_RDONLY)"
posix finds=unknown | python3 -c "import os; os.open('/etc/hosts', 0)"
# A default value: a parameter that is called is a function the code is
# handed, and whatever it is, the reader has no row for it.
posix finds=unknown | python3 -c 'def f(p, r=print): r(p)'
posix finds=unknown | python3 -c "import os\ndef f(p, r=os.remove): r(p)\nf('/home/me/.zshrc')"
posix finds=unknown | python3 -c "import os\ndef f(p, *, r=os.remove): r(p)\nf('/home/me/.zshrc')"
posix finds=unknown | python3 -c "import os\ndef f(p, r: object = os.remove): r(p)\nf('/home/me/.zshrc')"
posix finds=unknown | python3 -c "import shutil; f = lambda p, r=shutil.rmtree: r(p)"
posix finds=unknown | python3 -c "(lambda p, r=__import__('shutil').rmtree: r(p))('/home/me')"
# Not read whole by the strict gate: unknown.
posix finds=unknown | python3 -c 'def f(p, r=print): pass'
posix finds=unknown | python3 -c 'f = lambda x, y=1: x'
posix finds=unknown | python3 -c 'def f(a, *args, k: int = 1, **kw): pass'
posix finds=unknown | python3 -c 'def f(open): pass'
# A module handed on as a value is unread.
posix finds=unknown | python3 -c "import os\ndef f(o): o.remove('/home/me/.zshrc')\nf(os)"
posix finds=unknown | python3 -c "import glob\ndef f(g): g.os.remove('/home/me/.zshrc')\nf(glob)"
posix finds=unknown | python3 -c "import os\ndef f(o): o.remove('/home/me/.zshrc')\nf(os.path)"
posix finds=unknown | python3 -c "import sys\n(lambda s: s.modules['os'].remove('/home/me/.zshrc'))(sys)"
posix finds=unknown | python3 -c "(lambda o: o.remove('/home/me/.zshrc'))(__import__('os'))"
posix finds=unknown | python3 -c "import operator, shutil; operator.methodcaller('rmtree','/home/me')(shutil)"
posix finds=unknown | python3 -c "import shutil\nfor m in [shutil]: m.rmtree('/home/me')"
posix finds=unknown | python3 -c "import shutil; [shutil][0].rmtree('/home/me')"
posix finds=unknown | python3 -c "import shutil; d = {'m': shutil}; d['m'].rmtree('/home/me')"
posix finds=unknown | python3 -c "import shutil; t = shutil, 1; t[0].rmtree('/home/me')"
posix finds=unknown | python3 -c "import shutil; m = shutil if x else None; m.rmtree('/home/me')"
posix finds=unknown | python3 -c "import shutil; list(map(getattr(shutil, 'rmtree'), ['/home/me']))"
posix finds=unknown | python3 -c "import sys; sys.modules.get('os').remove('/home/me/.zshrc')"
posix finds=unknown | python3 -c "import os\ndef f(s): s.modules['os'].remove('/home/me/.zshrc')\nf(os.sys)"
# A module another one imported, under the name it imported it by.
posix finds=delete | python3 -c "import tempfile; tempfile._os.remove('/home/me/.zshrc')"
posix finds=delete | python3 -c "import glob; glob.os.remove('/home/me/.zshrc')"
# A chain of names is followed to the end.
posix finds=delete | python3 -c "import os; a = b = os; a.remove('/home/me/.zshrc')"
posix finds=unknown | node -e "(f => f.rmSync('/home/me',{recursive:true}))(require('fs'))"
posix finds=unknown | node -e "Reflect.get(require('fs'),'rmSync')('/home/me',{recursive:true})"
posix finds=unknown | node -e "Object.values(require('child_process'))[0]('rm -rf ~')"
posix finds=unknown | node -e "Object.assign(globalThis, require('fs')); rmSync('/home/me',{recursive:true})"
posix finds=unknown | node -e "const d = {f: require('fs')}; d.f.rmSync('/home/me',{recursive:true})"
posix finds=unknown | node -e "const fs = require('fs'); const o = {fs}; o.fs.rmSync('/home/me',{recursive:true})"
posix finds=unknown | node -e "[require('fs')].forEach(f => f.rmSync('/home/me',{recursive:true}))"
posix finds=unknown | node -e "for (const f of [require('fs')]) f.rmSync('/home/me',{recursive:true})"
posix finds=unknown | node -e "(r => r('fs').rmSync('/home/me',{recursive:true}))(require)"
posix finds=unknown | node -e "(f => f.rmSync('/home/me',{recursive:true}))(process.mainModule)"
posix finds=unknown | node -e "(m => m.require('fs').rmSync('/home/me'))(module)"
posix finds=unknown | node -e "const f = x => x.rmSync('/home/me',{recursive:true}); f(require('fs'))"
posix finds=unknown | node -e "module.exports = require('fs')"
posix finds=unknown | node -e "require('module')._load('fs').rmSync('/home/me',{recursive:true})"
posix finds=unknown | node -e "const fs = (0, require)('fs'); fs.rmSync('/home/me')"
posix finds=unknown | node -e "(async () => (f => f.rmSync('/home/me'))(await import('fs')))()"
posix finds=delete | node -e "const a = b = require('fs'); a.rmSync('/home/me',{recursive:true})"
posix finds=delete | node -e "const r = require; r('fs').rmSync('/home/me',{recursive:true})"
# Not read whole by the strict gate: unknown.
posix finds=unknown | python3 -c 'import os; print(os.path.join("a", "b"))'
posix finds=unknown | python3 -c 'import glob; print(glob.glob("*.py"))'
posix finds=unknown | python3 -c 'import os; o = os; print(o.getcwd())'
posix finds=unknown | python3 -c 'import os; a = b = os; print(a.getcwd(), b.getcwd())'
posix finds=unknown | python3 -c 'import os; print(getattr(os, "getcwd")())'
posix finds=unknown | python3 -c 'import os; print((os).getcwd())'
posix finds=unknown | python3 -c 'try:\n import os\nexcept ImportError:\n os = None'
posix finds=unknown | node -e 'const fs = require("fs"); console.log(fs.readFileSync("a"))'
posix finds=unknown | node -e 'const { readFileSync } = require("fs"); readFileSync("a")'
posix finds=unknown | node -e 'const { readFileSync: r = null } = require("fs"); r("a")'
posix finds=unknown | node -e 'const { a, ...rest } = { a: 1, b: 2 }; console.log(rest)'
posix finds=unknown | node -e 'let fs; fs = require("fs"); fs.readFileSync("a")'
posix finds=unknown | node -e 'console.log(typeof process, typeof require)'
posix finds=unknown | node -e 'process.exit(0)'
posix finds=unknown | node -e 'console.log(require("fs").readdirSync("."))'
posix finds=unknown | node -e 'const p = require("fs").promises; p.readFile("a")'
posix finds=unknown | node -e 'require("fs"); require("os")'
posix finds=unknown | node -e 'const r = require; console.log(r("os").homedir())'
posix finds=unknown | deno eval 'console.log(Deno.cwd(), typeof Deno)'
# A `with` statement and a destructuring with a rest are unread.
posix finds=unknown | node -e "with (require('fs')) rmSync('/home/me',{recursive:true})"
posix finds=unknown | node -e "const fs = require('fs'); with (fs) { rmSync('/home/me') }"
posix finds=unknown | node -e "const {...f} = require('fs'); f.rmSync('/home/me',{recursive:true})"
posix finds=unknown | node -e "const {rmSync, ...f} = require('fs'); f.unlinkSync('/home/me')"
posix finds=unknown | node -e "const {promises: {...p}} = require('fs'); p.rm('/home/me')"
# A default for a member that is not there still names the member.
posix finds=delete | node -e "const {rmSync = null} = require('fs'); rmSync('/home/me',{recursive:true})"
posix finds=delete | node -e "const {rmSync: r = null} = require('fs'); r('/home/me',{recursive:true})"
posix finds=delete | node -e "const {promises: {rm = null}} = require('fs'); rm('/home/me')"
# Every way JavaScript reaches a module: `this` is the global object in
# `node -e`.
posix finds=delete | node -e 'this.require("fs").rmSync("/home/me", {recursive: true})'
posix finds=delete | node -e 'this.eval("require(\\"fs\\").rmSync(\\"/home/me\\",{recursive:true})")'
posix finds=delete | node -e 'this["eval"]("require(\\"fs\\").rmSync(\\"/home/me\\",{recursive:true})")'
posix finds=delete | node -e 'globalThis["require"]("fs").rmSync("/home/me", {recursive: true})'
posix finds=delete | node -e 'globalThis["eval"]("require(\\"fs\\").rmSync(\\"/home/me\\",{recursive:true})")'
posix finds=delete | node -e 'global.global.require("fs").rmSync("/home/me", {recursive: true})'
posix finds=delete | node -e 'globalThis.globalThis.require("fs").rmSync("/home/me", {recursive: true})'
posix finds=delete | node -e 'const g = globalThis; g.require("fs").rmSync("/home/me")'
# `require` through `call`, `apply` and `bind`.
posix finds=delete | node -e 'require.call(null, "fs").rmSync("/home/me", {recursive: true})'
posix finds=delete | node -e 'require.apply(null, ["fs"]).rmSync("/home/me", {recursive: true})'
posix finds=delete | node -e 'require.bind(null)("fs").rmSync("/home/me", {recursive: true})'
posix finds=delete | node -e 'const r = require.bind(null); r("fs").rmSync("/home/me")'
posix finds=delete | node -e 'require.call(null, "child_process").execSync("rm -rf ~")'
posix finds=unknown | node -e 'require.call(null, name)'
posix finds=unknown | node -e 'require.apply(null, args)'
posix finds=unknown | node -e 'require.call(null, ...args)'
# `process.getBuiltinModule`.
posix finds=delete | node -e 'process.getBuiltinModule("fs").rmSync("/home/me", {recursive: true})'
posix finds=delete | node -e 'require("process").getBuiltinModule("fs").rmSync("/home/me")'
posix finds=delete | node -e 'const { getBuiltinModule } = process; getBuiltinModule("fs").rmSync("/home/me")'
posix finds=delete | node -e 'const { rmSync } = process.getBuiltinModule("fs"); rmSync("/home/me")'
posix finds=delete | node -e 'const get = process.getBuiltinModule; get("child_process").execSync("rm -rf ~")'
posix finds=unknown | node -e 'process.getBuiltinModule(name)'
posix finds=unknown | node -e 'f(process.getBuiltinModule)'
# Bun's `import.meta.require`.
posix finds=delete | bun -e 'import.meta.require("fs").rmSync("/home/me", {recursive: true})'
posix finds=unknown | bun -e 'import.meta.require(name)'
posix finds=unknown | bun -e 'f(import.meta.require)'
# The default export of a namespace is the module.
posix finds=delete | node -e 'import * as ns from "fs"; ns.default.rmSync("/home/me", {recursive: true})'
posix finds=delete | node -e 'import { default as f } from "node:fs"; f.rmSync("/home/me")'
posix finds=delete | node -e 'import * as ns from "fs"; const { default: f } = ns; f.rmSync("/home/me")'
posix finds=delete | node -e 'import * as ns from "child_process"; ns.default.execSync("rm -rf ~")'
