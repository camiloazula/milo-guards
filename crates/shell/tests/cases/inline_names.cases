posix finds=unknown | node -e 'x.spawnSync("rm", ["-rf", "~"])'
posix finds=unknown | node -e 'x["rmSync"]("/home/me")'
posix finds=unknown | node -e 'this.rmSync("/home/me")'
posix finds=unknown | node -e 'const r = x.rmSync; r("/home/me")'
posix finds=unknown | node -e 'const { rmSync } = x; rmSync("/home/me")'
