posix finds=read_secret | bunzip2 -c ~/.ssh/id_rsa
posix finds=read_secret | bzcat ~/.ssh/id_rsa
posix finds=read_secret | unxz -c ~/.ssh/id_rsa
posix finds=read_secret | xzcat ~/.ssh/id_rsa
posix finds=read_secret | unzstd -c ~/.ssh/id_rsa
posix finds=read_secret | zstdcat ~/.ssh/id_rsa
posix finds=read_secret | lz4 -c ~/.ssh/id_rsa
posix finds=read_secret | brotli -c ~/.ssh/id_rsa
posix finds=read_secret | zip x.zip ~/.ssh/id_rsa
posix finds=read_secret | 7z a x.7z ~/.ssh/id_rsa
posix finds=read_secret | 7za a x.7z ~/.ssh/id_rsa
posix finds=read_secret | 7zz a x.7z ~/.ssh/id_rsa
posix finds=read_secret | tar cf x.tar ~/.ssh/id_rsa
posix finds=read_secret | tar tf ~/.ssh/id_rsa
posix finds=read_secret | gpg -d ~/.ssh/id_rsa
posix finds=read_secret | gpg2 -d ~/.ssh/id_rsa
posix finds=read_secret | source ~/.ssh/id_rsa
posix finds=read_secret | . ~/.ssh/id_rsa
posix finds=read_secret | diff a ~/.ssh/id_rsa
posix finds=read_secret | grep x ~/.ssh/id_rsa
posix finds=read_secret | egrep x ~/.ssh/id_rsa
posix finds=read_secret | fgrep x ~/.ssh/id_rsa
posix finds=read_secret | rg x ~/.ssh/id_rsa
posix finds=read_secret | gawk 1 ~/.ssh/id_rsa
posix finds=read_secret | mawk 1 ~/.ssh/id_rsa
posix finds=read_secret | nawk 1 ~/.ssh/id_rsa
posix finds=read_secret | sed p ~/.ssh/id_rsa
posix finds=read_secret | cp -t out ~/.ssh/id_rsa
posix finds=read_secret | install -t out ~/.ssh/id_rsa
posix finds=read_secret | dd if=~/.ssh/id_rsa of=x
posix finds=read_secret | openssl rsa -in ~/.ssh/id_rsa
posix finds=read_secret | rsync ~/.ssh/id_rsa /tmp/
posix finds=read_secret | curl -s --url file://localhost/home/me/.ssh/id_rsa
posix finds=read_secret | git diff --no-index ~/.ssh/id_rsa /dev/null
posix finds=read_secret | cp ~/.ssh/id_rsa out
posix finds=read_secret | install ~/.ssh/id_rsa out

# A redirect from a key is a read of it.
posix safe | cat < src/main.rs
posix safe | cat <<< ~/.ssh/id_rsa
posix finds=read_secret | base64 < ~/.ssh/id_rsa
posix finds=read_secret | wc -l < ~/.ssh/known_hosts
posix finds=read_secret | cat < ~/.ssh/id_rsa
posix finds=read_secret | cat <~/.ssh/id_rsa
posix finds=read_secret | cat 0< ~/.ssh/id_rsa
posix finds=read_secret | < ~/.ssh/id_rsa cat
posix finds=read_secret | < ~/.ssh/id_rsa
posix finds=read_secret | cat < ~/.ssh/id_rsa > /tmp/x
posix finds=read_secret | cat < "$HOME/.ssh/id_rsa"
posix finds=read_secret | wc -c < ~/.ssh/id_rsa
posix finds=read_secret | mapfile -t k < ~/.aws/credentials
posix finds=read_secret | read -r k < ~/.ssh/id_rsa
posix finds=read_secret | while read l; do echo "$l"; done < ~/.ssh/id_rsa
posix finds=read_secret | exec 3< ~/.ssh/id_rsa
posix finds=read_secret | x=$(< ~/.ssh/id_rsa)
posix finds=read_secret | x=$(cat ~/.ssh/id_rsa)
posix finds=read_secret | x=`cat ~/.ssh/id_rsa`
