# A quoted redirect source is read with its quotes off. The network check
# reads the same word: a quoted share is a share.
cmd effect=unknown | more < "\\\\server\\share\\x"
cmd effect=unknown | type < "\\\\?\\UNC\\server\\share\\x"
cmd effect=reads_workspace | type < "src\\main.rs"

# A part that can match `..` climbs to the parent. From `~/work/repo` two
# parts climb to the home directory; from a folder below it they climb to a
# folder that holds no key.
posix@sub safe | cat .*/.*/.ssh/id_rsa
posix@sub safe | cat .*rc
posix@sub safe | ls .*
posix@sub finds=read_secret | cat .*/.*/.*/.ssh/id_rsa
posix@sub finds=read_secret | cat .?/.?/.?/.aws/credentials
posix@macos safe | cat .*rc
posix@macos safe | ls .*
posix@macos finds=read_secret | cat .*/.*/.ssh/id_rsa
posix@macos finds=read_secret | cat .?/.?/.ssh/id_rsa
posix@macos finds=read_secret | grep -r x .*/.*/.ssh
# A delete reads the same: the parent is beyond the workspace, and a
# protected path above it is the caller's.
posix@home_folder finds=delete | rm -rf .*/.*/x
posix@home_folder finds=delete | rm -rf .*/.*/.agent
posix@home_folder finds=delete | rm .?/.?/.agent/config.yaml
posix@home_folder finds=delete | ls .* | xargs rm -rf
posix@home_folder first=delete reason="deletes the agent's settings" | rm -rf .*/.*/.agent

# A bare variable and path in PowerShell is read, and the line stays
# unreadable. The grammar cannot read `$HOME\x`: the line is `unreadable` as
# it ever was, whatever is found in it, and it is read again with the word
# quoted, so a key in it is found.
powershell finds=unreadable lacks=read_secret | Get-Content $HOME\\x
powershell finds=unreadable lacks=read_secret | Get-ChildItem $HOME\\.ssh
powershell finds=unreadable lacks=read_secret | Test-Path $HOME\\.zshrc
# A program only known when it runs is that line's finding.
powershell finds=unknown lacks=read_secret | & $HOME\\script.ps1
# The bare-variable cases above (`Get-Content $HOME\...`, `. $HOME\...`)
# are read so too.
powershell finds=read_secret | gc $env:USERPROFILE\\.ssh\\id_rsa
powershell finds=read_secret | & $HOME\\.ssh\\id_rsa
powershell finds=read_secret | & $env:APPDATA\\Microsoft\\Credentials\\x
# A .NET read of a file is a Get-Content of it.
powershell safe | [IO.File]::ReadAllText('README.md')
powershell finds=read_secret | [IO.File]::ReadAllText("$HOME\\.ssh\\id_rsa")
powershell finds=read_secret | [System.IO.File]::ReadAllBytes("$HOME\\.aws\\credentials")

# A folder read all the way down can be the parent when a part can match
# `..`. From `~/work` the parent is the home directory, which holds the
# keys: `..` is read so, and so is a final `.*`, which bash 3.2 and dash
# match against `..`.
posix@work finds=read_secret | grep -r x ..
posix@work finds=read_secret | cp -r .. /tmp/x
posix@work finds=read_secret | tar czf /tmp/x.tgz ..
posix@work finds=read_secret | find .. -exec cat {} +
posix@work finds=read_secret | grep -r x .*
posix@work finds=read_secret | grep -r x .?
posix@work finds=read_secret | grep -r x .[.]
posix@work finds=read_secret | grep -r x .[!a]
posix@work finds=read_secret | cp -r .* /tmp/x
posix@work finds=read_secret | tar czf /tmp/x.tgz .*
posix@work finds=read_secret | find .* -exec cat {} +
posix@work finds=read_secret | find .? -type f | xargs cat
posix@work finds=read_secret | rg -uuu x .*
posix@work finds=read_secret | rg x .?
posix@work finds=read_secret | diff -r .* /tmp/x
posix@work finds=read_secret | cp -r ./.* /tmp/x
posix@work finds=read_secret | cp -r .*/. /tmp/x
# Where the parent holds no key, none of them is a finding: a workspace
# below the home directory's own folder of work, a root of its own, a Mac.
posix@sub lacks=read_secret | grep -r x .*
posix@sub lacks=read_secret | cp -r .* /tmp/x
posix@sub lacks=read_secret | tar czf /tmp/x.tgz .*
posix@sub lacks=read_secret | rg -uuu x .?
posix@root lacks=read_secret | grep -r x .*
posix@root lacks=read_secret | cp -r .* /tmp/x
posix@root lacks=read_secret | tar czf /tmp/x.tgz .*
posix@root lacks=read_secret | rg -uuu x .?
posix@macos lacks=read_secret | grep -r x .*
posix@macos lacks=read_secret | cp -r .* /tmp/x
posix@macos lacks=read_secret | tar czf /tmp/x.tgz .*
posix@macos lacks=read_secret | rg -uuu x .?
# A name that cannot be `..` is not read that way.
posix@work lacks=read_secret | grep -r x .*rc
posix@work lacks=read_secret | cp -r .git* /tmp/x
posix@work lacks=read_secret | rg x .cache
