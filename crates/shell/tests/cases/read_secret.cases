posix finds=read_secret | cat '~'/.ssh/id_rsa
posix finds=read_secret | cat ~/'.ssh'/"id_rsa"
posix finds=read_secret | cat ~/.s"sh"/id_rsa
posix finds=read_secret | cat ~root/.ssh/id_rsa
posix finds=read_secret | cat ~alice/.aws/credentials
posix finds=read_secret | cat ~alice/.ssh
posix finds=read_secret | cat /root/.ssh/id_rsa
posix finds=read_secret | cat /var/root/.ssh/id_rsa
posix finds=read_secret | cat /home/alice/.ssh/id_rsa
posix finds=read_secret | cat /Users/alice/.ssh/id_rsa
# After a `cd`.
posix finds=read_secret | cd ~/.ssh && cat id_rsa
posix finds=read_secret | cd ~/.ssh; cat id_rsa
posix finds=read_secret | cd ~ && cat .ssh/id_rsa
posix finds=read_secret | cd ~/.ssh && cat ./id_rsa
posix finds=read_secret | pushd ~/.ssh >/dev/null; cat id_rsa
posix finds=read_secret | cd ~/.aws && grep key credentials
posix finds=read_secret | cd /etc && cat shadow
posix finds=read_secret | cd / && cat etc/shadow
posix finds=read_secret | cd ~/.ssh && base64 < id_rsa
# A word that only ends in what is known when the line runs.
posix finds=read_secret | cat ~/.ssh/$f
posix finds=read_secret | cat "$HOME/.ssh/$name"
posix finds=read_secret | cat ~/.ssh/${f}.pub
posix finds=read_secret | for f in ~/.ssh/*; do cat "$f"; done
posix finds=read_secret | for f in ~/.ssh/id_rsa ~/.ssh/id_ed25519; do cat $f; done
posix finds=read_secret | for f in id_rsa; do cat ~/.ssh/$f; done
posix finds=read_secret | for f in ~/.ssh/id_rsa; do base64 < "$f"; done

