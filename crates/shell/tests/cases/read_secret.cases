posix finds=read_secret | . ~/.aws/credentials
posix finds=read_secret | dd if=~/.ssh/id_rsa
# A copy reads its sources, whatever it does with them.
posix finds=read_secret | cp ~/.ssh/id_ed25519 ./keys/
posix finds=read_secret | cp ~/.ssh/id_ed25519 keys/id
posix finds=read_secret | cp ~/.ssh/id_ed25519.pub keys/
posix finds=read_secret | cp -t keys ~/.ssh/id_ed25519
posix finds=read_secret | cp -r ~/.ssh keys
posix finds=read_secret | cp a.txt ~/.ssh/id_ed25519 keys/
posix finds=read_secret | install ~/.ssh/id_ed25519 keys/id
