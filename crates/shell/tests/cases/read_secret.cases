posix first=read_secret reason="reads your home directory, and the keys in it" | grep -r BEGIN ~

# The names of a reason (its target is in read_secret.rs).
posix finds=read_secret reason="reads your SSH keys" | cat ~/.ssh/id_ed25519
posix finds=read_secret reason="reads your AWS credentials" | head -c 100 ~/.aws/credentials
posix finds=read_secret reason="reads your saved logins" | grep key ~/.netrc
posix finds=read_secret reason="reads your SSH keys" | base64 < ~/.ssh/id_rsa
posix finds=read_secret reason="reads the system's password hashes" | cat /etc/shadow
posix finds=read_secret reason="reads the kernel's process files" | cat /proc/self/environ
posix finds=read_secret reason="reads a disk, and every key on it" | dd if=/dev/sda
posix finds=read_secret reason="reads your SSH keys" | cp ~/.ssh/id_ed25519 keys/
posix finds=read_secret reason="reads your SSH keys" | ls ~/.ssh | xargs cat

# One finding for one file, however often it is read.
posix rules=read_secret | cat ~/.ssh/id_rsa ~/.ssh/id_rsa; cat ~/.ssh/id_rsa < ~/.ssh/id_rsa

# A read of a key reads only and reaches beyond the workspace. The finding
# says which file, and `effect` does not make the read a change: what it
# says of the program is still what it says. `cat` reads only, beyond the
# workspace; `base64` is not a program it knows, and `cp` changes the disk.
# A key inside a workspace that is the home directory is beyond the project
# as well, and a plain file in it is not; a read that is no secret and stays
# in the workspace is `Workspace`.
posix effect=reads_beyond | cat ~/.ssh/id_ed25519
posix effect=reads_beyond | head -c 100 ~/.aws/credentials
posix effect=reads_beyond | ls ~/.ssh | xargs cat
posix effect=unknown | base64 < ~/.ssh/id_rsa
posix effect=changes | cp ~/.ssh/id_ed25519 keys/
posix effect=reads_beyond | cat ~/.ssh/id_rsa
posix effect=reads_beyond | head -c 10 /etc/shadow
posix effect=reads_beyond | sudo cat ~/.ssh/id_rsa
posix effect=reads_beyond | sudo cat ~/.ssh/id_ed25519
posix effect=reads_workspace | cat src/main.rs
posix@home effect=reads_beyond | cat .ssh/id_rsa
posix@home effect=reads_workspace | cat src/main.rs

