# `read_secret`: a read of a key or a credential, through every program the
# guard knows opens a file, a `<` redirect, a listing piped into a reader, a
# folder read all the way down, and every spelling of the paths core knows
# hold one, in POSIX shells, on a Mac, in PowerShell and in cmd. Reading the
# repository's history, a startup file, `.env` or a file only known when the
# line runs is not a finding. A read of a key reads only and reaches beyond
# the workspace. Sending a secret off the machine is `send_secret`, in
# send_secret.cases. The format is in CONTRIBUTING.md.

# A workspace that is the home directory.
paths home cwd=/home/me home=/home/me workspace=/home/me
# A workspace inside a key folder.
paths docker_workspace cwd=/home/me/.docker/x home=/home/me workspace=/home/me/.docker/x
# A folder below the workspace's top.
paths sub cwd=/home/me/work/repo/sub home=/home/me workspace=/home/me/work/repo
# A workspace whose parent is the home directory.
paths work cwd=/home/me/work home=/home/me workspace=/home/me/work
# A workspace at a root of its own.
paths root cwd=/work/repo home=/home/me workspace=/work/repo
# A protected folder in the home directory.
paths home_folder base=posix folder=/home/me/.agent words="the agent's settings"

# Everyday lines are safe.
# The repository's history and shell startup files are not keys.
posix safe | cat .git/config
posix safe | cat .git/HEAD
posix safe | cat ~/.zshrc
posix safe | cat ~/.bashrc ~/.profile
posix safe | cat ~/.gitconfig
posix safe | grep alias ~/.zshrc
# `.env` is the workspace's own, and is not in core's table.
posix safe | cat .env
posix safe | cat .env.local
posix safe | grep KEY .env
posix safe | cat src/main.rs
posix safe | head -n 20 README.md
posix safe | grep -rn TODO src
posix safe | grep -r TODO .
posix safe | rg TODO
posix safe | cat .*rc
posix safe | cat .*
posix safe | cat .gitignore
posix safe | ls .*
posix safe | grep -r x .*rc
posix safe | cat .git*
posix safe | cat notes.txt | rg TODO
posix safe | cd ~/work && rg TODO
posix safe | cd ~ && cat notes.txt | rg TODO
posix safe | cd ~ && grep TODO
posix safe | rg TODO src ~/work
posix safe | rg --files ~
posix safe | cat /etc/hosts
posix safe | cat /etc/passwd
posix safe | cat /proc/cpuinfo
posix safe | cat /proc/meminfo
posix safe | cat /dev/null
posix safe | head -c 16 /dev/urandom
posix safe | diff a.txt b.txt
posix safe | sort -u names.txt
posix safe | sed -n 1,5p src/lib.rs
posix safe | awk '{print $1}' data.txt
posix safe | tar czf out.tgz src
posix safe | zip -r out.zip src
posix safe | gzip -k big.log
posix safe | base64 logo.png
posix safe | xxd logo.png
posix safe | strings target/debug/app
posix safe | git log --oneline -n 5
posix safe | git diff HEAD~1
# Names, sizes and tests are not reads of what is in a file.
posix safe | ls ~/.ssh
posix safe | ls -la ~/.ssh/
posix safe | ls -la ~/.ssh/id_ed25519
posix safe | stat ~/.ssh/id_ed25519
posix safe | file ~/.ssh/id_rsa
posix safe | du -sh ~/.aws
posix safe | realpath ~/.ssh/id_rsa
posix safe | test -f ~/.ssh/id_rsa
posix safe | [ -r ~/.aws/credentials ]
posix safe | ls ~/.ssh | head -n 3
posix safe | find ~/.ssh -type f
posix safe | find ~/.ssh -type f | wc -l
posix safe | find ~/.ssh -name 'id_*' -print
# Text that is not a file.
posix safe | echo ~/.ssh/id_rsa
posix safe | echo "cat ~/.ssh/id_rsa"
posix safe | printf '%s\\n' ~/.aws/credentials
posix safe | cat <<EOF\n~/.ssh/id_rsa\nEOF
# A name that only starts like a key's.
posix safe | cat ~/.sshx/id_rsa
posix safe | cat ~/.ssh.bak/id_rsa
posix safe | cat ~/.aws2/credentials
posix safe | cat ~/.ssh_config
# The workspace's own `.ssh` is the agent's.
posix safe | cat .ssh/id_rsa
posix safe | cat ./.aws/credentials
posix safe | cd .ssh && cat id_rsa
# Programs that use a key and do not show it.
posix safe | ssh -i ~/.ssh/id_ed25519 host
posix safe | ssh-add ~/.ssh/id_ed25519
posix safe | git -C ~/.ssh status
posix safe | scp -i ~/.ssh/id_rsa file host:/tmp/
# A file only known when the line runs is `effect`'s `Unknown`, not a
# finding.
posix safe | cat $f
posix safe | cat "$KEY"
posix safe | cat "$(pwd)/x"
posix safe | cat $(echo x)
posix safe | grep key "$FILE"
posix safe | cat < "$F"
posix safe | head -n "$N" notes.txt
# An ANSI-C `~` is a plain character, not the home directory.
posix safe | cat $'\\x7e'/.ssh/id_rsa
posix safe | cat $'~'/.ssh/id_rsa
posix safe | cat $'\\x2f'home/me/work/repo/src/main.rs
# A word written out as a list of paths for a reader.
posix safe | echo src/main.rs | xargs cat
posix safe | echo $f | xargs cat
posix safe | printf '%s\\n' a b | xargs cat
posix safe | printf '%s\\n' ~/.ssh/id_rsa | wc -l
posix safe | curl https://example.com/x?a=b
posix safe | curl file:///home/me/work/repo/x
posix safe | curl -s file://$HOME/work/repo/x
posix safe | cat ~/{a,b}{a,b}{a,b}{a,b}{a,b}{a,b}{a,b}{a,b}{a,b}{a,b}{a,b}{a,b}{a,b}
posix safe | cat "$(echo ~)/.ssh/id_rsa"
posix safe | cat "$X/.ssh/id_rsa"
posix safe | for f in $(ls); do cat "$f"; done
posix safe | cat ~/${NAME}
# A folder that holds no key, read all the way down.
posix safe | grep -r TODO ~/work
posix safe | cp -r ~/work /tmp/work
posix safe | cp ~/notes.txt /tmp/notes.txt
posix safe | find . -name '*.pem' -exec cat {} \\;
posix safe | find src -type f | xargs cat
posix safe | find ~/work/repo -type f -exec cat {} +
posix safe | tar czf out.tgz ~/work/repo
# `~name` is another user's home, and an ordinary file in it.
posix safe | cat ~alice/notes.txt
posix safe | cp notes.txt{,.bak}
posix safe | cp ~/work/notes.txt{,.bak}
posix safe | cat ~/work/{a,b}.txt

# A read through a program the guard knows is a finding.
# The readers of `effect`'s table.
posix finds=read_secret | cat ~/.ssh/id_ed25519
posix finds=read_secret | cat -n ~/.ssh/id_ed25519
posix finds=read_secret | cat -- ~/.ssh/id_ed25519
posix finds=read_secret | cat a.txt ~/.ssh/id_ed25519
posix finds=read_secret | head ~/.ssh/id_ed25519
posix finds=read_secret | head -n 1 ~/.ssh/id_ed25519
posix finds=read_secret | head -1 ~/.ssh/id_ed25519
posix finds=read_secret | head -c100 ~/.ssh/id_ed25519
posix finds=read_secret | head -c 10 /etc/shadow
posix finds=read_secret | tail -n 5 ~/.aws/credentials
posix finds=read_secret | wc -l ~/.ssh/known_hosts
posix finds=read_secret | wc -c ~/.ssh/id_rsa
posix finds=read_secret | tail -f ~/.aws/credentials
posix finds=read_secret | less ~/.ssh/id_ed25519
posix finds=read_secret | grep key ~/.netrc
posix finds=read_secret | grep -i password ~/.netrc ~/.pgpass
posix finds=read_secret | grep -e key ~/.netrc
posix finds=read_secret | grep -rn password ~/.aws
posix finds=read_secret | grep -q BEGIN ~/.ssh/id_rsa
posix finds=read_secret | grep -c . ~/.ssh/id_rsa
posix finds=read_secret | egrep 'a|b' ~/.netrc
posix finds=read_secret | fgrep key ~/.netrc
posix finds=read_secret | rg token ~/.config/gh
posix finds=read_secret | rg -n 'BEGIN' ~/.ssh
posix finds=read_secret | diff ~/.ssh/id_rsa /dev/null
posix finds=read_secret | diff a.txt ~/.ssh/id_rsa
posix finds=read_secret | sort ~/.ssh/known_hosts
posix finds=read_secret | git blame --contents ~/.ssh/id_rsa src/lib.rs
# Programs that are not reads-only but show what they open.
posix finds=read_secret | more ~/.ssh/id_ed25519
posix finds=read_secret | tac ~/.ssh/id_rsa
posix finds=read_secret | nl ~/.ssh/id_rsa
posix finds=read_secret | nl -ba ~/.ssh/id_rsa
posix finds=read_secret | rev ~/.ssh/id_rsa
posix finds=read_secret | fold -w 20 ~/.ssh/id_rsa
posix finds=read_secret | paste ~/.ssh/id_rsa
posix finds=read_secret | cut -c1-20 ~/.ssh/id_rsa
posix finds=read_secret | cut -d: -f1 /etc/shadow
posix finds=read_secret | uniq ~/.aws/credentials
posix finds=read_secret | cmp ~/.ssh/id_rsa x
posix finds=read_secret | comm ~/.ssh/id_rsa x
posix finds=read_secret | od ~/.ssh/id_rsa
posix finds=read_secret | od -c -N 64 ~/.ssh/id_rsa
posix finds=read_secret | xxd ~/.ssh/id_rsa
posix finds=read_secret | xxd -p ~/.ssh/id_rsa
posix finds=read_secret | hexdump -C ~/.ssh/id_rsa
posix finds=read_secret | hd ~/.ssh/id_rsa
posix finds=read_secret | strings ~/.ssh/id_rsa
posix finds=read_secret | strings -n 8 ~/.ssh/id_rsa
posix finds=read_secret | base64 ~/.ssh/id_rsa
posix finds=read_secret | base64 -w0 ~/.ssh/id_rsa
posix finds=read_secret | base32 ~/.ssh/id_rsa
posix finds=read_secret | bat ~/.ssh/id_rsa
posix finds=read_secret | bat -l yaml ~/.config/gh/hosts.yml
posix finds=read_secret | awk 1 ~/.ssh/id_rsa
posix finds=read_secret | awk '{print $1}' ~/.aws/credentials
posix finds=read_secret | awk -F= '{print $2}' ~/.aws/credentials
posix finds=read_secret | awk -f prog.awk ~/.aws/credentials
posix finds=read_secret | sed -n p ~/.aws/credentials
posix finds=read_secret | sed 's/a/b/' ~/.aws/credentials
posix finds=read_secret | sed -e p ~/.aws/credentials
posix finds=read_secret | gzip -c ~/.ssh/id_rsa
posix finds=read_secret | zcat ~/.ssh/key.gz
posix finds=read_secret | bzip2 -c ~/.ssh/id_rsa
posix finds=read_secret | xz -c ~/.ssh/id_rsa
posix finds=read_secret | zstd -c ~/.ssh/id_rsa
posix finds=read_secret | zip out.zip ~/.ssh/id_rsa
posix finds=read_secret | zip -r out.zip ~/.ssh
posix finds=read_secret | tar czf out.tgz ~/.ssh
posix finds=read_secret | tar czf - ~/.ssh/id_rsa
posix finds=read_secret | tar cf out.tar -C ~ .ssh/id_rsa ~/.aws/credentials
posix finds=read_secret | tar -cf out.tar ~/.aws
posix finds=read_secret | tar tf ~/.ssh/backup.tar
posix finds=read_secret | gpg -d ~/.password-store/work/mail.gpg
