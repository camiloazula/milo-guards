# A `file:` URL names a file, and `$HOME` in it is known.
posix finds=read_secret | curl file://$HOME/.ssh/id_rsa
posix finds=read_secret | curl file://"$HOME"/.ssh/id_rsa
posix finds=read_secret | curl "file://$HOME/.ssh/id_rsa"
posix finds=read_secret | curl file://${HOME}/.ssh/id_rsa
posix finds=read_secret | curl -s --url file://$HOME/.aws/credentials
posix finds=read_secret | curl file:/etc/shadow
posix finds=read_secret | curl file:///home/me/.ssh/id_rsa
