posix finds=read_secret | trap 'cat ~/.ssh/id_ed25519' EXIT
# A root's read is both, and says so in that order.
posix rules=elevated,read_secret | sudo cat ~/.ssh/id_ed25519

# Every spelling of a key is the key.
