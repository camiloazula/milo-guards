posix finds=read_secret | if true; then cat ~/.ssh/id_ed25519; fi
posix finds=read_secret | for i in 1 2; do cat ~/.ssh/id_ed25519; done
posix finds=read_secret | f() { cat ~/.ssh/id_ed25519; }; f
posix finds=read_secret | cat ~/.ssh/id_ed25519 | head
