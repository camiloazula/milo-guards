# The plain lines beside the limits `limits.rs` searches for: lines left
# open or broken, which are never safe, and the lines a shell reads as plain
# words, which are safe there (what the grammars say, not a guess). The
# format is in CONTRIBUTING.md.

# Left open or broken in every shell. PowerShell has no here-documents and
# cmd no single quotes, so there the delete on the next line is read.
posix finds=unreadable | echo "abc
posix finds=unreadable | { echo
posix finds=unreadable | [[ x
posix finds=unreadable | echo ||
posix finds=unreadable | echo &&
posix finds=unreadable | echo |
posix finds=unreadable | |
posix finds=unreadable | &&
posix finds=unreadable | echo \u{0}
posix finds=unreadable | echo >
posix finds=unreadable | echo <
posix finds=unreadable | if x
posix finds=unreadable | for x in
posix finds=unreadable | echo 'a\nrm -rf /
posix finds=unreadable | cat <<EOF\nrm -rf /
powershell finds=unreadable | echo "abc
powershell finds=unreadable | { echo
powershell finds=unreadable | [[ x
powershell finds=unreadable | echo ||
powershell finds=unreadable | echo &&
powershell finds=unreadable | echo |
powershell finds=unreadable | |
powershell finds=unreadable | &&
powershell finds=unreadable | echo \u{0}
powershell finds=unreadable | echo >
powershell finds=unreadable | echo <
powershell finds=unreadable | if x
powershell finds=unreadable | for x in
powershell finds=unreadable | echo 'a\nrm -rf /
powershell finds=delete | cat <<EOF\nrm -rf /
cmd finds=unreadable | echo "abc
cmd finds=unreadable | { echo
cmd finds=unreadable | [[ x
cmd finds=unreadable | echo ||
cmd finds=unreadable | echo &&
cmd finds=unreadable | echo |
cmd finds=unreadable | |
cmd finds=unreadable | &&
cmd finds=unreadable | echo \u{0}
cmd finds=unreadable | echo >
cmd finds=unreadable | echo <
cmd finds=unreadable | if x
cmd finds=unreadable | for x in
cmd finds=delete | echo 'a\nrm -rf /
cmd finds=unreadable | cat <<EOF\nrm -rf /

# Left open in a POSIX shell and PowerShell: cmd has no `'`, backtick, `$(`
# or `${`, so they are plain words there (below).
posix finds=unreadable | echo 'abc
posix finds=unreadable | echo $(echo
posix finds=unreadable | echo `ls
posix finds=unreadable | echo ${x
posix finds=unreadable | echo (
posix finds=unreadable | echo )
posix finds=unreadable | echo $(
posix finds=unreadable | echo $((1
powershell finds=unreadable | echo 'abc
powershell finds=unreadable | echo $(echo
powershell finds=unreadable | echo `ls
powershell finds=unreadable | echo ${x
powershell finds=unreadable | echo (
powershell finds=unreadable | echo )
powershell finds=unreadable | echo $(
powershell finds=unreadable | echo $((1

# Left open in a POSIX shell only.
posix finds=unreadable | echo \\
posix finds=unreadable | case x
posix finds=unreadable | ;
posix finds=unreadable | echo <<EOF
# PowerShell's grammar reads `<<EOF` as a word, but PowerShell refuses a `<`.
powershell finds=unreadable | echo <<EOF
posix finds=unreadable | echo x <<'EOF'\nrm -rf /

# What a shell reads as plain words is safe there.
cmd safe | echo 'abc
cmd safe | echo `ls
cmd safe | echo $(echo
cmd safe | echo ${x
cmd safe | echo (
powershell safe | echo \\
posix safe | echo }
posix safe | echo x <<'EOF'\nrm -rf /\nEOF

# The plain delete is read: the shells in shells that read start from it.
posix finds=delete lacks=unreadable | rm -rf /

# Everyday finds are far under the work `find -exec` may do.
posix lacks=unreadable | find . -name '*.o' -exec rm {} \\;
posix lacks=unreadable | find src tests docs -type f -name '*.rs' -exec grep -l foo {} +
posix lacks=unreadable | find . -exec find . -exec echo {} \\; \\;

# The counts before parsing skip what the shell reads as a literal, and
# count the rest (`limits.rs` holds the long lines).
posix safe | printf '%s\n' 'a<<b' 'c<<d'
posix safe | cat > x.h <<'EOF'\n#define X(a) ((a) << 1) | \\\n  (a)\nEOF
posix finds=delete | echo ')(' ; rm -rf /
posix finds=delete | cat <<'EOF'\n(\nEOF\nrm -rf /
cmd safe | echo "a & b | (c"
cmd finds=delete | echo "a & b" & rd /s /q C:\\

# Noise the grammars recover from at every token, as each starts at the
# length limit: under the count of recoveries it is read as far as an error
# is, and a finding beside the errors is kept.
powershell rules=unreadable first=unreadable reason="cannot be read in full" | ${a}${a}${a}${a}
powershell rules=unreadable first=unreadable reason="cannot be read in full" | ${a} ${a} ${a} ${a}
powershell rules=unreadable first=unreadable reason="cannot be read in full" | $a${a}$a${a}$a${a}
powershell rules=unreadable first=unreadable reason="cannot be read in full" | {{{{{{{{{{}}}}}}}}}}{{{{{{{{{{}}}}}}}}}}
powershell rules=unreadable first=unreadable reason="cannot be read in full" | 1 2 1 2 1 2
powershell rules=unreadable first=unreadable reason="cannot be read in full" | $a[0]$a[0]$a[0]
posix rules=unreadable,unknown first=unreadable reason="cannot be read in full" | ${a${a${a${a${a${a${a${a${a${a}}}}}}}}}}${a${a${a${a${a${a${a${a${a${a}}}}}}}}}}
powershell finds=unreadable,delete | 1 2 1 2; Remove-Item -Recurse ~
cmd rules=unreadable,unknown first=unreadable reason="cannot be read in full" | for %%i in (a) do for %%i in (a) do for %%i in (a) do\s

# Many redirects on one line. cmd reads a `;` as a space, so each of these
# is one `echo`, but its grammar puts a missing line break before each `echo`
# after a `;`: the line cannot be read in full, and a finding beside the
# errors is kept. At each such `echo` the grammar's lexer also reads on to
# the end of the line, which only costs time: past some kilobytes the budget
# of what it reads stops the line instead ("takes too long to read"). Every
# `>` of one command is judged, in every shell, wherever the one that lands
# outside the workspace is.
cmd rules=unreadable first=unreadable reason="cannot be read in full" | echo y > NUL; echo y > NUL; echo y > NUL;\s
cmd rules=unreadable first=unreadable reason="cannot be read in full" | echo y > out.txt; echo y > out.txt; echo y > out.txt;\s
cmd rules=unreadable,overwrite first=unreadable | echo y > NUL; echo y > ..\\..\\x.txt;\s
cmd rules=unreadable,overwrite first=unreadable | echo y > ..\\..\\x.txt; echo y > NUL;\s
cmd safe | echo y > a > b > c
cmd rules=overwrite | echo y > a > b > ..\\..\\x.txt
cmd rules=overwrite | echo y > a > ..\\..\\x.txt > b
cmd rules=overwrite | echo y > ..\\..\\x.txt > a > b
posix safe | echo y >a >b >c
posix rules=overwrite | echo y >a >b >../../x
posix rules=overwrite | echo y >a >../../x >b
posix rules=overwrite | echo y >../../x >a >b
powershell safe | echo y > a > b > c
powershell rules=overwrite | echo y > a > b > ..\\..\\x.txt
powershell rules=overwrite | echo y > a > ..\\..\\x.txt > b
powershell rules=overwrite | echo y > ..\\..\\x.txt > a > b

# A name a copy gives again and again lands at one path.
posix finds=overwrite reason="writes to a system folder" | cp -r a a a a a a /etc/x
posix safe | cp -r a a a a a a sub/dir/
