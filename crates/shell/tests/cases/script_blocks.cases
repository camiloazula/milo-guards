powershell finds=unknown | Trace-Command -Name ParameterBinding -Expression $b
powershell finds=unknown | Trace-Command -Name ParameterBinding -Exp $b
powershell finds=unknown | Trace-Command ParameterBinding $b
powershell finds=unknown | Trace-Command -Name ParameterBinding $b
powershell finds=unknown | Trace-Command ParameterBinding Get-Date
powershell finds=unknown | Trace-Command -Name ParameterBinding -Command Get-Date
powershell finds=unknown | Trace-Command -Name ParameterBinding -Expression { 1 } @p
