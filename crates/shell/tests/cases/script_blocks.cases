powershell safe | Get-ChildItem | ? -Filter { $_.Length -gt 1 }
# A word first is the property of the comparison form.
powershell safe | Get-ChildItem | ? Name -like '*.rs'
powershell safe | Get-ChildItem | Where-Object Name -eq 'a.rs'
