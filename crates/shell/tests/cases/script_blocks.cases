powershell finds=unknown | 1 | ForEach-Object -Process { 1 } -RemainingScripts { 2 }, $c

# A splat on a cmdlet that runs a block is unknown.
# One block is all these take: a splat beside one adds none.
powershell safe | Invoke-Command { Get-Date } @p
powershell safe | Invoke-Command -ComputerName srv -ScriptBlock { Get-Date } @p
powershell safe | New-Module { function f { 1 } } @p
powershell safe | Measure-Command { cargo build } @p
powershell safe | Set-PSBreakpoint -Script build.ps1 -Line 3 -Action { break } @p
# A splat on a cmdlet that runs no block of its own.
powershell safe | Get-ChildItem @p
powershell safe | Get-Process @p
powershell finds=unknown | Set-PSBreakpoint @p
powershell finds=unknown | Set-PSBreakpoint -Command Get-Date @p
powershell finds=unknown | Set-PSBreakpoint -Script build.ps1 -Line 3 @p
powershell finds=unknown | sbp @p
powershell finds=unknown | Start-Job { 1 } @p
powershell finds=unknown | Start-Job -ScriptBlock { 1 } @p
powershell finds=unknown | Start-Job @p
powershell finds=unknown | Start-ThreadJob { 1 } @p
powershell finds=unknown | Start-ThreadJob -ScriptBlock { 1 } @p
powershell finds=unknown | Register-ScheduledJob -Name nightly -ScriptBlock { 1 } @p
powershell finds=unknown | Invoke-Command @p
powershell finds=unknown | Invoke-Command -ComputerName srv @p
powershell finds=unknown | New-Module @p
powershell finds=unknown | Measure-Command @p
powershell finds=unknown | 1..3 | ForEach-Object { $_ } @p
powershell finds=unknown | 1..3 | ForEach-Object @p
# The event cmdlets keep their own reading of a splat and of a block that is
# not written out.
powershell finds=unknown | Register-EngineEvent PowerShell.Exiting -Action $b
powershell finds=unknown | Register-EngineEvent @p

# Every hook on `InvokeCommand` is read, set or called.
powershell safe | $ExecutionContext.InvokeCommand.LocationChangedAction = { param($s, $e) }
powershell safe | $ExecutionContext.InvokeCommand.set_CommandNotFoundAction({ param($n) })
powershell safe | $ExecutionContext.InvokeCommand.set_PreCommandLookupAction({ param($n) })
powershell safe | $ExecutionContext.InvokeCommand.set_PostCommandLookupAction({ param($n) })
powershell safe | $ExecutionContext.InvokeCommand.set_LocationChangedAction({ param($s, $e) })
powershell safe | $ExecutionContext.InvokeCommand.set_Other($b)
powershell safe | $ExecutionContext.InvokeCommand.Other = $b
powershell finds=unknown | $ExecutionContext.InvokeCommand.LocationChangedAction = $b
powershell finds=unknown | $ExecutionContext.InvokeCommand.LocationChangedAction += $b
powershell finds=unknown | $ExecutionContext.InvokeCommand.LocationChangedAction = (Get-Block)
powershell finds=unknown | $ExecutionContext.InvokeCommand.'LocationChangedAction' = $b
powershell finds=unknown | $ExecutionContext.InvokeCommand.set_CommandNotFoundAction($b)
powershell finds=unknown | $ExecutionContext.InvokeCommand.set_PreCommandLookupAction($b)
powershell finds=unknown | $ExecutionContext.InvokeCommand.set_PostCommandLookupAction($b)
powershell finds=unknown | $ExecutionContext.InvokeCommand.set_LocationChangedAction($b)
powershell finds=unknown | $ExecutionContext.InvokeCommand.set_LocationChangedAction((Get-Block))
powershell finds=unknown | $ExecutionContext.InvokeCommand.set_CommandNotFoundAction()
powershell finds=unknown | $ExecutionContext.InvokeCommand.set_CommandNotFoundAction('x')

# A method name in quotes is the method.
powershell finds=unknown | $ExecutionContext.InvokeCommand.'InvokeScript'('Remove-Item -Recurse -Force ~')
powershell finds=unknown | $ExecutionContext.InvokeCommand."InvokeScript"('Remove-Item -Recurse -Force ~')
powershell finds=unknown | $ExecutionContext.InvokeCommand."NewScriptBlock"($code)
powershell finds=unknown | [scriptblock]::'Create'('Remove-Item -Recurse -Force ~')
powershell finds=unknown | [scriptblock]::"Create"($code)
powershell finds=unknown | $ExecutionContext.InvokeCommand.'set_CommandNotFoundAction'($b)
powershell finds=unknown | $ExecutionContext.InvokeCommand.'ExpandString'($s)
powershell finds=unknown | $b.'Invoke'()
powershell finds=delete | (Get-Item ~).'Delete'()
powershell finds=delete | $ExecutionContext.InvokeCommand.'InvokeScript'('Remove-Item -Recurse -Force ~')
powershell finds=delete | [scriptblock]::'Create'('Remove-Item -Recurse -Force ~')

# A method called by a name known only when it runs is unknown.
powershell safe | $list.Add(1)
powershell safe | $list.'Add'(1)
powershell safe | $list."Add"(1)
powershell safe | $s.Substring(1)
powershell safe | $s."Substring"(1)
powershell safe | [Math]::Max(1, 2)
powershell safe | [Math]::"Max"(1, 2)
# A property read has no argument list: a name only known when it runs is a
# column, not a call.
powershell safe | $row.$col
powershell safe | $row.$col.Name
powershell safe | $row."$col"
powershell safe | $row.($col)
powershell safe | $row.$col = 1
powershell safe | Write-Output $row.$col
powershell finds=unknown | $m='InvokeScript'; $ExecutionContext.InvokeCommand.$m('Remove-Item -Recurse -Force ~')
powershell finds=unknown | $ExecutionContext.InvokeCommand.($m)('Remove-Item -Recurse -Force ~')
powershell finds=unknown | $ExecutionContext.InvokeCommand."$m"('x')
powershell finds=unknown | $ExecutionContext.InvokeCommand."Invoke$('Script')"('Remove-Item -Recurse -Force ~')
powershell finds=unknown | $ExecutionContext.InvokeCommand."Invoke$($m)"('x')
powershell finds=unknown | $m="Delete"; (Get-Item ~).$m()
powershell finds=unknown | $m='Delete'; (Get-Item ~).$m()
powershell finds=unknown | $m='Delete'; [IO.Directory]::$m('C:\\x', $true)
powershell finds=unknown | $t::$m('x')
powershell finds=unknown | $list.$m(1)
powershell finds=unknown | $list.(Get-Name)(1)
powershell finds=unknown | $list.{ Add }(1)
powershell finds=unknown | $list.[string]$m(1)
# A name written out stays the method it names: constant strings, with or
# without quotes, and the escape in a double-quoted one.
powershell finds=unknown | $e.InvokeCommand.InvokeScript('x')
powershell finds=unknown | $e.InvokeCommand.'InvokeScript'('x')
powershell finds=unknown | $e.InvokeCommand."InvokeScript"('x')
powershell finds=unknown | $e.InvokeCommand."Invoke`Script"('x')
powershell finds=delete | (Get-Item ~)."Delete"()
powershell finds=delete | (Get-Item ~)."Del`ete"()

# `ExpandString` runs the subexpressions in its text.
powershell finds=delete,unknown | $ExecutionContext.InvokeCommand.ExpandString('$(Remove-Item -Recurse -Force ~)')
powershell finds=delete,unknown | $ExecutionContext.SessionState.InvokeCommand.ExpandString('a $(Remove-Item -Recurse -Force ~)')
powershell finds=unknown | $ExecutionContext.InvokeCommand.ExpandString($s)
powershell finds=unknown | $ExecutionContext.InvokeCommand.ExpandString('plain text')

# A member name that runs code or deletes is the method called.
powershell safe | Get-ChildItem | % FullName
powershell safe | Get-ChildItem | % -MemberName Length
powershell safe | 'a' | % ToUpper
powershell safe | 'a' | % -MemberName Replace -ArgumentList 'a', 'b'
powershell finds=unknown | $b | ForEach-Object Invoke
powershell finds=unknown | $b | % -MemberName Invoke
powershell finds=unknown | $b | % -MemberName:Invoke
powershell finds=unknown | $b | ForEach-Object InvokeReturnAsIs
powershell finds=unknown | $b | % InvokeWithContext
powershell finds=unknown | $b | % 'Invoke'
powershell finds=unknown | $b | % -Mem Invoke
powershell finds=unknown | $b | % -MemberName $m
powershell finds=delete | Get-ChildItem | % Delete
powershell finds=delete | Get-ChildItem | % -MemberName MoveTo -ArgumentList x
powershell finds=delete | Get-Item HKCU:\\x | % DeleteSubKeyTree

# A member name that builds code or sets a hook is judged.
powershell safe | $ExecutionContext.InvokeCommand | % -MemberName CommandNotFoundAction
powershell safe | $ExecutionContext.InvokeCommand | % CommandNotFoundAction
powershell safe | $ExecutionContext.InvokeCommand | % -MemberName CommandNotFoundAction -ArgumentList { 1 }
powershell safe | $ExecutionContext.InvokeCommand | % -MemberName set_CommandNotFoundAction -ArgumentList { 1 }
powershell safe | $ExecutionContext.InvokeCommand | % set_CommandNotFoundAction { 1 }
powershell finds=unknown | $ExecutionContext.InvokeCommand | % InvokeScript $s
powershell finds=unknown | $ExecutionContext.InvokeCommand | % NewScriptBlock $s
powershell finds=unknown | $ExecutionContext.InvokeCommand | % ExpandString $s
powershell finds=unknown | $ExecutionContext.InvokeCommand | % 'InvokeScript' 'Get-Date'
powershell finds=unknown | $ExecutionContext.InvokeCommand | % -MemberName InvokeScript -ArgumentList $s
powershell finds=unknown | $ExecutionContext.InvokeCommand | % set_CommandNotFoundAction $b
powershell finds=unknown | $ExecutionContext.InvokeCommand | % set_CommandNotFoundAction
powershell finds=unknown | $ExecutionContext.InvokeCommand | % set_LocationChangedAction $b
powershell finds=unknown | $ExecutionContext.InvokeCommand | % -MemberName set_CommandNotFoundAction -ArgumentList $b
powershell finds=unknown | $ExecutionContext.InvokeCommand | % -MemberName CommandNotFoundAction -ArgumentList $b
powershell finds=unknown | $ExecutionContext.InvokeCommand | % CommandNotFoundAction $b
powershell finds=unknown | $ExecutionContext.InvokeCommand | % -MemberName PreCommandLookupAction -Args $b
# The text given as the code is read, whichever way it is written out.
powershell finds=delete,unknown | $ExecutionContext.InvokeCommand | % InvokeScript 'Remove-Item -Recurse -Force ~'
powershell finds=delete,unknown | $ExecutionContext.InvokeCommand | % -MemberName InvokeScript -ArgumentList 'Remove-Item -Recurse -Force ~'
