posix finds=unknown | python3 -X dev -c 'print(1)'
posix finds=unknown | python3 -u -c 'print(1)'
posix finds=unknown | python3 -B -c 'print(1)'
posix finds=unknown | python3 -E -c 'print(1)'
posix finds=unknown | python3 -S -c 'print(1)'
posix finds=unknown | python3 -O -c 'print(1)'
posix finds=unknown | python3 -X importtime -c 'print(1)'
posix finds=unknown | python3 -c 'print(1)' arg
