posix finds=unknown | node -r ./x -e 'console.log(1)'
posix finds=unknown | node --import ./x.mjs -e 'console.log(1)'
posix finds=unknown | node --loader ./x.mjs -e 'console.log(1)'
posix finds=unknown | node --experimental-loader ./x.mjs -e 'console.log(1)'
posix finds=unknown | node --input-type=module -e 'console.log(1)'
posix finds=unknown | node --no-warnings -e 'console.log(1)'
posix finds=unknown | node -e 'console.log(1)' arg
posix finds=unknown | bun --smol -e 'console.log(1)'
posix finds=unknown | bun -r ./x.js -e 'console.log(1)'
posix finds=unknown | deno eval -A 'console.log(1)'
posix finds=unknown | deno eval --allow-all 'console.log(1)'
posix finds=unknown | deno eval --import-map x.json 'console.log(1)'
posix finds=unknown | PYTHONSTARTUP=x.py python3 -c 'print(1)'
posix finds=unknown | FOO=1 python3 -c 'print(1)'
posix finds=unknown | env python3 -c 'print(1)'
posix finds=unknown | env FOO=1 python3 -c 'print(1)'
posix finds=unknown | env -i python3 -c 'print(1)'
posix finds=unknown | export FOO=1; python3 -c 'print(1)'
