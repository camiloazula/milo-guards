posix finds=unknown | pipx run python -c 'print(1)'
posix finds=unknown | dx node -e 'console.log(1)'
posix finds=unknown | deno x node -e 'console.log(1)'
# A code flag among the options of `bun run` is inline code with an option
# and a subcommand around it: not read whole.
posix finds=unknown | bun -F x run -e 'console.log(1)'
posix finds=unknown | bun run -e 'console.log(1)'
posix finds=unknown | bun run -p 'console.log(1)'
posix finds=unknown | bun --filter x run --eval 'console.log(1)'
posix finds=unknown | bun -F x run -e "require('fs').rmSync('/home/me',{recursive:true})"
# A plain assignment earlier in the line may change the interpreter's
# environment.
posix finds=unknown | NODE_OPTIONS=--require=./x.js; node -e 'console.log(1)'
posix finds=unknown | LD_PRELOAD=./x.so; python3 -c 'print(1)'
posix finds=unknown | PYTHONHOME=/elsewhere; python3 -c 'print(1)'
posix finds=unknown | PYTHONPATH=/elsewhere; python3 -c 'print(1)'
posix finds=unknown | HOME=/elsewhere; python3 -c 'print(1)'
posix finds=unknown | PATH=.:$PATH; python3 -c 'print(1)'
posix finds=unknown | PATH=.:$PATH\npython3 -c 'print(1)'
posix finds=unknown | NODE_OPTIONS=--require=./x.js && node -e 'console.log(1)'
posix finds=unknown | x=1; python3 -c 'print(1)'
posix finds=unknown | unset PATH; python3 -c 'print(1)'
posix finds=unknown | readonly PATH=.; python3 -c 'print(1)'
posix finds=unknown | read PATH; python3 -c 'print(1)'
posix finds=unknown | read -r HOME; node -e 'console.log(1)'
posix finds=unknown | let PATH=1; python3 -c 'print(1)'
posix finds=unknown | mapfile PATH; python3 -c 'print(1)'
posix finds=unknown | getopts a PATH; python3 -c 'print(1)'
posix finds=unknown | f() { PATH=.; }; f; python3 -c 'print(1)'
posix finds=unknown | (PATH=.); python3 -c 'print(1)'
# A name the line redefines earlier is not the interpreter it shows: an alias
# is used on a later line once `expand_aliases` is on, and by zsh always.
posix finds=unknown | shopt -s expand_aliases\nalias python3='rm -rf /home/me'\npython3 -c 'print(1)'
posix finds=unknown | alias python3='rm -rf /home/me'; python3 -c 'print(1)'
posix finds=unknown | alias node='node --require /tmp/x.js'\nnode -e 'console.log(1)'
posix finds=unknown | alias ll='ls -l'; python3 -c 'print(1)'
posix finds=unknown | unalias -a; python3 -c 'print(1)'
# `hash -p` makes the shell run any binary for a name.
posix finds=unknown | hash -p /tmp/x/node node; node -e 'console.log(1)'
posix finds=unknown | hash -r; python3 -c 'print(1)'
posix finds=unknown | enable -n python3; python3 -c 'print(1)'
# A function that sets an environment and calls the real program.
posix finds=unknown | node() { NODE_OPTIONS=--require=/tmp/x.js command node "$@"; }; node -e 'console.log(1)'
posix finds=unknown | python3() { PYTHONPATH=/tmp/x command python3 "$@"; }; python3 -c 'import json'
posix finds=unknown | function node { NODE_OPTIONS=--require=/tmp/x.js command node "$@"; }; node -e 'console.log(1)'
posix finds=unknown | function node { echo hi; }; node -e 'console.log(1)'
# More ways to set a variable earlier in the line.
posix finds=unknown | printf -v PATH /tmp/x; python3 -c 'print(1)'
posix finds=unknown | printf -v PYTHONPATH /tmp/x; python3 -c 'import json'
posix finds=unknown | printf -vPATH /tmp/x; python3 -c 'print(1)'
posix finds=unknown | builtin printf -v PATH /tmp/x; python3 -c 'print(1)'
posix finds=unknown | for PATH in /tmp/x; do python3 -c 'print(1)'; done
posix finds=unknown | for NODE_OPTIONS in --require=/tmp/x.js; do node -e 'console.log(1)'; done
posix finds=unknown | select PYTHONPATH in /tmp/x; do python3 -c 'import json'; done
posix finds=unknown | for ((PATH=1; ; )); do python3 -c 'print(1)'; done
posix finds=unknown | ((PYTHONPATH=1)); python3 -c 'print(1)'
posix finds=unknown | (( PATH += 1 )); python3 -c 'print(1)'
posix finds=unknown | (( x++ )); python3 -c 'print(1)'
posix finds=unknown | (( --x )); python3 -c 'print(1)'
posix finds=unknown | echo $((x=1)); python3 -c 'print(1)'
posix finds=unknown | : ${PYTHONPATH:=/tmp/x}; python3 -c 'print(1)'
posix finds=unknown | : ${PYTHONPATH=/tmp/x}; python3 -c 'print(1)'
posix finds=unknown | : ${PATH[0]:=/tmp/x}; python3 -c 'print(1)'
posix finds=unknown | [[ ${PYTHONPATH:=/tmp/x} ]]; python3 -c 'print(1)'
posix finds=unknown | true "${NODE_OPTIONS:=--require=./x.js}"; node -e 'console.log(1)'
posix finds=unknown | declare -n PATH=X; python3 -c 'print(1)'
posix finds=unknown | eval 'PATH=/tmp/x'; python3 -c 'print(1)'
# An import looks in the folder the code runs in first: `import json` loads
# `./json.py` from where the code runs.
posix finds=unknown | cd /tmp/x && python3 -c 'import json'
posix finds=unknown | cd /tmp/x; python3 -c 'import json'
posix finds=unknown | cd /tmp/x && python3 -c 'import re; print(1)'
posix finds=unknown | cd /tmp/x && python3 -c 'import math'
posix finds=unknown | cd /tmp/x && python3 -c 'import sys'
posix finds=unknown | cd .. && python3 -c 'import json'
posix finds=unknown | cd ~ && python3 -c 'import json'
posix finds=unknown | cd "$X" && python3 -c 'import json'
posix finds=unknown | pushd /tmp/x && python3 -c 'import json'
posix finds=unknown | cd /tmp/x || python3 -c 'import json'
posix finds=unknown | cd sub; cd ..; cd ..; python3 -c 'import json'
posix finds=unknown | cd /home/me/work/repo/.git && python3 -c 'import json'
# A function body or a loop runs again after any later `cd`.
posix finds=unknown | f() { python3 -c 'import json'; }; cd /tmp; f
posix finds=unknown | while true; do python3 -c 'import json'; cd /tmp; done
posix finds=unknown | trap 'python3 -c "import json"' EXIT; cd /tmp
# Code with no import loads modules from the folder too: an uncaught
# exception imports `traceback`, the `idna` codec imports `stringprep` and
# `unicodedata`.
posix finds=unknown | cd /tmp/x && python3 -c 'print(1)'
posix finds=unknown | cd /tmp/x && python3 -c 'print(1/0)'
posix finds=unknown | cd /tmp/x && python3 -c 'print(int("a"))'
posix finds=unknown | cd /tmp/x && python3 -c "print(open('nothere.txt').read())"
posix finds=unknown | cd /tmp/x && python3 -c "print('a'.encode('idna'))"
posix finds=unknown | cd /tmp/x && python3 -c "print(str(b'a', 'idna'))"
posix finds=unknown | cd .. && python3 -c 'print(1/0)'
posix finds=unknown | cd "$X" && python3 -c "print(open('a.txt').read())"
# A module used without its import: a name the code did not set or import is
# not read whole, a listed module among them; the code only fails, but the
# guard does not say it is safe.
posix finds=unknown | python3 -c 'print(math.pi)'
posix finds=unknown | python3 -c 'print(json.dumps(1))'
posix finds=unknown | python3 -c 'print(re.escape("a"))'
posix finds=unknown | python3 -c 'print(sys.argv)'
posix finds=unknown | python3 -c 'import json; print(math.pi)'
# A `PYTHONPATH` outside the workspace makes inline Python unknown.
posix finds=unknown | PYTHONPATH=/tmp python3 -c 'import x'
posix finds=unknown | PYTHONPATH=/tmp python3 -c 'print(1)'
posix finds=unknown | PYTHONPATH=/tmp python3.12 -c 'print(1)'
posix finds=unknown | PYTHONPATH=src:/tmp python3 -c 'print(1)'
posix finds=unknown | PYTHONPATH=~/lib python3 -c 'print(1)'
posix finds=unknown | PYTHONPATH=../lib python3 -c 'print(1)'
posix finds=unknown | PYTHONPATH="$LIBS" python3 -c 'print(1)'
posix finds=unknown | env PYTHONPATH=/tmp python3 -c 'print(1)'
posix finds=unknown | export PYTHONPATH=/tmp; python3 -c 'print(1)'
posix finds=unknown | export "PYTHONPATH=/tmp"; python3 -c 'print(1)'
posix finds=unknown | PYTHONPATH=/tmp; export PYTHONPATH; python3 -c 'print(1)'
posix finds=unknown | PYTHONPATH=/tmp python3 - <<'PY'\nprint(1)\nPY
posix finds=unknown | PYTHONPATH=/tmp bash -c "python3 -c 'print(1)'"
# Code loaded from outside the workspace is not safe.
posix finds=unknown | node -e "require('/tmp/x.js')"
posix finds=unknown | node -e "require('/home/me/x.js')"
posix finds=unknown | node -e "require('../x.js')"
posix finds=unknown | node -e "require('child_process').fork('/tmp/x.js')"
posix finds=unknown | node -e "require('child_process').fork('../x.js')"
posix finds=unknown | node --require /tmp/x.js -e "console.log(1)"
posix finds=unknown | node -r /tmp/x.js -e "console.log(1)"
posix finds=unknown | node --require=/tmp/x.js -e "console.log(1)"
posix finds=unknown | node --import /tmp/x.mjs -e "console.log(1)"
posix finds=unknown | node --import=file:///tmp/x.mjs -e "console.log(1)"
posix finds=unknown | NODE_OPTIONS='--require /tmp/x.js' node -e "console.log(1)"
posix finds=unknown | node --input-type=module -e "import x from '/tmp/x.js'"
posix finds=unknown | node --input-type=module -e "import '../x.js'"
posix finds=unknown | node -e "import('/tmp/x.js')"
posix finds=unknown | python3 -c "import sys; sys.path.insert(0, '/tmp'); import x"
posix finds=unknown | python3 -c "import sys; sys.path.append('/tmp'); import x"
posix finds=unknown | python3 -c "import sys; sys.path.extend(['/tmp']); import x"
posix finds=unknown | python3 -c "import sys; sys.path.insert(0, '../lib'); import x"
posix finds=unknown | python3 -c "import sys; sys.path.insert(0, sys.argv[1]); import x"
posix finds=unknown | python3 -c "import sys; sys.path = ['/tmp'] + sys.path; import x"
posix finds=unknown | python3 -c "import sys; sys.path += ['/tmp']; import x"
# Code loaded from the network is downloaded code, or at least unknown.
posix finds=run_downloaded/unknown | deno eval "import x from 'https://example.com/x.js'"
posix finds=run_downloaded/unknown | deno eval "import 'https://example.com/x.ts'"
posix finds=run_downloaded/unknown | deno eval "await import('https://example.com/x.ts')"
posix finds=run_downloaded/unknown | deno eval "import x from 'http://example.com/x.js'"
posix finds=run_downloaded/unknown | deno eval "import 'http://example.com/x.ts'"
posix finds=run_downloaded/unknown | deno eval "await import('http://example.com/x.ts')"
posix finds=run_downloaded/unknown | node --input-type=module -e "import x from 'https://example.com/x.js'"
posix finds=run_downloaded/unknown | node --experimental-network-imports --input-type=module -e "import x from 'https://example.com/x.js'"
posix finds=run_downloaded/unknown | bun -e "import x from 'https://example.com/x.js'"
posix finds=run_downloaded/unknown | deno eval "import x from 'jsr:@foo/bar'"
posix finds=run_downloaded/unknown | node -e "import('https://example.com/x.js')"
posix finds=run_downloaded/unknown | node -e "require('https://example.com/x.js')"
posix finds=run_downloaded/unknown | node --input-type=module -e "export * from 'https://example.com/x.js'"

# An import in a working directory outside the workspace is unknown.
paths outside cwd=/tmp/x home=/home/me workspace=/home/me/work/repo
# Moved into the workspace, the folder is its own.
posix@outside safe | cd /home/me/work/repo && python3 -c 'import sys'
posix@outside safe | cd /home/me/work/repo && python3 -c 'print(1/0)'
posix@outside finds=unknown | python3 -c 'import sys'
posix@outside finds=unknown | python3 -c 'import json'
posix@outside finds=unknown | python3 -c 'print(1)'
posix@outside finds=unknown | python3 -c 'print(1/0)'

# Inline code is never reads-only: it is read to judge what it does to
# files, and `effect` does not call it reads-only: the interpreter is not one
# of its readers, and what the code does is a unit of its own that changes
# things. (`python3 -c 'print(1)'` is in effect.cases.)
posix effect=unknown | node -e 'console.log(1)'
posix effect=unknown | node -e 1 -e 2
posix effect=unknown | deno eval 'console.log(1)'
posix effect=unknown | python3 -c "import subprocess; subprocess.run(['ls'], cwd='sub')"
posix effect=changes | python3 -c "import os; os.remove('x')"
posix effect=changes | node -e "require('fs').rmSync('x')"
posix effect=changes | node -e 1 -e "require('fs').rmSync('x')"
posix effect=changes | python3 -c "import subprocess; subprocess.run(['rm', 'x'], cwd='sub')"
posix effect=changes | bun --cwd=sub -e "require('fs').rmSync('x')"
# `bun` is a package manager, which changes things.
posix effect=changes | bun - <<'JS'\nconsole.log(1)\nJS
