# A runner hands the interpreter an environment of its own (a venv or
# `node_modules/.bin` on `PATH`, npm's config, an `--env-file`).
posix finds=unknown | uv run python -c 'print(1)'
posix finds=unknown | uv run --env-file .env python -c 'print(1)'
posix finds=unknown | uv tool run python -c 'print(1)'
posix finds=unknown | npx node -e 'console.log(1)'
posix finds=unknown | npx --yes node -e 'console.log(1)'
posix finds=unknown | npm exec node -- -e 'console.log(1)'
posix finds=unknown | pnpm exec node -e 'console.log(1)'
posix finds=unknown | pnpm dlx node -e 'console.log(1)'
posix finds=unknown | pnpx node -e 'console.log(1)'
posix finds=unknown | yarn dlx node -e 'console.log(1)'
posix finds=unknown | bunx node -e 'console.log(1)'
posix finds=unknown | bun x node -e 'console.log(1)'
