posix finds=unknown | LD_PRELOAD=./x.so python3 -c 'print(1)'
posix finds=unknown | FOO=1 bash -c "python3 -c 'print(1)'"
posix finds=unknown | env FOO=1 sh -c "node -e 'console.log(1)'"
posix finds=unknown | echo x | xargs python3 -c 'print(1)'
posix finds=unknown | set -a; python3 -c 'print(1)'
# Code that does not parse or is empty.
posix finds=unknown | python3 -c 'if 1:'
posix finds=unknown | python3 -c 'print(1'
posix finds=unknown | python3 -c ''
posix finds=unknown | python3 -c '# nothing'
posix finds=unknown | node -e '{}'
