powershell finds=delete | Remove-Item -Recurse -Force ?git
powershell finds=delete | Remove-Item -Recurse -Force *GIT
powershell finds=delete | Remove-Item -Recurse -Force '[!.]git'
powershell first=delete reason="deletes a hidden file such as the repository's history" | Remove-Item -Recurse -Force '[!.]git'
powershell finds=delete | Remove-Item -Recurse -Force '[^.]git'
powershell finds=delete | Remove-Item -Recurse -Force '`.gi?'
powershell finds=delete | Remove-Item -Recurse -Force ????
