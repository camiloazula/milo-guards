# A filter reads the DOS wildcards of the file system: it reads `<`, `>` and
# `"` as `*`, `?` and `.`, so they can reach the names of `.git`; an include
# reads them as plain characters, and so does cmd's `del` in a quoted name.
# More filters that reach it are in windows_wildcards.rs, made for each
# listing.
powershell safe | Get-ChildItem -Force -Include '<' | Remove-Item -Recurse -Force
powershell safe | Get-ChildItem -Force -Include '.gi<' | Remove-Item -Recurse -Force
powershell safe | Get-ChildItem -Recurse -Force -Include 'HEA<' | Remove-Item -Force
powershell safe | Get-ChildItem -Recurse -Force -Include 'HEA>' | Remove-Item -Force
# A filter with DOS characters that cannot reach `.git`.
powershell safe | Get-ChildItem -Recurse -Force -Filter '*.t>' | Remove-Item -Force
powershell safe | Get-ChildItem -Recurse -Force -Filter 'node_modules"' | Remove-Item -Force
powershell safe | Get-ChildItem -Recurse -Force -Filter 'x<.tmp' | Remove-Item -Force
powershell safe | Get-ChildItem -Force -Filter 'b>>n' | Remove-Item -Force
powershell finds=delete | Get-ChildItem -Recurse -Force -Filter "HEA<" | Remove-Item -Recurse -Force
powershell finds=delete | Get-ChildItem -Recurse -Force -Filter 'HEA>' | Remove-Item -Force
powershell finds=delete | Get-ChildItem -Recurse -Force -Filter "a<" | Remove-Item -Force
powershell finds=delete | Get-ChildItem -Recurse -Force -Filter "o<" | Remove-Item -Force
powershell finds=delete | Get-ChildItem -Recurse -Force -Filter 'HEAD"' | Remove-Item -Force
powershell finds=delete | Get-ChildItem -Recurse -Force -Filter 'conf>>>' | Remove-Item -Force
cmd safe | del /s /q "foo<.obj"
cmd safe | del /s /q "a>>.txt"
cmd safe | del /s /q "*.ob>"
cmd finds=delete | del /s /q "HEA>"
cmd finds=delete | del /s /q "HEA<"
cmd finds=delete | del /s /q "<"
cmd finds=delete | del /s /q "conf>>>"
cmd finds=delete | del /s /q "mai<"

# Every dot before a wildcard can match nothing, as in DOS, in a filter and in
# `del`; a dot before a literal stays a plain dot. More filters, and a long
# one, are in windows_wildcards.rs.
powershell finds=delete | Get-ChildItem -Recurse -Force -Filter HEAD.*.* | Remove-Item -Force
powershell finds=delete | Get-ChildItem -Force -Filter *.*.*.* | Remove-Item -Recurse -Force
powershell safe | Get-ChildItem -Recurse -Force -Filter *.obj | Remove-Item -Force
powershell safe | Get-ChildItem -Recurse -Force -Filter *.tmp | Remove-Item -Force
powershell safe | Get-ChildItem -Recurse -Force -Filter test.*.js | Remove-Item -Force
cmd safe | del /s /q test.*.js
cmd finds=delete | del /s /q HEAD.*.*
cmd finds=delete | del /s /q config.*.*
cmd finds=delete | del /s /q *.?.?
cmd finds=delete | del /s /q *.*.*.*

# `del /s` from the workspace spelt as a long path reaches the history.
cmd safe | del /s /q \\\\?\\C:\\Users\\me\\dev\\repo\\src\\HEAD
cmd finds=delete | del /s /q \\\\?\\C:\\Users\\me\\dev\\repo\\HEAD
cmd finds=delete | del /s /q "\\\\?\\C:\\Users\\me\\dev\\repo\\HEAD"
cmd finds=delete | del /s /q //?/C:/Users/me/dev/repo/HEAD
cmd finds=delete | del /s /q \\\\?\\c:\\users\\me\\dev\\repo\\HEAD
cmd finds=delete | del /s /q \\\\?\\C:\\Users\\me\\dev\\repo\\config
cmd finds=delete | del /s /q \\\\?\\C:\\Users\\me\\dev\\repo\\??
powershell finds=delete | cmd /c del /s /q \\\\?\\C:\\Users\\me\\dev\\repo\\HEAD
