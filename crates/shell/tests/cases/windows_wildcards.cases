# Which names a Windows wildcard matches. Windows has no hidden dot names, so
# `*git` matches `.git`, `*.*` is every entry, and a wildcard part is trimmed
# of its trailing dots and spaces like a last part; a pattern can match `.git`
# by its 8.3 short name. A listing piped into a delete is judged as the delete
# of its pattern: a filtered or attribute-selected PowerShell listing reaches
# `.git` when it lists hidden entries and its filter can match a name there
# (the file system's short names and DOS wildcards included), and cmd's
# `del /s` from the workspace reaches the files of `.git` its pattern can
# match, by cmd's own wildcard rules. The format is in CONTRIBUTING.md.

# A working directory inside `.git`.
paths in_git cwd=C:\\Users\\me\\dev\\repo\\.git\\hooks home=C:\\Users\\me workspace=C:\\Users\\me\\dev\\repo

# A Windows wildcard can match a dot name.
powershell safe | Remove-Item -Recurse *.tmp
powershell safe | Remove-Item -Recurse -Force *.TMP
powershell safe | Remove-Item -Recurse -Force *gitx
powershell safe | Remove-Item -Recurse -Force ?git2
powershell safe | Remove-Item -Recurse -Force '[!x]git'
powershell safe | Remove-Item -Recurse -Force *\\bin, *\\obj
