# `Get-ChildItem` takes `-Depth` and `-Attributes` with a value: the value is
# no place, so the folder is the working directory.
powershell effect=reads_workspace | Get-ChildItem -Depth 2
powershell effect=reads_workspace | gci -dep 2
powershell effect=reads_workspace | ls -Attributes Hidden
powershell effect=reads_workspace | dir -at !System
powershell effect=reads_workspace | gci -Attributes Hidden+System src
powershell@in_windows effect=reads_beyond | Get-ChildItem -Depth 2
powershell@in_windows effect=reads_beyond | gci -Attributes Hidden
# A value that is a path is a place.
powershell effect=reads_beyond | Get-ChildItem -Depth C:\\Windows
powershell effect=reads_beyond | gci -Attributes ~
powershell effect=reads_beyond | gci -at ..\\x

# A path relative to the repository's root is read from the root too, as in
# reach.cases: a path git reads from the root is judged from the working
# directory and from each workspace folder.
powershell@proj effect=reads_beyond | git show HEAD:.ssh/id_rsa
powershell@proj effect=reads_beyond | git show :/.ssh/id_rsa
powershell@proj effect=reads_workspace | git show HEAD:src/lib.rs
powershell@proj effect=reads_workspace | git show :/src/lib.rs
