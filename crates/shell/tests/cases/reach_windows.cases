# The reach of a PowerShell or cmd line that only reads: where its reads land
# from the workspace and from other working directories, a protected `.agent`
# at the workspace's root (the workspace's own), a Windows wildcard that
# matches a hidden name and so reaches a hidden folder that holds a secret,
# and the values of `Get-ChildItem -Depth` and `-Attributes`. The plain
# readers of the plain workspace are in effect.cases; POSIX is in
# reach.cases. The format is in CONTRIBUTING.md.

# A Windows machine whose agent runs in another folder, in the workspace
# `C:\Users\me\dev\repo`.
paths in_src cwd=C:\\Users\\me\\dev\\repo\\src home=C:\\Users\\me workspace=C:\\Users\\me\\dev\\repo
paths in_src_cased cwd=c:\\users\\me\\dev\\REPO\\src home=C:\\Users\\me workspace=C:\\Users\\me\\dev\\repo
paths in_repo2 cwd=C:\\Users\\me\\dev\\repo2 home=C:\\Users\\me workspace=C:\\Users\\me\\dev\\repo
paths in_dev cwd=C:\\Users\\me\\dev home=C:\\Users\\me workspace=C:\\Users\\me\\dev\\repo
paths in_home cwd=C:\\Users\\me home=C:\\Users\\me workspace=C:\\Users\\me\\dev\\repo
paths in_windows cwd=C:\\Windows home=C:\\Users\\me workspace=C:\\Users\\me\\dev\\repo
paths in_c cwd=C:\\ home=C:\\Users\\me workspace=C:\\Users\\me\\dev\\repo
paths in_d cwd=D:\\work home=C:\\Users\\me workspace=C:\\Users\\me\\dev\\repo
# The plain workspace with a protected `.agent` folder at its root; a machine
# whose workspace is the home folder; one whose workspace is
# `AppData\Roaming`, which holds `gcloud`'s login; and one that runs in
# `~\proj` with the home folder as the workspace.
paths agent base=windows folder=C:\\Users\\me\\dev\\repo\\.agent words="the agent's settings"
paths home_workspace cwd=C:\\Users\\me home=C:\\Users\\me workspace=C:\\Users\\me
paths roaming cwd=C:\\Users\\me\\AppData\\Roaming home=C:\\Users\\me workspace=C:\\Users\\me\\AppData\\Roaming
paths proj cwd=C:\\Users\\me\\proj home=C:\\Users\\me workspace=C:\\Users\\me

# PowerShell reads say where they land.
powershell effect=reads_workspace | Get-ChildItem src
powershell effect=reads_workspace | Get-ChildItem -Path src
powershell effect=reads_workspace | Get-ChildItem .
powershell effect=reads_workspace | Get-ChildItem .\\src
powershell effect=reads_workspace | Get-ChildItem C:\\Users\\me\\dev\\repo
powershell effect=reads_workspace | Get-ChildItem C:\\Users\\me\\dev\\repo\\src
