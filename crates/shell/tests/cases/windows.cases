cmd@on_d finds=delete | del /q C:*
# `del *.obj`, `rd /s /q C:x` and `del D:*.obj` from D: are in cd.cases: cmd
# keeps a working directory for each drive and the line never shows where it
# is, so `D:*.obj` is unknown even on D:.
# On C:, `C:x` is `x` from the working directory.
powershell safe | Remove-Item C:*.log
powershell safe | Remove-Item -Recurse c:target
powershell safe | Remove-Item -Recurse C:build\\*.obj
powershell safe | Get-ChildItem C:*.log | Remove-Item
powershell finds=delete | Remove-Item -Recurse C:*
