powershell@in_app first=delete reason="deletes the root of the disk" | Get-ChildItem -Recurse C:\\* | Remove-Item -Recurse
powershell@in_app first=delete reason="deletes the root of the disk" | Get-ChildItem FileSystem::C:\\* | Remove-Item -Recurse
powershell@in_app first=delete reason="deletes the root of the disk" | Get-ChildItem Microsoft.PowerShell.Core\\FileSystem::C:\\* | Remove-Item -Recurse

# A script run from a place the guard cannot read is risky.
powershell safe | cd sub; cargo test
powershell safe | cd C:\\Users\\me\\dev\\repo\\sub; bash C:\\Users\\me\\dev\\repo\\sub\\x.sh
powershell finds=unknown | cd C:; 'x' > i.sh; bash C:i.sh
powershell finds=unknown | cd sub; 'x' > i.sh; bash C:i.sh
powershell finds=unknown | cd $x; 'x' > i.sh; bash i.sh
cmd finds=unknown | cd C: & echo x > i.sh & bash C:i.sh

# A Windows script run after a `cd` to an unknown place needs a write to be
# risky.
powershell safe | Set-Location $PSScriptRoot; python x.py
powershell safe | cd $dir; bash x.sh 2>$null
powershell finds=unknown | cd $dir; 'x' > i.sh; bash i.sh
powershell finds=unknown | 'x' > i.sh; cd $dir; bash ..\\i.sh
powershell finds=unknown | cd $dir; bash x.sh > $out
cmd safe | cd %X% & python run.py
cmd finds=unknown | cd %X% & echo x > i.sh & bash i.sh
# A device is no write that could be a script: only the unplaceable `cd` is
# found for it, never an unknown script.
powershell lacks=unknown | cd $dir; bash x.sh > $null
powershell lacks=unknown | cd $dir; python x.py > NUL
cmd lacks=unknown | cd %X% & bash x.sh > nul

# Windows drops trailing dots and spaces from a name: `.git.` and `.git ` are
# `.git`; the same names elsewhere are the plain names they were.
powershell safe | Remove-Item notes.txt.
powershell safe | Remove-Item 'build '
powershell safe | Remove-Item -Recurse 'target. .'
powershell safe | Remove-Item -Recurse -Force src\\.git.
powershell safe | Remove-Item -Recurse build
powershell finds=delete | Remove-Item -Recurse -Force .git.
powershell finds=delete | Remove-Item -Recurse -Force '.git '
powershell finds=delete | Remove-Item -Recurse -Force '.GIT. .'
powershell finds=delete | Remove-Item -Recurse -Force .git...
powershell finds=delete | Remove-Item -Recurse -Force '.\\.git .\\objects'
powershell finds=delete | Remove-Item -Recurse -Force src\\..\\.git.
powershell finds=delete | Remove-Item -Recurse -Force 'src\\.. \\.git'
powershell finds=delete | Remove-Item -Recurse -Force '.git.\\config'
powershell finds=delete | Remove-Item -Recurse -Force ~\\.ssh.
cmd safe | del notes.txt.
cmd safe | del /q "notes.txt "
cmd safe | rd /s /q target
cmd safe | rd /s /q target.
cmd safe | del /q build\\*.obj.
cmd safe | del C:\\Users\\me\\dev\\repo\\build.
cmd safe | del src\\.git.
cmd finds=delete | rd /s /q .git.
cmd finds=delete | rd /s /q ".git "
cmd finds=delete | rd /s /q .git. .
cmd finds=delete | rd /s /q .git\\objects.
cmd finds=delete | rd /s /q C:\\Users\\me\\dev\\repo\\.git.
cmd finds=delete | rd /s /q %USERPROFILE%\\.ssh.
cmd finds=delete | rd /s /q src\\..\\.git.
cmd finds=delete | rd /s /q src\\..\s
cmd finds=overwrite | echo x > .git.\\config

# A short name can be the repository's history: `.git` has the short name
# `GIT~1` (the dot is not kept). A short name whose name part cannot be that
# of `.git`, or one not directly in the workspace folder, is a plain name.
powershell safe | Remove-Item PROGRA~1.txt
powershell safe | Remove-Item -Recurse PROGRA~1
powershell safe | Remove-Item -Recurse GI~1
powershell safe | Remove-Item -Recurse GITX~
powershell safe | Remove-Item -Recurse GIT~
powershell safe | Remove-Item -Recurse GIT~1.txt
powershell safe | Remove-Item -Recurse GIT~1a
powershell safe | Remove-Item -Recurse GITIGN~1
powershell safe | Remove-Item -Recurse GITHUB~1
powershell safe | Remove-Item -Recurse GI3F2~1
powershell safe | Remove-Item -Recurse GIZZZZ~1
powershell safe | Remove-Item -Recurse src\\GIT~1
powershell finds=delete | Remove-Item -Recurse -Force GIT~1
powershell finds=delete | Remove-Item -Recurse -Force git~2
powershell finds=delete | Remove-Item -Recurse -Force Git~10
powershell finds=delete | Remove-Item -Recurse -Force GI3F2A~1
powershell finds=delete | Remove-Item -Recurse -Force gi3f2a~12\\objects
powershell finds=delete | Remove-Item -Recurse -Force GIT~1\\objects
powershell finds=delete | Remove-Item -Recurse -Force GIT~1.
powershell finds=delete | Remove-Item -Recurse -Force src\\..\\GIT~1
powershell finds=delete | Remove-Item -Recurse -Force C:\\Users\\me\\dev\\repo\\GIT~1
cmd safe | del PROGRA~1.txt
cmd safe | rd /s /q PROGRA~1
cmd safe | rd /s /q GI~1
cmd safe | rd /s /q GIT~1.txt
cmd safe | rd /s /q src\\GIT~1
cmd safe | del /q build\\GIT~1.obj
cmd safe | del /q GITHUB~1\\workflows\\ci.yml
cmd safe | del .gitignore GITIGN~1
cmd finds=delete | rd /s /q GIT~1
cmd finds=delete | rd /s /q git~3
cmd finds=delete | rd /s /q GI3F2A~1
cmd finds=delete | del /s /q gi3f2a~1\\objects\\pack
cmd finds=delete | rd /s /q GIT~1\\
cmd finds=delete | del /s /q GIT~1\\objects\\pack
cmd finds=overwrite | echo x > GIT~1\\config

# A stream suffix is known only when it runs.
powershell safe | Remove-Item C:\\Users\\me\\dev\\repo\\build
powershell safe | Remove-Item FileSystem::.\\build -Recurse
powershell finds=delete | Remove-Item -Recurse -Force .git::$INDEX_ALLOCATION
powershell finds=delete | Remove-Item -Recurse -Force '.git:$I30:$INDEX_ALLOCATION'
powershell finds=delete | Remove-Item notes.txt:stream
powershell finds=delete | Remove-Item build\\notes.txt:stream
powershell finds=delete | Remove-Item C:\\Users\\me\\dev\\repo\\notes.txt:stream
powershell finds=overwrite | Set-Content -Path notes.txt:hidden -Value hi
cmd safe | del C:\\Users\\me\\dev\\repo\\build\\x.obj
cmd safe | rd /s /q C:\\Users\\me\\dev\\repo\\target
cmd finds=delete | rd /s /q .git::$INDEX_ALLOCATION
cmd finds=delete | rd /s /q .git:$I30:$INDEX_ALLOCATION
cmd finds=delete | del notes.txt:stream
cmd finds=delete | del build\\notes.txt:stream
cmd finds=delete | del C:\\Users\\me\\dev\\repo\\notes.txt:stream
cmd finds=delete | del \\\\server\\share\\notes.txt:stream
cmd finds=overwrite | echo x > notes.txt:hidden

# Windows trims only the spaces it knows: a non-breaking space (U+00A0) or an
# ideographic one (U+3000) is part of a name to Windows, so these are plain
# names.
powershell safe | Remove-Item -Recurse -Force '.git\u{a0}'
powershell safe | Remove-Item -Recurse -Force '.git\u{3000}'
powershell safe | Remove-Item -Recurse -Force '.git\u{a0}\\objects'
cmd safe | rd /s /q ".git\u{a0}"
cmd safe | rd /s /q ".git\u{3000}"
cmd safe | rd /s /q ".git\u{3000}."

# A long path prefix is outside the workspace: `\\?\` is read as a share,
# which is outside: risky, as it was.
cmd finds=delete | rd /s /q \\\\?\\C:\\Users\\me\\dev\\repo\\.git.
cmd finds=delete | rd /s /q \\\\?\\C:\\Users\\me\\dev\\repo\\GIT~1
powershell finds=delete | Remove-Item -Recurse -Force '\\\\?\\C:\\Users\\me\\dev\\repo\\.git.'

# A letter NTFS does not fold is not the workspace's letter. The Kelvin sign,
# the Ångström sign, the Ohm sign and the capital sharp s look like `k`, `å`,
# `ω` and `ß` to the widest case fold, but not to NTFS: a folder by those
# names is another folder, so deleting it is a delete beyond the workspace.
cmd@work safe | rd /s /q C:\\Users\\me\\work\\x
cmd@work finds=delete | rd /s /q C:\\Users\\me\\wor\u{212a}\\x
cmd@work finds=delete | rd /s /q C:\\Users\\me\\wor\u{212a}
powershell@work safe | Remove-Item -Recurse -Force C:\\Users\\me\\work\\x
powershell@work finds=delete | Remove-Item -Recurse -Force C:\\Users\\me\\wor\u{212a}\\x
powershell@work finds=delete | Remove-Item -Recurse -Force C:\\Users\\me\\wor\u{212a}
