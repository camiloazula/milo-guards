cmd@on_d_with_c finds=delete | C: & rd /s /q ws\\sub
cmd@on_d_with_c finds=delete | rd /s /q C:
# On C:, the bare drive is the working directory, the workspace itself.
powershell first=delete reason="deletes the whole workspace" | Remove-Item -Recurse C:

