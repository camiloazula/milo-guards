powershell@in_app first=delete reason="deletes the root of the disk" | Get-ChildItem C:\\* | Remove-Item -Recurse
powershell@in_app first=delete reason="deletes the root of the disk" | Get-ChildItem -Path C:\\* | Remove-Item -Recurse
powershell@in_app first=delete reason="deletes the root of the disk" | Get-ChildItem C:/* | Remove-Item -Recurse
