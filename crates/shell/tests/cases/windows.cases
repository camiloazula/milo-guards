# Windows trims only the spaces it knows: a non-breaking space (U+00A0) or an
# ideographic one (U+3000) is part of a name to Windows, so these are plain
# names.
powershell safe | Remove-Item -Recurse -Force '.git\u{a0}'
powershell safe | Remove-Item -Recurse -Force '.git\u{3000}'
powershell safe | Remove-Item -Recurse -Force '.git\u{a0}\\objects'
cmd safe | rd /s /q ".git\u{a0}"
cmd safe | rd /s /q ".git\u{3000}"
cmd safe | rd /s /q ".git\u{3000}."

# A long path prefix is outside the workspace: `\\?\` is read as a share,
# which is outside: risky, as it was.
