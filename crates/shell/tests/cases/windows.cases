powershell finds=delete | Get-ChildItem C:.g* | Remove-Item -Recurse
powershell finds=delete | Get-ChildItem -Force C:.* | Remove-Item -Recurse
powershell finds=delete | Remove-Item -Recurse C:
powershell finds=delete | Remove-Item -Recurse D:target
powershell finds=unknown | 'x' > C:i.sh; bash i.sh
# A `cd` moves where `C:x` lands.
powershell finds=delete | cd C:..; Remove-Item -Recurse C:x
powershell finds=delete | cd ..\\..; Remove-Item -Recurse C:x
powershell finds=delete | cd C:..\\..\\..; Remove-Item -Recurse x

