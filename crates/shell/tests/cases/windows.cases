cmd finds=delete | rd /s /q \\\\?\\C:\\Users\\me\\dev\\repo\\GIT~1
powershell finds=delete | Remove-Item -Recurse -Force '\\\\?\\C:\\Users\\me\\dev\\repo\\.git.'

# A letter NTFS does not fold is not the workspace's letter. The Kelvin sign,
# the Ångström sign, the Ohm sign and the capital sharp s look like `k`, `å`,
# `ω` and `ß` to the widest case fold, but not to NTFS: a folder by those
# names is another folder, so deleting it is a delete beyond the workspace.
cmd@work safe | rd /s /q C:\\Users\\me\\work\\x
cmd@work finds=delete | rd /s /q C:\\Users\\me\\wor\u{212a}\\x
