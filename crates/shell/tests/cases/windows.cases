powershell finds=delete | Remove-Item -Recurse -Force git~2
powershell finds=delete | Remove-Item -Recurse -Force Git~10
powershell finds=delete | Remove-Item -Recurse -Force GI3F2A~1
powershell finds=delete | Remove-Item -Recurse -Force gi3f2a~12\\objects
powershell finds=delete | Remove-Item -Recurse -Force GIT~1\\objects
powershell finds=delete | Remove-Item -Recurse -Force GIT~1.
powershell finds=delete | Remove-Item -Recurse -Force src\\..\\GIT~1
powershell finds=delete | Remove-Item -Recurse -Force C:\\Users\\me\\dev\\repo\\GIT~1
cmd safe | del PROGRA~1.txt
cmd safe | rd /s /q PROGRA~1
cmd safe | rd /s /q GI~1
cmd safe | rd /s /q GIT~1.txt
cmd safe | rd /s /q src\\GIT~1
cmd safe | del /q build\\GIT~1.obj
