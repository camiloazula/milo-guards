# Where the relative paths of inline code land: `bun --cwd` moves the code
# first, `os.chdir` and the other ways Python changes directory (`fchdir`,
# `contextlib.chdir`, a directory handle) move what comes after, a `chdir`
# is not where the code sits (a function, a loop, a handler), a `chdir` in
# nested code is read rather than searched for, and a relative read after a
# `chdir` the reader cannot place is unknown. The format is in
# CONTRIBUTING.md.

# A relative path of inline code is counted from where the code has moved.
# `bun --cwd` moves the code first.
posix finds=delete | bun --cwd=/home/me -e "require('fs').rmSync('x',{recursive:true})"
posix finds=delete | bun --cwd /home/me -e "require('fs').rmSync('x',{recursive:true})"
posix finds=delete | bun -e "require('fs').rmSync('x',{recursive:true})" --cwd=/home/me
posix finds=unknown | bun --cwd "$DIR" -e 'require("fs").rmSync("x")'
# Not read whole by the strict gate: unknown.
posix finds=unknown | bun --cwd=sub -e 'require("fs").rmSync("x")'
posix finds=unknown | bun --cwd sub -e 'require("fs").rmSync("x")'
posix finds=unknown | bun --cwd=/home/me/work/repo -e 'require("fs").rmSync("x")'
# Python changes directory in other ways. A file opened from a directory
# handle is a file the guard cannot name: its path is counted from a place
# only known when the code runs, and a read of one is `unknown`.
posix finds=unknown | python3 -c "import os; os.open('x.txt', os.O_RDONLY, dir_fd=3)"
# `os.fchdir` goes to a directory only known when it runs.
posix finds=delete | python3 -c "import os, shutil; os.fchdir(os.open('/home/me', os.O_RDONLY)); shutil.rmtree('.ssh')"
posix finds=delete | python3 -c "import os, shutil; os.fchdir(fd); shutil.rmtree('.ssh')"
posix finds=delete | python3 -c "import os; os.chdir(os.open('/home/me', os.O_RDONLY)); os.remove('.zshrc')"
# `contextlib.chdir(D)` is a `chdir` to `D`.
posix finds=delete | python3 -c "import contextlib, os, shutil\nwith contextlib.chdir(os.path.expanduser('~')): shutil.rmtree('.ssh')"
posix finds=delete | python3 -c "import contextlib, shutil\nwith contextlib.chdir('/home/me'): shutil.rmtree('.ssh')"
posix finds=delete | python3 -c "from contextlib import chdir; import os\nwith chdir('/home/me'):\n    os.remove('.zshrc')"
# A path counted from a directory handle is only known when it runs.
posix finds=delete | python3 -c "import os; os.unlink('.zshrc', dir_fd=os.open('/home/me', os.O_RDONLY))"
posix finds=delete | python3 -c "import os; os.remove('.zshrc', dir_fd=fd)"
posix finds=delete | python3 -c "import os; os.rmdir('.ssh', dir_fd=os.open('/home/me', os.O_RDONLY))"
posix finds=overwrite | python3 -c "import os; os.open('.zshrc', os.O_WRONLY | os.O_TRUNC, dir_fd=os.open('/home/me', os.O_RDONLY))"
posix finds=delete | python3 -c "import shutil; shutil.rmtree('.ssh', dir_fd=fd)"
posix finds=delete | python3 -c "import os; os.rename('a', 'b', src_dir_fd=fd)"
posix finds=delete | python3 -c "import os; os.rename('a', 'b', dst_dir_fd=fd)"
posix finds=overwrite | python3 -c "import os; os.mkdir('.ssh', dir_fd=fd)"
# Not read whole by the strict gate: unknown.
posix finds=unknown | python3 -c "import os; os.unlink('x.log')"
posix finds=unknown | python3 -c "import os; os.scandir('.')"
# A `chdir` is not where the code sits. A function defined before the
# `chdir` and called after it.
posix finds=delete | python3 -c "import os, shutil\ndef g(): shutil.rmtree('.ssh')\nos.chdir('/home/me')\ng()"
# A later pass of a loop, after the first pass's `chdir`.
posix finds=delete | python3 -c "import os, shutil\nfor i in range(2):\n    shutil.rmtree('.ssh')\n    os.chdir('/home/me')"
# Something registered to run when the code ends.
posix finds=delete | python3 -c "import atexit, os, shutil; atexit.register(lambda: shutil.rmtree('.ssh')); os.chdir('/home/me')"
# The `chdir` first, as before.
posix finds=delete | python3 -c "import os, shutil; os.chdir('/home/me'); shutil.rmtree('.ssh')"
# Where it goes when it is `..`, mixed, or only known when it runs.
posix finds=delete | python3 -c "import os, shutil\ndef g(): shutil.rmtree('.ssh')\nos.chdir('..')\ng()"
posix finds=delete | python3 -c "import os, shutil\ndef g(): shutil.rmtree('.ssh')\nos.chdir('/home')\nos.chdir('me')\ng()"
posix finds=delete | python3 -c "import os, shutil\ndef g(): shutil.rmtree('.ssh')\nos.chdir(d)\ng()"
# Code that is run from a string has its own `chdir`.
posix finds=delete | python3 -c "import os, shutil\nexec('import os; os.chdir(\\"/home/me\\")')\nshutil.rmtree('.ssh')"
# The same for JavaScript.
posix finds=delete | node -e "const fs = require('fs'); function g() { fs.rmSync('.ssh', {recursive: true}); } process.chdir('/home/me'); g()"
posix finds=delete | node -e "const fs = require('fs'); setTimeout(() => fs.rmSync('.ssh', {recursive: true}), 0); process.chdir('/home/me')"
posix finds=delete | node -e "const fs = require('fs'); for (const i of [1, 2]) { fs.rmSync('.ssh', {recursive: true}); process.chdir('/home/me'); }"
posix finds=delete | bun -e "const fs = require('fs'); function g() { fs.rmSync('.ssh', {recursive: true}); } process.chdir('/home/me'); g()"
posix finds=delete | deno eval "function g() { Deno.removeSync('.ssh', {recursive: true}); } Deno.chdir('/home/me'); g()"
# Not read whole by the strict gate: unknown.
posix finds=unknown | python3 -c "import os, shutil; os.chdir('/tmp'); shutil.rmtree('x')"
posix finds=unknown | python3 -c "import os, shutil; os.chdir('sub'); shutil.rmtree('x')"
posix finds=unknown | python3 -c "import os, shutil; os.chdir('sub'); os.chdir('deeper'); shutil.rmtree('x')"
posix finds=unknown | python3 -c "import os, shutil\ndef g(): shutil.rmtree('x')\nos.chdir('/tmp')\ng()"
posix finds=unknown | python3 -c "import os, shutil; shutil.rmtree('/tmp/x'); os.chdir('/home/me')"
posix finds=unknown | node -e "const fs = require('fs'); function g() { fs.rmSync('x'); } process.chdir('sub'); g()"
# A `chdir` in nested code is read, not searched for.
posix finds=delete | python3 -c "import shutil; exec(\\"import os; getattr(os,'ch'+'dir')('/home/me')\\"); shutil.rmtree('.ssh')"
posix finds=delete | node -e "eval(\\"process[\\`ch\\${'dir'}\\`]('/home/me')\\"); require('fs').rmSync('.ssh',{recursive:true})"
# At any depth.
posix finds=delete | python3 -c "import shutil; exec(\\"exec(\\\\\\"import os; getattr(os,'ch'+'dir')('/home/me')\\\\\\")\\"); shutil.rmtree('.ssh')"
# Nested code the reader cannot read may change directory.
posix finds=unknown | python3 -c "import shutil; exec(\\"import os; f = getattr(os, input()); f('/home/me')\\"); shutil.rmtree('.ssh')"
# The nested code is in the other language's own terms.
posix finds=delete | node -e "eval(\\"process.chdir('/home/me')\\"); require('fs').rmSync('.ssh',{recursive:true})"
# Not read whole by the strict gate: unknown.
posix finds=unknown | python3 -c "import shutil; exec('import os; os.getcwd()'); print(shutil.which('ls'))"
posix finds=unknown | node -e "eval('1+1'); console.log(process.cwd())"
posix finds=unknown | python3 -c "exec('print(\\"chdir\\")')"
# A read after a `chdir` the reader can place stays as it was: a key by its
# absolute path is a key from anywhere.
posix finds=read_secret | python3 -c 'import os, sys; os.chdir(sys.argv[1]); print(open("/home/me/.ssh/id_rsa").read())'
posix finds=read_secret | python3 -c 'import os, sys; os.chdir(sys.argv[1]); print(open(os.path.expanduser("~/.ssh/id_rsa")).read())'
# Not read whole by the strict gate: unknown.
posix finds=unknown | python3 -c 'import os; os.chdir("a"); os.chdir("b"); print(open("notes.txt").read())'
posix finds=unknown | python3 -c 'import os; os.chdir("/tmp"); print(open("notes.txt").read())'
posix finds=unknown | node -e "process.chdir('/tmp'); console.log(require('fs').readFileSync('notes.txt', 'utf8'))"
posix finds=unknown | python3 -c 'import os, sys; os.chdir(sys.argv[1]); print(open("/home/me/work/repo/notes.txt").read())'
posix finds=unknown | python3 -c 'import os, sys; os.chdir(sys.argv[1]); print(1)'

# A relative read after a `chdir` the reader cannot place is unknown, or the
# read of the key it is. Two steps up: `cd .. && cd .. && cat .ssh/id_rsa`
# is the same read.
posix finds=unknown/read_secret | python3 -c 'import os; os.chdir(".."); os.chdir(".."); print(open(".ssh/id_rsa").read())'
posix finds=unknown/read_secret | python3 -c 'import os; os.chdir("../.."); print(open(".ssh/id_rsa").read())'
# An absolute target and a relative one mix.
posix finds=unknown/read_secret | python3 -c 'import os; os.chdir("/home"); os.chdir("me"); print(open(".ssh/id_rsa").read())'
posix finds=unknown/read_secret | python3 -c 'import os\nos.chdir("/home/me/work")\nos.chdir("..")\nprint(open(".ssh/id_rsa").read())'
posix finds=unknown/read_secret | python3 -c 'import os\nfor _ in range(2): os.chdir("..")\nprint(open(".ssh/id_rsa").read())'
# A directory handle, and a target from the arguments.
posix finds=unknown/read_secret | python3 -c 'import os\nos.fchdir(os.open("/home/me", os.O_RDONLY))\nprint(open(".ssh/id_rsa").read())'
posix finds=unknown/read_secret | python3 -c 'import os, sys; os.chdir(sys.argv[1]); print(open("id_rsa").read())'
# A program or a script run from there reads the same file.
posix finds=unknown/read_secret | python3 -c 'import os; os.chdir(".."); os.chdir(".."); os.system("cat .ssh/id_rsa")'
posix finds=unknown/read_secret | python3 -c 'import os, subprocess; os.chdir(".."); os.chdir(".."); subprocess.run(["cat", ".ssh/id_rsa"])'
# The same in JavaScript.
posix finds=unknown/read_secret | node -e "process.chdir('..'); process.chdir('..'); console.log(require('fs').readFileSync('.ssh/id_rsa', 'utf8'))"
posix finds=unknown/read_secret | deno eval "Deno.chdir('..'); Deno.chdir('..'); console.log(Deno.readTextFileSync('.ssh/id_rsa'))"
posix finds=unknown/read_secret | bun -e "process.chdir('..'); process.chdir('..'); console.log(await Bun.file('.ssh/id_rsa').text())"
# A read of a whole folder, and nested code run from there.
posix finds=unknown/read_secret | python3 -c 'import os, shutil; os.chdir(".."); os.chdir(".."); shutil.make_archive("x", "tar", ".ssh")'
posix finds=unknown/read_secret | python3 -c 'import os; os.chdir(".."); os.chdir(".."); exec("print(open(\\".ssh/id_rsa\\").read())")'
posix finds=unknown/read_secret | node -e "process.chdir('..'); process.chdir('..'); require('child_process').execSync('cat .ssh/id_rsa')"
