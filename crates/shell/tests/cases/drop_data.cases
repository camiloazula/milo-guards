# SQLite and DuckDB files are judged like any file.
posix safe | sqlite3 data.db 'DROP TABLE t'
posix safe | sqlite3 data.db 'DELETE FROM users'
posix safe | sqlite3 ./data.db 'DROP TABLE t'
posix safe | sqlite3 db/app.sqlite 'DELETE FROM t'
