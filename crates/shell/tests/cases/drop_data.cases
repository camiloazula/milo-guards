posix safe | psql --c 'DROP TABLE users'
# Not a statement option: its value is read as the next one.
posix safe | psql --host h --dbname db -c 'SELECT 1'
posix safe | psql --ho h 'DROP TABLE users'
posix safe | psql --user-typo x
posix safe | mysql --e 'DROP TABLE t'
posix safe | mysql --host h 'DROP TABLE t'
posix finds=drop_data | psql --co 'DROP TABLE users'
posix finds=drop_data | psql --com 'DROP TABLE users'
posix finds=drop_data | psql --comm='DROP TABLE users'
posix finds=drop_data | psql --db x --co 'DROP TABLE users'
posix finds=drop_data | mysql --ex 'DROP TABLE t'
posix finds=drop_data | mysql --exec='DROP TABLE t'
posix finds=drop_data | mysql --init_command='DROP TABLE t'
posix finds=drop_data | mysql --init 'DROP TABLE t'
posix finds=drop_data | clickhouse-client --query 'DROP TABLE t'
posix finds=drop_data | sqlcmd --quer 'DROP TABLE t'
posix finds=drop_data | cqlsh --exe 'DROP TABLE t'
posix finds=drop_data | mongosh --ev 'db.dropDatabase()'

# A password option with no value does not take the statement option.
posix safe | mongosh -u admin -p --eval 'db.users.find()'
posix safe | mongosh -u admin -p secret --eval 'db.users.find()'
posix safe | mongosh --username admin --password secret --eval 'db.users.find()'
posix safe | mongosh --username admin --password --eval 'db.users.find()'
posix safe | mongosh --password=secret --eval 'db.users.find()'
posix safe | mongo -u admin -p --eval 'db.users.find()'
posix safe | clickhouse-client --password secret --query 'SELECT 1'
posix safe | clickhouse-client --password --query 'SELECT 1'
posix safe | clickhouse-client --password=secret -q 'SELECT 1'
posix safe | clickhouse-client --password -q 'SELECT 1'
# The word after a password with no value is an option of its own.
posix finds=drop_data | mongosh -u admin -p --eval 'db.dropDatabase()'
posix finds=drop_data | mongosh --username admin --password --eval 'db.dropDatabase()'
posix finds=drop_data | mongo -u admin -p --eval 'db.dropDatabase()'
posix finds=drop_data | mongosh --host -p --eval 'db.dropDatabase()'
posix finds=drop_data | clickhouse-client --password --query 'DROP TABLE t'
posix finds=drop_data | clickhouse-client --password -q 'DROP TABLE t'
posix finds=drop_data | clickhouse-client --pass -q 'DROP TABLE t'
# A password that has a value still leaves the statement read.
posix finds=drop_data | mongosh -u admin -p secret --eval 'db.dropDatabase()'
posix finds=drop_data | clickhouse-client --password secret --query 'DROP TABLE t'
# A statement that starts with `-` is read as one too.
posix finds=drop_data | mongosh --eval '-1; db.dropDatabase()'

# A `WHERE` picks the rows of its own statement only: a batch without
# semicolons keeps each `WHERE` with the statement it follows.
posix safe | psql -c 'DELETE FROM t WHERE id = 1'
posix safe | psql -c 'DELETE FROM t WHERE id IN (SELECT id FROM u)'
posix safe | psql -c 'WITH d AS (DELETE FROM t WHERE x = 1 RETURNING *) SELECT * FROM d'
posix safe | psql -c 'DELETE FROM t WHERE id = 1; UPDATE u SET a = 1 WHERE b = 2'
posix safe | psql -c 'UPDATE t SET a = (SELECT 1) WHERE id = 1'
posix safe | psql -c 'UPDATE users SET a = (SELECT 1) WHERE id = 2'
posix safe | psql -c 'UPDATE users SET a = 1 FROM (SELECT 1 AS id) s WHERE users.id = s.id'
posix safe | psql -c 'MERGE INTO t USING s ON t.id = s.id WHEN MATCHED THEN DELETE WHEN NOT MATCHED THEN INSERT VALUES (1)'
posix safe | sqlcmd -Q 'UPDATE users SET active = 0 WHERE id = 1 SELECT * FROM users'
posix safe | sqlcmd -Q 'DELETE FROM users WHERE id = 1 PRINT 1'
posix finds=drop_data | psql -c 'DELETE FROM t'
posix finds=drop_data | psql -c 'DELETE FROM t WHERE 1 = 1'
posix finds=drop_data | psql -c 'DELETE FROM t WHERE (1)'
posix finds=drop_data | psql -c 'WITH d AS (DELETE FROM t RETURNING *) SELECT * FROM d WHERE x = 1'
posix finds=drop_data | psql -c 'DELETE FROM a DELETE FROM b WHERE x = 1'
posix finds=drop_data | psql -c 'SELECT (DELETE FROM t) WHERE x = 1'
posix finds=drop_data | psql -c 'DELETE FROM t WHERE id = 1; UPDATE u SET a = 1'
posix finds=drop_data | psql -c 'WITH x AS (SELECT 1) MERGE INTO t USING x ON true WHEN MATCHED THEN DELETE; DELETE FROM u'
posix finds=drop_data | sqlcmd -Q "UPDATE users SET active = 0 SELECT * FROM users WHERE id = 1"
posix finds=drop_data | psql -c "UPDATE users SET a = 1 SELECT 1 WHERE id = 2"
posix finds=drop_data | sqlcmd -Q "DELETE FROM users PRINT 'x' SELECT 1 WHERE a = 1"
posix finds=drop_data | sqlcmd -Q "DELETE FROM users EXEC sp_who SELECT 1 WHERE a = 1"
posix finds=drop_data | sqlcmd -Q "DELETE FROM users EXECUTE sp_who WHERE a = 1"
# A `WHERE` that picks every row, then another statement.
posix finds=drop_data | psql -c "UPDATE users SET a = 1 WHERE 1 SELECT 2"
powershell safe | sqlcmd -S db -Q 'UPDATE users SET a = 0 WHERE id = 1 SELECT 1'
powershell finds=drop_data | sqlcmd -S db -Q 'UPDATE users SET a = 0 SELECT * FROM users WHERE id = 1'

# `ON` before a verb is a statement, unless it is a rule.
posix safe | psql -c "CREATE TEMP TABLE x (a int) ON COMMIT DELETE ROWS"
posix safe | psql -c "CREATE TEMP TABLE x (a int) ON COMMIT DROP"
posix safe | sqlcmd -Q "SET NOCOUNT ON DELETE FROM users WHERE id = 1"
posix safe | psql -c "CREATE TABLE t (p int REFERENCES p(id) ON DELETE SET NULL ON UPDATE NO ACTION)"
posix safe | psql -c "CREATE TABLE t (p int REFERENCES p(id) ON DELETE RESTRICT ON UPDATE CASCADE)"
posix safe | mysql -e "CREATE TABLE t (a timestamp ON UPDATE CURRENT_TIMESTAMP)"
posix safe | psql -c "CREATE RULE r AS ON DELETE TO t DO INSTEAD NOTHING"
posix safe | psql -c "CREATE RULE r AS ON UPDATE TO t DO INSTEAD NOTHING"
posix finds=drop_data | sqlcmd -Q "SET NOCOUNT ON DELETE FROM users"
posix finds=drop_data | sqlcmd -Q "SET QUOTED_IDENTIFIER ON\nDELETE FROM t"
posix finds=drop_data | sqlcmd -Q "SET ANSI_NULLS ON UPDATE users SET a = 1"
posix finds=drop_data | sqlcmd -Q "SET NOCOUNT ON UPDATE users SET a = 1 SELECT 1 WHERE b = 2"
posix finds=drop_data | psql -c "CREATE TEMP TABLE x (a int) ON COMMIT DELETE ROWS; DELETE FROM t"

# `THEN DELETE` is part of a MERGE and nothing else.
posix safe | psql -c 'MERGE INTO t USING s ON t.id = s.id WHEN MATCHED THEN DELETE'
posix safe | psql -c 'MERGE INTO t USING s ON t.id = s.id WHEN NOT MATCHED BY SOURCE THEN DELETE'
posix safe | psql -c 'MERGE INTO t USING s ON t.id = s.id WHEN MATCHED AND s.x THEN UPDATE SET a = 1 WHEN NOT MATCHED THEN INSERT VALUES (1)'
posix safe | psql -c 'WITH s AS (SELECT 1 AS id) MERGE INTO t USING s ON t.id = s.id WHEN MATCHED THEN DELETE'
posix finds=drop_data | psql -c 'DO $$ BEGIN IF true THEN DELETE FROM users; END IF; END $$'
posix finds=drop_data | psql -c 'DO $$ BEGIN IF true THEN UPDATE users SET a = 1; END IF; END $$'
posix finds=drop_data | psql -c 'DO $$ BEGIN EXCEPTION WHEN OTHERS THEN DELETE FROM users; END $$'
posix finds=drop_data | psql -c 'DO $$ BEGIN IF true THEN DROP TABLE users; END IF; END $$'
posix finds=drop_data | psql -c 'SELECT CASE WHEN a THEN 1 END; DELETE FROM users'
# Not the matched clause of a MERGE.
posix finds=drop_data | psql -c 'MERGE INTO t USING s ON t.id = s.id WHEN MATCHED THEN DO NOTHING; IF x THEN DELETE FROM t'

# A `DROP` that takes away a constraint, a default, an identity or an
# expression deletes no data; `DROP IDENTITY` and `DROP EXPRESSION` only of a
# column.
posix safe | psql -c 'ALTER TABLE users ALTER COLUMN name DROP NOT NULL'
posix safe | psql -c 'ALTER TABLE users ALTER COLUMN name DROP DEFAULT'
posix safe | psql -c 'ALTER TABLE users ALTER COLUMN id DROP IDENTITY'
posix safe | psql -c 'ALTER TABLE users ALTER COLUMN id DROP IDENTITY IF EXISTS'
posix safe | psql -c 'ALTER TABLE users ALTER COLUMN c DROP EXPRESSION'
posix safe | psql -c 'ALTER TABLE users DROP CONSTRAINT users_pkey'
posix safe | psql -c 'ALTER TABLE users DROP CONSTRAINT IF EXISTS users_pkey CASCADE'
posix safe | psql -c 'CREATE TEMP TABLE t (a int) ON COMMIT DROP'
posix safe | sqlcmd -Q 'ALTER TABLE users DROP CONSTRAINT users_pkey'
posix safe | psql -c 'ALTER TABLE t ALTER COLUMN c DROP IDENTITY'
posix safe | psql -c 'ALTER TABLE t ALTER c DROP IDENTITY IF EXISTS'
posix safe | psql -c 'ALTER TABLE t ALTER COLUMN c DROP EXPRESSION'
posix safe | psql -c 'ALTER TABLE t ALTER c DROP expression'
posix safe | psql -c 'ALTER TABLE t ALTER COLUMN "c" DROP identity'
posix safe | psql -c 'ALTER TABLE t ALTER COLUMN identity DROP identity'
posix safe | psql -c 'ALTER TABLE t ALTER COLUMN c DROP NOT NULL'
posix safe | psql -c 'ALTER TABLE t ALTER COLUMN c DROP DEFAULT'
posix safe | psql -c 'ALTER TABLE t DROP CONSTRAINT k'
posix finds=drop_data | psql -c 'ALTER TABLE users DROP COLUMN name'
posix finds=drop_data | psql -c 'ALTER TABLE users DROP name'
posix finds=drop_data | mysql -e 'ALTER TABLE t DROP PARTITION p1'
posix finds=drop_data | psql -c 'ALTER TABLE users DROP CONSTRAINT c, DROP COLUMN name'
posix finds=drop_data | psql -c 'ALTER TABLE users ALTER COLUMN name DROP NOT NULL; DROP TABLE users'
posix finds=drop_data | psql -c 'CREATE TEMP TABLE t (a int) ON COMMIT DROP; DROP TABLE users'
posix finds=drop_data | psql -c 'ALTER TABLE users DROP DEFAULT, DROP COLUMN name'
# The word `COLUMN` is optional and neither word is reserved.
posix finds=drop_data | mysql -e 'ALTER TABLE users DROP identity'
posix finds=drop_data | psql -c 'ALTER TABLE t DROP expression'
posix finds=drop_data | psql -c 'ALTER TABLE t DROP COLUMN identity'
posix finds=drop_data | psql -c 'ALTER TABLE t DROP IF EXISTS identity'
posix finds=drop_data | psql -c 'ALTER TABLE t ALTER c TYPE int, DROP identity'
posix finds=drop_data | sqlite3 ~/x.db 'ALTER TABLE users DROP identity'
posix finds=drop_data | sqlite3 ~/x.db 'ALTER TABLE users DROP expression'

# On Windows.
powershell safe | sqlcmd -S db -Q 'SELECT 1'
powershell safe | sqlcmd -S db -Q "DELETE FROM users WHERE id = 3"
powershell safe | psql -c 'SELECT 1'
powershell safe | sqlite3 data.db 'DROP TABLE t'
powershell safe | sqlite3 C:\\Users\\me\\dev\\repo\\data.db 'DROP TABLE t'
powershell safe | Get-Content schema.sql | psql app
powershell safe | Write-Output 'SELECT 1' | psql app
powershell safe | Select-String 'DROP TABLE' migrations\\001.sql
powershell finds=drop_data | sqlcmd -S db -Q 'DROP TABLE users'
powershell finds=drop_data | sqlcmd -S db -Q "TRUNCATE TABLE users"
powershell finds=drop_data | sqlcmd -S db -Q 'DELETE FROM users'
powershell finds=drop_data | sqlcmd -S db -q 'DROP DATABASE prod'
powershell finds=drop_data | psql -c 'DROP TABLE users'
powershell finds=drop_data | psql.exe -c 'DROP TABLE users'
powershell finds=drop_data | mysql -e 'DROP DATABASE prod'
powershell finds=drop_data | sqlite3 C:\\Users\\me\\data.db 'DROP TABLE t'
powershell finds=drop_data | sqlite3 $env:DB 'DROP TABLE t'
powershell finds=drop_data | redis-cli FLUSHALL
powershell finds=drop_data | dropdb prod
powershell finds=drop_data | Write-Output 'DROP TABLE users' | psql app
powershell finds=drop_data | echo 'DROP TABLE users' | psql app
powershell finds=unknown | sqlcmd -S db -Q $q
cmd safe | sqlcmd -S db -Q "SELECT 1"
cmd safe | sqlcmd -S db -Q "DELETE FROM users WHERE id = 3"
cmd safe | sqlcmd -i schema.sql
cmd finds=drop_data | sqlcmd -S db -Q "DROP TABLE users"
cmd finds=drop_data | sqlcmd -S db -Q "TRUNCATE TABLE users"
cmd finds=drop_data | sqlcmd /S db /Q "DROP TABLE users"
cmd finds=drop_data | psql -c "DROP TABLE users"
cmd finds=drop_data | redis-cli FLUSHALL
