posix safe | cd work && sqlite3 data.db 'DROP TABLE t'
posix finds=drop_data | sqlite3 ~/data/data.db 'DROP TABLE t'
posix finds=drop_data | sqlite3 ~/data/data.db 'DELETE FROM users'
