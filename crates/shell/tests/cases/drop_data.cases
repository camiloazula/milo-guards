posix finds=drop_data | sqlite3 'file://host/x.db' 'DROP TABLE t'
posix finds=drop_data | sqlite3 'file:///work/%zz.db' 'DROP TABLE t'
posix finds=drop_data | sqlite3 file: 'DROP TABLE t'
posix finds=drop_data | duckdb "md:my_db" 'DROP TABLE t'
posix finds=drop_data | duckdb 'motherduck:my_db' 'DROP TABLE t'
posix finds=drop_data | duckdb 's3://bucket/x.db' 'DROP TABLE t'
posix finds=drop_data | sqlite3 'postgres:dbname=x' 'DROP TABLE t'
# `-readonly` holds only while nothing opens another file.
posix finds=drop_data | sqlite3 -readonly ~/x.db '.open /home/me/y.db' 'DROP TABLE t'
posix finds=drop_data | sqlite3 -readonly ~/x.db '.attach /home/me/y.db o' 'DROP TABLE o.t'
posix finds=drop_data | sqlite3 -readonly x.db 'ATTACH "/home/me/o.db" AS o' 'DROP TABLE o.t'
# An option that takes a value must not move the file onto it.
posix finds=drop_data | sqlite3 -nonce X ~/data.db 'DROP TABLE t'
posix finds=drop_data | sqlite3 -screenwidth 80 ~/data.db 'DROP TABLE t'
posix finds=drop_data | sqlite3 -escape ascii ~/data.db 'DROP TABLE t'
posix finds=drop_data | sqlite3 -A x ~/data.db 'DROP TABLE t'
posix finds=drop_data | sqlite3 -alg a ~/data.db 'DROP TABLE t'
posix finds=drop_data | sqlite3 -hexkey k ~/data.db 'DROP TABLE t'
posix finds=drop_data | sqlite3 -textkey k ~/data.db 'DROP TABLE t'
posix finds=drop_data | sqlite3 -key k ~/data.db 'DROP TABLE t'
posix finds=drop_data | sqlite3 -vfs unix ~/data.db 'DROP TABLE t'
posix finds=drop_data | sqlite3 -lookaside 100 5 ~/data.db 'DROP TABLE t'
posix finds=drop_data | sqlite3 -pagecache 100 5 ~/data.db 'DROP TABLE t'
posix finds=drop_data | sqlite3 -- ~/data.db 'DROP TABLE t'
posix finds=drop_data | duckdb -f x.sql ~/data.db 'DROP TABLE t'

# A SQLite dot command is every command its name starts.
# Names that start no command the guard reads.
posix safe | sqlite3 :memory: '.schema'
posix safe | sqlite3 :memory: '.sch'
posix safe | sqlite3 :memory: '.tables'
posix safe | sqlite3 :memory: '.mode csv'
posix safe | sqlite3 :memory: '.headers on'
posix safe | sqlite3 :memory: '.quit'
posix safe | duckdb -c '.tables'
posix safe | sqlite3 ./x.db '.import data.csv t'
posix safe | sqlite3 ./x.db '.imp data.csv t'
posix safe | sqlite3 ./x.db '.output out.txt'
posix safe | sqlite3 data.db '.bail on'
posix safe | sqlite3 data.db '.ba on'
posix safe | sqlite3 data.db '.b ~/x.db'
posix safe | sqlite3 data.db '.schema'
# `.restore` of the agent's own file, as for a DROP.
posix safe | sqlite3 ./x.db '.restore empty.db'
posix safe | sqlite3 :memory: '.restore empty.db'
posix safe | sqlite3 -readonly ~/x.db '.restore empty.db'
# `.backup` and `.save` to a copy in the workspace or the temporary folder.
posix safe | sqlite3 ~/x.db '.backup out.db'
posix safe | sqlite3 data.db '.backup backup.db'
posix safe | sqlite3 data.db '.backup /tmp/backup.db'
posix safe | sqlite3 data.db '.backup temp /tmp/backup.db'
posix safe | sqlite3 data.db '.save ./copy.db'
posix safe | sqlite3 -readonly data.db '.backup backup.db'
posix safe | sqlite3 data.db '.backup :memory:'
# `VACUUM INTO` and `.clone` refuse a file that exists.
posix safe | sqlite3 data.db "VACUUM INTO '/home/me/y.db'"
posix safe | sqlite3 data.db '.clone /home/me/y.db'
# The start of `.shell` and `.system` runs the program.
posix finds=unknown | sqlite3 :memory: '.sh rm -rf ~'
posix finds=unknown | sqlite3 :memory: '.she rm -rf ~'
posix finds=unknown | sqlite3 :memory: '.shel rm -rf ~'
posix finds=unknown | sqlite3 :memory: '.sy rm -rf ~'
posix finds=unknown | sqlite3 :memory: '.syst rm -rf ~'
posix finds=unknown | duckdb -c '.sys rm -rf ~'
posix finds=unknown | sqlite3 :memory: <<'EOF'\n.sy rm -rf ~\nEOF
# The start of `.output`, `.once`, `.read` and `.import` that pipes to or
# reads from a program.
posix finds=unknown | sqlite3 :memory: '.o "|rm -rf ~"'
posix finds=unknown | sqlite3 :memory: '.onc "|rm -rf ~"'
posix finds=unknown | sqlite3 :memory: '.ou "|rm -rf ~"'
posix finds=unknown | sqlite3 x.db '.rea "|rm -rf ~"'
posix finds=unknown | sqlite3 x.db '.re "|rm -rf ~"'
posix finds=unknown | sqlite3 :memory: '.imp "|rm -rf ~" t'
posix finds=unknown | duckdb -c '.rea "|rm -rf ~"'
# The start of `.open` and `.attach` reaches another file.
posix finds=drop_data | sqlite3 x.db '.op /home/me/y.db' 'DELETE FROM t'
posix finds=drop_data | sqlite3 x.db '.att /home/me/y.db z' 'DROP TABLE t'
posix finds=drop_data | sqlite3 x.db '.open /home/me/y.db' 'DELETE FROM t'
# `.restore`, and the start of it, replaces the database.
posix finds=drop_data | sqlite3 ~/x.db '.restore empty.db'
posix finds=drop_data | sqlite3 ~/x.db ".restore main empty.db"
posix finds=drop_data | sqlite3 ~/x.db <<'EOF'\n.restore empty.db\nEOF
posix finds=drop_data | sqlite3 ./x.db '.restore other.db' '.open ~/y.db' '.restore z.db'
posix finds=drop_data | sqlite3 ~/x.db '.restore b.db'
posix finds=drop_data | sqlite3 ~/x.db '.rest b.db'
posix finds=drop_data | sqlite3 ~/x.db '.res b.db'
# `.backup` and `.save` replace the file they are given.
posix finds=drop_data | sqlite3 data.db '.backup /home/me/y.db'
posix finds=drop_data | sqlite3 data.db '.save ~/prod.db'
posix finds=drop_data | sqlite3 -readonly data.db '.backup ~/prod.db'
# The start of a name that no other command has.
posix finds=drop_data | sqlite3 data.db '.bac ~/prod.db'
posix finds=drop_data | sqlite3 data.db '.back ~/prod.db'
posix finds=drop_data | sqlite3 data.db '.backu ~/prod.db'
posix finds=drop_data | sqlite3 data.db '.sav ~/prod.db'
posix finds=drop_data | sqlite3 data.db '.sa ~/prod.db'
posix finds=drop_data | sqlite3 data.db '.BACKUP ~/prod.db'
# A database name before the file, or an option.
posix finds=drop_data | sqlite3 data.db '.backup temp /home/me/y.db'
posix finds=drop_data | sqlite3 data.db '.backup main ../y.db'
posix finds=drop_data | sqlite3 data.db '.backup "/home/me/y db"'
# After another statement, or fed to the client.
posix finds=drop_data | sqlite3 data.db 'SELECT 1;' '.backup ~/prod.db'
posix finds=drop_data | echo '.backup ~/prod.db' | sqlite3 data.db
posix finds=drop_data | sqlite3 data.db <<EOF\n.backup ~/prod.db\nEOF
posix finds=drop_data | sqlite3 data.db <<< '.save ~/prod.db'
posix finds=drop_data | duckdb x.db '.backup /home/me/y.db'
# A file only the shell knows.
posix finds=unknown | sqlite3 data.db ".backup $x"

# SQLite skips a line that starts with a hash.
posix safe | sqlite3 ~/x.db <<'EOF'\n# a note\nSELECT 1;\nEOF
posix safe | sqlite3 ~/x.db <<'EOF'\nSELECT 1;\n# it's a note\nSELECT 2;\nEOF
posix safe | duckdb ~/x.db <<'EOF'\n# a note\nSELECT 1;\nEOF
# A `#` that is not at the start of a line is not a comment, so the quote
# after it opens a string.
posix safe | sqlite3 ~/x.db "SELECT 1 # ' ; DROP TABLE t; --'"
posix safe | sqlite3 ~/x.db <<'EOF'\nSELECT 1; # '\nDROP TABLE t; --'\nEOF
# Nor when a statement is pending.
posix safe | sqlite3 ~/x.db <<'EOF'\nSELECT 1\n# ';\nDROP TABLE t; --'\nEOF
# Only SQLite and DuckDB skip it: in PostgreSQL the quote opens a string.
posix safe | psql <<'EOF'\n# it's\nDROP TABLE t;\n# '\nEOF
posix finds=drop_data | sqlite3 ~/x.db <<'EOF'\n# it's\nDROP TABLE t;\n# '\nEOF
posix finds=drop_data | sqlite3 ~/x.db <<'EOF'\nSELECT 1;\n# it's\nDROP TABLE t;\n# '\nEOF
posix finds=drop_data | duckdb ~/x.db <<'EOF'\n# it's\nDROP TABLE t;\n# '\nEOF
posix finds=drop_data | sqlite3 ~/x.db <<'EOF'\n.mode csv\n# it's\nDROP TABLE t;\n# '\nEOF

