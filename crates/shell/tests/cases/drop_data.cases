# A line that runs no client is safe: the rule reads the program, not the
# text.
posix safe | echo 'psql -c "DROP TABLE t"'
posix safe | grep FLUSHALL notes.txt
posix safe | git log --grep='DROP TABLE'
posix safe | psqlx -c 'DROP TABLE t'
posix safe | python3 scripts/gen.py
posix safe | sqlx migrate run
posix safe | rails db:migrate

# A client command is read anywhere outside a string.
posix safe | psql <<< '\\echo hi \\\\ SELECT 1;'
posix safe | psql <<< '\\o out.txt'
posix safe | psql <<< '\\copy t to out.csv csv'
posix safe | psql <<< '\\set ON_ERROR_STOP on'
posix safe | psql -c 'SELECT 1 \\g out.txt'
posix safe | psql -c 'SELECT 1 \\gx'
# A command runs to the end of its line: the `;` is its argument.
posix safe | psql -c 'SELECT 1 \\g out.txt; DROP TABLE t'
posix safe | psql <<EOF\n\\dt\n\\d users\nSELECT 1;\nEOF
posix safe | psql -c "SELECT 'C:\\\\dir'"
posix safe | psql -c '\\dt \\\\ \\d users'
# A backslash ends a command and starts the next.
posix safe | psql -c '\\set x 1'
posix safe | psql -c '\\set x 1 \\set y 2'
posix safe | psql -c '\\set x "a b" \\echo done'
posix safe | psql -c '\\echo C:\\\\tmp'
posix safe | psql <<'EOF'\n\\set x 1\n\\set y 2\nEOF
posix safe | mysql -e 'SELECT * FROM t \\G'
posix safe | mysql -e 'SELECT 1\\g'
posix safe | clickhouse-client -q 'SELECT 1 \\G'
# What the query result runs, or sets for later, is not on the line.
posix finds=unknown | psql <<EOF\nSELECT format('DROP TABLE %I', tablename) FROM pg_tables WHERE schemaname = 'public' \\gexec\nEOF
posix finds=unknown | psql <<< "SELECT 'DROP TABLE users' \\gexec"
posix finds=unknown | psql -c 'SELECT a FROM t \\gset'
posix finds=unknown | psql -c "SELECT 'DROP TABLE t' \\set x 1 \\gexec"
# A command that runs a program.
posix finds=unknown | psql <<< 'SELECT 1 \\! touch x'
posix finds=unknown | psql <<< '\\o |touch x'
posix finds=unknown | psql <<< 'SELECT 1 \\g |touch x'
posix finds=unknown | psql <<< '\\gx |touch x'
posix finds=unknown | psql <<< '\\w |touch x'
posix finds=unknown | psql <<< 'SELECT 1 \\g (format=csv) |touch x'
posix finds=unknown | psql <<< '\\echo `touch x`'
posix finds=unknown | psql <<< '\\o '\\''|touch x'\\'''
posix finds=unknown | psql <<< "\\o $dest"
posix finds=unknown | psql -c '\\copy t from program x'
posix finds=unknown | psql -c '\\set x 1 \\! touch /tmp/pwn'
posix finds=unknown | psql <<'EOF'\n\\set x 1 \\! touch /tmp/pwn\nEOF
posix finds=unknown | psql -c '\\echo hi \\copy t from program x'
posix finds=unknown | psql -c '\\set x 1 \\o |cat'
posix finds=unknown | mysql -e 'SELECT 1 \\! touch x'
# The SQL goes on after a command ends.
posix finds=drop_data | psql <<< '\\echo hi \\\\ DROP TABLE users;'
posix finds=drop_data | psql <<< '\\\\ DROP TABLE users'
posix finds=drop_data | psql <<< '\\i x.sql \\\\ DROP TABLE t'
posix finds=drop_data | psql <<EOF\n\\c prod\nDROP TABLE users;\nEOF
posix finds=drop_data | psql -c 'SELECT 1 \\g out.txt \\\\ DROP TABLE t'
posix finds=drop_data | psql -c '\\set x 1 \\g \\\\ DROP TABLE t'
# `\g` and `\G` end a MySQL statement.
posix finds=drop_data | mysql -e "DELETE FROM t \\g SELECT * FROM x WHERE a = 1"
posix finds=drop_data | mysql -e 'SELECT 1 \\G DROP TABLE t'

# Each client reads its own quoting.
# PostgreSQL's `$tag$` and `E'…'` strings, and nested comments.
posix safe | psql -c 'SELECT $a$; DROP TABLE t; $a$'
# DuckDB's parser is PostgreSQL's, so it has `$tag$` and `E'…'` strings too,
# which hide what they hold.
posix safe | duckdb ~/x.db 'SELECT $a$; DROP TABLE t; SELECT $a$'
posix safe | duckdb ~/x.duckdb "SELECT \\$a\\$; DROP TABLE t; \\$a\\$"
posix safe | duckdb ~/x.duckdb "SELECT E'a\\\\'; DROP TABLE t; --'"
posix safe | psql -c "SELECT E'a\\\\'; DROP TABLE t; --'"
posix safe | psql -c "/* /* ; DROP TABLE t */ */ SELECT 1"
# Comments do not nest in MySQL and SQLite: the string after the first `*/`
# hides what follows.
posix safe | mysql -e "/* /* */ ' */ DROP TABLE t; --'"
posix safe | sqlite3 ~/x.db "/* /* */ ' */ DROP TABLE t; --'"
# ClickHouse: heredocs, `#` comments, backslash escapes, and block comments
# that nest.
posix safe | clickhouse-client -q 'SELECT $a$; DROP TABLE t; $a$'
posix safe | clickhouse-client -q 'SELECT 1 # ; DROP TABLE t'
posix safe | clickhouse-client -q "SELECT 'a\\\\'; DROP TABLE t; --'"
posix safe | clickhouse-client -q "/* /* ; DROP TABLE t */ */ SELECT 1"
# MySQL and SQLite: backticks.
posix safe | mysql -e 'SELECT `a;b` FROM t'
posix safe | sqlite3 ~/x.db 'SELECT `a;b` FROM t'
# SQLite and SQL Server: brackets.
posix safe | sqlite3 ~/x.db 'SELECT [a;b] FROM t'
posix safe | sqlcmd -Q 'SELECT [a;b] FROM t'
posix safe | sqlcmd -Q 'SELECT [a]]; DROP TABLE t; ] FROM t'
# CQL: `$$` strings.
posix safe | cqlsh -e 'INSERT INTO t (a) VALUES ($$; DROP TABLE t; $$)'
# SQLite has no `$tag$` string.
posix finds=drop_data | sqlite3 ~/x.db 'SELECT $a$; DROP TABLE t; SELECT $a$'
# MySQL and MariaDB read `$$` as an identifier.
posix finds=drop_data | mysql -e 'SELECT 1 AS $$; DROP TABLE t; SELECT 1 AS $$'
# CQL has `$$` and no tag.
posix finds=drop_data | cqlsh -e 'SELECT $a$; DROP TABLE t; $a$'
# `E'…'` is PostgreSQL's.
posix finds=drop_data | sqlite3 ~/x.db <<'EOF'\nSELECT E'a\\';\nDROP TABLE t;\n--';\nEOF
# In DuckDB, what looked like a string is code.
posix finds=drop_data | duckdb ~/x.duckdb "SELECT \\$\\$'\\$\\$; DROP TABLE t; SELECT \\$\\$'\\$\\$"
posix finds=drop_data | duckdb ~/x.duckdb "SELECT E'a\\\\' ; SELECT '; DROP TABLE t; --'"
# PostgreSQL has no backtick, and psql splits stdin on `;`.
posix finds=drop_data | psql <<'EOF'\nSELECT `;\nDROP TABLE users;\nSELECT `;\nEOF
# PostgreSQL's and SQL Server's block comments nest.
posix finds=drop_data | psql -c "/* /* */ ' */ DROP TABLE users; --'"
posix finds=drop_data | sqlcmd -Q "/* /* */ ' */ DROP TABLE users; --'"
# So do ClickHouse's: the comment ends at the last `*/`, and the quote after
# the DROP is never closed.
posix finds=unknown | clickhouse-client -q "/* /* */ ' */ DROP TABLE t; SELECT '"
posix finds=drop_data | clickhouse-client -q "/* /* */ ' */ SELECT 1; DROP TABLE t; /* ' */"
# MySQL and ClickHouse read a backslash in a string.
posix finds=drop_data | sqlite3 ~/x.db "SELECT 'a\\\\'; DROP TABLE t; --'"
# DuckDB's comments may nest: not read.
posix finds=unknown | duckdb ~/x.db '/* /* */ */ DROP TABLE t'
# A string, bracket or comment never closed.
posix finds=unknown | sqlite3 ~/x.db 'SELECT [a; DROP TABLE t'
posix finds=unknown | sqlcmd -Q 'SELECT [a; DROP TABLE t'
posix finds=unknown | sqlite3 ~/x.db 'SELECT `a; DROP TABLE t'
posix finds=unknown | duckdb ~/x.db 'SELECT 1 /* DROP TABLE t'

# Statements that end before a string that never closes still run: a client
# sends each one as its `;` arrives.
posix safe | mysql -e "SELECT 'it\\'s'"
posix safe | mysql -e "SELECT 'it\\'s'; SELECT 1"
posix safe | mariadb -e "SELECT 'it\\'s'"
posix finds=drop_data | mysql -e "SET sql_mode='NO_BACKSLASH_ESCAPES'; SELECT 'a\\'; DROP TABLE t; SELECT '"
posix finds=drop_data | mariadb -e "SET sql_mode='NO_BACKSLASH_ESCAPES'; SELECT 'a\\'; DROP TABLE t; SELECT '"
posix finds=drop_data | mysql <<'EOF'\nSET sql_mode='NO_BACKSLASH_ESCAPES'; SELECT 'a\\'; DROP TABLE t; SELECT '\nEOF
posix finds=drop_data | mysql -e "SET sql_mode='ANSI_QUOTES'; SELECT \\"a\\\\\\"; DROP TABLE t; SELECT \\""
posix finds=drop_data | mysql -e "SELECT 'a\\'; DROP TABLE t; SELECT '"
posix finds=drop_data | psql <<'EOF'\nSET standard_conforming_strings = off;\nSELECT 'a\\''; DROP TABLE t; SELECT ';\nEOF

# A long option is any unique start of one.
