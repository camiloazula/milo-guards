posix finds=drop_data | redis-cli -r 3 flushall
posix finds=drop_data | redis-cli <<< 'FLUSHALL'
posix finds=drop_data | redis-cli <<EOF\nSET a 1\nFLUSHDB\nEOF
posix finds=drop_data | echo FLUSHALL | redis-cli
posix finds=drop_data | echo 'SET a 1\nFLUSHDB' | redis-cli -n 1
posix finds=drop_data | redis-cli --scan --pattern 'sess:*' | xargs redis-cli del
posix finds=drop_data | redis-cli --scan --pattern 'a*' | xargs redis-cli del
posix finds=drop_data | redis-cli --scan --pattern 'sess:*' | xargs -L 100 redis-cli unlink
