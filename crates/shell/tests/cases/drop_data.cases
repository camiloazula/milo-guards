# A SQLite database name can be a URI or a remote database.
posix safe | sqlite3 file:x.db 'DROP TABLE t'
posix safe | sqlite3 file:./x.db 'DROP TABLE t'
posix safe | sqlite3 'file:x.db?mode=rwc' 'DROP TABLE t'
posix safe | sqlite3 'file:/home/me/work/repo/x.db' 'DROP TABLE t'
posix safe | sqlite3 'file:///home/me/work/repo/x.db' 'DROP TABLE t'
posix safe | sqlite3 'file://localhost/home/me/work/repo/x.db' 'DROP TABLE t'
posix safe | sqlite3 'file::memory:' 'DROP TABLE t'
posix safe | sqlite3 'file:x?mode=memory&cache=shared' 'DROP TABLE t'
posix safe | sqlite3 -readonly ~/x.db 'DROP TABLE t'
posix safe | sqlite3 -readonly ~/x.db 'SELECT 1'
posix safe | sqlite3 -nonce X x.db 'DROP TABLE t'
posix safe | sqlite3 -lookaside 100 5 x.db 'DROP TABLE t'
posix safe | sqlite3 -memtrace x.db 'DROP TABLE t'
posix safe | duckdb :memory: 'DROP TABLE t'
posix safe | duckdb x.db 'DROP TABLE t'
posix safe | sqlite3 '' 'DROP TABLE t'
posix finds=drop_data | sqlite3 file:/home/me/x.db 'DROP TABLE t'
posix finds=drop_data | sqlite3 'file:///home/me/x.db' 'DROP TABLE t'
posix finds=drop_data | sqlite3 'file://localhost/home/me/x.db' 'DROP TABLE t'
