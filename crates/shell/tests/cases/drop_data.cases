posix finds=drop_data | redis-cli --tls --cacertdir /etc/ssl/certs FLUSHALL
posix finds=drop_data | redis-cli --show-pushes no FLUSHALL
posix finds=drop_data | redis-cli -X tag FLUSHALL
posix finds=drop_data | redis-cli --quoted-pattern x FLUSHALL
posix finds=drop_data | redis-cli --intrinsic-latency 5 FLUSHDB
posix finds=unknown | redis-cli $CMD
posix finds=unknown | redis-cli "$CMD" k
posix finds=unknown | redis-cli <<< "$CMD"

# A Redis script that lists keys and deletes them drops data.
posix safe | redis-cli EVAL 'return 1' 0
posix safe | redis-cli EVAL "return redis.call('GET', KEYS[1])" 1 k
posix safe | redis-cli --eval script.lua k , a
# The keys a script is given are not a listing.
posix safe | redis-cli eval "return redis.call('del', KEYS[1])" 1 k
posix safe | redis-cli eval "return redis.call('get', KEYS[1])" 1 k
posix safe | redis-cli eval "return redis.call('unlink', KEYS[1], KEYS[2])" 2 a b
# A listing with nothing deleted.
posix safe | redis-cli eval "return redis.call('keys', '*')" 0
posix safe | redis-cli eval "return redis.call('scan', 0)" 0
posix safe | redis-cli evalsha abc 1 k
posix finds=drop_data | redis-cli eval "return redis.call('del', unpack(redis.call('keys', '*')))" 0
posix finds=drop_data | redis-cli eval "for _,k in ipairs(redis.call('keys','*')) do redis.call('del',k) end" 0
posix finds=drop_data | redis-cli eval "return redis.call('unlink', unpack(redis.call('scan', 0)))" 0
posix finds=drop_data | redis-cli eval "return redis.call('DEL', unpack(redis.call('KEYS', ARGV[1])))" 0 'user:*'
posix finds=drop_data | redis-cli eval "return redis.call([[del]], redis.call([==[keys]==], '*'))" 0
posix finds=drop_data | redis-cli eval_ro "redis.call('del', redis.call('keys', '*'))" 0
# Text fed to it, a line at a time.
posix finds=drop_data | echo "eval \\"return redis.call('del', unpack(redis.call('keys','*')))\\" 0" | redis-cli
# The flushes are still found.
posix finds=drop_data | redis-cli EVAL "redis.call('FLUSHALL')" 0
posix finds=drop_data | redis-cli eval "redis.call('flushall')" 0
# A script only known when it runs.
posix finds=unknown | redis-cli --cluster call 127.0.0.1:7000 EVAL "$S" 0
posix finds=unknown | redis-cli EVAL "$S" 0
posix finds=unknown | redis-cli EVALSHA "$SHA" 0
posix finds=unknown | redis-cli FCALL "$F" 0
posix finds=unknown | redis-cli EVAL $(cat s.lua) 0
posix finds=unknown | echo "EVAL \\"$S\\" 0" | redis-cli

