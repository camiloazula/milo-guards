posix safe | sqlite3 /home/me/work/repo/data.db 'TRUNCATE t'
posix safe | sqlite3 /tmp/scratch.db 'DROP TABLE t'
posix safe | sqlite3 :memory: 'DROP TABLE t'
posix safe | sqlite3 'DROP TABLE t'
posix safe | sqlite3 -readonly ~/data.db 'DROP TABLE t'
posix safe | sqlite3 data.db 'SELECT * FROM t'
posix safe | sqlite3 ~/data/data.db 'SELECT * FROM t'
posix safe | sqlite3 ~/data/data.db 'INSERT INTO t VALUES (1)'
