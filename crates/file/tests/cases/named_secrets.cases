# The secrets a caller names (`Paths::secrets`): a read of one breaks
# `read_secret` in the caller's words, inside the workspace too, however it
# is spelled, and a write to one `write_sensitive`. A path both protected and
# secret keeps `write_protected` for a write, and a read of it is a read of
# the secret. Each section has the same paths with no secret named, where
# no other file has them. The format is in CONTRIBUTING.md.

paths env base=posix secret_file=/home/me/work/repo/.env words="the project's environment file"
paths vault base=posix secret_folder=/home/me/.vault words="your password vault"
paths both base=posix file=/home/me/work/repo/.env words="the agent's settings" secret_file=/home/me/work/repo/.env words="the project's environment file"
paths canonical base=posix secret_file=/home/me/work/repo/café.env words="the café's keys"
paths windows_env base=windows secret_file=C:\\Users\\me\\dev\\repo\\.env words="the project's environment file"
paths windows_vault base=windows secret_folder=C:\\Users\\me\\AppData\\Local\\Vault words="your password vault"

# A read of a named file is `read_secret`, in the caller's words.
read@env rules=read_secret first=read_secret reason="reads the project's environment file" | .env
read@env rules=read_secret | /home/me/work/repo/.env
read@env rules=read_secret | ~/work/repo/.env
read@env rules=read_secret | ./src/../.env
# Names compare without case on every host.
read@env rules=read_secret | .ENV
read@env rules=read_secret | /home/me/work/REPO/.Env
# A name beside it is no secret.
read@env safe | .env.example
read@env safe | src/.env
read@env safe | src/main.rs
# With no secret named, the same reads are safe.
read safe | /home/me/work/repo/.env
read safe | ~/work/repo/.env
read safe | .ENV

# A write to a named secret that is not protected is `write_sensitive`.
write@env rules=write_sensitive first=write_sensitive reason="writes to the project's environment file" | .env
write@env rules=write_sensitive | .ENV
write@env safe | src/main.rs

# A named folder is a secret, and so is everything under it.
read@vault rules=read_secret first=read_secret reason="reads your password vault" | ~/.vault/logins.db
read@vault rules=read_secret | /home/me/.vault
read@vault rules=read_secret | ~/.VAULT/a/b
read@vault safe | ~/.vaultx
read safe | ~/.vault/logins.db
read safe | /home/me/.vault
write@vault rules=write_sensitive first=write_sensitive reason="writes to your password vault" | ~/.vault/logins.db
write rules=write_outside | ~/.vault/logins.db

# Either canonical spelling names the same file.
read@canonical rules=read_secret first=read_secret reason="reads the café's keys" | café.env
read@canonical rules=read_secret | cafe\u{301}.env
read@canonical rules=read_secret | CAFE\u{301}.ENV
read safe | cafe\u{301}.env

# Windows spellings: case, either separator, the dots and spaces a name ends
# in, a short name, a long path.
read@windows_env rules=read_secret first=read_secret reason="reads the project's environment file" | .env
read@windows_env rules=read_secret | C:\\Users\\me\\dev\\repo\\.ENV
read@windows_env rules=read_secret | c:/users/me/dev/repo/.env.
read@windows_env rules=read_secret | .env\s
read@windows_env rules=read_secret | ENV~1
read@windows_env rules=read_secret | \\\\?\\C:\\Users\\me\\dev\\repo\\.env
read@windows_env rules=read_secret | ~\\dev\\repo\\.env
read@windows safe | C:\\Users\\me\\dev\\repo\\.ENV
read@windows safe | ENV~1
read@windows_vault rules=read_secret first=read_secret reason="reads your password vault" | ~\\AppData\\Local\\Vault\\x
read@windows_vault rules=read_secret | C:\\Users\\me\\AppData\\Roaming\\..\\Local\\VAULT
read@windows safe | ~\\AppData\\Local\\Vault\\x
write@windows_env rules=write_sensitive | .env

# A path both protected and secret: a read reads the secret, and a write
# keeps the protected finding.
read@both rules=read_secret first=read_secret reason="reads the project's environment file" | .env
read@both rules=read_secret | /home/me/work/repo/.ENV
write@both rules=write_protected first=write_protected reason="writes to the agent's settings" | .env
# A folder both protected and secret: a read under it reads the secret, a
# write keeps the protected finding.
paths keys_both base=posix folder=/home/me/work/repo/keys words="the agent's keys" secret_folder=/home/me/work/repo/keys words="the project's keys"
read@keys_both rules=read_secret first=read_secret reason="reads the project's keys" | keys/signing.pem
read@keys_both rules=read_secret | keys
write@keys_both rules=write_protected first=write_protected reason="writes to the agent's keys" | keys/signing.pem
read safe | keys/signing.pem

# A bracket is a character of the name a file API is given: the named path
# written out is the secret, and a protected one the caller's, whose read is
# safe as a protected path's is.
paths bracket base=posix secret_file=/home/me/work/repo/app/[id]/secret.json words="the app's secret"
paths bracket_folder base=posix secret_folder=/home/me/work/repo/app/[id] words="the app's secrets"
paths bracket_protected base=posix file=/home/me/work/repo/app/[id]/secret.json words="the agent's settings"
paths windows_bracket base=windows secret_file=C:\\Users\\me\\dev\\repo\\app\\[id]\\secret.json words="the app's secret"
read@bracket rules=read_secret first=read_secret reason="reads the app's secret" | app/[id]/secret.json
read@bracket rules=read_secret | /home/me/work/repo/app/[ID]/secret.json
write@bracket rules=write_sensitive first=write_sensitive reason="writes to the app's secret" | app/[id]/secret.json
read@bracket safe | app/[id]/other.json
read@bracket_folder rules=read_secret | app/[id]/x.json
read@windows_bracket rules=read_secret | app\\[id]\\secret.json
write@bracket_protected rules=write_protected first=write_protected reason="writes to the agent's settings" | app/[id]/secret.json
read safe | app/[id]/secret.json
write safe | app/[id]/secret.json

# A Mac links `/tmp`, `/var` and `/etc` from `/private`: a named path is the
# same under either spelling.
paths mac_tmp base=macos secret_file=/tmp/s/token words="the session token"
paths mac_private base=macos secret_file=/private/tmp/s/token words="the session token"
paths mac_etc base=macos secret_folder=/etc/myapp words="the app's settings"
paths mac_protected base=macos file=/tmp/s/token words="the agent's state"
read@mac_tmp rules=read_secret first=read_secret reason="reads the session token" | /private/tmp/s/token
read@mac_tmp rules=read_secret | /tmp/s/token
read@mac_private rules=read_secret | /tmp/s/token
read@mac_etc rules=read_secret | /private/etc/myapp/secret.conf
write@mac_protected rules=write_protected | /private/tmp/s/token
read@macos safe | /private/tmp/s/token
write@macos safe | /private/tmp/s/token
read@bracket_protected safe | app/[id]/secret.json
paths bracket_protected_folder base=posix folder=/home/me/work/repo/app/[id] words="the routes"
read@bracket_protected_folder safe | app/[id]/page.tsx
write@bracket_protected_folder rules=write_protected first=write_protected reason="writes to the routes" | app/[id]/page.tsx
paths bracket_both base=posix file=/home/me/work/repo/app/[id]/secret.json words="the agent's settings" secret_file=/home/me/work/repo/app/[id]/secret.json words="the app's secret"
read@bracket_both rules=read_secret first=read_secret reason="reads the app's secret" | app/[id]/secret.json
write@bracket_both rules=write_protected | app/[id]/secret.json
# A bracket class that picks a protected path by the pattern, not by its
# name, is no one literal path: as on `main`.
paths agent_folder base=posix folder=/home/me/.agent words="the agent's settings"
read@agent_folder rules=unreadable | ~/.ag[e]nt/x
write@agent_folder rules=unreadable | ~/.ag[e]nt/x
# A file's own name with a bracket in it.
paths sec_prod base=posix secret_file=/home/me/work/repo/sec[prod].json words="the production secret"
read@sec_prod rules=read_secret first=read_secret reason="reads the production secret" | sec[prod].json
read safe | sec[prod].json
# A bracket in a name below a protected folder whose own name has none: the
# path is under the folder as it is written, so it is judged as written and
# is no longer `unreadable`. A read of a protected path is safe; a write is
# the protected finding.
read@agent_folder safe | ~/.agent/[a]/x
read@agent_folder safe | /home/me/.agent/rules[1].md
write@agent_folder rules=write_protected first=write_protected reason="writes to the agent's settings" | ~/.agent/[a]/x
# The folder that holds a protected file with a bracket in its path, written
# with the bracket: no one literal path, where `app` written plain is the
# protected finding.
write@bracket_protected finds=unreadable | app/[id]
