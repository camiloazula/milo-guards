# Drive, case, separators, long path.
write@windows finds=write_sensitive | C:\\Users\\me\\dev\\repo\\.envrc
write@windows finds=write_sensitive | c:\\users\\ME\\dev\\repo\\.ENVRC
write@windows finds=write_sensitive | C:/Users/me/dev/repo/.envrc
write@windows finds=write_sensitive | \\Users\\me\\dev\\repo\\.envrc
write@windows finds=write_sensitive | \\\\?\\C:\\Users\\me\\dev\\repo\\.envrc
write@windows finds=write_sensitive | //?/C:/Users/me/dev/repo/.vscode/tasks.json
write@windows finds=write_sensitive | ~\\dev\\repo\\.envrc
write@windows finds=write_sensitive | C:.envrc
write@windows finds=write_sensitive | c:.vscode\\tasks.json
# Mixed and doubled separators, dots.
write@windows finds=write_sensitive | .vscode\\/tasks.json
write@windows finds=write_sensitive | .vscode\\\\tasks.json
write@windows finds=write_sensitive | .vscode\\.\\tasks.json
write@windows finds=write_sensitive | .vscode\\x\\..\\tasks.json
write@windows finds=write_sensitive | src\\..\\.envrc
write@windows finds=write_sensitive | .github\\workflows\\
# Trailing dots and spaces a name loses on Windows.
write@windows finds=write_sensitive | .envrc.
write@windows finds=write_sensitive | .envrc\s
write@windows finds=write_sensitive | .envrc. .
write@windows finds=write_sensitive | .vscode.\\tasks.json
write@windows finds=write_sensitive | .vscode\\tasks.json.
write@windows finds=write_sensitive | .vscode\\tasks.json\s
write@windows finds=write_sensitive | .github.\\workflows.\\ci.yml
# Case.
write@windows finds=write_sensitive | .VSCODE\\TASKS.JSON
write@windows finds=write_sensitive | .GitHub\\Workflows\\CI.yml
write@windows finds=write_sensitive | JENKINSFILE
# 8.3 short names, whole or in part.
write@windows finds=write_sensitive | VSCODE~1\\TASKS~1.JSO
write@windows finds=write_sensitive | VSCODE~1\\tasks.json
write@windows finds=write_sensitive | .vscode\\TASKS~1.JSO
write@windows finds=write_sensitive | vscode~1\\launch~1.jso
write@windows finds=write_sensitive | VSCODE~1\\MCP~1.JSO
write@windows finds=write_sensitive | VSCODE~1\\MCP.JSON
write@windows finds=write_sensitive | ENVRC~1
write@windows finds=write_sensitive | envrc~1
write@windows finds=write_sensitive | GITHUB~1\\WORKFL~1\\ci.yml
write@windows finds=write_sensitive | GITHUB~1\\workflows\\ci.yml
write@windows finds=write_sensitive | GITHUB~1\\ACTIONS\\x\\action.yml
write@windows finds=write_sensitive | GITHUB~1\\ACTION~1\\x\\action.yml
write@windows finds=write_sensitive | HUSKY~1\\pre-commit
write@windows finds=write_sensitive | PRE-CO~1.YAM
write@windows finds=write_sensitive | GITLAB~1.YML
write@windows finds=write_sensitive | LEFTHO~1.YML
write@windows finds=write_sensitive | JENKIN~1
write@windows finds=write_sensitive | AZURE-~1.YML
write@windows finds=write_sensitive | DEVCON~1\\devcontainer.json
write@windows finds=write_sensitive | DEVCON~1.JSO
write@windows finds=write_sensitive | CIRCLE~1\\config.yml
# The form a name hashes to once short names collide.
write@windows finds=write_sensitive | VS1A2B~1\\tasks.json
write@windows finds=write_sensitive | EN1A2B~1
# Beside the repository's history and under another folder.
write@windows finds=write_sensitive | src\\ENVRC~1
write@windows finds=write_sensitive | packages\\app\\GITHUB~1\\workflows\\ci.yml

# Windows keeps the everyday names safe.
write@windows safe | VSCODE~1\\EXTENS~1.JSO
write@windows safe | .vscode\\extensions.json
write@windows safe | GITHUB~1\\ISSUE_~1\\bug.md
write@windows safe | GITHUB~1\\DEPEND~1.YML
write@windows safe | GITHUB~1\\workflows-old\\x
write@windows safe | ENVRCX~1
write@windows safe | MAKEFI~1
write@windows safe | PACKAG~1.JSO
write@windows safe | JUSTFI~1
write@windows safe | .github\\hooks\\x
write@windows safe | C:\\Users\\me\\dev\\repo\\Makefile
write@windows safe | C:\\Users\\me\\dev\\repo\\package.json
write@windows safe | \\\\?\\C:\\Users\\me\\dev\\repo\\justfile
# A short name of another kind of name is a plain name.
write@windows safe | PROGRA~1\\x
write@windows safe | VSCODE~X
write@windows safe | ENVRC~

# What Windows cannot read to a name stays unreadable.
write@windows rules=unreadable | .vscode\\tasks.json::$DATA
write@windows rules=unreadable | .envrc:stream
write@windows rules=unreadable | .github\\workflows\\x \\ci.yml
write@windows rules=unreadable | D:.envrc

# Only the workspace's own paths are found. Beyond the workspace the place
# already says so, and nothing is added to it.
write rules=write_outside | /home/me/other/.envrc
write rules=write_outside | /home/me/.vscode/tasks.json
# `~` is also a folder named `~` in the working directory, which is the
# workspace's own, and that reading is judged too.
write rules=write_outside,write_sensitive | ~/.envrc
write rules=write_outside | /etc/.envrc
write rules=write_outside | /home/me/work/.github/workflows/ci.yml
# A temporary file is the agent's own.
write safe | /tmp/x/.envrc
write safe | /tmp/.vscode/tasks.json
write safe | /var/tmp/x/.github/workflows/ci.yml
# The repository's history, a hook and a key keep their words.
write rules=write_sensitive first=write_sensitive reason="writes to the repository's history" | .git/.envrc
write rules=write_sensitive | vendor/x/.git/hooks/.envrc

# A protected path keeps its own words.
paths protected base=posix file=/home/me/work/repo/.vscode/tasks.json words="the agent's settings" folder=/home/me/work/repo/.github/workflows words="the agent's rules"
write@protected rules=write_protected | .vscode/tasks.json
write@protected rules=write_protected first=write_protected reason="writes to the agent's rules" | .github/workflows/ci.yml
# Not protected: one finding of its own.
write@protected rules=write_sensitive | .vscode/launch.json
write@protected rules=write_sensitive | .github/actions/x/action.yml

# A write in a workspace that is the home directory is found too.
paths home cwd=/home/me home=/home/me workspace=/home/me
write@home rules=write_sensitive | .envrc
write@home rules=write_sensitive | proj/.vscode/tasks.json
write@home rules=write_sensitive | ~/proj/.github/workflows/ci.yml
# What the home directory holds keeps its own words.
write@home rules=write_sensitive first=write_sensitive reason="writes to a shell startup file" | .bashrc
write@home rules=write_sensitive | .ssh/id_rsa
write@home safe | proj/Makefile

# A bracket class inside the workspace is read as a pattern: a class that
# can pick one of the places is one.
write finds=write_sensitive | .vscode/[t]asks.json
write finds=write_sensitive | [.]vscode/tasks.json
write finds=write_sensitive | .github/workflows/[a-z].yml

# A share or a device is not the workspace's own.
write@windows rules=write_outside,network_share | \\\\srv\\share\\.envrc
write@windows rules=write_outside | \\\\.\\C:\\Users\\me\\dev\\repo\\.envrc
write@windows rules=write_outside,network_share | \\\\?\\GLOBALROOT\\Device\\x\\.envrc
# A workspace on a share: its own paths are found, and the share is the
# caller's own.
paths share cwd=\\\\srv\\share\\repo home=C:\\Users\\me workspace=\\\\srv\\share\\repo
write@share rules=write_sensitive | \\\\srv\\share\\repo\\.envrc
write@share rules=write_sensitive | //srv/share/repo/.vscode/tasks.json
write@share rules=write_sensitive | \\\\?\\UNC\\srv\\share\\repo\\.github\\workflows\\ci.yml
write@share rules=write_sensitive | .github\\workflows\\ci.yml
write@share safe | \\\\srv\\share\\repo\\Makefile
