# Spellings of one are one file: absolute, from home, from the working
# directory.
write finds=write_sensitive | /home/me/work/repo/.envrc
write finds=write_sensitive | ~/work/repo/.envrc
write finds=write_sensitive | ~/work/repo/.vscode/tasks.json
write finds=write_sensitive | ./.envrc
write finds=write_sensitive | src/../.envrc
write finds=write_sensitive | ../repo/.envrc
write finds=write_sensitive | /home/me/work/./repo/.envrc
# Doubled and dotted separators, `..` inside the name's folder.
write finds=write_sensitive | .//.envrc
write finds=write_sensitive | .vscode//tasks.json
write finds=write_sensitive | .vscode/./tasks.json
write finds=write_sensitive | .vscode/x/../tasks.json
write finds=write_sensitive | .github//workflows//ci.yml
write finds=write_sensitive | .github/workflows/
write finds=write_sensitive | .husky/
write finds=write_sensitive | .husky/.
write finds=write_sensitive | .github/x/../workflows/ci.yml
# Without case: a Mac and Windows ignore it.
write finds=write_sensitive | .ENVRC
write finds=write_sensitive | .Envrc
write finds=write_sensitive | .VSCode/Tasks.JSON
write finds=write_sensitive | .GitHub/Workflows/CI.yml
write finds=write_sensitive | .HUSKY/pre-commit
write finds=write_sensitive | JENKINSFILE
write finds=write_sensitive | LeftHook.YML
write finds=write_sensitive | .PRE-COMMIT-CONFIG.YAML
write finds=write_sensitive | .Devcontainer/devcontainer.json
# The widest fold, as a Mac's file system reads it: the Kelvin sign U+212A
# is a `k`.
write finds=write_sensitive | lefthoo\u{212A}.yml
write finds=write_sensitive | src/.ENVRC

# A Mac reads the same names by its links and its fold.
write@macos finds=write_sensitive | /Users/me/dev/repo/.envrc
write@macos finds=write_sensitive | /Users/me/dev/repo/.vscode/tasks.json
write@macos finds=write_sensitive | .ENVRC
write@macos finds=write_sensitive | .VSCODE/TASKS.JSON
write@macos finds=write_sensitive | .GITHUB/WORKFLOWS/ci.yml
write@macos finds=write_sensitive | /System/Volumes/Data/Users/me/dev/repo/.envrc
write@macos finds=write_sensitive | /Volumes/Macintosh HD/Users/me/dev/repo/.vscode/tasks.json
write@macos finds=write_sensitive | /Volumes/Macintosh HD - Data/Users/me/dev/repo/.husky/pre-commit
write@macos finds=write_sensitive | ../../../../System/Volumes/Data/Users/me/dev/repo/.envrc
write@macos finds=write_sensitive | ~/dev/repo/.envrc
# The long s is an `s` there.
write@macos finds=write_sensitive | .vſcode/tasks.json
write@macos finds=write_sensitive | Jenkinſfile

