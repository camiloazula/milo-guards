# A path on a machine with no workspace is outside.
paths none cwd=/srv/app home=/home/me
read@none safe | x
read@none safe | /etc/hosts
write@none finds=write_outside | x
write@none finds=write_outside | /home/me/work/repo/x
write@none safe | /tmp/x
write@none safe | /dev/null

# A relative working directory puts every path outside.
paths relative cwd=repo home=/home/me workspace=/home/me/repo
write@relative finds=write_outside | x
read@relative finds=read_secret | ~/.ssh/id_rsa

