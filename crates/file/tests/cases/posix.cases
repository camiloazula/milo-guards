# What is readable: what discards, what is random or zero, the terminal and
# the standard streams, and the machine's own facts.
read safe | /dev/random
read safe | /dev/tty
read safe | /dev/stdout
read safe | /dev/stderr
read safe | /dev/fd/0
read safe | /dev/fd/1
read safe | /dev/fd/2
read safe | /DEV/NULL
read safe | /dev/./null
read safe | /proc/meminfo
read safe | /proc/version
