# Accepted false alarm: a Mac ignores case, so this is the workspace, spelled
# by another case than the caller's.
write@macos finds=write_outside | /Users/me/DEV/repo/x

# A workspace on a Mac spelled by another case than the home still holds its
# keys.
paths mac_upper cwd=/Users/ME home=/Users/me workspace=/Users/ME
read@mac_upper finds=read_secret | .ssh/id_rsa
read@mac_upper finds=read_secret | /Users/me/.ssh/id_rsa
