read@windows finds=network_share | \\\\?\\unc\\server\\share\\x
read@windows finds=network_share | //?/UNC/server/share/x
read@windows finds=network_share | \\\\localhost\\C$\\Users\\me\\.ssh\\id_rsa
read@windows finds=network_share | \\\\127.0.0.1\\C$\\x
read@windows finds=network_share | \\\\wsl$\\Ubuntu\\home\\me\\.ssh\\id_rsa
read@windows finds=network_share | \\\\wsl.localhost\\Ubuntu\\home\\me\\x
read@windows finds=network_share | \\\\server\\..\\x
write@windows finds=network_share | \\\\server\\share\\x
write@windows finds=network_share | //server/share/x
write@windows finds=network_share | \\\\server\\share
write@windows finds=network_share | \\\\server
write@windows finds=network_share | \\\\?\\UNC\\server\\share\\x
write@windows finds=network_share | \\\\?\\unc\\server\\share\\x
write@windows finds=network_share | //?/UNC/server/share/x
write@windows finds=network_share | \\\\localhost\\C$\\Users\\me\\.ssh\\id_rsa
write@windows finds=network_share | \\\\127.0.0.1\\C$\\x
write@windows finds=network_share | \\\\wsl$\\Ubuntu\\home\\me\\.ssh\\id_rsa
write@windows finds=network_share | \\\\wsl.localhost\\Ubuntu\\home\\me\\x
write@windows finds=network_share | \\\\server\\..\\x
read@windows rules=network_share | \\\\server\\share\\x
read@windows rules=network_share | \\\\?\\UNC\\server\\share\\x
read@windows rules=network_share | \\\\localhost\\C$\\Users\\me\\.ssh\\id_rsa
# The device namespace is a disk as well.
read@windows rules=read_secret,network_share | \\\\.\\UNC\\server\\share\\x
read@windows rules=read_secret,network_share | \\\\?\\GLOBALROOT\\Device\\Mup\\server\\share\\x
# A share that cannot be told apart from what it says is both.
read@windows rules=unreadable,network_share | \\\\server\\share\\*
read@windows rules=unreadable,network_share | \\\\*\\share
write@windows rules=write_outside,network_share | \\\\server\\share\\x
write@windows rules=write_outside,network_share | \\\\?\\UNC\\server\\share\\x
write@windows rules=write_outside,network_share | \\\\server\\share
# Not a share: a drive, a long path to one, a device.
read@windows lacks=network_share | C:\\x
read@windows lacks=network_share | \\x
read@windows lacks=network_share | \\\\?\\C:\\x
read@windows lacks=network_share | //?/C:/x
read@windows lacks=network_share | /x
read@windows lacks=network_share | C:\\\\x
read@windows lacks=network_share | src\\x
# On a POSIX machine two separators are one.
read safe | //server/share/x
read safe | \\\\server\\share\\x

# A workspace on a share is the agent's own.
paths share cwd=\\\\srv\\share\\repo home=C:\\Users\\me workspace=\\\\srv\\share\\repo
write@share safe | src/x
write@share safe | \\\\srv\\share\\repo\\src\\x
write@share safe | \\\\SRV\\Share\\repo\\src\\x
write@share safe | \\\\?\\UNC\\srv\\share\\repo\\src\\x
write@share rules=write_outside,network_share | \\\\srv\\share\\other\\x
write@share rules=write_outside,network_share | \\\\evil\\share\\repo\\src\\x
write@share rules=write_sensitive | \\\\srv\\share\\repo\\.git\\HEAD
write@share rules=write_outside | \\\\srv\\share\\repo
read@share safe | \\\\srv\\share\\repo\\src\\x
read@share safe | \\\\srv\\share\\repo\\.git\\config
read@share rules=network_share | \\\\srv\\share\\other\\x
read@share rules=network_share | \\\\evil\\share\\x

# A workspace spelled as a long path is still the workspace: a canonical path
# on Windows carries the long-path prefix.
paths long cwd=\\\\?\\C:\\Users\\me\\dev\\repo home=\\\\?\\C:\\Users\\me workspace=\\\\?\\C:\\Users\\me\\dev\\repo
write@long safe | src/x
write@long safe | C:\\Users\\me\\dev\\repo\\src\\x
write@long safe | \\\\?\\C:\\Users\\me\\dev\\repo\\src\\x
write@long rules=write_outside | C:\\Users\\me\\notes.txt
write@long rules=write_sensitive | C:\\Users\\me\\.ssh\\config
read@long rules=read_secret | C:\\Users\\me\\.ssh\\id_rsa
read@long rules=read_secret | \\\\?\\C:\\Users\\me\\.ssh\\id_rsa
read@long safe | src/x

# A home directory with a long name is judged by its short name too.
paths long_name cwd="C:\\Users\\Camilo Azula\\dev\\repo" home="C:\\Users\\Camilo Azula" workspace="C:\\Users\\Camilo Azula\\dev\\repo"
read@long_name rules=read_secret | C:\\Users\\Camilo Azula\\.ssh\\id_rsa
read@long_name rules=read_secret | C:\\Users\\CAMILO~1\\.ssh\\id_rsa
read@long_name rules=read_secret | C:\\Users\\camilo~1\\SSH~1\\id_rsa
read@long_name rules=read_secret | C:\\Users\\CAMILO~1\\.aws\\credentials
read@long_name safe | C:\\Users\\CAMILO~1\\notes.txt
read@long_name safe | C:\\Users\\CAMILO~1\\dev\\repo\\src\\x.rs
read@long_name rules=read_secret | ~\\.ssh\\id_rsa
write@long_name rules=write_sensitive | C:\\Users\\CAMILO~1\\.ssh\\config
write@long_name rules=write_outside | C:\\Users\\CAMILO~1\\notes.txt
write@long_name rules=write_outside | C:\\Users\\CAMILO~1
# The workspace by its short name is, conservatively, beyond it.
write@long_name rules=write_outside | C:\\Users\\CAMILO~1\\dev\\repo\\x
write@long_name safe | C:\\Users\\Camilo Azula\\dev\\repo\\x

# A workspace that is the home directory keeps its keys.
paths home cwd=C:\\Users\\me home=C:\\Users\\me workspace=C:\\Users\\me
read@home rules=read_secret | .ssh\\id_rsa
read@home rules=read_secret | SSH~1\\id_rsa
read@home rules=read_secret | C:\\Users\\ME\\.SSH\\id_rsa
read@home safe | src\\x.rs
write@home rules=write_sensitive | .ssh\\config
write@home rules=write_sensitive | .git\\HEAD
write@home safe | src\\x.rs

# Only the names NTFS folds make the workspace the workspace. The Kelvin
# sign, the Ångström sign, the Ohm sign and the capital sharp s are not the
# letters they look like to NTFS: a folder by those names is another folder,
# so a write to it is beyond the workspace.
paths work cwd=C:\\Users\\me\\work home=C:\\Users\\me workspace=C:\\Users\\me\\work
write@work safe | C:\\Users\\me\\work\\x
write@work rules=write_outside | C:\\Users\\me\\wor\u{212a}\\x
paths wora cwd=C:\\Users\\me\\wor\u{e5} home=C:\\Users\\me workspace=C:\\Users\\me\\wor\u{e5}
write@wora safe | C:\\Users\\me\\wor\u{e5}\\x
write@wora rules=write_outside | C:\\Users\\me\\wor\u{212b}\\x
paths woromega cwd=C:\\Users\\me\\wor\u{3c9} home=C:\\Users\\me workspace=C:\\Users\\me\\wor\u{3c9}
write@woromega safe | C:\\Users\\me\\wor\u{3c9}\\x
write@woromega rules=write_outside | C:\\Users\\me\\wor\u{2126}\\x
paths strasse cwd=C:\\Users\\me\\stra\u{df}e home=C:\\Users\\me workspace=C:\\Users\\me\\stra\u{df}e
write@strasse safe | C:\\Users\\me\\stra\u{df}e\\x
write@strasse rules=write_outside | C:\\Users\\me\\stra\u{1e9e}e\\x
# Where matching too much fails closed, they still match: the home
# directory, a key's folder, a protected path.
paths kim cwd=C:\\Users\\Kim\\dev home=C:\\Users\\Kim workspace=C:\\Users\\Kim\\dev
read@kim rules=read_secret | C:\\Users\\\u{212a}im\\.ssh\\id_rsa
read@kim rules=read_secret | C:\\Users\\Kim\\.\u{212a}ube\\config

# The credential stores and startup places that have twins are listed.
read@windows finds=read_secret | C:\\Users\\me\\AppData\\Roaming\\GitHub CLI\\hosts.yml
read@windows finds=read_secret | ~\\AppData\\Roaming\\GitHub CLI\\hosts.yml
read@windows finds=read_secret | C:\\Users\\me\\AppData\\Roaming\\gcloud\\credentials.db
read@windows finds=read_secret | C:\\Users\\me\\AppData\\Roaming\\gnupg\\private-keys-v1.d\\x.key
read@windows finds=read_secret | C:\\Users\\me\\AppData\\Local\\Microsoft\\Vault\\x
read@windows finds=read_secret | C:\\Users\\me\\AppData\\Roaming\\Microsoft\\Vault\\x
read@windows finds=read_secret | C:\\ProgramData\\Microsoft\\Vault\\x
read@windows finds=read_secret | C:\\Users\\me\\APPDAT~1\\Roaming\\GITHUB~1\\hosts.yml
# Another user's, whatever this user's home is.
read@windows finds=read_secret | C:\\Users\\alice\\AppData\\Roaming\\GitHub CLI\\hosts.yml
write@windows finds=write_sensitive | C:\\Users\\me\\.config\\git\\config
write@windows finds=write_sensitive | ~\\.config\\powershell\\Microsoft.PowerShell_profile.ps1
write@windows finds=write_sensitive | C:\\Users\\me\\OneDrive\\Documents\\PowerShell\\profile.ps1
write@windows finds=write_sensitive | C:\\Users\\me\\OneDrive\\Documents\\WindowsPowerShell\\Microsoft.PowerShell_profile.ps1
write@windows finds=write_sensitive | C:\\Users\\me\\onedrive\\documents\\powershell\\profile.ps1
write@windows finds=write_sensitive | C:\\Users\\me\\.config\\systemd\\user\\x.service
read@windows safe | C:\\Users\\me\\OneDrive\\Documents\\PowerShell\\profile.ps1
read@windows safe | C:\\Users\\me\\.config\\git\\config

# Another user's home is one whatever this user's home is.
paths profiles cwd=D:\\profiles\\me\\repo home=D:\\profiles\\me workspace=D:\\profiles\\me\\repo
read@profiles finds=read_secret | C:\\Users\\alice\\.ssh\\id_rsa
read@profiles finds=read_secret | c:\\users\\ALICE\\.SSH\\id_rsa
read@profiles finds=read_secret | D:\\Users\\alice\\.ssh\\id_rsa
read@profiles finds=read_secret | D:\\profiles\\alice\\.ssh\\id_rsa
read@profiles safe | C:\\Users\\alice\\notes.txt

# A git folder at any depth is history, and its hooks run code: a write to
# one is a finding, a read is safe.
write@windows finds=write_sensitive | src\\.git\\x
write@windows finds=write_sensitive | src\\GIT~1\\x
write@windows finds=write_sensitive | vendor\\x\\.git\\hooks\\pre-commit
write@windows finds=write_sensitive | vendor\\x\\GIT~1\\hooks\\pre-commit
write@windows finds=write_sensitive | vendor\\x\\.git.\\hooks\\pre-commit
write@windows finds=write_sensitive | vendor\\x\\.GIT\\HOOKS\\pre-commit
write@windows finds=write_sensitive | ..\\other\\.git\\hooks\\x
read@windows safe | vendor\\x\\.git\\hooks\\pre-commit
read@windows safe | vendor\\x\\.git\\config
# The reasons: a hook says it runs code; the rest is the history.
write@windows rules=write_sensitive first=write_sensitive reason="writes to a git hook, which runs code" | vendor\\x\\.git\\hooks\\pre-commit
write@windows rules=write_sensitive first=write_sensitive reason="writes to the repository's history" | vendor\\x\\.git\\config
# Not a git folder.
write@windows safe | src\\GITHUB~1\\x
write@windows safe | src\\.github\\x
write@windows safe | hooks\\x
