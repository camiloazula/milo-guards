write@windows finds=write_sensitive | ~\\.zshrc
write@windows finds=write_sensitive | ~\\.gitconfig
# The repository's history, by every name Windows gives it.
write@windows finds=write_sensitive | .git\\HEAD
write@windows finds=write_sensitive | .git/HEAD
write@windows finds=write_sensitive | .git
write@windows finds=write_sensitive | .git\\
write@windows finds=write_sensitive | .git.\\HEAD
write@windows finds=write_sensitive | .git\\HEAD.
write@windows finds=write_sensitive | .git\\HEAD\s
write@windows finds=write_sensitive | .GIT\\HEAD
write@windows finds=write_sensitive | GIT~1\\HEAD
write@windows finds=write_sensitive | git~1\\head
write@windows finds=write_sensitive | src\\..\\.git\\HEAD
write@windows finds=write_sensitive | C:\\Users\\me\\dev\\repo\\.git\\HEAD
write@windows finds=write_sensitive | c:\\users\\me\\dev\\repo\\.GIT\\HEAD
write@windows finds=write_sensitive | \\\\?\\C:\\Users\\me\\dev\\repo\\.git\\HEAD
write@windows finds=write_sensitive | C:.git\\HEAD
write@windows finds=write_sensitive | C:..\\..\\.ssh\\config

# A path that is not one literal path is unreadable, to a read and to a
# write: empty, a variable, a wildcard, another user's `~`, a name Windows
# reads at run time (a stream, a name of dots and spaces, a folder name that
# ends in a space or two dots), and another drive's own working directory,
# which is not known.
read@windows finds=unreadable |
read@windows finds=unreadable | %USERPROFILE%\\.ssh\\id_rsa
read@windows finds=unreadable | %APPDATA%\\x
read@windows finds=unreadable | %ProgramFiles(x86)%\\x
read@windows finds=unreadable | $env:USERPROFILE\\x
read@windows finds=unreadable | ${env:HOME}\\x
read@windows finds=unreadable | $HOME\\x
read@windows finds=unreadable | $(Get-Location)\\x
read@windows finds=unreadable | `$HOME\\x
read@windows finds=unreadable | C:\\Users\\me\\x.txt::$DATA
read@windows finds=unreadable | C:\\Users\\me\\.ssh::$INDEX_ALLOCATION\\id_rsa
read@windows finds=unreadable | ~\\*
read@windows finds=unreadable | \\\\server\\share\\*
read@windows finds=unreadable | C:\\Users\\me\\dev\\repo\\*.rs
read@windows finds=unreadable | C:\\Users\\me\\.ss?\\id_rsa
read@windows finds=unreadable | C:\\Users\\me\\.s*\\id_rsa
read@windows finds=unreadable | C:*
read@windows finds=unreadable | \\\\?\\C:\\x*
read@windows finds=unreadable | \\\\?\\C:\\Users\\me\\dev\\repo\\x?
