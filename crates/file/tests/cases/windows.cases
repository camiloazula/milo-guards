# Reads and writes judged against a Windows machine's paths: every spelling
# Windows reads as one name must be judged as that name. One section for each
# behaviour. The format is in CONTRIBUTING.md; a backslash is doubled.

# Everyday reads are safe.
read@windows safe | src\\main.rs
read@windows safe | .\\Cargo.toml
read@windows safe | src/main.rs
read@windows safe | C:\\Users\\me\\dev\\repo\\src\\x.rs
read@windows safe | c:\\users\\me\\DEV\\REPO\\x
read@windows safe | C:\\Windows\\System32\\drivers\\etc\\hosts
read@windows safe | C:\\Windows\\notepad.exe
read@windows safe | C:\\Program Files\\App\\x.dll
read@windows safe | C:\\Users\\me\\notes.txt
read@windows safe | ~\\notes.txt
read@windows safe | ~/notes.txt
read@windows safe | ~
read@windows safe | ~\\
read@windows safe | NUL
read@windows safe | nul
read@windows safe | CON
read@windows safe | C:\\Users\\me\\AppData\\Local\\Temp\\x.log
read@windows safe | C:\\Windows\\Temp\\x
# The repository's history is not a secret.
read@windows safe | .git\\config
read@windows safe | .GIT\\config
read@windows safe | .git.\\config
read@windows safe | GIT~1\\config
read@windows safe | \\\\?\\C:\\Users\\me\\dev\\repo\\.git\\config
# Startup files are read for what they say.
read@windows safe | ~\\.zshrc
read@windows safe | ~\\Documents\\PowerShell\\profile.ps1
read@windows safe | C:\\Users\\me\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\x.lnk
# Beside a secret place is not under it.
read@windows safe | C:\\Users\\me\\.sshx\\id
read@windows safe | C:\\Users\\me\\.ssh.d\\id
read@windows safe | C:\\Users\\me\\SSH~2.txt
read@windows safe | C:\\Windows\\System32\\configx\\x
# A long path to a plain file, and a drive-relative one.
read@windows safe | \\\\?\\C:\\Windows\\System32\\drivers\\etc\\hosts
read@windows safe | \\\\?\\C:\\Users\\me\\dev\\repo\\src\\x.rs
read@windows safe | C:x
read@windows safe | c:src\\x.rs
read@windows safe | \\Users\\me\\dev\\repo\\x
# A POSIX path is read from the working directory's drive.
read@windows safe | /Windows/notepad.exe
# Characters that are plain in a file name.
read@windows safe | app\\[id]\\page.tsx
read@windows safe | price$.txt
read@windows safe | docs/100%.md
read@windows safe | a%20b.txt

# A read of a key or a credential is a finding.
read@windows finds=read_secret | C:\\Users\\me\\.ssh\\id_rsa
read@windows finds=read_secret | C:\\Users\\me\\.aws\\credentials
read@windows finds=read_secret | C:\\Users\\me\\.kube\\config
read@windows finds=read_secret | C:\\Users\\me\\.npmrc
read@windows finds=read_secret | C:\\Users\\me\\AppData\\Roaming\\Microsoft\\Credentials\\x
read@windows finds=read_secret | C:\\Users\\me\\AppData\\Roaming\\Microsoft\\Protect\\S-1-5\\x
read@windows finds=read_secret | C:\\Windows\\System32\\config\\SAM
read@windows finds=read_secret | C:\\ProgramData\\ssh\\ssh_host_rsa_key
# Another user's.
read@windows finds=read_secret | C:\\Users\\other\\.ssh\\id_rsa
read@windows finds=read_secret | ..\\..\\..\\other\\.ssh\\id_rsa
read@windows finds=read_secret | ~\\..\\other\\.ssh\\id_rsa
# A disk, and a namespace that is not a file path at all.
read@windows finds=read_secret | \\\\.\\PhysicalDrive0
read@windows finds=read_secret | \\\\.\\C:
read@windows finds=read_secret | \\\\?\\GLOBALROOT\\Device\\Harddisk0\\Partition1
# Accepted false alarm: a public key is under `.ssh`.
read@windows finds=read_secret | C:\\Users\\me\\.ssh\\id_rsa.pub

# Every spelling of a key is the key, to a read and to a write.
read@windows finds=read_secret | C:/Users/me/.ssh/id_rsa
read@windows finds=read_secret | C:/Users\\me/.ssh\\id_rsa
read@windows finds=read_secret | C:\\Users\\me\\.ssh\\\\id_rsa
read@windows finds=read_secret | C:\\Users\\me\\.ssh\\.\\id_rsa
read@windows finds=read_secret | C:\\Users\\me\\.ssh\\x\\..\\id_rsa
read@windows finds=read_secret | C:\\\\Users\\\\me\\\\.ssh\\\\id_rsa
# Case.
read@windows finds=read_secret | c:\\users\\me\\.ssh\\id_rsa
read@windows finds=read_secret | C:\\USERS\\ME\\.SSH\\ID_RSA
read@windows finds=read_secret | C:\\Users\\Me\\.Ssh\\Id_Rsa
# What Windows drops from a name.
read@windows finds=read_secret | C:\\Users\\me\\.ssh.\\id_rsa
read@windows finds=read_secret | C:\\Users\\me\\.ssh\\id_rsa.
read@windows finds=read_secret | C:\\Users\\me\\.ssh\\id_rsa\s
read@windows finds=read_secret | C:\\Users\\me\\.ssh\\id_rsa. .\s
read@windows finds=read_secret | C:\\Users\\me.\\.ssh\\id_rsa
# Short names: the folder's own, and the long name's.
read@windows finds=read_secret | C:\\Users\\me\\SSH~1\\id_rsa
read@windows finds=read_secret | C:\\Users\\me\\ssh~1\\ID_RS~1
read@windows finds=read_secret | C:\\Users\\me\\SSH~2\\id_rsa
read@windows finds=read_secret | C:\\Users\\ME\\SSH~1
# Rooted, drive-relative, climbing, and from the home directory.
read@windows finds=read_secret | \\Users\\me\\.ssh\\id_rsa
read@windows finds=read_secret | /Users/me/.ssh/id_rsa
read@windows finds=read_secret | \\Users\\me\\dev\\repo\\..\\..\\.ssh\\id_rsa
read@windows finds=read_secret | ~\\.ssh\\id_rsa
read@windows finds=read_secret | ~/.ssh/id_rsa
read@windows finds=read_secret | ~\\.SSH\\id_rsa
read@windows finds=read_secret | ~\\SSH~1\\id_rsa
read@windows finds=read_secret | ~\\.\\.ssh\\id_rsa
read@windows finds=read_secret | ~\\x\\..\\.ssh\\id_rsa
read@windows finds=read_secret | ..\\..\\.ssh\\id_rsa
read@windows finds=read_secret | src\\..\\..\\..\\.ssh\\id_rsa
read@windows finds=read_secret | C:..\\..\\.ssh\\id_rsa
read@windows finds=read_secret | c:..\\..\\.SSH\\id_rsa
read@windows finds=read_secret | C:src\\..\\..\\..\\.ssh\\id_rsa
read@windows finds=read_secret | C:\\Users\\me\\dev\\repo\\..\\..\\.ssh\\id_rsa
# A long path, with either separator.
read@windows finds=read_secret | \\\\?\\C:\\Users\\me\\.ssh\\id_rsa
read@windows finds=read_secret | \\\\?\\c:\\users\\me\\.SSH\\id_rsa
read@windows finds=read_secret | //?/C:/Users/me/.ssh/id_rsa
read@windows finds=read_secret | \\/?\\C:\\Users\\me\\.ssh\\id_rsa
read@windows finds=read_secret | \\\\?\\C:\\Users\\me\\SSH~1\\id_rsa
read@windows finds=read_secret | \\\\?\\C:\\Users\\me\\dev\\repo\\..\\..\\.ssh\\id_rsa
write@windows finds=write_sensitive | C:\\Users\\me\\.ssh\\id_rsa
write@windows finds=write_sensitive | C:/Users/me/.ssh/id_rsa
write@windows finds=write_sensitive | C:/Users\\me/.ssh\\id_rsa
