# A drive-relative path is from the working directory on that drive. On the
# drive the working directory is on: from it.
read@windows safe | C:.git\\config
read@windows rules=read_secret | C:..\\..\\.ssh\\id_rsa
read@windows safe | C:..\\..\\notes.txt
read@windows rules=unreadable | D:x
write@windows rules=write_outside | C:..\\..\\notes.txt
write@windows rules=write_outside | C:..
write@windows rules=unreadable | D:x
# A working directory on D:, with a second workspace on C:.
paths d_work cwd=D:\\work home=C:\\Users\\me workspace=D:\\work workspace=C:\\Users\\me\\dev\\repo
write@d_work safe | D:x
write@d_work rules=write_outside | D:..\\x
write@d_work rules=unreadable | C:x
write@d_work safe | C:\\Users\\me\\dev\\repo\\x
write@d_work rules=write_sensitive | C:\\Users\\me\\.ssh\\config
read@d_work rules=unreadable | C:x
read@d_work rules=read_secret | C:\\Users\\me\\.ssh\\id_rsa
read@d_work safe | x

