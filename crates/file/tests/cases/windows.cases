write@windows finds=write_sensitive | \\/?\\C:\\Users\\me\\.ssh\\id_rsa
write@windows finds=write_sensitive | \\\\?\\C:\\Users\\me\\SSH~1\\id_rsa
write@windows finds=write_sensitive | \\\\?\\C:\\Users\\me\\dev\\repo\\..\\..\\.ssh\\id_rsa

# A device namespace is a disk whatever it names: `\\.\C:\x` is `C:\x` to
# Windows, and `\\?\GLOBALROOT\...` can be any file by an object name. Both
# are judged as the disk they reach.
read@windows rules=read_secret | \\\\.\\C:\\Users\\me\\.ssh\\id_rsa
read@windows rules=read_secret | //./C:/Users/me/.ssh/id_rsa
read@windows rules=read_secret | \\/.\\C:\\Users\\me\\.ssh\\id_rsa
read@windows rules=read_secret | /\\.\\C:\\Users\\me\\.ssh\\id_rsa
read@windows rules=read_secret | \\\\.\\\\C:\\Users\\me\\.ssh\\id_rsa
read@windows rules=read_secret | \\\\.\\C:\\Users\\me\\dev\\repo\\x
read@windows rules=read_secret | \\\\.\\PhysicalDrive0
read@windows rules=read_secret | \\\\.\\pipe\\x
read@windows rules=read_secret | \\\\?\\Volume{26a21bda-a627-11d7-9931-806e6f6e6963}\\Users\\me\\.ssh\\id_rsa
read@windows rules=read_secret | \\\\?\\C:x
read@windows rules=read_secret | \\\\?\\
read@windows rules=read_secret | \\\\?\\X
read@windows rules=read_secret | \\\\?\\PhysicalDrive0
write@windows rules=write_outside | \\\\.\\C:\\Users\\me\\.ssh\\id_rsa
write@windows rules=write_outside | //./C:/Users/me/.ssh/id_rsa
write@windows rules=write_outside | \\/.\\C:\\Users\\me\\.ssh\\id_rsa
write@windows rules=write_outside | /\\.\\C:\\Users\\me\\.ssh\\id_rsa
write@windows rules=write_outside | \\\\.\\\\C:\\Users\\me\\.ssh\\id_rsa
write@windows rules=write_outside | \\\\.\\C:\\Users\\me\\dev\\repo\\x
write@windows rules=write_outside | \\\\.\\PhysicalDrive0
write@windows rules=write_outside | \\\\.\\pipe\\x
write@windows rules=write_outside | \\\\?\\Volume{26a21bda-a627-11d7-9931-806e6f6e6963}\\Users\\me\\.ssh\\id_rsa
write@windows rules=write_outside | \\\\?\\C:x
write@windows rules=write_outside | \\\\?\\
write@windows rules=write_outside | \\\\?\\X
write@windows rules=write_outside | \\\\?\\PhysicalDrive0
# `GLOBALROOT` can also be a share (`\\?\GLOBALROOT\Device\Mup\server\share`),
# so it is one as well; and a share with no server.
read@windows rules=read_secret,network_share | \\\\.\\GLOBALROOT\\Device\\HarddiskVolumeShadowCopy1\\Users\\me\\.ssh\\id_rsa
read@windows rules=read_secret,network_share | \\\\?\\GLOBALROOT\\Device\\HarddiskVolumeShadowCopy1\\Users\\me\\.ssh\\id_rsa
read@windows rules=read_secret,network_share | \\\\?\\globalroot\\x
read@windows rules=read_secret,network_share | \\\\?\\UNC
read@windows rules=read_secret,network_share | \\\\?\\UNC\\
write@windows rules=write_outside,network_share | \\\\.\\GLOBALROOT\\Device\\HarddiskVolumeShadowCopy1\\Users\\me\\.ssh\\id_rsa
write@windows rules=write_outside,network_share | \\\\?\\GLOBALROOT\\Device\\HarddiskVolumeShadowCopy1\\Users\\me\\.ssh\\id_rsa
write@windows rules=write_outside,network_share | \\\\?\\globalroot\\x
write@windows rules=write_outside,network_share | \\\\?\\UNC
write@windows rules=write_outside,network_share | \\\\?\\UNC\\

# Everyday writes are safe.
write@windows safe | src\\main.rs
write@windows safe | .\\x
write@windows safe | src/x
write@windows safe | C:\\Users\\me\\dev\\repo\\x
write@windows safe | c:\\USERS\\me\\dev\\repo\\x
write@windows safe | C:/Users/me/dev/repo/x
write@windows safe | \\Users\\me\\dev\\repo\\x
write@windows safe | .gitignore
write@windows safe | .gitx\\config
write@windows safe | C:x
write@windows safe | c:src\\x.rs
write@windows safe | app\\[id]\\page.tsx
write@windows safe | price$.txt
# A temporary file, and the null device.
write@windows safe | C:\\Users\\me\\AppData\\Local\\Temp\\x
write@windows safe | C:\\Windows\\Temp\\x
write@windows safe | ~\\AppData\\Local\\Temp\\x
write@windows safe | NUL
write@windows safe | nul
# The other names Windows keeps for a device, and the null device in the
# device namespace.
write@windows safe | com1
write@windows safe | lpt9:
write@windows safe | \\\\.\\NUL
write@windows rules=write_outside | \\\\.\\NUL\\x
write@windows safe | NUL:
# A long path to the workspace.
write@windows safe | \\\\?\\C:\\Users\\me\\dev\\repo\\x
write@windows safe | \\\\?\\c:\\users\\me\\dev\\repo\\x
write@windows safe | //?/C:/Users/me/dev/repo/x

# A write beyond the workspace is a finding.
write@windows finds=write_outside | C:\\Users\\me\\notes.txt
write@windows finds=write_outside | ~\\notes.txt
write@windows finds=write_outside | ~/notes.txt
write@windows finds=write_outside | C:\\Windows\\x
write@windows finds=write_outside | C:\\Windows\\System32\\drivers\\etc\\hosts
write@windows finds=write_outside | C:\\Program Files\\x
write@windows finds=write_outside | D:\\x
write@windows finds=write_outside | D:\\x\\y
write@windows finds=write_outside | ..\\other\\x
write@windows finds=write_outside | ..\\..\\x
write@windows finds=write_outside | C:..\\..\\x
write@windows finds=write_outside | \\x
write@windows finds=write_outside | C:\\
write@windows finds=write_outside | C:/
write@windows finds=write_outside | \\\\?\\C:\\
# The workspace itself, and the folders around it.
write@windows finds=write_outside | .
write@windows finds=write_outside | C:\\Users\\me\\dev\\repo
write@windows finds=write_outside | C:
write@windows finds=write_outside | c:.
write@windows finds=write_outside | ..
write@windows finds=write_outside | C:\\Users\\me
write@windows finds=write_outside | ~
write@windows finds=write_outside | C:\\Users
# A disk, and a long path that is no drive.
write@windows finds=write_outside | \\\\.\\PhysicalDrive0
write@windows finds=write_outside | \\\\.\\C:\\x
write@windows finds=write_outside | \\\\?\\GLOBALROOT\\x
write@windows finds=write_outside | \\\\?\\C:x
# Another drive and a share are not the workspace, even by the same path.
write@windows finds=write_outside | \\\\?\\D:\\Users\\me\\dev\\repo\\x
write@windows finds=write_outside | \\\\srv\\share\\Users\\me\\dev\\repo\\x

# A write to a key, a startup file or the history is a finding.
write@windows finds=write_sensitive | C:\\Users\\me\\.ssh\\config
write@windows finds=write_sensitive | ~\\.ssh\\authorized_keys
write@windows finds=write_sensitive | C:\\Users\\me\\.aws\\credentials
write@windows finds=write_sensitive | C:\\Windows\\System32\\config\\SAM
write@windows finds=write_sensitive | C:\\Users\\other\\.ssh\\authorized_keys
write@windows finds=write_sensitive | C:\\ProgramData\\ssh\\sshd_config
# What Windows starts, by any name for it.
write@windows finds=write_sensitive | C:\\Users\\me\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\x.bat
write@windows finds=write_sensitive | ~\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\x.bat
write@windows finds=write_sensitive | ~\\Documents\\PowerShell\\profile.ps1
write@windows finds=write_sensitive | ~\\Documents\\WindowsPowerShell\\Microsoft.PowerShell_profile.ps1
