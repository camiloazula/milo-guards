# Cargo build artifacts
/target/
**/target/

# Cargo backup files (generated by `cargo fix`, edition migrations, etc.)
**/*.rs.bk

# Cargo local config overrides (keep .cargo/config.toml tracked, ignore local overrides)
.cargo/config.local.toml

# MSVC profiling output
*.pdb

# Generated docs
/doc/

# Coverage / profiling
*.profraw
*.profdata
/coverage/
tarpaulin-report.*
lcov.info

# Criterion benchmark output
/criterion/

# Flamegraph output
flamegraph.svg
perf.data
perf.data.old

# rust-analyzer cache
.rust-analyzer/

# IDE / editor
.idea/
.vscode/
*.iml
*.swp
*.swo
*~
.fleet/
.zed/

# OS
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
id_rsa*
id_ed25519*

# Logs
*.log
.claude

# Ignore local .cargo state but keep config.toml tracked: it holds the
# shared `cargo lint` alias (the clippy step of `just verify`). A blanket
# `.cargo/` excludes the dir itself, so the `!` negation below can't re-include
# the file; `.cargo/*` excludes only the contents and lets the negation work.
.cargo/*
!.cargo/config.toml
tmp
